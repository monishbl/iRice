// Tessera bug reports: a Worker of its own (not part of the site Worker), with
// a D1 database. Deployed by hand. See README.md here.
{
  // (Cloudflare-side names from before the rename, kept on purpose: this
  // Worker holds the GitHub token and its database holds every report, and
  // Cloudflare can't move a saved secret to a new Worker. Only these two
  // internal names keep the old spelling; every address is Tessera's)
  "name": "irice-bugs",
  "account_id": "fc02bfeb77675c77175d0d20804ca5e2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "tessera-bugs.monishbl.in", "custom_domain": true },
    // (the old address: installs from before still post there, and older
    // issues link their screenshots there. REMOVE AFTER 2027-02-01, with
    // docs/rename-to-tessera.md's list)
    { "pattern": "irice-bugs.monishbl.in", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "irice",
      "database_id": "060067a4-73b9-4ba7-a07b-4e41b425007d",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (already set on this Worker): GITHUB_TOKEN, RATE_SALT
}
