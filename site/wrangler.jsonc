// tessera.monishbl.in: the install page, the /get setup script and the shared
// settings package, served as static files by a Cloudflare Worker.
//   site/build.sh && npx wrangler deploy --config site/wrangler.jsonc
// Deployed from the maintainer's laptop (GitHub Actions are off).
{
  "name": "tessera-site",
  "account_id": "fc02bfeb77675c77175d0d20804ca5e2",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "tessera.monishbl.in", "custom_domain": true },
    // (the address until 17 Nov 2026: installs and links made before still
    // fetch /get and /config from it, so it serves the same files)
    { "pattern": "irice.monishbl.in", "custom_domain": true }
  ]
}
