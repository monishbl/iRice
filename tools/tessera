#!/usr/bin/env bash
# tessera: look after a Tessera install.
#   tessera doctor            check that everything is in place and running
#   tessera update            get the latest Tessera and install it
#   tessera rebuild [--load]  rebuild the glass plugin, shaders and native helpers, and bring tessera-ui and tessera-events up to date (after a Hyprland or Qt update)
#   tessera repair            restart the shell (duplicated bars, a frozen shell); apps keep running
#   tessera undo-update       go back to before the last update (works from a text console too)
#   tessera logs              the shell's log
#   tessera uninstall         remove Tessera and put your previous Hyprland config back
set -uo pipefail

DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
SRC="$(cat "$DATA/tessera/source" 2>/dev/null || true)"
need_src() {
    [[ -n "$SRC" && -x "$SRC/install.sh" ]] && return 0
    echo "Can't find the Tessera source (expected in $DATA/tessera/source). Reinstall with setup.sh."
    exit 1
}

case "${1:-help}" in
    doctor|check)
        need_src
        exec "$SRC/install.sh" --verify
        ;;
    update)
        need_src
        if [[ -d "$SRC/.git" ]]; then
            echo "Getting the latest Tessera…"
            git -C "$SRC" pull --ff-only || { echo "Couldn't update $SRC (local changes?)."; exit 1; }
        fi
        "$SRC/install.sh" --yes --no-extras --no-greeter "${@:2}" || exit 1
        # AUR extras (themes, cursors) too
        if command -v yay >/dev/null; then
            echo "Updating AUR packages…"
            yay -Sua --noconfirm --answerdiff None --answerclean None
        fi
        ;;
    rebuild)
        need_src
        "$SRC/tools/build-shaders.sh" || exit 1
        # The installed shell is a copy (unless installed with --dev): refresh its shaders
        if [[ ! -L "$CONFIG/quickshell/tessera" && -d "$CONFIG/quickshell/tessera" ]]; then
            (cd "$SRC/shell" && find . -name '*.qsb' -exec cp --parents {} "$CONFIG/quickshell/tessera/" \;)
        fi
        make -C "$SRC/hypr/plugin/tessera-glass" clean >/dev/null 2>&1
        "$SRC/tools/build-plugin.sh" "${@:2}" || exit 1
        # Native helpers (after a Qt update); the installed copy gets the new build
        if "$SRC/shell/native/build.sh"; then
            if [[ ! -L "$CONFIG/quickshell/tessera" && -d "$CONFIG/quickshell/tessera" ]]; then
                rm -rf "$CONFIG/quickshell/tessera/native/build"
                cp -r "$SRC/shell/native/build" "$CONFIG/quickshell/tessera/native/build"
            fi
            echo "Native helpers rebuilt; restart the shell to use them (tessera repair)"
        fi
        "$SRC/tools/build-native.sh" && echo "tessera-ui and tessera-events are up to date; restart the shell to use new ones (tessera repair)"
        pacman -Q hyprland 2>/dev/null | awk '{print $2}' | sed 's/-[0-9.]*$//; s/^[0-9]*://; s/\.r[0-9].*//' >"$DATA/tessera/tessera-glass.built-for"
        ;;
    repair)
        exec "$CONFIG/quickshell/tessera/assets/scripts/repair-shell.sh"
        ;;
    undo-update)
        # (the installed shell's copy: it works without the source folder)
        exec python3 -I "$CONFIG/quickshell/tessera/assets/scripts/sysupdate.py" undo --terminal
        ;;
    logs)
        exec qs log -c tessera -t "${2:-80}" -f
        ;;
    uninstall)
        need_src
        exec "$SRC/uninstall.sh" "${@:2}"
        ;;
    *)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        ;;
esac
