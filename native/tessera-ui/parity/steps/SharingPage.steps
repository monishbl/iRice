# needs the Sharing module in the layout
look material
setup python3 -I -c "import json,os;p=os.path.expanduser('~/.config/tessera/config.json');c=json.load(open(p));c.setdefault('controlCenter',{})['layout']=['sharing:2x1'];json.dump(c,open(p,'w'),indent=4)"
wait 2
ipc panels open controlCenter TESSERA-TEST
wait 1
ptr move 1602 86 sleep 50 down sleep 1100 up
wait 0.6
shot sharing-page
ipc panels close
wait 1
setup sh -c 'grep -i look ~/.local/state/tessera/tessera-ui.log | tail -3'
note sharing stopped looking after close
