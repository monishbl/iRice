# Arena TESSERA-TEST 1920x1080 scale 1, the user's config (expressive motion, Colloid, their 4 widgets).
# Each file runs top to bottom from a fresh desktop. `static NAME x y w h`: that region must not change
# from there until the next `shot`, `rec` or `look` (the no-reload blocks end with their last close).
# Right-clicks: `ptr ... down up` lines marked (right button) need the runner's right button.

look glass
setup python3 -c "import json,os;p=os.path.expanduser('~/.config/tessera/config.json');c=json.load(open(p));c.setdefault('desktop',{})['widgets']=json.loads('[\"clock:m:0:0\", \"stack:m:0:1:pz3mh8\", \"batteries:m:0:2\", \"shortcuts:m:2:0:5a2cav\", \"today:m:2:1:pt1\"]');json.dump(c,open(p,'w'),indent=4)"
wait 2
shot td-added
note click the greeting: Today opens; Escape
note no reload: widgets must not fade or grow in again while windows open, focus and close (only the clock's minute may change)
ptr move 1500 600
shot td-before
setup sh -c "foot & sleep 0.8; hyprctl dispatch \"hl.dsp.window.move({ workspace = 'special:parity', follow = false, window = 'class:foot' })\""
shot td-after-open-1
setup sh -c "foot & sleep 0.8; hyprctl dispatch \"hl.dsp.window.move({ workspace = 'special:parity', follow = false, window = 'class:foot' })\""
shot td-after-open-2
note the after-open shots equal the before shot over the widgets (no widget at 0.9 scale or faded)
static td-clock 32 54 344 164
static td-stack 32 234 344 164
static td-batteries 32 414 344 164
static td-shortcuts 392 54 344 164
ptr move 1300 700 click
wait 1
setup hyprctl dispatch 'hl.dsp.window.close({ window = "class:foot" })'
wait 1.5
setup hyprctl dispatch 'hl.dsp.window.close({ window = "class:foot" })'
wait 1.5

look material
setup python3 -c "import json,os;p=os.path.expanduser('~/.config/tessera/config.json');c=json.load(open(p));c.setdefault('desktop',{})['widgets']=json.loads('[\"clock:m:0:0\", \"stack:m:0:1:pz3mh8\", \"batteries:m:0:2\", \"shortcuts:m:2:0:5a2cav\", \"today:m:2:1:pt1\"]');json.dump(c,open(p,'w'),indent=4)"
wait 2
shot td-added
note click the greeting: Today opens; Escape
note no reload: widgets must not fade or grow in again while windows open, focus and close (only the clock's minute may change)
ptr move 1500 600
shot td-before
setup sh -c "foot & sleep 0.8; hyprctl dispatch \"hl.dsp.window.move({ workspace = 'special:parity', follow = false, window = 'class:foot' })\""
shot td-after-open-1
setup sh -c "foot & sleep 0.8; hyprctl dispatch \"hl.dsp.window.move({ workspace = 'special:parity', follow = false, window = 'class:foot' })\""
shot td-after-open-2
note the after-open shots equal the before shot over the widgets (no widget at 0.9 scale or faded)
static td-clock 32 54 344 164
static td-stack 32 234 344 164
static td-batteries 32 414 344 164
static td-shortcuts 392 54 344 164
ptr move 1300 700 click
wait 1
setup hyprctl dispatch 'hl.dsp.window.close({ window = "class:foot" })'
wait 1.5
setup hyprctl dispatch 'hl.dsp.window.close({ window = "class:foot" })'
wait 1.5
