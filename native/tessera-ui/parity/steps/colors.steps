# Wallpaper accent (Glass) and Material colours (latency.md steps 13 and 15):
# the same wallpaper and config give the same colours in both shells.
look glass
setup python3 -I -c "import json,os;p=os.path.expanduser('~/.config/tessera/config.json');c=json.load(open(p));c['appearance']['accent']='wallpaper';json.dump(c,open(p,'w'),indent=4)"
wait 3
ipc panels open overview TESSERA-TEST
wait 1.5
shot accent-overview
ipc panels close
ipc panels open missionControl TESSERA-TEST
wait 1.5
shot accent-missioncontrol
ipc panels close
ipc panels openSettings
wait 3
shot accent-settings
key -k Escape
note the accent (Overview's selection, Mission Control's highlight, Settings' accent swatch) is the same colour in QML and Rust
# the seeds both shells take from the picture (written in the arena, read by the reviewer)
setup p=$(python3 -I -c "import json,os;print(json.load(open(os.path.expanduser('~/.config/tessera/config.json')))['wallpaper'].get('path',''))"); matugen image "$p" --json hex --dry-run --source-color-index 0 > /tmp/core-seed-qml.json 2>&1; "$HOME/.local/share/tessera/bin/tessera-ui" --seed "$p" > /tmp/core-seed-rust.txt 2>&1; true
note /tmp/core-seed-qml.json (source_color) and /tmp/core-seed-rust.txt must be the same colour
look material
wait 3
ipc panels open spotlight TESSERA-TEST
wait 1
key 12*12
wait 1
shot material-spotlight-calculator
key -k Escape
ipc panels open controlCenter TESSERA-TEST
wait 1.5
shot material-controlcenter
ipc panels close
note material shots: containers (Calculator hero, Top hit, tiles) the same colours in QML and Rust
