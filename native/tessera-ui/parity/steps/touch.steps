# Touch, shell-wide (latency.md step 17). Needs a touch device in the arena:
# the runner injects touch with `vtouch` if the sandbox has it (else this
# file is skipped and reported as such). setup lines below use it as
#   vtouch tap X Y | vtouch hold X Y MS | vtouch drag X1 Y1 X2 Y2 MS
look material
setup command -v vtouch >/dev/null || echo "no vtouch: touch steps skipped" > /tmp/core-touch-skipped.txt
note if /tmp/core-touch-skipped.txt exists in the arena, skip the rest and say so
# dock: tap an app (it opens), long-press one (its menu), drag one a little (no click)
setup vtouch tap 900 1040
wait 2
shot tap-dock-app
setup vtouch hold 960 1040 700
wait 1
shot hold-dock-menu
key -k Escape
setup vtouch drag 960 1040 1000 900 400
wait 1
shot drag-dock-icon
note tap-dock-app: the app opened; hold-dock-menu: its context menu; drag-dock-icon: dragged, not clicked
# Control Center: tap a toggle, drag a slider
ipc panels open controlCenter IRICE-TEST
wait 1.5
shot cc-before-touch
setup vtouch tap 1600 90
wait 1
setup vtouch drag 1580 300 1580 240 400
wait 1
shot cc-after-touch
ipc panels close
note the toggle changed and the slider moved, as the QML does
# Notification Center: flick the list
setup for i in 1 2 3 4 5 6 7 8; do notify-send "Note $i" "line"; done
ipc panels open notificationCenter IRICE-TEST
wait 1.5
setup vtouch drag 1700 800 1700 300 150
wait 2
shot nc-after-flick
ipc panels close
# Launchpad: flick between pages
ipc panels open launchpad IRICE-TEST
wait 1.5
setup vtouch drag 1400 540 500 540 150
wait 1.5
shot launchpad-page-flicked
ipc panels close
# Settings: tap a page, scroll by dragging
ipc panels openSettings
wait 3
setup vtouch tap 120 232
wait 1
setup vtouch drag 700 700 700 300 300
wait 1
shot settings-touch
key -k Escape
note every touch acts as in the QML; two fingers at once (vtouch two X Y X Y) act as the first only
