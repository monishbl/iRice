# Arena TESSERA-TEST 1920x1080 scale 1, the user's config (expressive motion, Colloid, their 4 widgets).
# Each file runs top to bottom from a fresh desktop. `static NAME x y w h`: that region must not change
# from there until the next `shot`, `rec` or `look` (the no-reload blocks end with their last close).
# Right-clicks: `ptr ... down up` lines marked (right button) need the runner's right button.

look glass
ptr move 200 130 sleep 200
note resize the clock: right-click it → Small
setup python3 -c "import json,os;p=os.path.expanduser('~/.config/tessera/config.json');c=json.load(open(p));c.setdefault('desktop',{})['widgets']=json.loads('[\"clock:s:0:0\", \"stack:m:0:1:pz3mh8\", \"batteries:m:0:2\", \"shortcuts:m:2:0:5a2cav\"]');json.dump(c,open(p,'w'),indent=4)"
wait 1
setup sh -c 'sleep $((60 - $(date +%S) - 1))'
rec ac-minute 3 ptr move 1500 600
note the minute hand turns 6° clockwise with a small overshoot over ≈400 ms (not a jump)
setup python3 -c "import json,os;p=os.path.expanduser('~/.config/tessera/config.json');c=json.load(open(p));c.setdefault('desktop',{})['widgets']=json.loads('[\"clock:m:0:0\", \"stack:m:0:1:pz3mh8\", \"batteries:m:0:2\", \"shortcuts:m:2:0:5a2cav\"]');json.dump(c,open(p,'w'),indent=4)"
wait 1

