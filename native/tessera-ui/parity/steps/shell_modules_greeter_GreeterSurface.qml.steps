# GreeterSurface: Glass and Material login screens, every demo state.
# NOTE: $TESSERA_BIN must point at the Rust binary; QML greeter (qs -p shell/greeter.qml, TESSERA_GREETER_MOCK=1) is the reference. Mock password: tessera.
# Sandbox clock may be after 22:00; compare QML and Rust in the same mode.
# ===== glass
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo users &
wait 2
shot g-users
note (glass) --demo users: 3 made-up people, avatar, name row with chevrons and Switch user, field, session, power buttons; positions, texts and colours as QML.
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo typing &
wait 2
shot g-typing
note (glass) --demo typing: Field shows dots and the send arrow active (Glass: hover 45 %; Material: send circle in primary).
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo wrong &
wait 2
shot g-wrong
note (glass) --demo wrong: Error line under the field (Glass, red) / red-toned say pill above the pill (Material), field empty.
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo busy &
wait 2
shot g-busy
note (glass) --demo busy: Placeholder "Logging in...", dots, spinner; Material avatar turned about 40 degrees.
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo finger &
wait 2
shot g-finger
note (glass) --demo finger: Fingerprint glyph in the field (Glass: placeholder "Use Fingerprint or Enter Password"; Material: finger slot).
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo finger-miss &
wait 2
shot g-finger-miss
note (glass) --demo finger-miss: Fingerprint glyph red (Glass) / error container slot (Material).
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo session &
wait 2
shot g-session
note (glass) --demo session: Session chip / "Name  ▾" under the field as in QML.
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo power &
wait 2
shot g-power
note (glass) --demo power: A power choice is pending: chosen button red, line asks to confirm ("... click it again or press Return. Esc cancels.").
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo other &
wait 2
shot g-other
note (glass) --demo other: Typed-username mode: username field shown with the placeholder "Username".
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo none &
wait 2
shot g-none
note (glass) --demo none: No people listed: username field shown, initial "?" avatar.
key -k Escape
wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look glass --demo single &
wait 2
shot g-single
note (glass) --demo single: A single person: no chevrons / Switch user behaviour as in QML.
key -k Escape
wait 1
# ===== material
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look material --demo users &
wait 2
ptr move 960 540 sleep 200 glide 1010 600 300
wait 1
shot m-users
note (material) --demo users: 3 made-up people, avatar, name row with chevrons and Switch user, field, session, power buttons; positions, texts and colours as QML.
key -k Escape
wait 1
