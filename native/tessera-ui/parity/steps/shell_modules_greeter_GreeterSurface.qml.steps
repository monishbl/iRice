setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look material --demo power &
wait 2
shot m-power
note (material) --demo power: A power choice is pending: chosen button red, line asks to confirm ("... click it again or press Return. Esc cancels.").
