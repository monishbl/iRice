wait 1
setup TESSERA_GREETER_MOCK=1 $TESSERA_BIN --greeter --style look --look material --demo single &
wait 2
ptr move 960 540 sleep 200 glide 1010 600 300
wait 1
shot m-single
note (material) --demo single: A single person: no chevrons / Switch user behaviour as in QML.
