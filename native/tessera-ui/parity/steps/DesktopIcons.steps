# Arena IRICE-TEST 1920x1080 scale 1, the user's config (expressive motion, Colloid, their 4 widgets).
# Each file runs top to bottom from a fresh desktop. `static NAME x y w h`: that region must not change
# from there until the next `shot`, `rec` or `look` (the no-reload blocks end with their last close).
# Right-clicks: `ptr ... down up` lines marked (right button) need the runner's right button.

look glass
setup sh -c 'mkdir -p ~/Desktop/Work; touch ~/Desktop/notes.txt; sleep 0.3; touch ~/Desktop/report.pdf ~/Desktop/song.mp3 ~/Desktop/archive.zip; ffmpeg -loglevel quiet -y -f lavfi -i color=red:s=400x300 -frames:v 1 ~/Desktop/photo.jpg'
wait 4
shot di-stacks
note Use Stacks on: stacks top right; each fan uses Colloid icons; Documents' front icon is the PDF (red), as QML
static di-stacks 1500 54 420 600
setup touch ~/Desktop/new.txt
wait 4
note only Documents' fan may change; other stacks don't blink
setup python3 -c "import json,os;p=os.path.expanduser('~/.config/tessera/config.json');c=json.load(open(p));c.setdefault('desktop',{})['useStacks']=json.loads('false');json.dump(c,open(p,'w'),indent=4)"
wait 4
shot di-files
setup touch ~/Desktop/a-very-long-file-name-for-testing-middle-elide.txt
wait 4
shot di-long
note long name: two lines at most, cut in the middle (a-very-…elide.txt)
setup python3 -c "import json,os;p=os.path.expanduser('~/.config/tessera/config.json');c=json.load(open(p));c.setdefault('desktop',{})['useStacks']=json.loads('true');json.dump(c,open(p,'w'),indent=4)"
wait 4
note no reload: widgets must not fade or grow in again while windows open, focus and close (only the clock's minute may change)
ptr move 1500 600
shot di-before
setup sh -c "foot & sleep 0.8; hyprctl dispatch \"hl.dsp.window.move({ workspace = 'special:parity', follow = false, window = 'class:foot' })\""
shot di-after-open-1
setup sh -c "foot & sleep 0.8; hyprctl dispatch \"hl.dsp.window.move({ workspace = 'special:parity', follow = false, window = 'class:foot' })\""
shot di-after-open-2
note the after-open shots equal the before shot over the widgets (no widget at 0.9 scale or faded)
static di-clock 32 54 344 164
static di-stack 32 234 344 164
static di-batteries 32 414 344 164
static di-shortcuts 392 54 344 164
ptr move 1300 700 click
wait 1
setup hyprctl dispatch 'hl.dsp.window.close({ window = "class:foot" })'
wait 1.5
setup hyprctl dispatch 'hl.dsp.window.close({ window = "class:foot" })'
wait 1.5

