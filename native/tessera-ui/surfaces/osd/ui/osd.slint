// The OSD in Rust (rust.surfaces: osd), compare shell/modules/osd/Osd.qml
// (Glass: the capsule under the menu bar; the thin bar over a fullscreen
// app), MaterialVolumePanel.qml (Material: Android's volume panel at the
// right edge) and menubar/IslandLevels.qml (the rows under the button).

import { Theme, Icon } from "@tessera/theme.slint";

// A row under the button: a choice (an output, input, page or settings) or,
// with a value, a level (a display, an app)
export struct OsdRow {
    icon: string,
    picture: image, // a device's picture in place of the icon (none: empty)
    text: string,
    current: bool,
    chevron: bool,
    value: float, // a level: 0..1; a choice: -1
    dim: bool, // a level's icon dimmed (the app is muted)
}

// A level along a row (IslandLevels' Level): Glass a thin track, Material its
// slider (common/Slider.qml); click or drag along it, or scroll
component RowLevel inherits Rectangle {
    in property <float> value;
    in property <color> ink;
    in property <string> label;
    callback moved(float);
    height: Theme.material ? 32px : 20px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: Math.round(clamp(value, 0, 1) * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    accessible-value-step: 0.05;
    accessible-action-increment => { moved(clamp(value + 0.05, 0, 1)); }
    accessible-action-decrement => { moved(clamp(value - 0.05, 0, 1)); }
    if !Theme.material: Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 6px;
        border-radius: 3px;
        background: ink.with-alpha(0.16);
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * clamp(value, 0, 1);
            height: parent.height;
            border-radius: 3px;
            background: ink;
        }
    }
    if Theme.material: Rectangle {
        property <length> track: 16px;
        property <length> gap: 6px;
        property <length> handle: ta.pressed ? 2px : 4px;
        property <length> hx: clamp(value, 0, 1) * (self.width - handle);
        animate handle { duration: 100ms; }
        Rectangle {
            visible: self.width > 0;
            x: 0;
            y: (parent.height - self.height) / 2;
            width: max(0px, hx - gap);
            height: track;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
            border-top-right-radius: 2px;
            border-bottom-right-radius: 2px;
            background: Theme.m3-primary;
        }
        Rectangle {
            visible: self.width > 0;
            x: hx + handle + gap;
            y: (parent.height - self.height) / 2;
            width: max(0px, parent.width - self.x);
            height: track;
            border-top-left-radius: 2px;
            border-bottom-left-radius: 2px;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
            background: Theme.m3-secondary-container;
            Rectangle {
                visible: parent.width > 12px;
                x: parent.width - 6px - 4px;
                y: (parent.height - 4px) / 2;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Theme.m3-primary;
            }
        }
        Rectangle {
            x: hx;
            width: handle;
            height: parent.height;
            border-radius: self.width / 2;
            background: Theme.m3-primary;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                moved(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
        moved => {
            if self.pressed { root.moved(clamp(self.mouse-x / self.width, 0, 1)); }
        }
        scroll-event(e) => {
            if e.delta-y == 0 { return reject; }
            root.moved(clamp(value + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
            accept
        }
    }
}

// A choice: a picture or icon, a name, a tick or an arrow (IslandLevels' Choice)
component Choice inherits Rectangle {
    in property <OsdRow> item;
    in property <color> ink;
    callback picked();
    property <bool> m3-current: Theme.material && item.current;
    property <color> content: m3-current ? Theme.m3-on-tertiary-container : ink;
    property <bool> mark: item.current || item.chevron;
    height: 32px;
    border-radius: m3-current ? self.height / 2 : 10px;
    background: m3-current ? Theme.m3-tertiary-container : ta.pressed ? ink.with-alpha(Theme.material ? 0.1 : 0.14) : ta.has-hover ? ink.with-alpha(0.08) : transparent;
    animate background { duration: 150ms; }
    accessible-role: button;
    accessible-label: item.text;
    accessible-item-selectable: item.current;
    accessible-item-selected: item.current;
    accessible-action-default => { picked(); }
    // (Material's current row: its state layer over the container)
    if m3-current: Rectangle {
        border-radius: parent.border-radius;
        background: Theme.m3-on-tertiary-container.with-alpha(ta.pressed ? 0.1 : ta.has-hover ? 0.08 : 0);
    }
    if item.picture.width > 0: Image {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        source: item.picture;
        image-fit: contain;
        accessible-role: none;
    }
    if item.picture.width == 0: Icon {
        x: 9px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        text: item.icon;
        fill: true;
        font-size: 16px;
        color: content;
    }
    Text {
        x: 36px;
        y: 0;
        width: parent.width - 36px - (mark ? 8px + 13px + 8px : 8px);
        height: parent.height;
        text: item.text;
        overflow: elide;
        color: content;
        font-size: 13px;
        font-weight: item.current ? 600 : 400;
        vertical-alignment: center;
        accessible-role: none;
    }
    if mark: Icon {
        x: parent.width - 8px - 13px;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        text: item.chevron ? "\u{e13a}" : "\u{e182}"; // caret-right, check
        bold: true;
        font-size: 13px;
        color: m3-current ? content : ink.with-alpha(0.6);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { picked(); }
    }
}

// The rows, one under another (IslandLevels)
component Levels inherits VerticalLayout {
    in property <[OsdRow]> rows;
    in property <color> ink;
    callback picked(int);
    callback level(int, float);
    spacing: 2px;
    for r[i] in rows: Rectangle {
        height: r.value >= 0 ? 34px : 32px;
        if r.value < 0: Choice {
            width: parent.width;
            height: 32px;
            item: r;
            ink: root.ink;
            picked => { root.picked(i); }
        }
        if r.value >= 0: Rectangle {
            if r.picture.width > 0: Image {
                x: 6px;
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                source: r.picture;
                image-fit: contain;
                accessible-role: none;
            }
            if r.picture.width == 0: Icon {
                x: 9px;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                text: r.icon;
                fill: true;
                font-size: 16px;
                color: root.ink;
                opacity: r.dim ? 0.35 : 1;
            }
            // (an app's icon mutes it, as IslandLevels')
            TouchArea {
                x: 5px;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }
            name := Text {
                x: 36px;
                y: 0;
                height: parent.height;
                width: min(self.preferred-width, parent.width * (r.dim || r.icon == "\u{e5da}" ? 0.35 : 0.4));
                text: r.text;
                overflow: elide;
                color: root.ink;
                font-size: 13px;
                vertical-alignment: center;
                accessible-role: none;
            }
            RowLevel {
                x: name.x + name.width + 12px;
                y: (parent.height - self.height) / 2;
                width: parent.width - self.x - 8px;
                value: r.value;
                ink: root.ink;
                label: r.text;
                moved(v) => { root.level(i, v); }
            }
        }
    }
}

// ── Glass: the capsule under the menu bar (Osd.qml) ─────────────────────────
// A 280×52 capsule on the plugin's glass, 6 px under the bar at the right:
// the symbol (it mutes), the label over a thin level, and a button that opens
// the outputs, inputs or displays under it. Fades and grows in (220 ms on the
// emphasized curve), out on the exit curve.
export component OsdCapsule inherits Window {
    in property <bool> shown;
    in property <bool> on-glass; // the glass plugin draws the glass under it
    in property <float> pace: 1;
    in property <string> glyph: "\u{e44a}";
    in property <string> label: "Sound";
    in property <float> value;
    in property <bool> can-mute: true;
    in property <string> more-label: "Outputs";
    in property <bool> levels-open;
    in property <[OsdRow]> rows;
    out property <float> progress: shown ? 1 : 0;
    out property <length> levels-height: levels-open ? levels.preferred-height + 8px : 0;
    out property <bool> pointer-on: hover.has-hover;
    callback closed(); // the exit animation ended
    callback set-level(float);
    callback toggle-mute();
    callback toggle-levels();
    callback picked(int);
    callback row-level(int, float);

    property <length> m: 24px; // room for the glass's shadow
    background: transparent;
    no-frame: true;
    title: "Volume";
    default-font-family: Theme.font;
    preferred-width: 280px + 2 * m;
    preferred-height: 52px + levels-height + 2 * m;

    animate progress {
        duration: 220ms * pace;
        easing: shown ? cubic-bezier(0.2, 0.9, 0.1, 1.0) : cubic-bezier(0.4, 0.0, 1.0, 1.0);
    }
    changed progress => {
        if !shown && progress <= 0.001 { closed(); }
    }

    // Without the plugin, its own tint (Hyprland's blur behind it); with
    // it, the plugin draws the glass (Rust sends the shape, scaled as this)
    Rectangle {
        x: m;
        y: m;
        width: 280px;
        height: root.height - 2 * m;
        border-radius: 26px;
        background: on-glass ? transparent : Theme.panel;
        opacity: progress;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: 0.94 + 0.06 * progress;
    }

    // (resting on it keeps it up: hover covers everything in it)
    hover := TouchArea {
        x: m;
        y: m;
        width: 280px;
        height: root.height - 2 * m;
        opacity: progress;

        // The symbol: mutes (not for brightness)
        Icon {
            x: 16px;
            y: (52px - self.height) / 2;
            width: 20px;
            height: 20px;
            text: glyph;
            fill: true;
            font-size: 20px;
            color: Theme.label;
        }
        if can-mute: TouchArea {
            x: 16px - 6px;
            y: (52px - 20px) / 2 - 6px;
            width: 32px;
            height: 32px;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Mute";
            accessible-action-default => { toggle-mute(); }
            clicked => { toggle-mute(); }
        }
        Text {
            x: 48px;
            y: 13px;
            width: min(self.preferred-width, 180px);
            text: label;
            overflow: elide;
            color: Theme.label;
            font-size: Theme.small;
            font-weight: 600;
            accessible-role: none;
        }
        bar := Rectangle {
            x: 48px;
            y: 33px;
            width: 180px;
            height: 6px;
            border-radius: 3px;
            background: Theme.toggle-off;
            accessible-role: slider;
            accessible-label: label;
            accessible-value: Math.round(clamp(value, 0, 1) * 100) + "%";
            accessible-value-minimum: 0;
            accessible-value-maximum: 1;
            accessible-value-step: 0.05;
            accessible-action-increment => { set-level(value + 0.05); }
            accessible-action-decrement => { set-level(value - 0.05); }
            Rectangle {
                x: 0;
                width: parent.width * clamp(value, 0, 1);
                height: parent.height;
                border-radius: 3px;
                background: Theme.label;
                animate width { duration: drag.pressed ? 0ms : 150ms * pace; }
            }
        }
        // (the level's pointer area reaches 10 px past it)
        drag := TouchArea {
            x: bar.x - 10px;
            y: bar.y - 10px;
            width: bar.width + 20px;
            height: bar.height + 20px;
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    set-level((self.mouse-x - 10px) / bar.width);
                }
            }
            moved => {
                if self.pressed { set-level((self.mouse-x - 10px) / bar.width); }
            }
            scroll-event(e) => {
                if e.delta-y == 0 { return reject; }
                set-level(value + (e.delta-y > 0 ? 0.05 : -0.05));
                accept
            }
        }
        // Outputs, inputs or displays
        Rectangle {
            x: 240px;
            y: 12px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: more.pressed ? Theme.fill-pressed : more.has-hover || levels-open ? Theme.fill : transparent;
            accessible-role: button;
            accessible-label: more-label;
            accessible-expandable: true;
            accessible-expanded: levels-open;
            accessible-action-default => { toggle-levels(); }
            Icon {
                width: 100%;
                height: 100%;
                text: levels-open ? "\u{e13c}" : "\u{e136}"; // caret-up, caret-down
                bold: true;
                font-size: 13px;
                color: Theme.label;
            }
            more := TouchArea {
                mouse-cursor: pointer;
                clicked => { toggle-levels(); }
            }
        }
        // (hidden, not made in an `if`: its height is known before it opens)
        levels := Levels {
            x: 8px;
            y: 52px;
            width: 280px - 16px;
            height: self.preferred-height;
            visible: levels-open;
            rows: root.rows;
            ink: Theme.label;
            picked(i) => { root.picked(i); }
            level(i, v) => { root.row-level(i, v); }
        }
    }
}

// ── Material: Android's volume panel at the right edge ──────────────────────
// (MaterialVolumePanel.qml) A pill, vertically centred, that springs in from
// the edge: the mute toggle, a tall Expressive slider (filled part primary
// with the symbol inside, a thin handle between gaps, a stop dot) and the
// button that opens the outputs, inputs or displays in a card beside it. The
// level shows beside the handle while dragging; a device that just arrived,
// or the microphone's state, in a toast pill to its left.
export component OsdPanel inherits Window {
    in property <bool> shown;
    in property <float> pace: 1;
    in property <string> glyph: "\u{e44a}";
    in property <string> label: "Sound";
    in property <float> value;
    in property <bool> can-mute: true; // the toggle (not for brightness)
    in property <bool> mic;
    in property <bool> muted; // the toggle is selected
    in property <bool> toast; // a device's name or the microphone's state
    in property <string> more-label: "Outputs";
    in property <bool> levels-open;
    in property <[OsdRow]> rows;
    out property <float> progress: shown ? 1 : 0;
    out property <bool> pointer-on: hover.has-hover;
    callback closed();
    callback set-level(float);
    callback toggle-mute();
    callback toggle-levels();
    callback picked(int);
    callback row-level(int, float);

    property <length> track-w: 44px;
    property <length> track-h: 200px;
    property <length> pad: 8px;
    property <length> button: 44px;
    property <length> edge: 16px; // from the screen's right edge
    out property <length> card-w: 296px;
    out property <length> panel-w: track-w + 2 * pad;
    out property <length> panel-h: pad + (can-mute ? button + pad : 0) + track-h + pad + button + pad;
    // where the panel rests, and the card
    out property <length> panel-x0: self.width - edge - panel-w;
    out property <length> panel-y0: Math.round((self.height - panel-h) / 2 / 1px) * 1px;
    out property <length> card-h: levels.preferred-height + 48px + 8px;
    out property <length> card-x: panel-x0 - 12px - card-w;
    out property <length> card-y: max(16px, min(self.height - card-h - 16px, panel-y0 + panel-h - card-h));

    background: transparent;
    no-frame: true;
    title: "Volume";
    default-font-family: Theme.font;
    preferred-width: edge + panel-w + 12px + card-w + 24px;

    // In on Material's default spatial spring (a little past its place), out
    // faster on the emphasized accelerate curve
    animate progress {
        duration: shown ? 322ms : 200ms * pace;
        easing: shown ? spring(0.2) : cubic-bezier(0.3, 0.0, 0.8, 0.15);
    }
    changed progress => {
        if !shown && progress <= 0.001 { closed(); }
    }

    hover := TouchArea {
        // ── The panel ───────────────────────────────────────────────────
        panel := Rectangle {
            x: panel-x0 + (1 - progress) * (panel-w + edge + 16px);
            y: panel-y0;
            width: panel-w;
            height: panel-h;
            opacity: clamp(progress * 2, 0, 1);
            border-radius: self.width / 2;
            background: Theme.m3-surface-container.with-alpha(Theme.panel-alpha);
            // (elevation 2; see-through it has none, as Android 17's)
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.blur ? transparent : Theme.m3-shadow.with-alpha(Theme.dark ? 0.4 : 0.16);

            // Mute: round when on, a squarer tertiary container when muted
            if can-mute: Rectangle {
                x: pad;
                y: pad;
                width: button;
                height: button;
                border-radius: muted ? 12px : self.width / 2;
                animate border-radius { duration: 222ms; easing: spring(0.4); }
                background: muted ? Theme.m3-tertiary-container : Theme.m3-surface-container-highest;
                animate background { duration: 150ms * pace; }
                accessible-role: AccessibleRole.button;
                accessible-label: mic ? (muted ? "Turn microphone on" : "Turn microphone off") : (muted ? "Unmute" : "Mute");
                accessible-action-default => { toggle-mute(); }
                Rectangle {
                    border-radius: parent.border-radius;
                    background: (muted ? Theme.m3-on-tertiary-container : Theme.m3-on-surface-variant).with-alpha(mute-ta.pressed ? 0.1 : mute-ta.has-hover ? 0.08 : 0);
                }
                Icon {
                    width: 100%;
                    height: 100%;
                    text: mic ? (muted ? "\u{e328}" : "\u{e326}") : (muted ? "\u{e45c}" : "\u{e44a}");
                    fill: muted;
                    font-size: 20px;
                    color: muted ? Theme.m3-on-tertiary-container : Theme.m3-on-surface-variant;
                }
                mute-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { toggle-mute(); }
                }
            }

            // The slider: the inactive part on top (a stop dot at its end),
            // the handle, the filled part below
            slider := Rectangle {
                x: pad;
                y: pad + (can-mute ? button + pad : 0);
                width: track-w;
                height: track-h;
                property <float> ratio: clamp(value, 0, 1);
                // (follows the level quickly; straight under the pointer)
                property <float> shown-ratio: ratio;
                animate shown-ratio {
                    duration: area.pressed ? 0ms : 150ms * pace;
                    easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
                }
                property <length> outer: self.width / 2;
                property <length> inner: 4px;
                property <length> gap: 6px;
                property <length> thick: area.pressed ? 2px : 4px; // the handle, thinner while held
                animate thick { duration: 100ms; }
                property <length> hy: (1 - shown-ratio) * (self.height - thick);
                property <length> active-top: hy + thick + gap;
                property <length> active-h: max(0px, self.height - active-top);
                property <bool> icon-inside: active-h >= 24px + 20px;
                accessible-role: AccessibleRole.slider;
                accessible-label: label;
                accessible-value: Math.round(ratio * 100) + "%";
                accessible-value-minimum: 0;
                accessible-value-maximum: 1;
                accessible-value-step: 0.05;
                accessible-action-increment => { set-level(ratio + 0.05); }
                accessible-action-decrement => { set-level(ratio - 0.05); }

                Rectangle {
                    visible: self.height > 0;
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: max(0px, hy - gap);
                    border-top-left-radius: min(outer, max(0px, self.height - inner));
                    border-top-right-radius: min(outer, max(0px, self.height - inner));
                    border-bottom-left-radius: min(inner, self.height / 2);
                    border-bottom-right-radius: min(inner, self.height / 2);
                    background: Theme.m3-secondary-container;
                    Rectangle {
                        visible: parent.height > 20px;
                        x: (parent.width - self.width) / 2;
                        y: 8px;
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.m3-primary;
                    }
                }
                Rectangle {
                    visible: self.height > 0;
                    x: 0;
                    y: active-top;
                    width: parent.width;
                    height: active-h;
                    border-top-left-radius: min(inner, self.height / 2);
                    border-top-right-radius: min(inner, self.height / 2);
                    border-bottom-left-radius: min(outer, max(0px, self.height - inner));
                    border-bottom-right-radius: min(outer, max(0px, self.height - inner));
                    background: Theme.m3-primary;
                }
                // The handle, a little wider than the track
                Rectangle {
                    x: -4px;
                    y: hy;
                    width: parent.width + 8px;
                    height: thick;
                    border-radius: self.height / 2;
                    background: Theme.m3-primary;
                }
                // The symbol inside the filled part while it fits, else just
                // above the handle
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: icon-inside ? parent.height - 12px - self.height : hy - gap - 8px - self.height;
                    visible: icon-inside || self.y >= 0;
                    width: 20px;
                    height: 20px;
                    text: glyph;
                    fill: true;
                    font-size: 20px;
                    color: icon-inside ? Theme.m3-on-primary : Theme.m3-on-secondary-container;
                }
                area := TouchArea {
                    x: -pad;
                    y: -pad;
                    width: parent.width + 2 * pad;
                    height: parent.height + 2 * pad;
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            set-level(1 - (self.mouse-y - pad - thick / 2) / (slider.height - thick));
                        }
                    }
                    moved => {
                        if self.pressed { set-level(1 - (self.mouse-y - pad - thick / 2) / (slider.height - thick)); }
                    }
                    scroll-event(e) => {
                        if e.delta-y == 0 { return reject; }
                        set-level(value + (e.delta-y > 0 ? 0.05 : -0.05));
                        accept
                    }
                }
            }

            // Outputs, inputs or displays
            Rectangle {
                x: pad;
                y: slider.y + track-h + pad;
                width: button;
                height: button;
                border-radius: levels-open ? 12px : self.width / 2;
                animate border-radius { duration: 222ms; easing: spring(0.4); }
                background: levels-open ? Theme.m3-secondary-container : Theme.m3-surface-container-highest;
                animate background { duration: 150ms * pace; }
                accessible-role: AccessibleRole.button;
                accessible-label: more-label;
                accessible-expandable: true;
                accessible-expanded: levels-open;
                accessible-action-default => { toggle-levels(); }
                Rectangle {
                    border-radius: parent.border-radius;
                    background: (levels-open ? Theme.m3-on-secondary-container : Theme.m3-on-surface-variant).with-alpha(more-ta.pressed ? 0.1 : more-ta.has-hover ? 0.08 : 0);
                }
                Icon {
                    width: 100%;
                    height: 100%;
                    text: "\u{e434}"; // sliders-horizontal
                    fill: levels-open;
                    font-size: 20px;
                    color: levels-open ? Theme.m3-on-secondary-container : Theme.m3-on-surface-variant;
                }
                more-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { toggle-levels(); }
                }
            }

            // The level while dragging, beside the handle
            Rectangle {
                x: -self.width - 8px;
                y: max(0px, min(parent.height - self.height, slider.y + slider.hy + slider.thick / 2 - self.height / 2));
                width: 52px;
                height: 36px;
                border-radius: self.height / 2;
                background: Theme.m3-inverse-surface;
                opacity: area.pressed ? 1 : 0;
                animate opacity { duration: 100ms; }
                Text {
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: Math.round(slider.ratio * 100);
                    color: Theme.m3-inverse-on-surface;
                    font-size: 14px;
                    font-weight: 500;
                    accessible-role: none;
                }
            }

            // A toast pill: the device that just arrived, or the microphone's state
            toast-pill := Rectangle {
                property <bool> showing: toast && !levels-open && !area.pressed;
                x: -self.width - 8px + (showing ? 0 : 8px);
                animate x { duration: 220ms * pace; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
                y: pad;
                width: min(280px, toast-row.preferred-width + 32px);
                height: 44px;
                border-radius: self.height / 2;
                background: Theme.m3-inverse-surface;
                opacity: showing ? 1 : 0;
                animate opacity { duration: 150ms * pace; }
                toast-row := HorizontalLayout {
                    x: (parent.width - self.preferred-width) / 2;
                    width: self.preferred-width;
                    spacing: 8px;
                    Icon {
                        width: 18px;
                        text: glyph;
                        fill: true;
                        font-size: 18px;
                        color: Theme.m3-inverse-on-surface;
                    }
                    Text {
                        max-width: 220px;
                        text: label;
                        overflow: elide;
                        color: Theme.m3-inverse-on-surface;
                        font-size: 14px;
                        letter-spacing: 0.25px;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
        }

        // ── Outputs, inputs or displays: a card beside the panel ────────
        card := Rectangle {
            property <bool> open: levels-open && shown;
            x: card-x;
            y: card-y;
            width: card-w;
            height: card-h;
            opacity: open ? min(1, progress) : 0;
            animate opacity { duration: 150ms * pace; }
            transform-origin: { x: self.width, y: self.height };
            transform-scale: open ? 1 : 0.92;
            animate transform-scale { duration: 222ms; easing: spring(0.4); }
            border-radius: Theme.radius-module;
            background: Theme.m3-surface-container;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.m3-shadow.with-alpha(Theme.dark ? 0.4 : 0.16);
            Text {
                x: 20px;
                y: 16px;
                text: more-label;
                color: Theme.m3-on-surface-variant;
                font-size: 14px;
                font-weight: 500;
                letter-spacing: 0.1px;
                accessible-role: none;
            }
            levels := Levels {
                x: 8px;
                y: 48px;
                width: parent.width - 16px;
                rows: root.rows;
                ink: Theme.m3-on-surface;
                picked(i) => { root.picked(i); }
                level(i, v) => { root.row-level(i, v); }
            }
        }
    }
}

// ── Over a fullscreen app: a thin bar centred along the top edge ────────────
// (Osd.qml's fsBar) A 5 px level on a faint track, a small symbol before it;
// fades in (150 ms), and out after 1.2 s without a change. Clicks go through.
export component OsdBar inherits Window {
    in property <bool> shown;
    in property <bool> still; // Reduce motion: no travel
    in property <string> glyph: "\u{e44a}";
    in property <float> value;
    in property <string> name: "Volume";
    out property <float> fade: shown ? 1 : 0;
    callback closed();

    background: transparent;
    no-frame: true;
    title: name;
    accessible-role: progress-indicator;
    accessible-label: name;
    accessible-value: Math.round(clamp(value, 0, 1) * 100) + "%";
    preferred-height: 24px;

    animate fade {
        duration: shown ? 150ms : 100ms;
        easing: shown ? cubic-bezier(0.33, 1, 0.68, 1) : cubic-bezier(0.32, 0, 0.67, 0);
    }
    changed fade => {
        if !shown && fade <= 0.001 { closed(); }
    }

    // (Material: its fixed primary tones, which read the same over any video)
    property <color> ink: Theme.material ? Theme.m3-primary-fixed-dim : #F5F5F7;
    property <length> track: self.width - 32px - 20px;
    property <length> row-w: 12px + 8px + track;
    Rectangle {
        x: (root.width - row-w) / 2;
        y: 6px - (still ? 0 : Math.round((1 - fade) * 4) * 1px);
        width: row-w;
        height: 12px;
        opacity: fade;
        Icon {
            x: 0;
            y: 0;
            width: 12px;
            height: 12px;
            text: glyph;
            fill: true;
            font-size: 12px;
            color: ink;
        }
        Rectangle {
            x: 20px;
            y: (parent.height - self.height) / 2;
            width: track;
            height: 5px;
            border-radius: 2.5px;
            background: Theme.material ? Theme.m3-scrim.with-alpha(0.35) : #00000059;
            border-width: 1px;
            border-color: Theme.material ? Theme.m3-primary-fixed.with-alpha(0.22) : #ffffff38;
            // (a soft dark halo, so it reads over bright video too)
            drop-shadow-blur: 6px;
            drop-shadow-color: #0000008c;
            Rectangle {
                visible: value > 0;
                x: 0;
                width: max(parent.height, parent.width * clamp(value, 0, 1));
                height: parent.height;
                border-radius: 2.5px;
                background: ink;
                animate width { duration: 100ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            }
        }
    }
}
