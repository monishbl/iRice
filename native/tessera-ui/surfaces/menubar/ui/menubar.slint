// The menu bar in Rust (rust.surfaces: menubar), compare
// shell/modules/menubar/MenuBar.qml, MenuBarItem.qml, HoverTip.qml,
// PrivacyDots.qml, common/BatteryGlyph.qml and WifiGlyph.qml, and the menus:
// glass/MenuPopover.qml and MaterialMenu.qml.
// (Slint draws no cut-outs: the battery's bolt and its number inside are
// outlined instead of cut out of the fill.)

import { Theme, Icons } from "@tessera/theme.slint";
import { Spaces, Chip, Island, Live, Ctl, AlertRow, Ring, IslandStats, BatteryGlyph, ActRow, RecentRow, LevelRow } from "island.slint";
import { Symbols, SymIcon } from "@tessera/symbols.slint";

export { Chip, Live, Ctl, AlertRow, Ring, IslandStats, ActRow, RecentRow, LevelRow, Symbols }

// One item on the right (items.rs: Entry)
export struct Entry {
    id: string,
    icon: string,
    fill: bool,
    bold: bool,
    text: string,
    tip: string,
    // 0 icon/text, 1 battery, 2 Wi-Fi, 3 privacy, 4 a tray picture
    glyph: int,
    image: image,
    level: float,
    charging: bool,
    plugged: bool,
    low-power: bool,
    show-percent: bool,
    wifi-on: bool,
    wifi-lit: string, // the lit arcs' glyph ("" none)
    camera: bool,
    mic: bool,
    location: bool,
    share: bool,
    danger: bool,
    active: bool,
    badge: int,
    indicator: string,
    unread: int,
}

// A privacy dot: pops in (PrivacyDots: scale 0 → 1, 200 ms OutBack)
component Dot inherits Rectangle {
    in property <color> c;
    width: 7px;
    border-radius: 3.5px;
    background: c;
    property <bool> in-view;
    init => { in-view = true; }
    transform-scale: in-view ? 1 : 0;
    animate transform-scale { duration: 200ms; easing: ease-out-back; }
}

// One bar item (MenuBarItem): its icon or drawing, its text, a rounded
// highlight on hover and while its menu is open
component Item inherits Rectangle {
    in property <Entry> e;
    in property <color> ink;
    in property <bool> ink-dark;
    // a drag of files over the bar (the shelf item takes it: MenuBar.qml's DropArea)
    in property <bool> drag-over;
    in property <length> drag-x;
    callback clicked(PointerEventButton, length);
    callback hovered(bool, length, string);
    callback drop-hot(bool);
    property <bool> hot: e.id == "shelf" && drag-over && drag-x >= self.absolute-position.x && drag-x < self.absolute-position.x + self.width;
    changed hot => { root.drop-hot(hot); }
    property <color> tone: e.danger ? Theme.danger : ink;
    height: 24px;
    width: (e.glyph == 3 && Theme.material ? chip.width : row.preferred-width) + (e.glyph == 3 ? 16px : 18px);
    border-radius: Theme.material ? self.height / 2 : Theme.radius-item;
    background: Theme.material
        ? tone.with-alpha(e.active ? 0.16 : touch.pressed ? 0.1 : touch.has-hover ? 0.08 : 0)
        : tone.with-alpha(e.active ? 0.22 : touch.pressed ? 0.2 : touch.has-hover ? 0.12 : 0);
    animate background { duration: Theme.hover; }
    accessible-role: button;
    accessible-label: e.tip != "" ? e.tip : e.text;
    accessible-action-default => { root.clicked(PointerEventButton.left, self.absolute-position.x); }

    touch := TouchArea {
        changed has-hover => { root.hovered(self.has-hover, root.absolute-position.x + root.width / 2, e.tip); }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right && self.has-hover {
                root.clicked(PointerEventButton.right, root.absolute-position.x);
            }
        }
        clicked => { root.clicked(PointerEventButton.left, root.absolute-position.x); }
    }

    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        visible: e.glyph != 3;
        // Unread notifications, before the clock's text
        if e.unread > 0 && e.indicator != "off": HorizontalLayout {
            spacing: 3px;
            alignment: center;
            if e.indicator == "bellDot" || e.indicator == "bellCount": Rectangle {
                width: 15px;
                SymIcon {
                    text: "\u{e0ce}"; // bell
                    fill: true;
                    font-size: 14px;
                    color: root.tone;
                }
                if e.indicator == "bellDot": Rectangle {
                    x: 9px;
                    y: (parent.height - 16px) / 2;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.material ? Theme.m3-primary : Theme.blue;
                    border-width: Theme.material ? 0 : 1px;
                    border-color: #00000040;
                }
            }
            if e.indicator == "dot": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.material ? Theme.m3-primary : Theme.blue;
                }
            }
            if e.indicator == "count" || e.indicator == "bellCount": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: max(16px, count.preferred-width + 8px);
                    height: 16px;
                    border-radius: 8px;
                    background: e.indicator == "count" ? (Theme.material ? Theme.m3-primary : Theme.blue) : transparent;
                    count := Text {
                        text: e.unread > 99 ? "99+" : e.unread;
                        color: e.indicator == "count" ? (Theme.material ? Theme.m3-on-primary : #ffffff) : root.tone;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if e.glyph == 4: VerticalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: e.image;
                image-fit: contain;
                accessible-role: none;
            }
        }
        if e.glyph == 1: VerticalLayout {
            alignment: center;
            BatteryGlyph {
                level: e.level;
                charging: e.charging;
                plugged: e.plugged;
                low-power: e.low-power;
                show-percent: e.show-percent;
                ink: root.tone;
                ink-dark: root.ink-dark;
            }
        }
        // Wi-Fi: the arcs faint, the lit ones as strong as the signal
        if e.glyph == 2: Rectangle {
            width: 16px;
            SymIcon {
                text: e.wifi-on ? "\u{e4ea}" : "\u{e4f2}"; // wifi-high | wifi-slash
                fill: true;
                font-size: 16px;
                color: e.wifi-on ? root.tone.with-alpha(0.35) : root.tone;
            }
            if e.wifi-on && e.wifi-lit != "": SymIcon {
                text: e.wifi-lit;
                fill: true;
                font-size: 16px;
                color: root.tone;
            }
        }
        // (the shelf's in a fixed slot: it fills while files are over it, and
        // the filled glyph's width doesn't reach the bar's layout)
        if e.icon != "" && e.id == "shelf": Rectangle {
            min-width: 15px;
            max-width: 15px;
            preferred-width: 15px;
            SymIcon {
                x: 0;
                y: 0;
                width: 15px;
                height: parent.height;
                text: e.icon;
                fill: e.fill || hot;
                bold: e.bold;
                font-size: 15px;
                color: hot ? Theme.accent : root.tone;
            }
        }
        if e.icon != "" && e.id != "shelf": SymIcon {
            text: e.icon;
            fill: e.fill;
            bold: e.bold;
            font-size: 15px;
            color: hot ? Theme.accent : root.tone;
        }
        if e.text != "": Text {
            text: e.text;
            color: root.tone;
            font-size: Theme.material ? 14px : Theme.body;
            font-weight: e.bold ? (Theme.material ? 600 : 700) : 500;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    // The privacy dots (Glass), Android's privacy chip (Material)
    if e.glyph == 3 && !Theme.material: HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-top: 8.5px;
        padding-bottom: 8.5px;
        if e.camera: Dot { c: #30D158; }
        if e.mic: Dot { c: #FF9F0A; }
        if e.location: Dot { c: #0A84FF; }
        if e.share: Dot { c: #BF5AF2; }
    }
    chip := Rectangle {
        visible: e.glyph == 3 && Theme.material;
        width: icons.preferred-width + 12px;
        height: 20px;
        border-radius: 10px;
        background: Theme.m3-tertiary-container;
        icons := HorizontalLayout {
            alignment: center;
            spacing: 2px;
            if e.camera: SymIcon { text: "\u{e4da}"; fill: true; font-size: 12px; color: Theme.m3-on-tertiary-container; }
            if e.mic: SymIcon { text: "\u{e326}"; fill: true; font-size: 12px; color: Theme.m3-on-tertiary-container; }
            if e.location: SymIcon { text: "\u{eade}"; fill: true; font-size: 12px; color: Theme.m3-on-tertiary-container; }
            if e.share: SymIcon { text: "\u{e404}"; fill: true; font-size: 12px; color: Theme.m3-on-tertiary-container; }
        }
    }
    // A count bubble (the shelf's items)
    if e.badge > 0: Rectangle {
        x: parent.width - self.width - 1px;
        y: 0;
        width: max(14px, badge.preferred-width + 6px);
        height: 14px;
        border-radius: 7px;
        background: Theme.danger;
        badge := Text {
            text: e.badge > 99 ? "99+" : e.badge;
            color: Theme.material ? Theme.m3-on-error : #ffffff;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A left-side item: the system menu's icon, the app's name, "Window"
component LeftItem inherits Rectangle {
    in property <string> icon;
    in property <image> image;
    in property <bool> has-image;
    in property <string> text;
    in property <bool> bold;
    in property <bool> active;
    in property <color> ink;
    in property <string> label;
    callback clicked(length);
    height: 24px;
    width: row.preferred-width + 18px;
    border-radius: Theme.material ? self.height / 2 : Theme.radius-item;
    background: ink.with-alpha(Theme.material ? (active ? 0.16 : t.pressed ? 0.1 : t.has-hover ? 0.08 : 0) : (active ? 0.22 : t.pressed ? 0.2 : t.has-hover ? 0.12 : 0));
    animate background { duration: Theme.hover; }
    accessible-role: button;
    accessible-label: label != "" ? label : text;
    accessible-expandable: true;
    accessible-expanded: active;
    accessible-action-default => { root.clicked(self.absolute-position.x); }
    t := TouchArea {
        clicked => { root.clicked(root.absolute-position.x); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right && self.has-hover { root.clicked(root.absolute-position.x); }
        }
    }
    row := HorizontalLayout {
        alignment: center;
        if has-image: VerticalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: root.image;
                colorize: ink;
                image-fit: contain;
            }
        }
        if icon != "" && !has-image: SymIcon {
            text: icon;
            fill: true;
            font-size: 16px;
            color: ink;
        }
        if text != "": Text {
            text: root.text;
            color: ink;
            font-size: Theme.material ? 14px : Theme.body;
            font-weight: bold ? (Theme.material ? 600 : 700) : 500;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// One rounded screen corner (Corner.qml: black, concave)
component Corner inherits Path {
    in property <bool> at-right;
    in property <length> r: 12px;
    width: r;
    height: r;
    viewbox-width: 12;
    viewbox-height: 12;
    fill: #000000;
    commands: at-right ? "M 12 0 L 0 0 A 12 12 0 0 1 12 12 Z" : "M 0 0 L 12 0 A 12 12 0 0 0 0 12 Z";
}

// ── The bar (one per output) ────────────────────────────────────────────────
export component Bar inherits Window {
    // the look over the wallpaper
    in property <color> ink: Theme.fg; // the items' colour
    in property <bool> ink-dark; // (dark text: the battery's number reads light)
    in property <color> wall-ink: Theme.fg; // the spaces' and the island's, idle
    in property <bool> pills; // Material without a background: the groups in tonal pills
    in property <bool> opaque; // a background behind the bar
    in property <color> bg: Theme.bar-tint;
    in property <bool> corners;
    in property <length> corner-r: 12px;
    in property <bool> revealed: true; // auto-hide: shown now
    in property <bool> chrome: true; // false over a fullscreen app
    // left
    in property <string> logo: "\u{e604}";
    in property <image> logo-image; // the distro's logo (menuIcon "distro")
    in property <bool> has-logo-image;
    in property <bool> island-art;
    in property <bool> app-menu: true;
    in property <string> app-name: "Desktop";
    in property <bool> window-menu: true;
    in property <string> window-title;
    in property <string> open-menu; // system | app | window | "" (its highlight)
    // centre: the spaces alone, or the island (which shows them)
    in property <bool> spaces-shown;
    in property <bool> island-on;
    in property <[Chip]> chips;
    in property <length> strip-w;
    in property <bool> arrows;
    in property <length> left-x;
    in property <length> right-x;
    in property <bool> left-more;
    in property <bool> left-hot;
    in property <bool> right-more;
    in property <bool> right-hot;
    // the island's
    in property <int> island-mode;
    in property <bool> event-inside;
    in property <bool> has-card;
    in property <bool> hot;
    in property <bool> pinned;
    in property <string> layout: "replace";
    in property <Live> live;
    in property <int> live-count;
    in property <Live> card;
    in property <bool> card-on;
    in property <bool> all-mode;
    in property <[ActRow]> act-rows;
    in property <[RecentRow]> recent;
    in property <int> recent-n;
    out property <bool> island-keys: island.wants-keys;
    in property <int> live-index;
    in property <[AlertRow]> alerts;
    in property <string> pill-text;
    in property <string> pill-icon;
    in property <color> pill-tint;
    in property <IslandStats> stats;
    in property <string> battery-tip; // the island's battery figure: its tip
    in property <bool> playing;
    // right
    in property <[Entry]> entries;
    // for Rust: where the island is (glass, input region) and the tip
    out property <length> isl-x: island.x + island.shape-x;
    out property <length> isl-y: island.y + island.shape-y;
    out property <length> isl-w: island.shape-w;
    out property <length> isl-h: island.shape-h;
    out property <length> isl-r: island.shape-r;
    out property <float> isl-fade: island.fade;
    out property <length> tip-x: tip.x;
    out property <length> tip-y: tip.y;
    out property <length> tip-w: tip.width;
    out property <length> tip-h: tip.height;
    out property <float> tip-o: tip.opacity;
    out property <bool> hovered: reveal.has-hover || (island-on && island.island-hovered);
    callback menu(string, length); // system | app | window, at x
    callback clicked(string, PointerEventButton, length); // an entry: its id
    callback go(int);
    callback space-menu(int, length);
    callback arrow(int);
    callback space-wheel(int);
    callback scrolled(bool, length); // left half?, wheel delta (logical px, up > 0)
    callback island-hover(bool);
    callback island-pill();
    callback island-cycle(length, length);
    callback island-control(string, int, bool);
    callback island-act(int, string);
    callback island-dismiss(int);
    callback island-level(float);
    callback island-pin();
    callback island-hold(bool);
    callback empty-click();
    // files dragged over the bar: where, and whether the shelf item is under them
    in property <bool> drag-over;
    in property <length> drag-x;
    callback shelf-hot(bool);
    in property <bool> reduce-motion;
    in property <[LevelRow]> levels;
    in property <bool> levels-open;
    in property <bool> alerts-below;
    callback level-pick(string);
    callback level-set(string, float);
    out property <length> below-x: island.x + island.below-x;
    out property <length> below-y: island.y + island.below-y;
    out property <length> below-w: island.below-w;
    out property <length> below-h: island.below-h;
    out property <float> below-o: island.below-o;
    callback recent-run(int);
    callback recent-forget(int);
    callback recent-clear();
    callback music-seek(float);
    callback music-volume(float);
    callback music-mute();
    callback open-player();
    callback island-escape();
    // ResourceHover: the popover under a figure (its key) opens or closes, at x (centre), y (top)
    callback res-popover(string, bool, length, length);

    background: transparent;
    no-frame: true;
    title: "Menu bar";
    default-font-family: Theme.font;

    // the dancing bars' clock (12 frames a second, only while music plays)
    property <int> tick;
    Timer {
        interval: 83ms;
        running: (playing && island-on && island-mode == 1 && live.kind == "music" && live.show-bars) || (island-on && island-mode == 1 && live.kind == "recording");
        triggered => { tick += 1; }
    }

    // the hover tip (HoverTip): after half a second on an item, under it
    // (as if each item had its own HoverTip: the one pointed at is `tip-want`,
    // the one shown `tip-key`; a new item restarts the 500 ms, the old one
    // closes 120 ms after the pointer left it)
    property <bool> tip-want: tip-want-key != "";
    property <bool> tip-open: tip-key != "";
    property <string> tip-want-key;
    property <string> tip-key;
    property <string> tip-want-text;
    property <length> tip-want-at;
    property <length> tip-want-top: 35px;
    property <string> tip-text;
    property <length> tip-at;
    property <length> tip-top: 35px; // (under a bar item; the island's battery: under it)
    // ResourceHover: half a second's rest on a figure opens its popover,
    // 120 ms after leaving it closes
    property <string> res-want;
    property <string> res-open;
    property <length> res-x;
    property <length> res-y;
    res-open-timer := Timer {
        interval: 500ms;
        running: res-want != "" && res-want != res-open;
        triggered => {
            if res-open != "" { root.res-popover(res-open, false, 0, 0); }
            res-open = res-want;
            root.res-popover(res-open, true, res-x, res-y);
        }
    }
    Timer {
        interval: 120ms;
        running: res-open != "" && res-want != res-open;
        triggered => {
            root.res-popover(res-open, false, 0, 0);
            res-open = "";
        }
    }
    function res-hover(key: string, on: bool, x: length, y: length) {
        if on {
            res-x = x;
            res-y = y;
            if res-want != key { res-want = key; res-open-timer.restart(); }
        } else if res-want == key {
            res-want = "";
        }
    }
    tip-open-timer := Timer {
        interval: 500ms;
        running: tip-want-key != "" && tip-want-key != tip-key;
        triggered => {
            tip-key = tip-want-key;
            tip-text = tip-want-text;
            tip-at = tip-want-at;
            tip-top = tip-want-top;
        }
    }
    Timer {
        interval: 120ms;
        running: tip-key != "" && tip-want-key != tip-key;
        triggered => { tip-key = ""; }
    }
    function tip-hover(key: string, on: bool, text: string, x: length, top: length) {
        if on && text != "" {
            tip-want-text = text;
            tip-want-at = x;
            tip-want-top = top;
            if tip-want-key != key { tip-want-key = key; tip-open-timer.restart(); }
        } else if tip-want-key == key {
            tip-want-key = "";
        }
    }

    reveal := TouchArea {
        height: 30px;
        y: 0;
        // a click on the bar's empty strip closes an open menu (Popover's catcher: no item there)
        clicked => { root.empty-click(); }
        scroll-event(e) => {
            if e.delta-y == 0 { return reject; }
            root.scrolled(self.mouse-x < self.width / 2, e.delta-y);
            accept
        }

        content := Rectangle {
            y: revealed ? 0 : -30px;
            opacity: revealed ? 1 : 0;
            animate y { duration: Theme.popover; easing: cubic-bezier(0.2, 0, 0, 1); }
            animate opacity { duration: Theme.popover; }

            if opaque && chrome: Rectangle {
                background: root.bg;
            }
            if corners && chrome: Corner {
                x: 0;
                y: 0;
                r: root.corner-r;
            }
            if corners && chrome: Corner {
                x: parent.width - self.width;
                y: 0;
                r: root.corner-r;
                at-right: true;
            }

            // The groups' pills (Material, no background)
            if pills && chrome && left.width > 0: Rectangle {
                x: left.x - 2px;
                width: left.width + 4px;
                y: 2px;
                height: 26px;
                border-radius: 13px;
                background: Theme.pill;
            }
            if pills && chrome && right.width > 0: Rectangle {
                x: right.x - 2px;
                width: right.width + 4px;
                y: 2px;
                height: 26px;
                border-radius: 13px;
                background: Theme.pill;
            }
            if pills && spaces-shown: Rectangle {
                x: spaces.x - 10px;
                width: spaces.width + 20px;
                y: 2px;
                height: 26px;
                border-radius: 13px;
                background: Theme.pill;
            }

            // ── Left
            left := HorizontalLayout {
                visible: chrome;
                x: pills ? 6px : 8px;
                width: self.preferred-width;
                y: 3px;
                height: 24px;
                spacing: 0;
                LeftItem {
                    icon: root.logo;
                    image: root.logo-image;
                    has-image: root.has-logo-image;
                    ink: root.ink;
                    label: "System menu";
                    active: open-menu == "system";
                    clicked(x) => { root.menu("system", x); }
                }
                if app-menu: LeftItem {
                    text: app-name;
                    bold: true;
                    ink: root.ink;
                    label: "Active app: " + app-name;
                    active: open-menu == "app";
                    clicked(x) => { root.menu("app", x); }
                }
                if window-menu: LeftItem {
                    text: "Window";
                    ink: root.ink;
                    active: open-menu == "window";
                    clicked(x) => { root.menu("window", x); }
                }
                if window-title != "": Text {
                    max-width: max(0px, root.width / 2 - 8px - 360px);
                    text: window-title;
                    color: root.ink.with-alpha(0.65);
                    font-size: Theme.body;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            // ── Centre: the spaces alone (the island shows them when it's on)
            spaces := Spaces {
                visible: spaces-shown;
                x: (parent.width - self.width) / 2;
                y: 4px;
                ink: pills ? Theme.m3-on-surface : root.wall-ink;
                chips: root.chips;
                strip-w: root.strip-w;
                arrows: root.arrows;
                left-x: root.left-x;
                right-x: root.right-x;
                left-more: root.left-more;
                left-hot: root.left-hot;
                right-more: root.right-more;
                right-hot: root.right-hot;
                go(id) => { root.go(id); }
                menu(id, x) => { root.space-menu(id, x); }
                arrow(d) => { root.arrow(d); }
                wheel(d) => { root.space-wheel(d); }
            }

            // ── Right
            right := HorizontalLayout {
                visible: chrome;
                width: self.preferred-width;
                x: parent.width - self.width - (pills ? 6px : 8px);
                y: 3px;
                height: 24px;
                spacing: 0;
                for e in entries: Item {
                    e: e;
                    ink: root.ink;
                    ink-dark: root.ink-dark;
                    drag-over: root.drag-over;
                    drag-x: root.drag-x;
                    drop-hot(on) => { root.shelf-hot(on); }
                    clicked(b, x) => { tip-want-key = ""; tip-key = ""; root.res-hover("cpu", false, 0, 0); root.clicked(e.id, b, x); }
                    hovered(on, x, text) => {
                        // the resources item: the last minute's popover (not while its menu is open)
                        if e.id == "resources" {
                            root.res-hover("cpu", on && !e.active, x, 30px + 8px);
                        } else {
                            root.tip-hover(e.id, on && !e.active, text, x, 35px);
                        }
                    }
                }
            }
        }
    }

    // ── The island (taller than the bar: it opens below it)
    island := Island {
        visible: island-on;
        x: 0;
        y: content.y;
        width: root.width;
        height: root.height;
        opacity: content.opacity;
        mode: root.island-mode;
        event-inside: root.event-inside;
        has-card: root.has-card;
        pilled: root.pills;
        hot: root.hot;
        pinned: root.pinned;
        layout: root.layout;
        fg: pills ? Theme.m3-on-surface : root.wall-ink;
        chips: root.chips;
        strip-w: root.strip-w;
        arrows: root.arrows;
        left-x: root.left-x;
        right-x: root.right-x;
        left-more: root.left-more;
        left-hot: root.left-hot;
        right-more: root.right-more;
        right-hot: root.right-hot;
        live: root.live;
        live-count: root.live-count;
        card: root.card;
        card-on: root.card-on;
        all-mode: root.all-mode;
        island-art: root.island-art;
        reduce-motion: root.reduce-motion;
        levels: root.levels;
        levels-open: root.levels-open;
        alerts-below: root.alerts-below;
        level-pick(id) => { root.level-pick(id); }
        level-set(id, v) => { root.level-set(id, v); }
        act-rows: root.act-rows;
        recent: root.recent;
        recent-n: root.recent-n;
        recent-run(h) => { root.recent-run(h); }
        recent-forget(h) => { root.recent-forget(h); }
        recent-clear => { root.recent-clear(); }
        seek(f) => { root.music-seek(f); }
        set-volume(v) => { root.music-volume(v); }
        mute => { root.music-mute(); }
        open-player => { root.open-player(); }
        escape => { root.island-escape(); }
        live-index: root.live-index;
        alerts: root.alerts;
        pill-text: root.pill-text;
        pill-icon: root.pill-icon;
        pill-tint: root.pill-tint;
        stats: root.stats;
        act-n: root.live-count;
        tick: root.tick;
        go(id) => { root.go(id); }
        space-menu(id, x) => { root.space-menu(id, x); }
        arrow(d) => { root.arrow(d); }
        space-wheel(d) => { root.space-wheel(d); }
        hover(on) => { root.island-hover(on); }
        open-pill => { root.island-pill(); }
        cycle(dx, dy) => { root.island-cycle(dx, dy); }
        control(k, i, all) => { root.island-control(k, i, all); }
        act(u, w) => { root.island-act(u, w); }
        dismiss(u) => { root.island-dismiss(u); }
        set-level(v) => { root.island-level(v); }
        pin => { root.island-pin(); }
        holding(on) => { root.island-hold(on); }
        stat-hover(k, on, x, y) => {
            if k == "*" {
                // (it closed under the pointer)
                root.tip-hover("island:battery", false, "", 0, 0);
                res-want = "";
            } else if k == "battery" {
                root.tip-hover("island:battery", on, battery-tip, x, y + 14px);
            } else {
                root.res-hover(k, on, x, y + 14px);
            }
        }
    }

    // The tip: no input (outside the input region), on glass (Glass) or
    // Material's plain tooltip
    tip := Rectangle {
        property <length> pad-x: Theme.material ? 8px : 12px;
        property <length> pad-y: Theme.material ? 4px : 7px;
        width: tip-label.preferred-width + 2 * pad-x;
        height: tip-label.preferred-height + 2 * pad-y;
        x: max(0px, min(root.width - self.width, tip-at - self.width / 2));
        y: tip-top + (tip-open ? 0 : -4px);
        opacity: tip-open && revealed ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity, y { duration: tip-open ? Theme.popover : 0ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        border-radius: Theme.material ? 4px : Theme.radius-control;
        background: Theme.material ? Theme.m3-inverse-surface : Theme.panel;
        tip-label := Text {
            text: tip-text;
            color: Theme.material ? Theme.m3-inverse-on-surface : Theme.label;
            font-size: Theme.small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ── A menu (its own layer surface): the system menu, the app's, Window, a
// tray item's, a space's ──────────────────────────────────────────────────────
export struct MenuTile {
    x: float,
    y: float,
    w: float,
    h: float,
    label: string,
}

export struct MenuRow {
    text: string,
    shortcut: string,
    separator: bool,
    header: bool,
    checkable: bool,
    checked: bool,
    enabled: bool,
    tiles: [MenuTile],
    // Material: the row starts or ends a group (between separators)
    first: bool,
    last: bool,
}

// A tiny screen with one region filled (TileGlyph)
component TileGlyph inherits Rectangle {
    in property <MenuTile> t;
    in property <bool> hot;
    width: 36px;
    height: 24px;
    border-radius: 5px;
    border-width: 1.5px;
    border-color: hot ? Theme.on-highlight : Theme.secondary;
    Rectangle {
        x: 3px + (parent.width - 6px) * t.x;
        y: 3px + (parent.height - 6px) * t.y;
        width: max(2px, (parent.width - 6px) * t.w - 1px);
        height: max(2px, (parent.height - 6px) * t.h - 1px);
        border-radius: 2px;
        background: hot ? Theme.on-highlight : Theme.label;
    }
}

export component Menu inherits Window {
    in property <[MenuRow]> rows;
    in property <length> menu-w: 220px;
    in property <length> panel-left: 16px; // (under its item, screen x: less near the screen's edge)
    in property <bool> any-checks;
    in property <bool> shown; // drives the open/close animation
    in property <bool> context; // a space's context menu (ContextMenu: centred, 0.94 → 1)
    // (a context menu draws the same rows in either look: ContextMenu.qml has no Material twin)
    property <bool> m3: Theme.material && !context;
    in-out property <int> current: -1;
    out property <float> openness: shown ? 1 : 0; // (Rust follows it for the glass shape)
    out property <length> panel-x: panel.x;
    out property <length> panel-y: panel.y;
    out property <length> panel-width: panel.width;
    out property <length> panel-height: panel.height;
    out property <float> panel-scale: panel.transform-scale;
    property <length> pad: m3 ? 4px : 5px;
    callback activated(int);
    callback tile(int, int);
    callback step(int); // arrow keys: Rust picks the next row (menus.rs: step)
    callback dismissed();
    callback closed(); // the close animation ended
    callback hovered(bool); // the pointer over the panel (autoClose waits)
    callback bar-click(length, length); // a click on the bar's strip: it goes on to the bar

    background: transparent;
    no-frame: true;
    title: "Menu";
    default-font-family: Theme.font;

    animate openness {
        duration: shown ? 420ms : 140ms;
        easing: shown ? spring(0.3) : ease-in;
    }
    changed openness => {
        if !shown && openness <= 0.001 { closed(); }
    }

    public function open() {
        current = -1;
        keys.focus();
    }

    // The whole screen while open (Popover.qml's catcher): a click outside
    // the panel closes it
    TouchArea {
        enabled: shown;
        clicked => {
            if self.mouse-y < 30px { root.bar-click(self.mouse-x, self.mouse-y); } else { dismissed(); }
        }
    }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.UpArrow { step(-1); return accept; }
            if e.text == Key.DownArrow || e.text == Key.Tab { step(1); return accept; }
            if e.text == Key.Escape { dismissed(); return accept; }
            if e.text == Key.Return || e.text == " " { if current >= 0 { activated(current); } return accept; }
            reject
        }

        panel := Rectangle {
            x: panel-left;
            y: 34px + (1 - openness) * -8px;
            width: menu-w + 2 * pad;
            height: content.preferred-height + 2 * pad;
            transform-origin: { x: context ? self.width / 2 : 18px, y: 0px };
            transform-scale: context ? 0.94 + 0.06 * openness : 0.92 + 0.08 * openness;
            opacity: min(1, openness * 1.6);
            border-radius: m3 ? 16px : Theme.menu-radius + 2px;
            background: Theme.menu-bg;
            border-width: m3 ? 0 : 0.5px;
            border-color: Theme.separator;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
            accessible-role: list;
            accessible-label: "Menu";

            // (over the rows too: autoClose waits while it's pointed at)
            hover := TouchArea {
                changed has-hover => { root.hovered(self.has-hover); }
            content := VerticalLayout {
                x: pad;
                y: pad;
                width: menu-w;
                spacing: 0;
                for r[i] in rows: Rectangle {
                    property <bool> hot: current == i && r.enabled && !r.separator && !r.header && r.tiles.length == 0;
                    height: r.separator ? (m3 ? 2px : 11px) : (r.header ? (m3 ? 32px : context ? 26px : 22px) : r.tiles.length > 0 ? 36px : (m3 ? 40px : context ? 28px : 26px)) + (m3 && r.first ? 4px : 0) + (m3 && r.last ? 4px : 0);
                    // Material: the group's surface (corners 12 outside, 4 where groups meet)
                    background: m3 && !r.separator ? Theme.m3-surface-container-low : transparent;
                    border-top-left-radius: m3 ? (r.first ? (i == 0 ? 12px : 4px) : 0) : 0;
                    border-top-right-radius: self.border-top-left-radius;
                    border-bottom-left-radius: m3 ? (r.last ? (i == rows.length - 1 ? 12px : 4px) : 0) : 0;
                    border-bottom-right-radius: self.border-bottom-left-radius;
                    accessible-role: list-item;
                    accessible-label: r.text;
                    accessible-item-selectable: r.enabled && !r.header;
                    accessible-item-selected: current == i;
                    accessible-checkable: r.checkable;
                    accessible-checked: r.checked;
                    accessible-action-default => { activated(i); }

                    if r.separator && !m3: Rectangle {
                        width: parent.width - 18px;
                        height: 1px;
                        background: Theme.separator;
                    }
                    if r.header: Text {
                        x: m3 ? 12px : 10px;
                        y: parent.height - self.height - (m3 ? 6px : 3px);
                        text: r.text;
                        color: m3 ? Theme.m3-on-surface-variant : Theme.tertiary;
                        font-size: m3 ? 12px : Theme.caption;
                        font-weight: m3 ? 500 : 600;
                    }
                    if r.tiles.length > 0: HorizontalLayout {
                        x: m3 ? 4px : 6px;
                        y: (parent.height - 32px) / 2;
                        height: 32px;
                        width: self.preferred-width;
                        spacing: 4px;
                        for t[j] in r.tiles: Rectangle {
                            width: 44px;
                            border-radius: m3 ? 8px : Theme.radius-item + 2px;
                            background: tt.has-hover ? Theme.highlight : transparent;
                            accessible-role: button;
                            accessible-label: t.label;
                            accessible-action-default => { root.tile(i, j); }
                            TileGlyph {
                                t: t;
                                hot: tt.has-hover;
                            }
                            tt := TouchArea {
                                clicked => { root.tile(i, j); }
                            }
                        }
                    }
                    if !r.separator && !r.header && r.tiles.length == 0: Rectangle {
                        x: m3 ? 4px : 0;
                        y: m3 && r.first ? 4px : 0;
                        width: parent.width - 2 * self.x;
                        height: m3 ? 40px : context ? 28px : 26px;
                        border-radius: m3 ? (r.checked ? self.height / 2 : 8px) : Theme.radius-item + 2px;
                        background: m3
                            ? (r.checked ? (hot ? Theme.m3-tertiary-container.mix(Theme.m3-on-tertiary-container, 0.92) : Theme.m3-tertiary-container) : hot ? Theme.m3-on-surface.with-alpha(0.08) : transparent)
                            : (hot ? Theme.highlight : transparent);
                        animate background { duration: 100ms; }
                        if r.checked: SymIcon {
                            x: m3 ? 12px : 6px;
                            width: 16px;
                            text: "\u{e182}"; // check
                            bold: true;
                            font-size: m3 ? 16px : 12px;
                            color: m3 ? Theme.m3-on-tertiary-container : hot ? Theme.on-highlight : Theme.label;
                        }
                        Text {
                            x: m3 ? (any-checks ? 40px : 12px) : 22px;
                            width: parent.width - self.x - (r.shortcut != "" ? sc.preferred-width + 24px : 12px);
                            height: parent.height;
                            text: r.text;
                            color: m3
                                ? (!r.enabled ? Theme.m3-on-surface.with-alpha(0.38) : r.checked ? Theme.m3-on-tertiary-container : Theme.m3-on-surface)
                                : (hot ? Theme.on-highlight : r.enabled ? Theme.label : Theme.tertiary);
                            font-size: m3 ? 14px : Theme.body;
                            font-weight: m3 ? 500 : 400;
                            overflow: elide;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        sc := Text {
                            x: parent.width - self.width - (m3 ? 12px : 10px);
                            width: self.preferred-width;
                            height: parent.height;
                            text: r.shortcut;
                            color: m3 ? (!r.enabled ? Theme.m3-on-surface.with-alpha(0.38) : Theme.m3-on-surface-variant) : hot ? Theme.on-highlight.with-alpha(0.8) : Theme.tertiary;
                            font-size: m3 ? 13px : Theme.body;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        TouchArea {
                            enabled: r.enabled;
                            moved => { if self.has-hover { current = i; } }
                            changed has-hover => {
                                if self.has-hover { current = i; } else if current == i { current = -1; }
                            }
                            clicked => { activated(i); }
                        }
                    }
                }
            }
            }
        }
    }
}
