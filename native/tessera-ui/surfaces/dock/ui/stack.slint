// The Downloads stack (rust.surfaces: dock; compare
// shell/modules/dock/DownloadsStack.qml and MaterialDownloadsStack.qml, the
// files in DownloadsFiles.qml): the newest files in ~/Downloads as a grid of
// four above the dock, a click on a file opens it, a right-click shares it,
// the eye is Quick Look, "Open in Files" opens the folder; Escape or a click
// outside closes it. Glass: on the plugin's glass; Material: a tonal
// popover with a title and a state layer on each file. Rust lists the files
// and decides what each click does; this draws them and springs the card up
// out of the dock.

import { Theme, Icon } from "@tessera/theme.slint";

export struct StackFile { name: string, icon: image, has-icon: bool }

// Glass
export component StackGlass inherits Window {
    in property <[StackFile]> files;
    in property <length> stack-x; // the screen x the stack points at
    in property <length> bar-height;
    in property <length> bottom-gap;
    in property <bool> shown;
    in property <bool> on-glass;
    callback open(int, bool); // a file, right button?
    callback quick-look(int);
    callback folder();
    callback dismissed();
    // the card, for the glass (window px)
    out property <float> card-x: (body.x + m) / 1px;
    out property <float> card-y: (body.y + m) / 1px;
    out property <float> card-w: (body.width - 2 * m) / 1px;
    out property <float> card-h: (body.height - 2 * m) / 1px;
    out property <float> fade: min(1, progress);
    out property <float> scale: 0.92 + 0.08 * progress;
    public function focus-keys() {
        keys.focus();
    }
    property <length> m: 24px;
    property <length> cell: 96px;
    property <int> n: files.length;
    property <int> rows: ceil(max(1, n) / 4);
    property <float> progress: shown ? 1 : 0;
    animate progress { duration: 520ms; easing: spring(0.35); }
    background: transparent;
    no-frame: true;
    title: "Downloads";
    default-font-family: Theme.font;

    // A click outside closes
    TouchArea {
        clicked => { root.dismissed(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button != PointerEventButton.left {
                root.dismissed();
            }
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            reject
        }
        body := Rectangle {
            width: 4 * cell + 24px + 2 * m;
            height: rows * (cell + 8px) + 24px + 44px + 2 * m;
            x: max(0px, min(root.width - self.width, stack-x - self.width / 2));
            y: root.height - bar-height - bottom-gap - 8px - self.height + m;
            opacity: fade;
            transform-scale: scale;
            transform-origin: { x: self.width / 2, y: self.height };

            Rectangle {
                x: m;
                y: m;
                width: parent.width - 2 * m;
                height: parent.height - 2 * m;
                border-radius: Theme.radius-popover;
                background: on-glass ? transparent : Theme.panel;
                border-width: on-glass ? 0px : 0.5px;
                border-color: Theme.separator;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: Theme.dark ? #0000003d : #0000001a;
                // (clicks on the card don't close it)
                TouchArea { }
            }
            for f[i] in files: Rectangle {
                x: m + 12px + mod(i, 4) * cell;
                y: m + 12px + floor(i / 4) * (cell + 8px);
                width: cell;
                height: cell;
                border-radius: Theme.radius-control;
                background: ft.has-hover || eye.has-hover ? Theme.fill : transparent;
                accessible-role: button;
                accessible-label: f.name;
                accessible-action-default => { root.open(i, false); }
                if f.has-icon: Image {
                    x: (parent.width - 48px) / 2;
                    y: 8px;
                    width: 48px;
                    height: 48px;
                    source: f.icon;
                }
                Text {
                    x: 4px;
                    y: parent.height - 8px - self.height;
                    width: parent.width - 8px;
                    text: f.name;
                    color: Theme.label;
                    font-size: Theme.small;
                    horizontal-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
                ft := TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up && (e.button == PointerEventButton.left || e.button == PointerEventButton.right) {
                            root.open(i, e.button == PointerEventButton.right);
                        }
                    }
                }
                // Quick Look without opening the app (shown while the pointer is
                // anywhere on the cell, the button included)
                Rectangle {
                    opacity: ft.has-hover || eye.has-hover ? 1 : 0;
                    x: parent.width - 2px - 24px;
                    y: 2px;
                    width: 24px;
                    height: 24px;
                    border-radius: Theme.radius-control - 2px;
                    background: eye.pressed ? Theme.fill-pressed : eye.has-hover ? Theme.fill-hover : transparent;
                    accessible-role: button;
                    accessible-label: "Quick Preview";
                    accessible-action-default => { root.quick-look(i); }
                    Icon {
                        width: parent.width;
                        height: parent.height;
                        text: "\u{e220}";
                        color: Theme.secondary;
                        font-size: 14px;
                    }
                    eye := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.quick-look(i); }
                    }
                }
            }
            if n == 0: Text {
                x: m;
                y: body.height / 2 - self.height / 2 - 20px;
                width: parent.width - 2 * m;
                text: "Nothing downloaded yet";
                color: Theme.secondary;
                font-size: Theme.body;
                horizontal-alignment: center;
            }
            // Open the folder
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - m - 12px - self.height;
                width: openl.preferred-width + 28px;
                height: 28px;
                border-radius: 14px;
                background: ot.pressed ? Theme.fill-pressed : ot.has-hover ? Theme.fill-hover : Theme.fill;
                accessible-role: button;
                accessible-label: "Open in Files";
                accessible-action-default => { root.folder(); }
                openl := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "Open in Files";
                    color: Theme.label;
                    font-size: Theme.small;
                    font-weight: 500;
                    accessible-role: none;
                }
                ot := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.folder(); }
                }
            }
        }
    }
}

// Material
export component StackMaterial inherits Window {
    in property <[StackFile]> files;
    in property <length> stack-x;
    in property <length> bar-height;
    in property <length> bottom-gap;
    in property <bool> shown;
    in property <string> cookie; // the empty state's shape (0..100 box)
    callback open(int, bool);
    callback quick-look(int);
    callback folder();
    callback dismissed();
    public function focus-keys() {
        keys.focus();
    }
    property <length> cell: 96px;
    property <length> pad: 16px;
    property <int> n: files.length;
    property <int> rows: ceil(max(1, n) / 4);
    property <float> progress: shown ? 1 : 0;
    animate progress { duration: 520ms; easing: spring(0.4); }
    background: transparent;
    no-frame: true;
    title: "Downloads";
    default-font-family: Theme.font;

    TouchArea {
        clicked => { root.dismissed(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button != PointerEventButton.left {
                root.dismissed();
            }
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            reject
        }
        body := Rectangle {
            width: 4 * cell + 2 * pad;
            height: 56px + (n > 0 ? rows * (cell + 4px) : 160px) + pad;
            x: max(8px, min(root.width - self.width - 8px, stack-x - self.width / 2));
            y: root.height - bar-height - bottom-gap - 8px - self.height;
            opacity: max(0, min(1, progress * 1.5));
            transform-scale: 0.9 + 0.1 * progress;
            transform-origin: { x: self.width / 2, y: self.height };
            border-radius: Theme.radius-popover;
            background: Theme.m3-surface-container;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.m3-shadow.with-alpha(Theme.dark ? 0.4 : 0.16);
            // (clicks on the card don't close it)
            TouchArea { }

            Text {
                x: pad + 8px;
                y: 16px;
                height: 24px;
                text: "Downloads";
                color: Theme.m3-on-surface;
                font-size: 16px;
                font-weight: 500;
                vertical-alignment: center;
            }
            // Open the folder: a text button
            Rectangle {
                x: parent.width - pad - self.width;
                y: 12px;
                width: openl.preferred-width + 24px;
                height: 32px;
                border-radius: self.height / 2;
                background: Theme.m3-primary.with-alpha(ot.pressed ? 0.1 : ot.has-hover ? 0.08 : 0);
                animate background { duration: 150ms; }
                accessible-role: button;
                accessible-label: "Open in Files";
                accessible-action-default => { root.folder(); }
                openl := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "Open in Files";
                    color: Theme.m3-primary;
                    font-size: 14px;
                    font-weight: 500;
                    accessible-role: none;
                }
                ot := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.folder(); }
                }
            }
            for f[i] in files: Rectangle {
                x: pad + mod(i, 4) * cell;
                y: 56px + floor(i / 4) * (cell + 4px);
                width: cell;
                height: cell;
                accessible-role: button;
                accessible-label: f.name;
                accessible-action-default => { root.open(i, false); }
                // State layer
                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    border-radius: 16px;
                    background: Theme.m3-on-surface.with-alpha(ft.pressed ? 0.1 : ft.has-hover || eye.has-hover ? 0.08 : 0);
                    animate background { duration: 150ms; }
                }
                if f.has-icon: Image {
                    x: (parent.width - 48px) / 2;
                    y: 10px;
                    width: 48px;
                    height: 48px;
                    source: f.icon;
                }
                Text {
                    x: 6px;
                    y: parent.height - 10px - self.height;
                    width: parent.width - 12px;
                    text: f.name;
                    color: Theme.m3-on-surface;
                    font-size: 12px;
                    horizontal-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
                ft := TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up && (e.button == PointerEventButton.left || e.button == PointerEventButton.right) {
                            root.open(i, e.button == PointerEventButton.right);
                        }
                    }
                }
                // Quick Look without opening the app: a small tonal icon button
                Rectangle {
                    opacity: ft.has-hover || eye.has-hover ? 1 : 0;
                    x: parent.width - 6px - 28px;
                    y: 6px;
                    width: 28px;
                    height: 28px;
                    border-radius: eye.pressed ? 8px : 14px;
                    animate border-radius { duration: 150ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    background: Theme.m3-secondary-container.mix(Theme.m3-on-secondary-container, eye.pressed ? 0.9 : eye.has-hover ? 0.92 : 1);
                    accessible-role: button;
                    accessible-label: "Quick Preview";
                    accessible-action-default => { root.quick-look(i); }
                    Icon {
                        width: parent.width;
                        height: parent.height;
                        text: "\u{e220}";
                        color: Theme.m3-on-secondary-container;
                        font-size: 14px;
                    }
                    eye := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.quick-look(i); }
                    }
                }
            }
            // Nothing yet: the download symbol on a shape, and one line
            if n == 0: VerticalLayout {
                x: 0px;
                y: 56px + 16px;
                width: parent.width;
                height: 120px;
                alignment: start;
                spacing: 12px;
                Rectangle {
                    height: 72px;
                    Rectangle {
                        x: (parent.width - 72px) / 2;
                        width: 72px;
                        height: 72px;
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            commands: cookie;
                            fill: Theme.m3-secondary-container;
                        }
                        Icon {
                            width: parent.width;
                            height: parent.height;
                            text: "\u{e20c}";
                            color: Theme.m3-on-secondary-container;
                            font-size: 28px;
                        }
                    }
                }
                Text {
                    text: "Nothing downloaded yet";
                    color: Theme.m3-on-surface-variant;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
