// The dock in Rust (rust.surfaces: dock), compare shell/modules/dock/:
// DockGlass.qml + DockItem.qml (Glass: macOS's slab, hover lift, optional
// magnification, a name label on frosted glass) and MaterialDock.qml +
// MaterialDockItem.qml (Material: a Pixel tablet's taskbar, a tonal pill,
// state layer circles, a dash under running apps, plain tooltips), and
// glass/ContextMenu.qml for the right-click menu.
//
// Rust (src/surfaces/dock/) decides everything that depends on the pointer
// (which icon is hot, magnified sizes, auto-hide) from fixed rectangles, as
// DockLogic.qml does; this draws it and animates it.

import { Theme, Icon } from "@tessera/theme.slint";

export struct DockSlot {
    kind: string, // launcher | app | recent | minimized | downloads | trash
    name: string,
    icon: image,
    has-icon: bool,
    themed: bool, // Glass's Apps button: the icon theme has an app grid (else the dot grid)
    running: bool,
    focused: bool, // the app in front
    divider: bool,
    x: length, // the icon's left edge in the pill
    size: length, // its size now (Glass: magnified)
    lead: length, // the divider's room before it
    hot: bool,
    pressed: bool,
    bounce: int, // bumped to make it hop (launching)
}

// Glass's Apps button without a themed icon: a 3×3 grid of colour dots on a tile
component DotGrid inherits Rectangle {
    in property <length> size;
    property <[color]> dots: Theme.dark ? [#93A3FC, #F5886C, #6EC272, #E087CE, #E7963D, #25C2C2, #BF93F1, #F3829F, #93A3FC] : [#6D7CDF, #D05F43, #409D48, #BB5FAA, #BE7100, #1D9999, #9B6BCE, #CE597A, #6D7CDF];
    x: size * 0.04;
    y: size * 0.04;
    width: size * 0.92;
    height: size * 0.92;
    border-radius: self.width * 0.225;
    background: Theme.dark ? #2C2C31 : #F4F4F5;
    border-width: 1px;
    border-color: Theme.dark ? #36363C : #D4D4D8;
    property <length> dot: root.size * 0.15;
    property <length> step: dot + self.width * 0.09;
    for c[i] in dots: Rectangle {
        x: (parent.width - 3 * dot - 2 * (step - dot)) / 2 + Math.mod(i, 3) * step;
        y: (parent.height - 3 * dot - 2 * (step - dot)) / 2 + floor(i / 3) * step;
        width: dot;
        height: dot;
        border-radius: dot / 2;
        background: c;
    }
}

// ── The dock (one per output) ───────────────────────────────────────────────
export component Dock inherits Window {
    in property <[DockSlot]> slots;
    in property <length> pill-width: 100px;
    in property <length> base: 48px;
    in property <length> pad: 12px;
    in property <length> gap: 9px;
    in property <length> corner: 15px;
    in property <length> bar-height: 72px;
    in property <length> bottom-gap: 6px;
    in property <float> max-scale: 1;
    in property <bool> hidden;
    in property <bool> glass-plugin; // Glass: the plugin draws the slab's glass
    in property <bool> tips-warm; // Material: tooltips show (after the first wait)
    in property <bool> popup-open; // a menu or the Downloads stack is up
    // 0 shown .. 1 hidden: slides out of the window (QML: 350 ms out-back
    // coming up, 250 ms in-cubic going down; Material: its default spring)
    out property <float> slide: hidden ? 1 : 0;
    animate slide {
        duration: Theme.material ? 320ms : (hidden ? 250ms : 350ms);
        easing: Theme.material ? spring(0.2) : (hidden ? cubic-bezier(0.32, 0, 0.67, 0) : cubic-bezier(0.34, 1.35, 0.64, 1));
    }
    out property <length> pill-x: pill.x;
    out property <length> pill-y: pill.y;
    property <length> extra: base * (max-scale - 1);
    callback pointer(length, length, bool); // window x, y; on the window
    callback press(length, length, int); // button: 0 left, 1 right, 2 other
    callback release(length, length, int);
    callback activate(int); // (accessibility: a slot's default action)

    background: transparent;
    no-frame: true;
    title: "Dock";
    default-font-family: Theme.font;

    pill := Rectangle {
        x: (root.width - root.pill-width) / 2;
        y: root.height - root.bar-height - (root.bottom-gap - (Theme.material ? root.bar-height + root.bottom-gap + 8px : root.bar-height + root.extra + root.bottom-gap + 24px) * root.slide);
        width: root.pill-width;
        height: root.bar-height;
        // Glass: the plugin's glass (a tint over it without the plugin);
        // Material: surfaceContainer, fully round, elevation by tone
        border-radius: Theme.material ? self.height / 2 : root.corner;
        background: Theme.material ? Theme.m3-surface-container : (root.glass-plugin ? transparent : Theme.panel);
        border-width: !Theme.material && !root.glass-plugin ? 0.5px : 0;
        border-color: Theme.separator;
        accessible-role: list;
        accessible-label: "Dock";

        for s[i] in slots: Rectangle {
            property <length> slot: Theme.material ? root.base : s.size;
            x: s.x - s.lead;
            y: Theme.material ? root.pad : root.bar-height - root.pad - slot;
            width: s.lead + slot;
            height: slot;
            accessible-role: button;
            accessible-label: s.name + (s.running ? ", running" : "");
            accessible-action-default => { root.activate(i); }

            // Hops: up and down twice (Glass 260 ms out-quad / in-quad,
            // Material 220 ms up, 260 ms bouncing back)
            property <int> bounce-count: s.bounce;
            property <duration> bounce-start;
            property <bool> bouncing;
            changed bounce-count => {
                bounce-start = animation-tick();
                bouncing = true;
            }
            Timer {
                interval: Theme.material ? 960ms : 1040ms;
                running: bouncing;
                triggered => { bouncing = false; }
            }
            property <float> bt: bouncing ? (animation-tick() - bounce-start) / 1ms : 0;
            property <float> cycle: Math.mod(bt, Theme.material ? 480 : 520);
            property <length> hop: !bouncing ? 0 : Theme.material ? (cycle < 220 ? (1 - Math.pow(1 - cycle / 220, 5)) * root.base * 0.3 : (1 - out-bounce((cycle - 220) / 260)) * root.base * 0.3) : (cycle < 260 ? (1 - (1 - cycle / 260) * (1 - cycle / 260)) * root.base * 0.35 : (1 - (cycle - 260) / 260 * (cycle - 260) / 260) * root.base * 0.35);
            pure function out-bounce(p: float) -> float {
                if p < 1 / 2.75 { return 7.5625 * p * p; }
                if p < 2 / 2.75 { return 7.5625 * (p - 1.5 / 2.75) * (p - 1.5 / 2.75) + 0.75; }
                if p < 2.5 / 2.75 { return 7.5625 * (p - 2.25 / 2.75) * (p - 2.25 / 2.75) + 0.9375; }
                return 7.5625 * (p - 2.625 / 2.75) * (p - 2.625 / 2.75) + 0.984375;
            }

            // Divider before a new section
            if s.divider: Rectangle {
                x: round((s.lead - 1px) / 2px) * 1px - root.gap / 2;
                width: 1px;
                height: Theme.material ? round(root.base / 2px) * 1px : root.base * 0.8;
                y: Theme.material ? (parent.height - self.height) / 2 : parent.height - root.base * 0.1 - self.height;
                background: Theme.material ? Theme.m3-outline-variant : Theme.separator;
            }

            // ── Glass ──
            // Hover lift and press squish, on springs (QML: spring 4.5 /
            // damping 0.28, and 6 / 0.35)
            property <length> lift: s.hot && root.max-scale <= 1 ? root.base * 0.14 : 0;
            animate lift { duration: 380ms; easing: spring(0.48); }
            if !Theme.material: Rectangle {
                x: s.lead;
                y: -parent.lift - parent.hop;
                width: s.size;
                height: s.size;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-scale: s.pressed ? 0.9 : 1;
                animate transform-scale { duration: 320ms; easing: spring(0.44); }
                if s.kind == "launcher" && !s.themed: DotGrid { size: s.size; }
                // Minimized: a tile for its last frame (no thumbnail here), its app's badge
                if s.kind == "minimized": Rectangle {
                    x: s.size * 0.06;
                    y: s.size * 0.06;
                    width: s.size * 0.88;
                    height: s.size * 0.88;
                    border-radius: self.width * 0.12;
                    background: Theme.fill;
                }
                if s.has-icon && (s.kind != "launcher" || s.themed): Image {
                    x: s.kind == "minimized" ? s.size * 0.5 : 0;
                    y: s.kind == "minimized" ? s.size * 0.5 : 0;
                    width: s.kind == "minimized" ? s.size * 0.5 : s.size;
                    height: self.width;
                    source: s.icon;
                    image-rendering: smooth;
                    accessible-role: none;
                }
            }
            // Running: a small dot under the icon
            if !Theme.material && s.running: Rectangle {
                x: s.lead + (s.size - 4px) / 2;
                y: s.size + root.pad * 0.35;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Theme.label;
                opacity: 0.8;
            }
            // The name above the hovered icon, on frosted glass
            if !Theme.material && s.hot: Rectangle {
                x: s.lead + (s.size - self.width) / 2;
                y: -parent.lift - parent.hop - self.height - 10px;
                width: name.preferred-width + 20px;
                height: 26px;
                border-radius: 13px;
                background: Theme.dark ? rgba(28, 28, 33, 0.55) : rgba(247, 247, 252, 0.62);
                border-width: 1px;
                border-color: Theme.dark ? rgba(255, 255, 255, 0.14) : rgba(0, 0, 0, 0.1);
                Rectangle {
                    x: 13px * 1.28;
                    y: 1px;
                    width: parent.width - 2 * self.x;
                    height: 1px;
                    background: Theme.dark ? rgba(255, 255, 255, 0.12) : rgba(255, 255, 255, 0.6);
                }
                name := Text {
                    text: s.name;
                    color: Theme.label;
                    font-size: Theme.body;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }

            // ── Material ──
            if Theme.material: Rectangle {
                x: s.lead;
                y: -parent.hop;
                width: root.base;
                height: root.base;
                // State layer: a circle a little larger than the icon
                if s.kind != "launcher": Rectangle {
                    x: -2px;
                    y: -2px;
                    width: root.base + 4px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.m3-on-surface.with-alpha(s.pressed ? 0.1 : s.hot ? 0.08 : 0);
                    animate background { duration: 150ms; }
                }
                // The icon, swelling a little while pressed (the press spring)
                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: root.base - 4px;
                    height: self.width;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    transform-scale: s.pressed ? 1 + min(0.06, 10px / self.width) : 1;
                    animate transform-scale { duration: 290ms; easing: spring(0.57); }
                    // Apps button: a tonal circle that squares off while pressed
                    if s.kind == "launcher": Rectangle {
                        border-radius: s.pressed ? 16px : self.width / 2;
                        animate border-radius { duration: 150ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                        background: Theme.m3-on-secondary-container.mix(Theme.m3-secondary-container, s.pressed ? 0.1 : s.hot ? 0.08 : 0);
                        animate background { duration: 150ms; }
                        // squares-four, as Material draws it (Icon.qml: a Material
                        // Symbol, 1.2× the size; the font's default fill)
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "\u{e5c3}";
                            font-family: "Tessera Symbols";
                            font-size: round(parent.width * 0.45 / 1px) * 1.2px;
                            color: Theme.m3-on-secondary-container;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    if s.kind == "minimized": Rectangle {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        border-radius: 8px;
                        background: Theme.m3-surface-container-highest;
                    }
                    if s.has-icon && s.kind != "launcher": Image {
                        x: s.kind == "minimized" ? parent.width * 0.5 : 0;
                        y: s.kind == "minimized" ? parent.height * 0.5 : 0;
                        width: s.kind == "minimized" ? parent.width * 0.5 : parent.width;
                        height: self.width;
                        source: s.icon;
                        image-rendering: smooth;
                        accessible-role: none;
                    }
                }
            }
            // Running: a short dash under the icon, longer and primary for the app in front
            if Theme.material && s.running: Rectangle {
                width: s.focused ? 16px : 12px;
                animate width { duration: 220ms; easing: spring(0.4); }
                x: s.lead + (root.base - self.width) / 2;
                y: root.base + round((root.pad - 2px) / 2px) * 1px;
                height: 2px;
                border-radius: 1px;
                background: s.focused ? Theme.m3-primary : Theme.m3-on-surface-variant;
                animate background { duration: 150ms; }
            }
            // A plain tooltip above the pill: inverse surface, after a first wait
            if Theme.material: Rectangle {
                property <bool> shown: s.hot && root.tips-warm && !root.popup-open;
                opacity: shown ? 1 : 0;
                animate opacity { duration: shown ? 150ms : 100ms; }
                visible: self.opacity > 0;
                x: s.lead + (root.base - self.width) / 2;
                y: -root.pad - 8px - self.height + (shown ? 0 : 4px);
                animate y { duration: 150ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }
                width: min(280px, tip.preferred-width + 16px);
                height: 24px;
                border-radius: 4px;
                background: Theme.m3-inverse-surface;
                tip := Text {
                    width: min(self.preferred-width, 264px);
                    text: s.name;
                    overflow: elide;
                    color: Theme.m3-inverse-on-surface;
                    font-size: 12px;
                    letter-spacing: 0.4px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
    }

    // One tracker over the whole window: every hover and click is decided
    // in Rust from where the pointer is (nothing that moves decides hover)
    touch := TouchArea {
        changed mouse-x => { root.pointer(self.mouse-x, self.mouse-y, self.has-hover); }
        changed mouse-y => { root.pointer(self.mouse-x, self.mouse-y, self.has-hover); }
        changed has-hover => { root.pointer(self.mouse-x, self.mouse-y, self.has-hover); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.press(self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : e.button == PointerEventButton.right ? 1 : 2);
            } else if e.kind == PointerEventKind.up {
                root.release(self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : e.button == PointerEventButton.right ? 1 : 2);
            } else if e.kind == PointerEventKind.cancel {
                root.release(-1px, -1px, 3);
            }
        }
    }
}

// ── The right-click menu (a full-screen overlay: a click anywhere else closes it) ──
export struct DockMenuRow {
    text: string,
    confirm: string,
    enabled: bool,
    danger: bool,
    separator: bool,
}

export component DockMenu inherits Window {
    in property <[DockMenuRow]> rows;
    in property <length> point-x; // the menu centres on this x
    in property <length> point-bottom; // and its bottom sits this far above the screen's (it opens upward)
    in property <length> menu-width: 200px;
    in property <bool> shown;
    in property <bool> glass-plugin;
    in-out property <int> current: -1;
    in-out property <int> armed: -1; // a row waiting for confirmation
    // (spring 5 / damping 0.36 in QML)
    out property <float> progress: shown ? 1 : 0;
    animate progress {
        duration: shown ? 350ms : 120ms;
        easing: shown ? spring(0.36) : ease-in;
    }
    out property <length> panel-x: panel.x;
    out property <length> panel-y: panel.y;
    out property <length> panel-width: panel.width;
    out property <length> panel-height: panel.height;
    out property <float> panel-scale: panel.transform-scale;
    out property <length> radius: Theme.material ? 18px : 14px;
    callback chosen(int);
    callback dismissed();
    callback closed(); // the close animation ended
    changed progress => {
        if !shown && progress <= 0.001 { closed(); }
    }

    background: transparent;
    no-frame: true;
    title: "Dock menu";
    default-font-family: Theme.font;

    public function open() {
        current = -1;
        armed = -1;
        keys.focus();
    }
    function ok(i: int) -> bool {
        return i >= 0 && i < rows.length && !rows[i].separator && rows[i].enabled;
    }
    // (arrows skip separators and disabled rows: never more than two in a row)
    function step(d: int) {
        if ok(current + d) { current = current + d; return; }
        if ok(current + 2 * d) { current = current + 2 * d; return; }
        if ok(current + 3 * d) { current = current + 3 * d; }
    }
    function choose(i: int) {
        if i < 0 || i >= rows.length || rows[i].separator || !rows[i].enabled { return; }
        if rows[i].confirm != "" && armed != i {
            armed = i;
            return;
        }
        chosen(i);
    }

    TouchArea {
        clicked => { root.dismissed(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button != PointerEventButton.left { root.dismissed(); }
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.dismissed(); return accept; }
            if e.text == Key.DownArrow { step(1); return accept; }
            if e.text == Key.UpArrow { step(-1); return accept; }
            if e.text == Key.Return || e.text == " " { choose(current); return accept; }
            reject
        }
        panel := Rectangle {
            width: root.menu-width;
            height: rows-layout.preferred-height;
            x: max(0, min(root.width - self.width, root.point-x - self.width / 2));
            y: max(8px, root.height - root.point-bottom - self.height);
            opacity: min(1, root.progress);
            transform-origin: { x: self.width / 2, y: self.height };
            transform-scale: 0.94 + 0.06 * root.progress;
            border-radius: root.radius;
            background: Theme.material ? Theme.menu-bg : (root.glass-plugin ? transparent : Theme.panel);
            border-width: Theme.material ? 0 : 0.5px;
            border-color: Theme.separator;
            drop-shadow-blur: Theme.material ? 12px : 0;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.dark ? #00000066 : #00000029;
            accessible-role: list;
            accessible-label: "Dock menu";
            TouchArea {} // (clicks between rows stay in the menu)
            rows-layout := VerticalLayout {
                padding: 5px;
                for r[i] in rows: Rectangle {
                    height: r.separator ? 11px : 28px;
                    if r.separator: Rectangle {
                        x: 9px;
                        width: parent.width - 18px;
                        height: 1px;
                        background: Theme.separator;
                    }
                    if !r.separator: Rectangle {
                        property <bool> armed-row: root.armed == i;
                        property <bool> hot: root.current == i && r.enabled;
                        accessible-role: list-item;
                        accessible-label: armed-row ? r.confirm : r.text;
                        accessible-action-default => { root.choose(i); }
                        border-radius: Theme.material ? 10px : 8px;
                        background: armed-row ? Theme.danger : hot ? (r.danger && !Theme.material ? Theme.danger : Theme.highlight) : transparent;
                        Text {
                            x: 12px;
                            text: armed-row ? r.confirm : r.text;
                            vertical-alignment: center;
                            height: parent.height;
                            font-size: Theme.body;
                            font-weight: armed-row ? 600 : 400;
                            color: armed-row ? (Theme.material ? Theme.m3-on-error : #ffffff) : hot && !(Theme.material && r.danger) ? (Theme.material ? Theme.on-highlight : #ffffff) : !r.enabled ? Theme.tertiary : r.danger ? Theme.danger : Theme.label;
                            accessible-role: none;
                        }
                        TouchArea {
                            enabled: r.enabled;
                            changed has-hover => { if self.has-hover { root.current = i; } }
                            clicked => { root.choose(i); }
                        }
                    }
                }
            }
        }
    }
}
