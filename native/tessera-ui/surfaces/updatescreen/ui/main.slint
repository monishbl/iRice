// The update screen (shell/assets/updater/shell.qml): "Tessera is updating",
// a progress bar and the step; "Tessera is up to date"; or what went wrong,
// that nothing was lost, and Close. One per display, all the same.
// (Its own colours, as the QML's: it's drawn the same in both looks.)

export global Up {
    // run | restart | done | error (update-run.sh's status file)
    in property <string> phase: "run";
    in property <float> percent: 0;
    in property <string> step: "Preparing";
    in property <string> detail;
    in property <string> backup;
    // shown: on (fades in) once the window is up; leaving: fades out
    in property <bool> opened;
    in property <bool> leaving;
    // the menu icon: a Phosphor glyph, or a picture (the distro's logo)
    in property <string> glyph;
    in property <bool> has-image;
    in property <image> image;
    // A build under way (tools/build-progress.py's build-progress.json):
    // "Building the shell — compiling slint (212 of 431)", its time, and
    // how far (build-fraction < 0: not known, the bar sweeps instead)
    in property <bool> build;
    in property <string> build-step;
    in property <string> build-time;
    in property <float> build-fraction: -1;
    // Show details: the update's output (its log), last lines, following the end
    in property <bool> details;
    in property <string> log;
    callback close();
    callback toggle-details();
    callback copy-log();
}

export component UpdateScreen inherits Window {
    background: transparent;
    property <bool> error: Up.phase == "error";
    // (QML: Behavior on shown, 300 ms OutCubic in, 400 ms InCubic out)
    // (cubic-bezier: Qt's OutCubic and InCubic)
    property <float> shown: 0;
    states [
        gone when Up.leaving: {
            shown: 0;
            in {
                animate shown {
                    duration: 400ms;
                    easing: cubic-bezier(0.3333, 0, 0.6667, 0);
                }
            }
        }
        up when Up.opened: {
            shown: 1;
            in {
                animate shown {
                    duration: 300ms;
                    easing: cubic-bezier(0.3333, 1, 0.6667, 1);
                }
            }
        }
    ]
    property <float> pct: Up.percent;
    animate pct {
        duration: 400ms;
        easing: cubic-bezier(0.3333, 1, 0.6667, 1);
    }
    property <bool> building: Up.build && Up.phase == "run";
    property <bool> sweep: root.building && Up.build-fraction < 0;
    property <float> bpct: max(0, Up.build-fraction) * 100;
    animate bpct {
        duration: 400ms;
        easing: cubic-bezier(0.3333, 1, 0.6667, 1);
    }
    property <length> col-w: min(Up.details && !root.error ? 640px : 360px, self.width - 64px);
    // What takes clicks while it works (Show details, the log and Copy);
    // everything else passes through. Read by the screen for its input region.
    out property <length> hit-x: col.x + toggle-row.x;
    out property <length> hit-y: col.y + toggle-row.y;
    out property <length> hit-w: toggle-row.width;
    out property <length> hit-h: (Up.details ? log-box.y + log-box.height : toggle-row.y + toggle-row.height) - toggle-row.y;
    public function focus-keys() {
        keys.focus();
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #0A0A0B;
        opacity: root.shown;

        // Return and Escape close the error screen (it has the keyboard then)
        keys := FocusScope {
            // (a click goes to what's under it: keys only; it covered link rows and choices, which then took two clicks or none)
            focus-on-click: false;
            x: 0;
            y: 0;
            width: 0;
            height: 0;
            key-pressed(e) => {
                if root.error && (e.text == Key.Return || e.text == Key.Escape) {
                    Up.close();
                    return accept;
                }
                reject
            }
        }

        col := VerticalLayout {
            x: (parent.width - self.width) / 2;
            // (centred, and moves up a little as it appears)
            y: (parent.height - self.height) / 2 + (1 - root.shown) * 8px;
            width: root.col-w;
            height: self.preferred-height;
            spacing: 0;
            alignment: start;

            // Your menu icon
            Rectangle {
                height: 56px;
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    visible: !Up.has-image;
                    text: Up.glyph;
                    color: #EDEDEF;
                    font-family: "Phosphor-Fill";
                    font-size: 52px;
                }

                if Up.has-image: Image {
                    x: (parent.width - 52px) / 2;
                    y: (parent.height - 52px) / 2;
                    width: 52px;
                    height: 52px;
                    source: Up.image;
                    image-fit: contain;
                }
            }

            Rectangle {
                height: 28px;
            }

            // (wrapped in the column: a long error step ran past the screen's middle column)
            Text {
                horizontal-alignment: center;
                wrap: word-wrap;
                text: root.error ? Up.step : Up.phase == "done" ? "Tessera is up to date" : Up.phase == "restart" ? "Tessera is restarting" : "Tessera is updating";
                color: #EDEDEF;
                font-family: "Inter";
                font-size: 14px;
                font-weight: 500;
            }

            Rectangle {
                height: 14px;
            }

            // Progress: the update's, or the build's while one runs
            if !root.error: Rectangle {
                height: 4px;
                bar := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 0;
                    width: min(200px, parent.width);
                    height: 4px;
                    border-radius: 2px;
                    background: #2C2C31;
                    clip: true;
                    if !root.sweep: Rectangle {
                        x: 0;
                        y: 0;
                        width: max(self.height, parent.width * (root.building ? root.bpct : root.pct) / 100);
                        height: parent.height;
                        border-radius: 2px;
                        background: #EDEDEF;
                    }
                    // (how far isn't known: a segment sweeps; a loop, so linear)
                    if root.sweep: Rectangle {
                        property <float> t: mod(animation-tick() / 1600ms, 1);
                        x: -parent.width * 0.3 + parent.width * 1.3 * self.t;
                        y: 0;
                        width: parent.width * 0.3;
                        height: parent.height;
                        border-radius: 2px;
                        background: #EDEDEF;
                    }
                }
            }
            if !root.error: Rectangle {
                height: 12px;
            }
            if !root.error: Text {
                horizontal-alignment: center;
                wrap: word-wrap;
                text: Up.phase == "done" ? "Your settings and shortcuts are as you left them." : root.building ? Up.build-step : Up.step + "…";
                color: #A1A1AA;
                font-family: "Inter";
                font-size: 12px;
            }
            if root.building: Rectangle {
                height: 4px;
            }
            if root.building: Text {
                horizontal-alignment: center;
                wrap: word-wrap;
                text: Up.build-time;
                color: #94949D;
                font-family: "Inter";
                font-size: 12px;
            }

            // Show details: the update's output, as it comes
            if !root.error && Up.phase != "done": Rectangle {
                height: 16px;
            }
            toggle-row := Rectangle {
                visible: !root.error && Up.phase != "done";
                height: self.visible ? 32px : 0px;
                toggle := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 0;
                    width: toggle-text.preferred-width + 24px;
                    height: 32px;
                    border-radius: 10px;
                    background: tt.pressed ? #333338 : tt.has-hover ? #2C2C31 : transparent;
                    transform-scale: tt.pressed ? 0.97 : 1;
                    animate transform-scale { duration: 100ms; }
                    animate background { duration: 150ms; }
                    toggle-text := Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: Up.details ? "Hide details" : "Show details";
                        color: #A1A1AA;
                        font-family: "Inter";
                        font-size: 12px;
                        font-weight: 500;
                    }
                    tt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Up.toggle-details();
                        }
                    }
                    accessible-role: button;
                    accessible-label: toggle-text.text;
                    accessible-action-default => { Up.toggle-details(); }
                }
            }
            if Up.details && !root.error && Up.phase != "done": Rectangle {
                height: 8px;
            }
            log-box := Rectangle {
                visible: Up.details && !root.error && Up.phase != "done";
                height: self.visible ? 240px : 0px;
                border-radius: 14px;
                background: #1A1A1D;
                border-width: 1px;
                border-color: #26262A;
                clip: true;
                flick := Flickable {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    content-height: body.preferred-height;
                    // (follows the end, unless scrolled up to read)
                    property <bool> at-end: true;
                    changed content-y => {
                        self.at-end = -self.content-y >= self.content-height - self.height - 4px;
                    }
                    changed content-height => {
                        if self.at-end {
                            self.content-y = -max(0px, self.content-height - self.height);
                        }
                    }
                    body := Text {
                        width: flick.width;
                        text: Up.log == "" ? "Waiting for output…" : Up.log;
                        wrap: char-wrap;
                        color: #D4D4D8;
                        font-family: "JetBrains Mono";
                        font-size: 11px;
                    }
                }
                copy := Rectangle {
                    x: parent.width - self.width - 8px;
                    y: 8px;
                    width: copy-text.preferred-width + 20px;
                    height: 28px;
                    border-radius: 10px;
                    background: ct.pressed ? #36363C : ct.has-hover ? #333338 : #2C2C31;
                    copy-text := Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "Copy";
                        color: #EDEDEF;
                        font-family: "Inter";
                        font-size: 12px;
                        font-weight: 500;
                    }
                    ct := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Up.copy-log();
                        }
                    }
                    accessible-role: button;
                    accessible-label: "Copy the output";
                    accessible-action-default => { Up.copy-log(); }
                }
            }

            // Something went wrong: what, that nothing was lost, and Close
            if root.error: Text {
                horizontal-alignment: center;
                wrap: word-wrap;
                text: Up.detail;
                color: #A1A1AA;
                font-family: "Inter";
                font-size: 13px;
            }
            if root.error: Rectangle {
                height: 8px;
            }
            if root.error: Text {
                horizontal-alignment: center;
                wrap: word-wrap;
                text: "Nothing was lost." + (Up.backup != "" ? " Your settings and shortcuts were backed up to " + Up.backup + "." : "");
                color: #A1A1AA;
                font-family: "Inter";
                font-size: 13px;
            }
            if root.error: Rectangle {
                height: 24px;
            }
            if root.error: Rectangle {
                height: 36px;
                close := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 0;
                    width: close-text.preferred-width + 40px;
                    height: 36px;
                    border-radius: 10px;
                    background: ta.pressed ? #C7C7CC : ta.has-hover ? #DADADF : #EDEDEF;
                    transform-scale: ta.pressed ? 0.97 : 1;
                    animate transform-scale { duration: 100ms; }
                    close-text := Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "Close";
                        color: #18181B;
                        font-family: "Inter";
                        font-size: 14px;
                        font-weight: 500;
                    }
                    ta := TouchArea {
                        clicked => {
                            Up.close();
                        }
                    }
                }
            }
        }
    }
}
