// The bottom screen corners (surfaces/screenfx corners.rs; compare
// shell/modules/background/ScreenCorners.qml and common/Corner.qml): a strip
// along the bottom edge, `r` high, with a black concave corner at each end.
// (The top ones are the menu bar's.) Clicks go through (an empty input region).

import { Theme } from "@tessera/theme.slint";

export component Corners inherits Window {
    in property <length> r: 12px;
    background: transparent;
    no-frame: true;
    title: "Screen corners";
    // left: the corner square's black part, the arc bulging toward the corner
    Path {
        x: 0px;
        y: 0px;
        width: r;
        height: r;
        viewbox-width: 12;
        viewbox-height: 12;
        fill: #000000;
        commands: "M 0 12 L 12 12 A 12 12 0 0 1 0 0 Z";
    }
    Path {
        x: root.width - r;
        y: 0px;
        width: r;
        height: r;
        viewbox-width: 12;
        viewbox-height: 12;
        fill: #000000;
        commands: "M 12 12 L 0 12 A 12 12 0 0 0 12 0 Z";
    }
}
