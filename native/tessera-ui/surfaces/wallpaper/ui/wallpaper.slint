// The wallpaper picker (src/surfaces/wallpaper; compare
// shell/modules/wallpaper/WallpaperPicker.qml): a strip of thumbnails above
// the dock. Arrow keys move, Enter applies, Esc closes; a click applies
// (and brings it to the middle, as the ListView's highlight range). The strip
// is dragged with the pointer and flicked on letting go (Flickable's 1500
// px/s² deceleration); a touchpad's scroll glides on after the fingers lift
// (Momentum.qml: at the speed it was going, after a 50 ms pause).
// Glass: the panel sits on the plugin's glass (Rust sends its shape);
// Material: a solid surface container. Numbers are the QML's.

import { Theme } from "@tessera/theme.slint";

export struct Thumb {
    name: string, // the file's name, for screen readers
    image: image,
    ready: bool, // decoded (it fades in)
}

export component WallpaperPicker inherits Window {
    in property <[Thumb]> thumbs;
    in property <int> applied: -1; // the picture showing now
    in-out property <int> current: 0; // the keyboard's
    in property <string> folder; // "~/Pictures/Wallpapers"
    in property <bool> listed; // the folder was read (until then no empty text)
    in property <bool> shown; // drives the open/close animation
    // Glass over the plugin's glass: the plugin draws the panel (its tint and
    // rim); without the plugin, the panel colour over Hyprland's blur
    in property <bool> on-glass;
    out property <float> progress: shown ? 1 : 0;
    out property <length> offset: list-offset; // how far the list is scrolled
    out property <length> list-width: strip.width;
    out property <length> step: thumb-w + 12px; // a thumbnail and its gap
    out property <length> panel-x: body.x;
    out property <length> panel-y: body.y;
    out property <length> panel-width: body.width;
    out property <length> panel-height: body.height;
    callback apply(int);
    callback open-folder();
    callback dismissed();
    callback closed(); // the close animation ended

    property <length> m: 24px; // room for the shadow round the panel
    property <length> thumb-w: 220px;
    property <length> thumb-h: 124px; // (220 × 9 / 16)
    property <length> list-offset: 0;
    property <duration> glide: 220ms;
    property <bool> flinging; // (a flick decelerates evenly: ease-out quad)
    // A drag of the strip: where it started (window x, offset), the latest
    // two samples (x, time) for its speed, and whether it moved enough to be one
    property <length> drag-x0;
    property <length> drag-off0;
    property <length> drag-x;
    property <duration> drag-t;
    property <length> drag-px;
    property <duration> drag-pt;
    property <bool> dragging;
    // A touchpad's scroll: its speed (px/s, smoothed) and when it last moved
    property <float> wheel-v;
    property <duration> wheel-at;
    property <bool> wheeling;

    background: transparent;
    no-frame: true;
    title: "Wallpaper";
    default-font-family: Theme.font;

    // Theme.motion.panel, emphasized in and the exit curve out (each look's)
    animate progress {
        duration: 320ms;
        easing: shown ? (Theme.material ? cubic-bezier(0.05, 0.7, 0.1, 1.0) : cubic-bezier(0.2, 0.9, 0.1, 1.0)) : (Theme.material ? cubic-bezier(0.3, 0.0, 0.8, 0.15) : cubic-bezier(0.4, 0.0, 1.0, 1.0));
    }
    changed progress => {
        if !shown && progress <= 0.001 { closed(); }
    }
    // (out-quad for a flick, else ease-out)
    animate list-offset { duration: glide; easing: flinging ? cubic-bezier(0.5, 1, 0.89, 1) : cubic-bezier(0, 0, 0.58, 1); }

    function max-offset() -> length {
        max(0px, thumbs.length * step - 12px - strip.width)
    }
    function centred(i: int) -> length {
        clamp(i * step + thumb-w / 2 - strip.width / 2, 0px, max-offset())
    }
    function move(d: int) {
        if thumbs.length == 0 { return; }
        current = clamp(current + d, 0, thumbs.length - 1);
        flinging = false;
        glide = 220ms;
        list-offset = centred(current);
    }
    function wheel(dx: length, dy: length) {
        let d = abs(dx) > abs(dy) ? dx : dy;
        let before = list-offset;
        flinging = false;
        glide = 120ms;
        list-offset = clamp(list-offset - d, 0px, max-offset());
        // (Momentum.qml's speed: the last few events', smoothed)
        let now = animation-tick();
        let dt = clamp((now - wheel-at) / 1ms, 4, 100) / 1000;
        wheel-v = wheeling ? wheel-v * 0.4 + (list-offset - before) / 1px / dt * 0.6 : (list-offset - before) / 1px / dt * 0.6;
        wheel-at = now;
        wheeling = true;
    }
    // Glide on at `v` px/s, slowing evenly (Flickable: 1500 px/s², at most 2500 px/s)
    function fling(v: float) {
        let speed = clamp(abs(v), 0, 2500);
        if speed < 120 { return; }
        let dist = speed * speed / 3000 * 1px;
        flinging = true;
        glide = speed / 1500 * 1000ms;
        list-offset = clamp(list-offset + (v > 0 ? dist : -dist), 0px, max-offset());
    }
    function drag-press(x: length) {
        drag-x0 = x;
        drag-off0 = list-offset;
        drag-x = x;
        drag-px = x;
        drag-t = animation-tick();
        drag-pt = drag-t;
        dragging = false;
    }
    function drag-move(x: length) {
        if !dragging && abs(x - drag-x0) < 8px { return; }
        if !dragging {
            // (from where it is, not where a glide was headed)
            drag-off0 = drag-off0 + (x - drag-x0 > 0 ? 8px : -8px);
        }
        dragging = true;
        flinging = false;
        glide = 0ms;
        drag-px = drag-x;
        drag-pt = drag-t;
        drag-x = x;
        drag-t = animation-tick();
        list-offset = clamp(drag-off0 - (x - drag-x0), 0px, max-offset());
    }
    function drag-release() {
        if !dragging { return; }
        // (let go after holding still: no flick)
        let dt = (drag-t - drag-pt) / 1ms;
        if animation-tick() - drag-t < 80ms && dt > 0 {
            fling(-(drag-x - drag-px) / 1px / dt * 1000);
        }
    }
    // A thumbnail picked with the pointer: chosen, and brought to the middle
    function pick(i: int) {
        current = i;
        flinging = false;
        glide = 220ms;
        list-offset = centred(i);
        apply(i);
    }
    // Opened: the current one in the middle at once, the keyboard here
    public function reveal() {
        flinging = false;
        dragging = false;
        glide = 0ms;
        list-offset = centred(current);
        keys.focus();
    }

    // The fingers lifted (no phases here: a 50 ms pause in the events)
    Timer {
        interval: 25ms;
        running: wheeling;
        triggered => {
            if animation-tick() - wheel-at >= 50ms {
                wheeling = false;
                if animation-tick() - wheel-at < 80ms { fling(wheel-v); }
            }
        }
    }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { dismissed(); return accept; }
            if e.text == Key.LeftArrow { move(-1); return accept; }
            if e.text == Key.RightArrow { move(1); return accept; }
            if e.text == Key.Return && thumbs.length > 0 { apply(current); return accept; }
            reject
        }

        body := Rectangle {
            x: m;
            y: m + (1 - progress) * 16px;
            width: root.width - 2 * m;
            height: root.height - 2 * m;
            opacity: progress;
            border-radius: Theme.radius-panel;
            // (Material, see-through: its surface at the panel alpha, Theme.veil)
            background: on-glass ? transparent : Theme.material ? Theme.panel.with-alpha(Theme.panel-alpha) : Theme.panel;
            border-width: Theme.material || on-glass ? 0 : 0.5px;
            border-color: Theme.separator;
            // (Glass.qml's shadow: Material's solid surface, glass a little lighter)
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            // (none in Material while see-through: Hyprland would blur it into a rim)
            drop-shadow-color: Theme.material ? (Theme.panel-alpha < 1 ? transparent : Theme.dark ? #0000003d : #0000001a) : (Theme.dark ? #00000031 : #00000015);

            title := Text {
                x: 14px;
                y: 14px;
                text: "Wallpaper";
                color: Theme.label;
                font-size: Theme.title;
                font-weight: 600;
            }
            Text {
                x: title.x + title.width + 10px;
                y: title.y;
                height: title.height;
                width: max(0px, btn.x - self.x - 12px);
                text: folder;
                color: Theme.tertiary;
                font-size: Theme.small;
                vertical-alignment: bottom;
                overflow: elide;
                accessible-role: none;
            }

            btn := Rectangle {
                width: label.preferred-width + (Theme.material ? 32px : 24px);
                height: Theme.material ? 32px : 26px;
                x: parent.width - 14px - self.width;
                y: title.y + (title.height - self.height) / 2;
                border-radius: self.height / 2;
                // (Material: a tonal button, the secondary container with state layers)
                background: Theme.material ? Theme.m3-secondary-container.mix(Theme.m3-on-secondary-container, 1 - (bt.pressed ? 0.1 : bt.has-hover ? 0.08 : 0)) : bt.has-hover ? Theme.fill-hover : Theme.fill;
                accessible-role: button;
                accessible-label: "Open folder";
                accessible-action-default => { open-folder(); }
                label := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "Open folder";
                    color: Theme.material ? Theme.m3-on-secondary-container : Theme.label;
                    font-size: Theme.small;
                    font-weight: 500;
                    accessible-role: none;
                }
                bt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { open-folder(); }
                }
            }

            strip := Rectangle {
                x: 14px;
                y: parent.height - 14px - self.height;
                width: parent.width - 28px;
                height: thumb-h + 8px;
                clip: true;
                accessible-role: list;
                accessible-label: "Wallpapers";

                // (the gaps between thumbnails scroll and drag too)
                gap := TouchArea {
                    scroll-event(e) => {
                        wheel(e.delta-x, e.delta-y);
                        accept
                    }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { drag-press(self.absolute-position.x + self.mouse-x); }
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { drag-release(); }
                    }
                    moved => { if self.pressed { drag-move(self.absolute-position.x + self.mouse-x); } }
                }

                for t[i] in thumbs: Rectangle {
                    x: i * step - list-offset;
                    width: thumb-w;
                    height: thumb-h + 8px;
                    accessible-role: list-item;
                    accessible-label: t.name;
                    accessible-item-selectable: true;
                    accessible-item-selected: i == applied;
                    accessible-item-index: i;
                    accessible-action-default => { pick(i); }

                    frame := Rectangle {
                        property <bool> chosen: i == applied;
                        y: 4px;
                        width: parent.width;
                        height: thumb-h;
                        // (Material: corner 16, the chosen one rounder in a 3 px
                        // primary outline; keyboard focus in secondary)
                        border-radius: Theme.material ? (chosen ? 28px : 16px) : 12px;
                        animate border-radius { duration: 400ms; easing: spring(0.6); }
                        background: Theme.material && chosen ? Theme.m3-surface-container : Theme.fill;
                        border-width: chosen ? 3px : i == current ? 2px : 0;
                        border-color: chosen ? Theme.accent : Theme.material ? Theme.m3-secondary : Theme.label;
                        transform-scale: touch.has-hover ? 1.03 : 1;
                        animate transform-scale { duration: 150ms; }

                        // (Material: a gap inside the chosen one's outline)
                        inner := Rectangle {
                            property <length> inset: Theme.material && frame.chosen ? 6px : frame.border-width;
                            x: inset;
                            y: inset;
                            width: parent.width - 2 * inset;
                            height: parent.height - 2 * inset;
                            border-radius: max(0px, frame.border-radius - inset);
                            clip: true;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: t.image;
                                image-fit: cover;
                                opacity: t.ready ? 1 : 0;
                                animate opacity { duration: 220ms; }
                                accessible-role: none;
                            }
                        }
                        touch := TouchArea {
                            mouse-cursor: pointer;
                            // (a drag that started here moves the strip, and picks nothing)
                            pointer-event(e) => {
                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { drag-press(self.absolute-position.x + self.mouse-x); }
                                if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { drag-release(); }
                            }
                            moved => { if self.pressed { drag-move(self.absolute-position.x + self.mouse-x); } }
                            clicked => {
                                if !dragging { pick(i); }
                            }
                            scroll-event(e) => {
                                wheel(e.delta-x, e.delta-y);
                                accept
                            }
                        }
                    }
                }

                if listed && thumbs.length == 0: Text {
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "No images in " + folder;
                    color: Theme.secondary;
                    font-size: Theme.body;
                }
            }
        }
    }
}
