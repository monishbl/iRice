// Quick Look in Rust (rust.surfaces: quicklook; src/surfaces/quicklook),
// compare shell/modules/quicklook/QuickLook.qml: a preview of a file over a
// light scrim: pictures (with Live Text, T), video and audio, a PDF's first
// page, text and code, a folder's contents, or the file's details. Space or
// Esc closes it, Return opens the file in its app. Rust reads the file and
// sizes nothing; the card takes the preview's own shape within 80% of the
// screen, as the QML's.

import { Theme } from "@tessera/theme.slint";
import { StIc, StIcon } from "screentools.slint";
import { LtBox, LtBar, LiveTextLayer, LiveTextBar } from "shoteditor.slint";

// The toolbar's icon button: 36 px with a 20 px Phosphor icon (Glass), 40 px
// with a 24 px Material Symbol (Material). Glass: a fill on hover, a firmer
// one pressed (shrinking a little), the accent's tint when on; Material:
// state layers on a round shape that squares off pressed or on. A keyboard
// focus ring, and a tooltip (with its key) after a short hover. `danger`:
// red on hover (Delete); `done`: a check for a moment (Copy).
component QlButton inherits Rectangle {
    in property <StIc> icon;
    in property <StIc> done-icon;
    in property <string> tooltip;
    in property <string> done-tooltip;
    in property <string> shortcut;
    in property <bool> selected;
    in property <bool> danger;
    in property <bool> done;
    in property <bool> enabled: true;
    callback clicked();
    callback other-key(KeyEvent) -> bool;

    property <bool> hot: touch.has-hover && enabled;
    property <float> layer: !enabled ? 0 : touch.pressed ? 0.12 : touch.has-hover ? 0.08 : 0;
    property <color> mfg: !enabled ? Theme.m3-on-surface.with-alpha(0.38) : danger && hot ? Theme.m3-error
        : selected ? Theme.m3-on-secondary-container : Theme.m3-on-surface-variant;
    property <color> gfg: !enabled ? Theme.tertiary : danger && hot ? Theme.danger : selected ? Theme.accent : Theme.label;

    width: Theme.material ? 40px : 36px;
    height: self.width;
    border-radius: Theme.material ? (touch.pressed && enabled ? 12px : selected ? 14px : self.height / 2) : Theme.radius-control;
    animate border-radius { duration: 222ms; easing: spring(0.4); } // (springFast)
    background: Theme.material ? (selected ? Theme.m3-secondary-container.mix(mfg, 1 - layer) : mfg.with-alpha(layer))
        : selected ? Theme.accent.with-alpha(touch.pressed ? 0.28 : 0.18)
        : danger && hot ? Theme.danger.with-alpha(touch.pressed ? 0.24 : 0.14)
        : !enabled ? transparent : touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill-hover : transparent;
    animate background { duration: Theme.hover; }
    transform-scale: touch.pressed && enabled ? (Theme.material ? 1.06 : 0.97) : 1;
    animate transform-scale { duration: Theme.material ? 290ms : 100ms; easing: Theme.material ? spring(0.57) : cubic-bezier(0.3333, 1, 0.6667, 1); }
    accessible-role: button;
    accessible-label: done ? done-tooltip : tooltip;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }

    // Keyboard focus ring (Glass: 2 px accent, 2 px out; Material: 3 px secondary, 2 px out)
    if keys.has-focus: Rectangle {
        x: Theme.material ? -5px : -4px;
        y: self.x;
        width: root.width - 2 * self.x;
        height: root.height - 2 * self.y;
        border-radius: root.border-radius - self.x;
        border-width: Theme.material ? 3px : 2px;
        border-color: Theme.material ? Theme.m3-secondary : Theme.accent;
    }
    StIcon {
        width: 20px;
        height: 20px;
        icon: done ? done-icon : root.icon;
        fill: Theme.material && (selected || done);
        size: 20px; // (Material Symbols draw at 1.2x: 24 px)
        color: done ? (Theme.material ? Theme.m3-primary : Theme.accent) : Theme.material ? mfg : gfg;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    keys := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                root.clicked();
                return accept;
            }
            root.other-key(e) ? accept : reject
        }
    }

    // Tooltip after a short hover, under the button
    property <bool> hov: touch.has-hover;
    property <bool> tip-ready;
    changed hov => { if !hov { tip-ready = false; } }
    Timer {
        interval: 600ms;
        running: touch.has-hover && tooltip != "" && !touch.pressed && !tip-ready;
        triggered => { tip-ready = true; }
    }
    if tip-ready && touch.has-hover && tooltip != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height + 8px;
        width: tip-row.preferred-width + 16px;
        height: Theme.material ? 24px : 28px;
        border-radius: Theme.material ? 4px : 8px;
        background: Theme.material ? Theme.m3-inverse-surface : Theme.dark ? #3a3a3f : #1c1c1e;
        tip-row := HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Text {
                text: done ? done-tooltip : tooltip;
                color: Theme.material ? Theme.m3-inverse-on-surface : #f2f2f5;
                font-size: Theme.small;
                font-weight: 500;
                vertical-alignment: center;
                accessible-role: none;
            }
            if shortcut != "": Text {
                text: shortcut;
                color: Theme.material ? Theme.m3-inverse-on-surface.with-alpha(0.7) : #ffffff8c;
                font-size: Theme.small;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

export struct QlRow {
    icon: image,
    name: string,
}

export component QuickLook inherits Window {
    in property <bool> shown;
    // image | video | audio | pdf | text | folder | other | "" (not known yet)
    in property <string> kind;
    in property <string> file-name;
    in property <string> subtitle;
    in property <image> picture; // the image, the PDF's page, the video's frame
    in property <float> natural-w: 420;
    in property <float> natural-h: 260;
    in property <bool> picture-ready;
    in property <string> text-body;
    in property <[QlRow]> rows;
    in property <image> file-icon;
    in property <bool> playing;
    in property <float> position; // 0..1
    in property <string> wave; // Material's wavy progress (its path, 0..1000 × 0..12)
    in property <bool> text-mode;
    in property <[LtBox]> boxes;
    in property <float> glow;
    in property <bool> over-word;
    in property <LtBar> lt;
    in property <string> shape; // Material: the shape under the icon
    in property <string> play-shape; // Material: the play button's
    in property <string> press-shape; // Material: the play button's while pressed ("cookie9")
    in property <StIc> ic-text;
    in property <StIc> ic-copy;
    in property <StIc> ic-download;
    in property <StIc> ic-play;
    in property <StIc> ic-pause;
    in property <StIc> no-icon;
    in property <StIc> ic-x;
    in property <StIc> ic-markup;
    in property <StIc> ic-share;
    in property <StIc> ic-trash;
    in property <StIc> ic-check;
    in property <bool> copied; // (Copy's check, for a moment)
    callback close-it();
    callback open-it();
    callback share();
    callback copy-it();
    callback markup();
    callback delete-it();
    callback toggle-text();
    callback toggle-play();
    callback key(string, bool) -> bool; // text, control
    callback closed();
    callback lt-press(length, length, bool);
    callback lt-drag(length, length);
    callback lt-hover(length, length);
    callback lt-double(length, length);
    callback lt-chip(int);
    callback lt-copy-sel();
    callback lt-copy-all();
    callback lt-retry();
    callback lt-install();

    out property <float> progress: shown ? 1 : 0;
    out property <length> card-x: card.x;
    out property <length> card-y: card.y;
    out property <length> card-w: card.width;
    out property <length> card-h: card.height;
    out property <float> card-scale: card.transform-scale;
    // the picture as drawn (Live Text's layer goes exactly over it)
    out property <length> shown-w: pic-w;
    out property <length> shown-h: pic-h;

    background: transparent;
    no-frame: true;
    title: "Quick Look";
    default-font-family: Theme.font;
    forward-focus: keys;

    public function focus-keys() {
        keys.focus();
    }

    animate progress {
        duration: shown ? 200ms : 140ms;
        easing: shown ? cubic-bezier(0.3333, 1, 0.6667, 1) : cubic-bezier(0.3333, 0, 0.6667, 0);
    }
    changed progress => {
        if !shown && progress <= 0.001 { closed(); }
    }

    keys := FocusScope {
        // (a click goes to what's under it: keys only; it covered link rows and choices, which then took two clicks or none)
        focus-on-click: false;
        key-pressed(e) => {
            if root.key(e.text, e.modifiers.control) { return accept; }
            reject
        }
    }

    // The scrim: a click on it closes
    Rectangle {
        background: Theme.material ? Theme.m3-scrim.with-alpha(0.32 * progress) : #000000.with-alpha(0.3 * progress);
        TouchArea {
            enabled: shown;
            clicked => { root.close-it(); }
            // (the mouse's Back button closes, as Esc)
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.back { root.close-it(); }
            }
        }
    }

    property <length> header: 56px;
    // (wide enough for the whole toolbar and some of the name)
    property <length> min-w: kind == "image" ? (Theme.material ? 600px : 560px) : (Theme.material ? 520px : 480px);
    property <length> footer: text-mode && kind == "image" ? (Theme.material ? 40px : 36px) + 12px : 0;
    property <length> max-w: root.width * 0.8;
    property <length> max-h: root.height * 0.8 - header - footer;
    property <float> nat-w: kind == "image" && picture-ready ? natural-w : kind == "video" ? 1280 : kind == "pdf" ? natural-w : kind == "text" || kind == "folder" ? 760 : 420;
    property <float> nat-h: kind == "image" && picture-ready ? natural-h : kind == "video" ? 720 : kind == "pdf" ? natural-h : kind == "text" || kind == "folder" ? 900 : 260;
    property <float> k: min(1, max-w / 1px / max(1, nat-w), max-h / 1px / max(1, nat-h));
    // the picture inside the body, fitted (PreserveAspectFit)
    property <length> body-w: card.width - 24px;
    property <length> body-h: card.height - header - 12px - footer;
    property <float> aspect: max(0.01, nat-w) / max(0.01, nat-h);
    property <length> pic-w: min(body-w, body-h * aspect);
    property <length> pic-h: min(body-h, body-w / aspect);

    card := Rectangle {
        width: max(min-w, nat-w * k * 1px);
        height: nat-h * k * 1px + header + footer;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        opacity: progress;
        transform-scale: 0.94 + 0.06 * progress;
        border-radius: Theme.material ? Theme.radius-panel : 20px;
        background: Theme.material ? Theme.m3-surface-container : Theme.panel;
        drop-shadow-blur: Theme.material ? 24px : 0;
        drop-shadow-offset-y: Theme.material ? 6px : 0;
        drop-shadow-color: Theme.material ? Theme.m3-shadow.with-alpha(Theme.dark ? 0.4 : 0.16) : transparent;
        accessible-role: groupbox;
        accessible-label: file-name;
        // (clicks on the card don't close it; the Back button does)
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.back { root.close-it(); }
            }
        }

        // The preview
        body := Rectangle {
            x: 12px;
            y: header;
            width: body-w;
            height: body-h;
            clip: true;

            if (kind == "image" || kind == "pdf" || kind == "video") && picture-ready: Image {
                width: pic-w;
                height: pic-h;
                source: picture;
                image-fit: contain;
            }
            // Live Text over the picture as drawn
            if kind == "image" && text-mode: LiveTextLayer {
                width: pic-w;
                height: pic-h;
                boxes: root.boxes;
                glow: root.glow;
                ready: lt.status == "ready";
                over-word: root.over-word;
                press(x, y, s) => { root.lt-press(x, y, s); }
                drag-to(x, y) => { root.lt-drag(x, y); }
                hover(x, y) => { root.lt-hover(x, y); }
                double(x, y) => { root.lt-double(x, y); }
            }
            // Video: click to pause
            if kind == "video": TouchArea {
                clicked => { root.toggle-play(); }
            }

            // Audio, other files, an empty folder: the icon (Material: on a shape)
            if kind == "audio" || kind == "other" || (kind == "folder" && rows.length == 0): VerticalLayout {
                alignment: center;
                spacing: 16px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: Theme.material ? 144px : 96px;
                        height: self.width;
                        if Theme.material: Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            commands: shape;
                            fill: Theme.m3-surface-container-highest;
                        }
                        Image {
                            width: 96px;
                            height: 96px;
                            source: file-icon;
                        }
                    }
                }
                if kind == "audio": HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: Theme.material ? 64px : 44px;
                        height: self.width;
                        border-radius: Theme.material ? 0 : Theme.radius-control;
                        background: Theme.material ? transparent : pt.pressed ? Theme.fill-pressed : pt.has-hover ? Theme.fill : transparent;
                        transform-scale: Theme.material && pt.pressed ? 1.06 : 1;
                        animate transform-scale { duration: 290ms; easing: spring(0.57); } // (springPress)
                        accessible-role: button;
                        accessible-label: playing ? "Pause" : "Play";
                        accessible-action-default => { root.toggle-play(); }
                        // Material: play on a primary-container shape that
                        // morphs (a rounded square paused, a circle playing)
                        if Theme.material: Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            commands: pt.pressed ? press-shape : play-shape;
                            fill: Theme.m3-primary-container.mix(Theme.m3-on-primary-container, pt.pressed ? 0.9 : pt.has-hover ? 0.92 : 1);
                        }
                        StIcon {
                            icon: playing ? ic-pause : ic-play;
                            fill: true;
                            size: Theme.material ? 28px : 22px;
                            color: Theme.material ? Theme.m3-on-primary-container : Theme.label;
                        }
                        pt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-play(); }
                        }
                    }
                }
                if kind != "audio": Text {
                    text: kind == "folder" ? "Empty folder" : "No preview for this kind of file";
                    horizontal-alignment: center;
                    color: Theme.secondary;
                    font-size: Theme.body;
                }
            }

            // Video and audio: the progress (Material: wavy while it plays)
            if (kind == "video" || kind == "audio") && !Theme.material: Rectangle {
                y: parent.height - 3px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.fill;
                Rectangle {
                    x: 0;
                    width: parent.width * position;
                    border-radius: 1.5px;
                    background: Theme.accent;
                }
            }
            if (kind == "video" || kind == "audio") && Theme.material: Rectangle {
                y: parent.height - 12px;
                height: 12px;
                Path {
                    x: 0;
                    width: parent.width * position;
                    height: 12px;
                    viewbox-width: 1000 * position;
                    viewbox-height: 12;
                    commands: wave;
                    stroke: Theme.m3-primary;
                    stroke-width: 4px;
                    stroke-line-cap: round;
                    clip: true;
                }
                Rectangle {
                    x: parent.width * position + 8px;
                    y: 4px;
                    width: max(0, parent.width - self.x);
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.m3-secondary-container;
                }
            }

            // Text and code: the first 200 KB
            if kind == "text": Flickable {
                content-height: text-view.preferred-height;
                text-view := TextInput {
                    width: parent.width;
                    text: text-body;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    color: Theme.label;
                    selection-background-color: Theme.accent.with-alpha(0.4);
                    font-family: Theme.mono;
                    font-size: 12px;
                }
            }

            // A folder: what's inside
            if kind == "folder" && rows.length > 0: Flickable {
                content-height: rows.length * 32px;
                for r[i] in rows: Rectangle {
                    y: i * 32px;
                    height: 32px;
                    HorizontalLayout {
                        spacing: 10px;
                        Image {
                            width: 20px;
                            height: 20px;
                            source: r.icon;
                        }
                        Text {
                            text: r.name;
                            color: Theme.label;
                            font-size: Theme.body;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Live Text: what it found, chips and copying
        if text-mode && kind == "image" && lt.status != "": LiveTextBar {
            x: (parent.width - self.width) / 2;
            y: parent.height - 12px - self.height;
            bar: lt;
            ic-copy: root.ic-copy;
            ic-download: root.ic-download;
            no-icon: root.no-icon;
            chip(i) => { root.lt-chip(i); }
            copy-sel => { root.lt-copy-sel(); }
            copy-all => { root.lt-copy-all(); }
            retry => { root.lt-retry(); }
            install => { root.lt-install(); }
        }

        // The toolbar (after the preview: its tooltips draw over the picture).
        // Close, the name and what it is (both cut short when long), then
        // the actions in groups: the picture's own (Live Text, Mark up), the
        // file's (Copy, Share, Move to Trash), and Open. Glass: on the card's
        // glass, nothing drawn under it; Material: a tonal bar.
        if Theme.material: Rectangle {
            y: 0;
            height: header;
            border-top-left-radius: card.border-radius;
            border-top-right-radius: card.border-radius;
            background: Theme.m3-surface-container-high;
        }
        HorizontalLayout {
            y: 0;
            height: header;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: (header - (Theme.material ? 40px : 36px)) / 2;
            padding-bottom: self.padding-top;
            spacing: 8px;
            QlButton {
                icon: ic-x;
                tooltip: "Close";
                shortcut: "Esc";
                clicked => { root.close-it(); }
                other-key(e) => { root.key(e.text, e.modifiers.control) }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                padding-left: 4px;
                Text {
                    min-width: 0px;
                    text: file-name;
                    overflow: elide;
                    color: Theme.material ? Theme.m3-on-surface : Theme.label;
                    font-size: Theme.material ? 16px : Theme.body;
                    font-weight: Theme.material ? 500 : 600;
                }
                Text {
                    min-width: 0px;
                    text: subtitle;
                    overflow: elide;
                    color: Theme.material ? Theme.m3-on-surface-variant : Theme.secondary;
                    font-size: Theme.small;
                }
            }
            // A picture's own: Live Text, Mark up
            if kind == "image": HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 4px;
                QlButton {
                    icon: ic-text;
                    selected: text-mode;
                    tooltip: text-mode ? "Stop selecting text" : "Select text";
                    shortcut: "T";
                    enabled: picture-ready;
                    clicked => { root.toggle-text(); }
                    other-key(e) => { root.key(e.text, e.modifiers.control) }
                }
                QlButton {
                    icon: ic-markup;
                    tooltip: "Mark up";
                    enabled: picture-ready;
                    clicked => { root.markup(); }
                    other-key(e) => { root.key(e.text, e.modifiers.control) }
                }
            }
            // The file's: Copy, Share, Move to Trash
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 4px;
                padding-left: 4px;
                padding-right: 4px;
                QlButton {
                    icon: ic-copy;
                    done-icon: ic-check;
                    done: copied;
                    tooltip: kind == "image" ? "Copy picture" : kind == "text" ? "Copy text" : kind == "folder" ? "Copy folder" : "Copy file";
                    done-tooltip: "Copied";
                    shortcut: text-mode ? "" : "Ctrl+C";
                    enabled: kind != "";
                    clicked => { root.copy-it(); }
                    other-key(e) => { root.key(e.text, e.modifiers.control) }
                }
                if kind != "folder": QlButton {
                    icon: ic-share;
                    tooltip: "Share";
                    clicked => { root.share(); }
                    other-key(e) => { root.key(e.text, e.modifiers.control) }
                }
                QlButton {
                    icon: ic-trash;
                    danger: true;
                    tooltip: "Move to Trash";
                    shortcut: "Del";
                    clicked => { root.delete-it(); }
                    other-key(e) => { root.key(e.text, e.modifiers.control) }
                }
            }
            // Open, the one primary (Material: a filled pill, its corners
            // tightening while pressed; Glass: the accent)
            open-btn := Rectangle {
                horizontal-stretch: 0;
                width: open-text.preferred-width + (Theme.material ? 32px : 28px);
                border-radius: Theme.material ? (ot.pressed ? 12px : self.height / 2) : Theme.radius-control;
                animate border-radius { duration: 222ms; easing: spring(0.4); } // (springFast)
                transform-scale: ot.pressed ? (Theme.material ? 1.04 : 0.97) : 1;
                animate transform-scale { duration: Theme.material ? 290ms : 100ms; easing: Theme.material ? spring(0.57) : cubic-bezier(0.3333, 1, 0.6667, 1); }
                background: Theme.material ? Theme.m3-primary.mix(Theme.m3-on-primary, ot.pressed ? 0.88 : ot.has-hover ? 0.92 : 1)
                    : ot.pressed ? Theme.accent.darker(0.2) : ot.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                animate background { duration: Theme.hover; }
                accessible-role: button;
                accessible-label: open-text.text;
                accessible-action-default => { root.open-it(); }
                if ok.has-focus: Rectangle {
                    x: Theme.material ? -5px : -4px;
                    y: self.x;
                    width: open-btn.width - 2 * self.x;
                    height: open-btn.height - 2 * self.y;
                    border-radius: open-btn.border-radius - self.x;
                    border-width: Theme.material ? 3px : 2px;
                    border-color: Theme.material ? Theme.m3-secondary : Theme.accent;
                }
                open-text := Text {
                    text: kind == "folder" ? (Theme.material ? "Open folder" : "Open Folder") : (Theme.material ? "Open file" : "Open File");
                    color: Theme.material ? Theme.m3-on-primary : Theme.on-accent;
                    font-size: Theme.material ? 14px : Theme.body;
                    font-weight: 500;
                }
                ot := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-it(); }
                }
                ok := FocusScope {
                    focus-on-click: false;
                    key-pressed(e) => {
                        if e.text == " " || e.text == Key.Return {
                            root.open-it();
                            return accept;
                        }
                        root.key(e.text, e.modifiers.control) ? accept : reject
                    }
                }
            }
        }
    }
}
