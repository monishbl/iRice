// Notification Center in Rust (rust.surfaces: notifications), compare
// shell/modules/notifications/NotificationCenter.qml (Glass),
// NotificationShade.qml (Material), and the widgets beside them:
// CalendarWidget.qml, TodoWidget.qml, FocusWidget.qml, plus
// shell/common/Segmented.qml and controlcenter/CircleToggle.qml.
// Rust (src/surfaces/notifications, center.rs) groups the list, lays out the
// calendar's days and keeps what's open; the shell sends the widgets' data
// (its Calendar, Todos and Timers) and does what they're asked.

import { Theme, Icon } from "@tessera/theme.slint";
import { Squircle } from "@tessera/squircle.slint";
import { IconButton, StateShape } from "@tessera/widgets.slint";
import { CalendarTab, TodoTab, Segmented, NcDay, NcItem, NcTodo, NcTarget, NcDraft } from "@tessera/calendar.slint";
import { Banner, GlassCard, MaterialCard, Expander, Frost, Sliver } from "notifications.slint";

export struct NcRow {
    kind: int, // 0 a notification, 1 an island alert, 2 an open group's header
    group: string, // its app ("Tessera": the alerts)
    gkey: string, // its group's key (what toggles and clears it: two groups may share a name)
    count: int, // how many its card stands for (collapsed), else 1
    open: bool,
    edges: int, // a folded stack's cards peeking out below it (0..2)
    peek: length, // how far they reach below it (stack.rs)
    // Fanning out of the stack as its group opens (0 not: its front card;
    // the header 1, each card its place down), or folding back into it
    fan: int,
    fold: bool,
    from: length, // its height as it starts (what showed of it)
    shrink: float, // its scale and opacity then
    dim: float,
    delay: int, // ms before it moves
    first: bool, // Material: a block's ends
    last: bool,
    gap: length, // room above it
    b: Banner,
}

export struct NcLap {
    name: string,
    time: string,
}

// CircleToggle.qml: the focus timer's round buttons
component CircleButton inherits Rectangle {
    in property <color> ink; // Glass, on: the glyph on its white circle (accentOnGlyph)
    in property <string> icon;
    in property <bool> checked;
    in property <string> label;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: Theme.material ? (checked ? Theme.m3-primary : Theme.m3-surface-container-highest).mix(Theme.m3-on-surface, touch.pressed ? 0.9 : touch.has-hover ? 0.92 : 1)
        : checked ? #ffffff : touch.has-hover ? Theme.fill-hover : Theme.toggle-off;
    animate background { duration: 150ms; }
    transform-scale: touch.pressed ? 0.94 : 1;
    animate transform-scale { duration: 100ms; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    Icon {
        text: icon;
        fill: true;
        font-size: 18px;
        color: Theme.material ? (checked ? Theme.m3-on-primary : Theme.m3-on-surface-variant) : checked ? ink : Theme.label;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A piece of the list or a widget's card behind its content (Platter.qml):
// Glass, the platter (bare: a glass chip of its own, a white veil and edge);
// Material, its tonal surface
component Platter inherits Rectangle {
    in property <bool> chip;
    // the plugin draws a chip's glass; without it, Glass.qml's frosted
    // fallback: its tint under the chip's veil
    in property <bool> plugin: true;
    border-radius: 18px;
    background: !Theme.material && chip && !plugin ? Frost.tint : transparent;
    Squircle {
        radius: parent.border-radius;
        // (Material, see-through: Theme.qml's controlAlpha on its containers)
        fill: Theme.material ? Theme.m3-surface-container-high.with-alpha(Theme.blur ? 1 - 0.4 * (1 - Theme.panel-alpha) / 0.55 : 1) : chip ? (Theme.dark ? #ffffff12 : #ffffff47) : Theme.platter;
        // (on the glass's own curve, Platter.qml's Squircle: a circular fill
        // parted from the plugin's squircle at the corners, a second rounding;
        // a chip's hairline lies on the glass's edge)
        line-width: chip && !Theme.material ? 1px : 0;
        line-color: Theme.dark ? #ffffff0f : #ffffff4d;
    }
}

// ── Focus: the pomodoro ring and the stopwatch (FocusWidget.qml) ────────────
component FocusTab {
    in property <color> ink;
    in property <int> mode; // 0 focus timer, 1 stopwatch
    in property <string> remaining;
    in property <bool> focus-phase;
    in property <bool> running;
    in property <string> sessions;
    in property <string> track; // the ring (path commands, 110 px box)
    in property <string> progress;
    in property <string> sw;
    in property <bool> sw-running;
    in property <[NcLap]> laps;
    callback set-mode(int);
    callback act(string);
    height: col.preferred-height + 24px;
    col := VerticalLayout {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: self.preferred-height;
        spacing: 12px;
        Segmented {
            options: ["Focus", "Stopwatch"];
            current: mode;
            label: "Timer";
            selected(i) => { set-mode(i); }
        }
        if mode == 0: HorizontalLayout {
            spacing: 16px;
            alignment: start;
            Rectangle {
                width: 110px;
                height: 110px;
                Path {
                    width: 110px;
                    height: 110px;
                    viewbox-width: 110;
                    viewbox-height: 110;
                    commands: track;
                    stroke: Theme.material ? Theme.m3-secondary-container : Theme.toggle-off;
                    stroke-width: 8px;
                    stroke-line-cap: round;
                }
                if progress != "": Path {
                    width: 110px;
                    height: 110px;
                    viewbox-width: 110;
                    viewbox-height: 110;
                    commands: progress;
                    stroke: focus-phase ? (Theme.material ? Theme.m3-primary : Theme.accent) : Theme.material ? Theme.m3-tertiary : Theme.success;
                    stroke-width: 8px;
                    stroke-line-cap: round;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: remaining;
                        color: Theme.label;
                        font-size: 24px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: focus-phase ? "Focus" : "Break";
                        color: Theme.secondary;
                        font-size: Theme.caption;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: sessions;
                    color: Theme.secondary;
                    font-size: Theme.small;
                }
                HorizontalLayout {
                    spacing: 8px;
                    CircleButton {
                        ink: ink;
                        icon: running ? "\u{e39e}" : "\u{e3d0}";
                        checked: true;
                        label: running ? "Pause" : "Start";
                        clicked => { act("timer.toggle"); }
                    }
                    CircleButton {
                        ink: ink;
                        icon: "\u{e5a6}";
                        label: "Skip";
                        clicked => { act("timer.skip"); }
                    }
                    CircleButton {
                        ink: ink;
                        icon: "\u{e038}";
                        label: "Reset";
                        clicked => { act("timer.reset"); }
                    }
                }
            }
        }
        if mode == 1: VerticalLayout {
            spacing: 8px;
            Text {
                text: sw;
                color: Theme.label;
                font-size: 34px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                CircleButton {
                    ink: ink;
                    icon: sw-running ? "\u{e39e}" : "\u{e3d0}";
                    checked: true;
                    label: sw-running ? "Pause" : "Start";
                    clicked => { act("sw.toggle"); }
                }
                CircleButton {
                    ink: ink;
                    icon: "\u{e244}";
                    label: "Lap";
                    clicked => { act("sw.lap"); }
                }
                CircleButton {
                    ink: ink;
                    icon: "\u{e038}";
                    label: "Reset";
                    clicked => { act("sw.reset"); }
                }
            }
            for l in laps: HorizontalLayout {
                height: 20px;
                Text {
                    text: l.name;
                    color: Theme.secondary;
                    font-size: Theme.small;
                    horizontal-stretch: 1;
                }
                Text {
                    text: l.time;
                    color: Theme.label;
                    font-size: Theme.small;
                }
            }
        }
    }
}

// ── The panel ───────────────────────────────────────────────────────────────
export component Center inherits Window {
    in property <bool> shown;
    in property <bool> bare; // Glass without the panel: each piece its own glass
    in property <bool> glass-plugin;
    in property <[NcRow]> rows;
    in property <bool> anything;
    in property <string> focus-text; // "Work is on", "" no Focus mode
    in property <string> clock; // Material's time and date
    in property <string> date;
    in property <string> outline; // Material's empty shape (cookie9)
    in property <int> tab; // 0 calendar, 1 to-do, 2 focus
    // the calendar
    in property <string> cal-title;
    in property <bool> cal-week;
    in property <[NcDay]> days;
    in property <string> day-title;
    in property <[NcItem]> day-items;
    in property <string> every-day;
    in property <string> day-key;
    in property <string> day-short;
    in property <[NcTarget]> cal-targets;
    in property <string> cal-target;
    in property <string> cal-target-label: "This computer";
    in property <int> cal-default-alert: 10;
    in property <bool> cal-h24;
    in property <string> cal-undo;
    in-out property <string> cal-error;
    // to-do
    in property <[NcTodo]> todos;
    in property <string> todo-undo;
    // focus
    in property <int> focus-mode;
    in property <string> remaining;
    in property <bool> focus-phase;
    in property <bool> running;
    in property <string> sessions;
    in property <string> ring-track;
    in property <string> ring-progress;
    in property <string> sw;
    in property <bool> sw-running;
    in property <[NcLap]> laps;
    in property <color> accent-ink: Theme.accent;

    property <length> pad: Theme.material ? 12px : 16px;
    property <length> content-w: Theme.material ? 360px : 340px;
    property <length> m: 24px; // Popover.qml's shadow margin
    out property <length> body-x: body.x;
    out property <length> body-y: body.y;
    out property <length> body-width: body.width;
    out property <length> body-height: body.height;
    out property <float> body-opacity: body.opacity;
    out property <length> radius: Theme.material ? 24px + pad : 36px + pad;
    // (the list as scrolled, for the chips' glass)
    out property <length> list-top: body.y + pad + list-at.y;
    out property <length> list-scroll: -flick.content-y;
    out property <length> list-height: flick.height;
    out property <float> openness: shown ? 1 : 0;
    // the widgets' card, in the panel (Glass without the panel: its glass)
    out property <length> widgets-y: pad + widgets.y;
    out property <length> widgets-h: widgets.height;

    callback dismissed(); // a click outside, Esc
    callback closed(); // gone from view
    callback row-activated(int); // the card's click (its id)
    callback row-close(int); // dismiss it (its id; an alert's hid)
    callback alert-close(int);
    callback toggle-group(string);
    callback clear-group(string);
    callback action(int, string);
    callback reply-open(int);
    callback reply-cancel(int);
    callback reply-send(int, string);
    callback draft(int, string);
    callback link(string);
    callback clear-all();
    callback manage();
    callback set-tab(int);
    callback cal-step(int);
    callback cal-week-set(bool);
    callback cal-pick(string);
    callback todo-add(string);
    callback todo-toggle(string);
    callback todo-remove(string);
    callback todo-restore();
    callback todo-rename(string, string);
    callback cal-save(NcDraft, int);
    callback cal-remove(string, int);
    callback cal-move(string, string, int);
    callback cal-restore();
    // the calendar's editor, from Rust
    public function cal-close() {
        cal.close-editor();
    }
    public function cal-ask(what: int, day: string) {
        cal.ask(what, day);
    }
    public function cal-edit(it: NcItem) {
        cal.edit(it);
    }
    public function cal-fail(text: string) {
        cal.fail(text);
    }
    callback focus-mode-set(int);
    callback act(string);
    callback card(int, length, length, length, length, float, float); // a row's card as drawn: index, its top in the list, height (Glass's chips), width, its stack's peek, scale (about its foot) and opacity

    background: transparent;
    no-frame: true;
    title: "Notification Center";
    default-font-family: Theme.font;

    // (Popover.qml: closes in Theme.motion.popover × 0.7 on the look's exit
    // curve, as Control Center and the status menus)
    animate openness {
        duration: shown ? 420ms : Theme.popover * 0.7;
        easing: shown ? spring(0.3) : Theme.material ? cubic-bezier(0.3, 0, 0.8, 0.15) : cubic-bezier(0.4, 0, 1, 1);
    }
    changed openness => {
        if !shown && openness <= 0.001 { closed(); }
    }

    // A click outside closes it (Popover.qml's catcher)
    TouchArea {
        enabled: shown;
        clicked => { dismissed(); }
    }
    // Esc closes (Popover.qml); it has the keys from the start
    keys := FocusScope {
        // (a click goes to what's under it: keys only; it covered link rows and choices, which then took two clicks or none)
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Escape { dismissed(); return accept; }
            reject
        }
    }
    public function take-keys() {
        keys.focus();
    }

    body := Rectangle {
        width: content-w + 2 * pad;
        height: col.preferred-height + 2 * pad;
        x: parent.width - self.width - m;
        y: 34px + (1 - openness) * -8px;
        opacity: min(1, openness);
        border-radius: radius;
        // Material: its tonal surface; Glass: the plugin's glass and a tint
        // (bare: nothing; the pieces are glass of their own)
        // (Glass, no plugin: Glass.qml's frosted fallback, as the chips)
        background: bare ? transparent : Theme.material ? Theme.m3-surface-container.with-alpha(Theme.blur ? Theme.panel-alpha : 1) : glass-plugin ? transparent : Frost.tint;
        // (on the plugin's glass its rim is the edge: Popover draws no other)
        border-width: !Theme.material && !bare && !glass-plugin ? 0.5px : 0;
        border-color: Theme.separator;
        drop-shadow-blur: Theme.material && !bare ? 32px : 0;
        drop-shadow-offset-y: 8px;
        // (no blur isn't no shadow: Slint still draws it hard)
        drop-shadow-color: Theme.material && !bare ? #000000.with-alpha(Theme.dark ? 0.4 : 0.16) : transparent;
        accessible-role: groupbox;
        accessible-label: "Notification Center";
        // (clicks inside stay inside)
        TouchArea { }

        col := VerticalLayout {
            x: pad;
            y: pad;
            width: content-w;
            height: self.preferred-height;
            spacing: Theme.material ? 16px : 10px;

            // Material: the time and date, large
            if Theme.material: VerticalLayout {
                Text {
                    x: 12px;
                    text: clock;
                    color: Theme.m3-on-surface;
                    font-size: 40px;
                    font-weight: 500;
                    letter-spacing: -0.4px;
                }
                Text {
                    x: 12px;
                    text: date;
                    color: Theme.m3-on-surface-variant;
                    font-size: 14px;
                    font-weight: 500;
                }
            }
            // Glass: the title and Clear all
            if !Theme.material: HorizontalLayout {
                height: 28px;
                padding-left: 4px;
                Text {
                    text: "Notifications";
                    color: bare ? #ffffff : Theme.label;
                    font-size: Theme.title;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    stroke: bare ? #00000033 : transparent;
                    stroke-width: bare ? 0.6px : 0;
                }
                if anything: Rectangle {
                    y: 1px;
                    width: clear-l.preferred-width + 20px;
                    height: 26px;
                    border-radius: 13px;
                    background: clear-t.has-hover ? Theme.fill-hover : Theme.fill;
                    accessible-role: button;
                    accessible-label: "Clear all notifications";
                    accessible-action-default => { clear-all(); }
                    clear-l := Text {
                        text: "Clear all";
                        color: Theme.label;
                        font-size: Theme.small;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    clear-t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { clear-all(); }
                    }
                }
            }

            // The notifications, grouped by app
            list-at := Rectangle {
                height: anything ? min(list.preferred-height, Theme.material ? 440px : 420px) + (Theme.material ? 0 : 8px) : Theme.material ? mempty.preferred-height : 84px;
                // Nothing here (in the list's place: no room of its own)
                if !anything && !Theme.material: Platter {
                    chip: bare;
                    plugin: glass-plugin;
                    height: 84px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Icon {
                            text: "\u{e0d0}"; // bell-simple
                            font-size: 22px;
                            color: Theme.tertiary;
                        }
                        Text {
                            text: focus-text != "" ? focus-text : "No notifications";
                            color: Theme.secondary;
                            font-size: Theme.small;
                            horizontal-alignment: center;
                        }
                    }
                }
                mempty := VerticalLayout {
                    visible: !anything && Theme.material;
                    height: self.preferred-height;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        StateShape {
                            width: 80px;
                            height: 80px;
                            outline: outline;
                            icon: "\u{e0d0}";
                            icon-size: 32px;
                            shape-color: Theme.m3-surface-container-high;
                            icon-color: Theme.m3-on-surface-variant;
                        }
                    }
                    Text {
                        text: "No notifications";
                        color: Theme.m3-on-surface;
                        font-size: Theme.title;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                    if focus-text != "": Text {
                        text: focus-text;
                        color: Theme.m3-on-surface-variant;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }
                flick := Flickable {
                    visible: anything;
                    // (Glass: 8 px more on the left and top, for the close badges)
                    x: Theme.material ? 0 : -8px;
                    width: parent.width + (Theme.material ? 0 : 8px);
                    height: parent.height;
                    content-height: list.preferred-height + (Theme.material ? 0 : 8px);
                    list := VerticalLayout {
                        x: Theme.material ? 0 : 8px;
                        y: Theme.material ? 0 : 8px;
                        width: content-w;
                        height: self.preferred-height;
                        for r[i] in rows: Rectangle {
                            // its card's own height (a header: its bar)
                            property <length> card-h: r.kind == 2 ? (Theme.material ? 52px : 24px) : Theme.material ? mcard.height : gcard.height;
                            // Fanning out of the stack (its group just opened):
                            // from where it sat in the stack, one after another,
                            // on the shell's spring; folding back (Show less) on
                            // the exit curve. Reduce motion: it snaps (stack.rs)
                            property <bool> born: r.fan <= 0;
                            property <float> grow: born && !r.fold ? 1 : 0;
                            animate grow {
                                duration: Theme.still ? 0ms : r.fold ? 220ms : 460ms;
                                delay: Theme.still ? 0ms : r.delay * 1ms;
                                easing: r.fold ? cubic-bezier(0.4, 0, 1, 1) : Theme.material ? spring(0.5) : spring(0.32);
                            }
                            property <float> g: r.fan > 0 ? grow : 1;
                            property <float> sc: 1 - (1 - r.shrink) * (1 - min(1, g));
                            property <float> op: 1 - (1 - r.dim) * (1 - min(1, g));
                            height: max(0px, r.gap * g + r.from + (card-h - r.from) * g) + r.peek;
                            // (while it grows, nothing of it shows above its row:
                            // it comes out from under the card above)
                            clip: g < 0.999;
                            // the card's top: at the row's foot, over its stack's peek
                            property <length> top: self.height - r.peek - card-h;
                            property <string> geo: (self.y + top) / 1px + " " + card-h / 1px + " " + self.width / 1px + " " + r.peek / 1px + " " + sc + " " + op;
                            changed geo => { root.card(i, self.y + top, card-h, self.width, r.peek, sc, op); }
                            init => {
                                born = true;
                                root.card(i, self.y + top, card-h, self.width, r.peek, sc, op);
                            }

                            // ── Glass ──
                            if !Theme.material && r.kind == 2: Rectangle {
                                y: top;
                                height: 24px;
                                opacity: op;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    spacing: 6px;
                                    Text {
                                        text: r.group;
                                        color: Theme.label;
                                        font-size: Theme.body;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        y: 1px;
                                        width: less-l.preferred-width + 18px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: less-t.has-hover ? Theme.fill-hover : Theme.fill;
                                        accessible-role: button;
                                        accessible-label: "Show less";
                                        accessible-action-default => { toggle-group(r.gkey); }
                                        less-l := Text {
                                            text: "Show less";
                                            color: Theme.label;
                                            font-size: Theme.caption;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        less-t := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { toggle-group(r.gkey); }
                                        }
                                    }
                                    IconButton {
                                        y: 1px;
                                        width: 22px;
                                        height: 22px;
                                        icon: "\u{e4f6}";
                                        icon-size: 11px;
                                        label: r.kind == 1 || r.b.alert ? "Clear Tessera alerts" : "Clear " + r.group;
                                        clicked => { clear-group(r.gkey); }
                                    }
                                }
                            }
                            // a card, and (a folded stack) the cards peeking out under it
                            Rectangle {
                                visible: !Theme.material && r.kind != 2;
                                y: top;
                                height: card-h + r.peek;
                                for d in r.edges: Sliver {
                                    width: parent.width;
                                    height: parent.height;
                                    front-w: parent.width;
                                    front-h: card-h;
                                    radius: 18px;
                                    depth: d + 1;
                                    circular: false;
                                    // (as the card's platter: its glass's veil and
                                    // hairline, the frost without the plugin, or the
                                    // panel's platter)
                                    fill: bare && !glass-plugin ? Frost.tint : bare ? (Theme.dark ? #ffffff12 : #ffffff47) : Theme.platter;
                                    veil: Theme.dark ? #ffffff12 : #ffffff47;
                                    veiled: bare && !glass-plugin;
                                    line: Theme.dark ? #ffffff0f : #ffffff4d;
                                    line-width: bare ? 1px : 0;
                                    opacity: d == 0 ? 0.8 : 0.6;
                                }
                                // (what peeks out fans it out too)
                                if r.peek > 0: TouchArea {
                                    y: card-h;
                                    height: r.peek;
                                    mouse-cursor: pointer;
                                    clicked => { toggle-group(r.gkey); }
                                }
                                Rectangle {
                                    y: 0;
                                    height: card-h;
                                    transform-origin: { x: self.width / 2, y: self.height };
                                    transform-scale: sc;
                                    opacity: op;
                                    Platter {
                                        chip: bare;
                                        plugin: glass-plugin;
                                        y: 0;
                                        height: card-h;
                                        border-radius: 18px;
                                    }
                                    gtouch := TouchArea {
                                        y: 0;
                                        height: card-h;
                                        // (its text shows only once it's out of the stack)
                                        opacity: r.fan > 0 ? max(0, min(1, (g - 0.3) / 0.7)) : 1;
                                        gcard := GlassCard {
                                            width: content-w;
                                            b: r.b;
                                            hovered: gtouch.has-hover;
                                            // a folded stack: "2 more"; a click fans it
                                            // out, close clears the group
                                            more: r.count > 1 && !r.open ? r.count - 1 : 0;
                                            tap-expands: r.count > 1 && !r.open;
                                            close-label: r.count > 1 && !r.open ? "Clear " + r.count + " notifications from " + r.group : "";
                                            group-toggled => { toggle-group(r.gkey); }
                                            activated => { root.row-activated(r.b.id); }
                                            close => {
                                                if r.count > 1 && !r.open { root.clear-group(r.gkey); } else if r.b.alert { root.alert-close(r.b.id); } else { root.row-close(r.b.id); }
                                            }
                                            action(k) => { root.action(r.b.id, k); }
                                            reply-open => { root.reply-open(r.b.id); }
                                            reply-cancel => { root.reply-cancel(r.b.id); }
                                            reply-send(t) => { root.reply-send(r.b.id, t); }
                                            draft(t) => { root.draft(r.b.id, t); }
                                            link(u) => { root.link(u); }
                                        }
                                    }
                                }
                            }

                            // ── Material: one segmented list ──
                            seg := Rectangle {
                                visible: Theme.material;
                                property <length> live: swipe.current-position.x - swipe.pressed-position.x;
                                in-out property <length> off: 0;
                                property <length> dx: swipe.swiping ? live : off;
                                // (back on the default spring; off in 150 ms, InCubic)
                                animate dx { duration: swipe.swiping ? 0ms : off != 0 ? 150ms : 322ms; easing: off != 0 ? cubic-bezier(0.3333, 0, 0.6667, 0) : spring(0.5); }
                                // the pointer's speed (px per ms), for a fling
                                property <length> last-x;
                                property <duration> last-t;
                                property <float> vel;
                                // (a row now showing another card: back in place)
                                property <int> rid: r.b.id;
                                changed rid => { self.off = 0; }
                                property <bool> loose: swipe.swiping || dx != 0;
                                y: top;
                                x: dx;
                                // (fanning out: from its place in the stack)
                                transform-origin: { x: self.width / 2, y: self.height };
                                transform-scale: sc;
                                width: content-w;
                                height: r.kind == 2 ? 52px : mcard.height;
                                background: Theme.m3-surface-container-high.with-alpha(Theme.blur ? 1 - 0.4 * (1 - Theme.panel-alpha) / 0.55 : 1);
                                opacity: op * (1 - 0.6 * min(1, abs(dx) / max(1px, self.width)));
                                border-top-left-radius: loose || r.first ? 24px : 6px;
                                border-top-right-radius: self.border-top-left-radius;
                                border-bottom-left-radius: loose || r.last ? 24px : 6px;
                                border-bottom-right-radius: self.border-bottom-left-radius;
                                animate border-top-left-radius, border-bottom-left-radius { duration: 150ms; easing: cubic-bezier(0.3333, 1, 0.6667, 1); }
                                // a folded stack: the cards peeking out under it
                                // (its own block: round all round, as they are)
                                for d in r.edges: Sliver {
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height + r.peek;
                                    front-w: parent.width;
                                    front-h: parent.height;
                                    radius: 24px;
                                    depth: d + 1;
                                    circular: true;
                                    fill: parent.background;
                                    opacity: d == 0 ? 0.8 : 0.6;
                                }
                                if r.peek > 0: TouchArea {
                                    y: parent.height;
                                    height: r.peek;
                                    mouse-cursor: pointer;
                                    clicked => { toggle-group(r.gkey); }
                                }
                                fly := Timer {
                                    interval: 150ms;
                                    running: false;
                                    triggered => {
                                        self.running = false;
                                        if r.count > 1 { clear-group(r.gkey); } else if r.b.alert { alert-close(r.b.id); } else { row-close(r.b.id); }
                                    }
                                }
                                // Swipe sideways to dismiss: past a third of the way it
                                // slides off, otherwise it springs back
                                swipe := SwipeGestureHandler {
                                    enabled: Theme.material && r.kind != 2;
                                    handle-swipe-left: true;
                                    handle-swipe-right: true;
                                    moved => {
                                        let dt = max(1, (animation-tick() - seg.last-t) / 1ms);
                                        seg.vel = (seg.live - seg.last-x) / 1px / dt;
                                        seg.last-x = seg.live;
                                        seg.last-t = animation-tick();
                                    }
                                    // (past a third, or flung over 900 px/s its way)
                                    swiped => {
                                        if abs(live) > seg.width / 3 || (abs(seg.vel) > 0.9 && seg.vel * live / 1px > 0) {
                                            seg.off = (live > 0 ? 1 : -1) * (seg.width + 24px);
                                            fly.running = true;
                                        } else {
                                            seg.off = 0;
                                        }
                                    }
                                    cancelled => { seg.off = 0; }
                                    mtouch := TouchArea {
                                        opacity: r.fan > 0 ? max(0, min(1, (g - 0.3) / 0.7)) : 1;
                                        mcard := MaterialCard {
                                            visible: r.kind != 2;
                                            width: content-w;
                                            b: r.b;
                                            hovered: mtouch.has-hover;
                                            group-count: r.count;
                                            group-open: r.open;
                                            tap-expands: r.count > 1;
                                            group-toggled => { toggle-group(r.gkey); }
                                            activated => { root.row-activated(r.b.id); }
                                            close => { if r.b.alert { root.alert-close(r.b.id); } else { root.row-close(r.b.id); } }
                                            action(k) => { root.action(r.b.id, k); }
                                            reply-open => { root.reply-open(r.b.id); }
                                            reply-cancel => { root.reply-cancel(r.b.id); }
                                            reply-send(t) => { root.reply-send(r.b.id, t); }
                                            draft(t) => { root.draft(r.b.id, t); }
                                            link(u) => { root.link(u); }
                                        }
                                    }
                                }
                                // An open group's header: its name, Clear, and the chevron
                                if r.kind == 2: Rectangle {
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { toggle-group(r.gkey); }
                                    }
                                    Text {
                                        x: 16px;
                                        width: parent.width - 16px - 8px - 12px - 32px - 4px - 34px;
                                        text: r.group;
                                        color: Theme.m3-on-surface;
                                        font-size: Theme.title;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    IconButton {
                                        x: parent.width - 12px - 34px - 4px - 32px;
                                        y: (parent.height - self.height) / 2;
                                        width: 32px;
                                        height: 32px;
                                        icon: "\u{e4f6}";
                                        icon-size: 18px;
                                        icon-color: Theme.m3-on-surface-variant;
                                        label: r.b.alert ? "Clear Tessera alerts" : "Clear " + r.group;
                                        clicked => { clear-group(r.gkey); }
                                    }
                                    Expander {
                                        x: parent.width - 12px - self.width;
                                        y: (parent.height - self.height) / 2;
                                        count: r.count;
                                        open: true;
                                        clicked => { toggle-group(r.gkey); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Material: Manage and Clear all
            if Theme.material: Rectangle {
                height: 40px;
                manage-btn := Rectangle {
                    x: 0;
                    width: manage-l.preferred-width + 24px;
                    height: 40px;
                    border-radius: manage-t.pressed ? 12px : 20px;
                    animate border-radius { duration: 100ms; easing: cubic-bezier(0.3333, 1, 0.6667, 1); }
                    background: manage-t.pressed ? Theme.m3-primary.with-alpha(0.1) : manage-t.has-hover ? Theme.m3-primary.with-alpha(0.08) : transparent;
                    animate background { duration: 150ms; }
                    transform-scale: manage-t.pressed ? 0.97 : 1;
                    animate transform-scale { duration: 100ms; }
                    accessible-role: button;
                    accessible-label: "Manage notifications";
                    accessible-action-default => { manage(); }
                    manage-l := Text {
                        text: "Manage";
                        color: Theme.m3-primary;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    manage-t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { manage(); }
                    }
                }
                if anything: Rectangle {
                    x: parent.width - self.width;
                    width: mclear-l.preferred-width + 40px;
                    height: 40px;
                    border-radius: mclear-t.pressed ? 12px : 20px;
                    animate border-radius { duration: 100ms; easing: cubic-bezier(0.3333, 1, 0.6667, 1); }
                    background: Theme.m3-secondary-container.mix(Theme.m3-on-secondary-container, mclear-t.pressed ? 0.9 : mclear-t.has-hover ? 0.92 : 1);
                    animate background { duration: 150ms; }
                    transform-scale: mclear-t.pressed ? 0.97 : 1;
                    animate transform-scale { duration: 100ms; }
                    accessible-role: button;
                    accessible-label: "Clear all notifications";
                    accessible-action-default => { clear-all(); }
                    mclear-l := Text {
                        text: "Clear all";
                        color: Theme.m3-on-secondary-container;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    mclear-t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { clear-all(); }
                    }
                }
            }

            // Calendar, To-do and Focus: one card, the tabs its first row
            widgets := Platter {
                chip: bare;
                plugin: glass-plugin;
                border-radius: Theme.material ? 24px : 36px;
                height: tabs.height + 12px + (Theme.material ? 4px : 0) + (tab == 0 ? cal.height : tab == 1 ? todo.height : focus.height);
                tabs := Segmented {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: Theme.material ? 36px : 28px;
                    options: ["Calendar", "To-do", "Focus"];
                    current: tab;
                    label: "Widgets";
                    selected(i) => { set-tab(i); }
                }
                cal := CalendarTab {
                    outline: outline;
                    y: tabs.y + tabs.height + (Theme.material ? 4px : 0);
                    width: parent.width;
                    visible: tab == 0;
                    title: cal-title;
                    week: cal-week;
                    days: days;
                    day-title: day-title;
                    items: day-items;
                    every-day: every-day;
                    day-key: day-key;
                    day-short: day-short;
                    targets: cal-targets;
                    target: cal-target;
                    target-label: cal-target-label;
                    default-alert: cal-default-alert;
                    h24: cal-h24;
                    undo: cal-undo;
                    ink: accent-ink;
                    radius: Theme.material ? 24px : 36px;
                    error <=> cal-error;
                    save(d, every) => { cal-save(d, every); }
                    remove(k, every) => { cal-remove(k, every); }
                    move(k, day, every) => { cal-move(k, day, every); }
                    restore => { cal-restore(); }
                    step(n) => { cal-step(n); }
                    set-week(w) => { cal-week-set(w); }
                    pick(k) => { cal-pick(k); }
                    todo-toggle(k) => { root.todo-toggle(k); }
                }
                todo := TodoTab {
                    y: cal.y;
                    width: parent.width;
                    visible: tab == 1;
                    todos: todos;
                    undo: todo-undo;
                    ink: accent-ink;
                    add(t) => { todo-add(t); }
                    toggle(k) => { todo-toggle(k); }
                    remove(k) => { todo-remove(k); }
                    restore => { todo-restore(); }
                    rename(k, t) => { todo-rename(k, t); }
                }
                focus := FocusTab {
                    ink: accent-ink;
                    y: cal.y;
                    width: parent.width;
                    visible: tab == 2;
                    mode: focus-mode;
                    remaining: remaining;
                    focus-phase: focus-phase;
                    running: running;
                    sessions: sessions;
                    track: ring-track;
                    progress: ring-progress;
                    sw: sw;
                    sw-running: sw-running;
                    laps: laps;
                    set-mode(i) => { focus-mode-set(i); }
                    act(a) => { root.act(a); }
                }
            }
        }
    }
}
