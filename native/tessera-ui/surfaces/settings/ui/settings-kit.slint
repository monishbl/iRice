// Settings (native/tessera-ui/src/surfaces/settings): the page model Rust
// fills, and the controls its rows hold, both looks, as the QML ones in
// shell/common (Switch, Slider, Segmented, Dropdown, TextField, Chip) and
// shell/modules/settings (Row, Group, Choice, SettingsButton, SubpageLink,
// MoreOptions, WordSlider, PathField). Every control reports through the
// SBus global: act(row id, int, float, string).

import { Theme } from "@tessera/theme.slint";
import { Busy } from "@tessera/widgets.slint";

// An icon: its Phosphor glyph, and the Material Symbols one Material draws
// in its place ("" when there's none: Phosphor stays), as Icon.qml
export struct SIc {
    p: string,
    m: string,
}

// A small item: a segment, a chip, a button, a swatch, a list entry, a
// menu item, a custom view's datum
export struct SOpt {
    text: string,
    detail: string,
    icon: SIc,
    on: bool, // chosen, checked, connected…
    off: bool, // can't be chosen
    style: int, // buttons: 0 normal, 1 primary, 2 danger, 3 minor; else free
    color: color,
    image: image,
    num: float,
    id: string, // (a custom view's own key)
}

// One row in a group (Row.qml, SubpageLink.qml, or a custom view's)
export struct SetRow {
    id: string, // what act() names
    kind: string, // "row" | "link" | "text" | "custom"
    label: string,
    detail: string,
    icon: SIc,
    tone: int, // the label's colour: 0 label, 1 secondary, 2 danger, 3 success
    value: string, // link: its summary; "value": the text on the right
    control: string, // "" | switch | slider | segmented | choice | button | buttons | field | path | chips | value | swatches | spinner | custom
    on: bool,
    enabled: bool,
    num: float,
    from: float,
    to: float,
    step: float,
    low: string, // a slider's words under its ends (WordSlider)
    high: string,
    index: int, // segmented / choice: the current one (-1: none)
    opts: [SOpt],
    text: string, // a field's text, a single button's label
    placeholder: string,
    secret: bool,
    width: length, // the control's width (0: its own)
    style: int, // a single button: 0 normal, 1 primary, 2 danger, 3 minor
    busy: bool,
    flash: bool, // a search landed here
    group: string, // custom: whose view (the page group's .slint)
    sub: string, // custom: which view
    data: [SOpt],
    image: image,
}

// One block on a page (Group.qml, a PagePart's heading, MoreOptions'
// button, a paragraph, or a custom view)
export struct SBlock {
    kind: string, // "group" | "heading" | "more" | "text" | "custom"
    id: string,
    title: string,
    footer: string,
    text: string,
    dim: bool, // its rows can't be used now (QML: enabled false, 0.45)
    on: bool, // more: open
    above: length, // the space above it
    flash: bool,
    rows: [SetRow],
    group: string,
    sub: string,
    data: [SOpt],
    num: float,
    image: image,
}

export struct SSection {
    id: string,
    name: string,
    group: string, // its group's heading, on the first section of each group
    icon: SIc,
    color: color,
    current: bool,
}

export struct SResult {
    page: string,
    text: string,
    where: string, // the section's name ("" for a section itself)
    icon: SIc,
    color: color,
    section: bool,
}

// Everything a page's controls say, and the window's overlays they open
export global SBus {
    callback act(string, int, float, string);
    // a Choice (or a button with a menu) wants its list under it: its id
    // and its place in the window
    callback menu(string, length, length, length, length);
    // a search landed on a row: where it is in the window (the page
    // scrolls it into view)
    in-out property <length> reveal-y;
    in-out property <length> reveal-h;
    in-out property <int> reveal-seq;
    // the window's width for the page (custom views size from it)
    in-out property <length> page-width: 600px;
}

// Glyphs drawn here (phosphor.js / material-symbols.js codes)
export global SG {
    out property <SIc> caret-left: { p: "\u{e138}", m: "\u{e5cb}" };
    out property <SIc> caret-right: { p: "\u{e13a}", m: "\u{e5cc}" };
    out property <SIc> caret-down: { p: "\u{e136}", m: "\u{e313}" };
    out property <SIc> caret-up-down: { p: "\u{e140}", m: "\u{e5d7}" };
    out property <SIc> search: { p: "\u{e30c}", m: "\u{ef7a}" };
    out property <SIc> x: { p: "\u{e4f6}", m: "\u{e5cd}" };
    out property <SIc> check: { p: "\u{e182}", m: "\u{e668}" };
    out property <SIc> check-circle: { p: "\u{e184}", m: "\u{f0be}" };
    out property <SIc> minus: { p: "\u{e32a}", m: "\u{e15b}" };
    out property <SIc> plus: { p: "\u{e3d4}", m: "\u{e145}" };
    out property <SIc> notch: { p: "\u{eb44}", m: "" };
    out property <SIc> image: { p: "\u{e2ca}", m: "\u{e3f4}" };
    out property <SIc> info: { p: "\u{e2ce}", m: "\u{e88e}" };
    out property <SIc> warning: { p: "\u{e4e0}", m: "\u{f083}" };
    out property <SIc> gear: { p: "\u{e270}", m: "\u{e8b8}" };
    out property <SIc> dots: { p: "\u{e1fe}", m: "\u{e5d3}" };
    out property <SIc> trash: { p: "\u{e4a6}", m: "\u{e92e}" };
}

// Motion (Theme.motion)
export global SM {
    out property <duration> press: 100ms;
    out property <duration> hover: 150ms;
    out property <duration> popover: 220ms;
}

// An icon, Phosphor or (Material) its Material Symbol, as Icon.qml
export component SIcon {
    in property <SIc> g;
    in property <color> color: Theme.label;
    in property <length> size: 16px;
    in property <bool> fill;
    in property <bool> bold;
    property <bool> sym: Theme.material && g.m != "";
    preferred-width: size;
    preferred-height: size;
    min-width: size;
    min-height: size;
    Text {
        width: 100%;
        height: 100%;
        text: sym ? g.m : g.p;
        color: root.color;
        // (Material Symbols draw a little larger: their glyphs sit in a padded square)
        font-size: sym ? Math.round(size * 1.2 / 1px) * 1px : size;
        font-family: sym ? "Tessera Symbols" : fill ? "Phosphor-Fill" : bold ? "Phosphor-Bold" : "Phosphor";
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: AccessibleRole.none;
    }
}

// A focus ring (FocusRing.qml): the accent, 2 px outside, keyboard focus only
// (it fills what it's in; the ring is drawn 3 px outside that)
export component SFocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> radius: 8px;
    background: transparent;
    Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: root.radius + 3px;
        border-width: root.shown ? 2px : 0;
        border-color: Theme.material ? Theme.m3-secondary : Theme.accent;
        background: transparent;
    }
}

// ── Switch (Switch.qml) ─────────────────────────────────────────────────
export component SSwitch {
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled();
    width: Theme.material ? 52px : 38px;
    height: Theme.material ? 32px : 22px;
    opacity: enabled ? 1 : 0.4;
    accessible-role: AccessibleRole.checkbox;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: on;
    accessible-action-default => { if enabled { toggled(); } }
    forward-focus: fs;
    fs := FocusScope {
        key-pressed(e) => {
            if enabled && !e.repeat && (e.text == " " || e.text == Key.Return) {
                root.toggled();
                return accept;
            }
            reject
        }
    }
    SFocusRing { shown: fs.has-focus; radius: root.height / 2; }
    if !Theme.material: Rectangle {
        border-radius: self.height / 2;
        background: on ? Theme.accent : Theme.toggle-off;
        animate background { duration: SM.hover; }
        Rectangle {
            width: parent.height - 4px;
            height: self.width;
            y: 2px;
            x: on ? parent.width - self.width - 2px : 2px;
            animate x { duration: SM.popover; easing: cubic-bezier(0.2, 0, 0, 1); }
            border-radius: self.width / 2;
            background: white;
        }
    }
    if Theme.material: Rectangle {
        border-radius: self.height / 2;
        background: on ? Theme.m3-primary : Theme.m3-surface-container-highest;
        border-width: on ? 0 : 2px;
        border-color: Theme.m3-outline;
        animate background { duration: 150ms; }
        property <length> hs: ta.pressed ? 28px : on ? 24px : 16px;
        animate hs { duration: 250ms; easing: spring(0.54); }
        property <length> hx: on ? self.width - 16px : 16px;
        animate hx { duration: 300ms; easing: spring(0.54); }
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            x: parent.hx - 20px;
            y: (parent.height - self.height) / 2;
            background: (on ? Theme.m3-primary : Theme.m3-on-surface).with-alpha(ta.pressed ? 0.1 : ta.has-hover ? 0.08 : 0);
        }
        Rectangle {
            width: parent.hs;
            height: parent.hs;
            border-radius: parent.hs / 2;
            x: parent.hx - parent.hs / 2;
            y: (parent.height - self.height) / 2;
            background: on ? Theme.m3-on-primary : ta.has-hover || ta.pressed ? Theme.m3-on-surface-variant : Theme.m3-outline;
            animate background { duration: 150ms; }
            if on: SIcon { g: SG.check; size: 13px; bold: true; color: Theme.m3-on-primary-container; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => {
            fs.focus();
            fs.clear-focus();
            root.toggled();
        }
    }
}

// ── Slider (Slider.qml): drags show at once; `moved` says each step ─────
export component SSlider {
    in property <float> value;
    in property <float> from: 0;
    in property <float> to: 1;
    in property <float> step: 0;
    in property <bool> enabled: true;
    in property <string> label;
    callback moved(float);
    property <bool> dragging: ta.pressed;
    property <float> shown: dragging ? drag-value : value;
    property <float> drag-value;
    property <float> ratio: to == from ? 0 : max(0, min(1, (shown - from) / (to - from)));
    property <float> key-step: step > 0 ? step : (to - from) / 20;
    preferred-width: 180px;
    height: Theme.material ? 32px : 22px;
    opacity: enabled ? 1 : 0.45;
    accessible-role: AccessibleRole.slider;
    accessible-label: label;
    accessible-value: round(shown * 100) / 100;
    accessible-value-minimum: from;
    accessible-value-maximum: to;
    accessible-value-step: key-step;
    accessible-action-increment => { nudge(value + key-step); }
    accessible-action-decrement => { nudge(value - key-step); }
    function snap(v: float) -> float {
        let c = max(min(from, to), min(max(from, to), v));
        if step > 0 { return round(c / step) * step; }
        c
    }
    function nudge(v: float) {
        let n = snap(v);
        if n != value { moved(n); }
    }
    forward-focus: fs;
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.LeftArrow || e.text == Key.DownArrow { nudge(value - key-step); return accept; }
            if e.text == Key.RightArrow || e.text == Key.UpArrow { nudge(value + key-step); return accept; }
            if e.text == Key.PageDown { nudge(value - key-step * 5); return accept; }
            if e.text == Key.PageUp { nudge(value + key-step * 5); return accept; }
            if e.text == Key.Home { nudge(from); return accept; }
            if e.text == Key.End { nudge(to); return accept; }
            reject
        }
    }
    SFocusRing { shown: fs.has-focus; radius: root.height / 2 + 4px; }
    if !Theme.material: Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.toggle-off;
        Rectangle {
            x: 0;
            width: parent.width * root.ratio;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    if !Theme.material: Rectangle {
        x: root.ratio * (root.width - 18px);
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: white;
        border-width: 1px;
        border-color: #00000026;
    }
    if Theme.material: Rectangle {
        property <length> hw: ta.pressed || fs.has-focus ? 2px : 4px;
        animate hw { duration: 100ms; }
        property <length> hx: root.ratio * (self.width - hw);
        if parent.width > 0: Rectangle {
            x: 0;
            y: (parent.height - 16px) / 2;
            width: max(0px, parent.hx - 6px);
            height: 16px;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
            border-top-right-radius: 2px;
            border-bottom-right-radius: 2px;
            background: root.enabled ? Theme.m3-primary : Theme.m3-on-surface.with-alpha(0.38);
        }
        Rectangle {
            x: parent.hx + parent.hw + 6px;
            y: (parent.height - 16px) / 2;
            width: max(0px, parent.width - self.x);
            height: 16px;
            border-top-left-radius: 2px;
            border-bottom-left-radius: 2px;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
            background: root.enabled ? Theme.m3-secondary-container : Theme.m3-on-surface.with-alpha(0.12);
            if parent.width - self.x > 12px: Rectangle {
                x: parent.width - 10px;
                y: (parent.height - 4px) / 2;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Theme.m3-primary;
            }
        }
        Rectangle {
            x: parent.hx;
            width: parent.hw;
            border-radius: self.width / 2;
            background: root.enabled ? Theme.m3-primary : Theme.m3-on-surface.with-alpha(0.38);
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        function at(x: length) -> float {
            snap(from + max(0, min(1, x / max(1px, root.width))) * (to - from))
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                fs.focus();
                root.drag-value = at(self.mouse-x);
                root.moved(root.drag-value);
            }
        }
        moved => {
            if self.pressed {
                let v = at(self.mouse-x);
                if v != root.drag-value {
                    root.drag-value = v;
                    root.moved(v);
                }
            }
        }
    }
}

// A slider with a word under each end (WordSlider.qml)
export component SWordSlider inherits VerticalLayout {
    in property <float> value;
    in property <float> from: 0;
    in property <float> to: 1;
    in property <float> step: 0;
    in property <string> low;
    in property <string> high;
    in property <bool> enabled: true;
    in property <string> label;
    callback moved(float);
    spacing: 2px;
    SSlider {
        value: root.value;
        from: root.from;
        to: root.to;
        step: root.step;
        enabled: root.enabled;
        label: root.label;
        moved(v) => { root.moved(v); }
    }
    HorizontalLayout {
        Text { text: root.low; color: Theme.tertiary; font-size: Theme.caption; accessible-role: AccessibleRole.none; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.high; color: Theme.tertiary; font-size: Theme.caption; accessible-role: AccessibleRole.none; }
    }
}

// ── Segmented (Segmented.qml): natural widths, the rest shared ──────────
export component SSegmented {
    in property <[SOpt]> opts;
    in property <int> current;
    in property <bool> enabled: true;
    in property <string> label;
    callback selected(int);
    // (Glass: the chosen one's pill slides there)
    property <length> ix;
    property <length> iw;
    property <bool> placed;
    animate ix, iw { duration: placed ? SM.popover : 0ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    height: Theme.material ? 36px : 30px;
    opacity: enabled || Theme.material ? 1 : 0.45;
    accessible-role: AccessibleRole.tab-list;
    accessible-label: label;
    forward-focus: fs;
    function step(d: int) {
        let i = current + d;
        if i >= 0 && i < opts.length && !opts[i].off { selected(i); }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.LeftArrow || e.text == Key.UpArrow { step(-1); return accept; }
            if e.text == Key.RightArrow || e.text == Key.DownArrow { step(1); return accept; }
            if e.text == Key.Home { selected(0); return accept; }
            if e.text == Key.End { selected(opts.length - 1); return accept; }
            reject
        }
    }
    SFocusRing { shown: fs.has-focus; radius: root.height / 2; }
    Rectangle {
        border-radius: self.height / 2;
        background: Theme.material ? transparent : Theme.toggle-off;
    }
    if !Theme.material: Rectangle {
        x: root.ix;
        y: 2px;
        width: root.iw;
        height: parent.height - 4px;
        border-radius: self.height / 2;
        background: Theme.dark ? #ffffff33 : white;
    }
    HorizontalLayout {
        padding: 2px;
        spacing: Theme.material ? 2px : 0;
        for o[i] in opts: seg := Rectangle {
            property <bool> chosen: i == root.current;
            property <bool> usable: root.enabled && !o.off;
            horizontal-stretch: 1;
            min-width: 24px;
            preferred-width: t.preferred-width + 24px;
            init => {
                if chosen { root.ix = self.x; root.iw = self.width; }
            }
            changed chosen => { if chosen { root.placed = true; root.ix = self.x; root.iw = self.width; } }
            changed width => { if chosen { root.ix = self.x; root.iw = self.width; } }
            changed x => { if chosen { root.ix = self.x; root.iw = self.width; } }
            accessible-role: AccessibleRole.tab;
            accessible-label: o.text;
            accessible-item-selected: chosen;
            accessible-action-default => { root.selected(i); }
            if Theme.material: Rectangle {
                property <length> full: self.height / 2;
                property <length> inner: chosen ? full : sa.pressed ? 4px : 8px;
                property <length> lr: i == 0 ? full : inner;
                property <length> rr: i == root.opts.length - 1 ? full : inner;
                animate lr, rr { duration: 300ms; easing: spring(0.54); }
                border-top-left-radius: max(0px, min(full, lr));
                border-bottom-left-radius: max(0px, min(full, lr));
                border-top-right-radius: max(0px, min(full, rr));
                border-bottom-right-radius: max(0px, min(full, rr));
                background: !root.enabled ? Theme.m3-on-surface.with-alpha(chosen ? 0.12 : 0.06) : chosen ? Theme.m3-primary : Theme.m3-surface-container-highest;
                animate background { duration: 150ms; }
                Rectangle {
                    border-top-left-radius: parent.border-top-left-radius;
                    border-bottom-left-radius: parent.border-bottom-left-radius;
                    border-top-right-radius: parent.border-top-right-radius;
                    border-bottom-right-radius: parent.border-bottom-right-radius;
                    background: (chosen ? Theme.m3-on-primary : Theme.m3-on-surface-variant).with-alpha(sa.pressed ? 0.1 : sa.has-hover ? 0.08 : 0);
                }
            }
            t := Text {
                width: min(self.preferred-width, parent.width - 12px);
                text: o.text;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: Theme.material ? Theme.body : Theme.small;
                font-weight: Theme.material ? 500 : 600;
                color: Theme.material ? (!usable ? Theme.m3-on-surface.with-alpha(0.38) : chosen ? Theme.m3-on-primary : Theme.m3-on-surface-variant)
                    : !usable ? Theme.tertiary : chosen ? Theme.label : Theme.secondary;
                accessible-role: AccessibleRole.none;
            }
            sa := TouchArea {
                enabled: usable;
                mouse-cursor: pointer;
                clicked => {
                    fs.focus();
                    fs.clear-focus();
                    root.selected(i);
                }
            }
        }
    }
}

// ── A field's look: Material's filled field (FilledField.qml) ───────────
export component SFilled inherits Rectangle {
    in property <bool> active;
    in property <bool> hovered;
    in property <bool> error;
    border-radius: min(self.height / 2, 28px);
    background: hovered && !active ? Theme.m3-surface-container-highest.mix(Theme.m3-on-surface, 0.92) : Theme.m3-surface-container-highest;
    border-width: active || error ? 2px : 0;
    border-color: error ? Theme.m3-error : Theme.m3-primary;
    animate background { duration: SM.hover; }
}

// ── Choice / Dropdown (Choice.qml): its list opens in the window's menu ─
export component SChoice {
    in property <string> cid;
    in property <[SOpt]> opts;
    in property <int> current;
    in property <string> placeholder: "Choose";
    in property <bool> enabled: true;
    in property <bool> open;
    in property <string> label;
    property <string> said: current >= 0 && current < opts.length ? opts[current].text : placeholder;
    min-width: max(Theme.material ? 140px : 96px, lt.preferred-width + (Theme.material ? 52px : 40px));
    preferred-width: self.min-width;
    height: Theme.material ? 40px : 28px;
    opacity: enabled ? 1 : Theme.material ? 0.38 : 0.45;
    accessible-role: AccessibleRole.combobox;
    accessible-label: label;
    accessible-value: said;
    accessible-action-default => { show(); }
    function show() {
        SBus.menu(cid, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
    }
    forward-focus: fs;
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return || e.text == Key.DownArrow { show(); return accept; }
            reject
        }
    }
    SFocusRing { shown: fs.has-focus; radius: Theme.material ? root.height / 2 : Theme.radius-control - 2px; }
    if Theme.material: SFilled { active: root.open; hovered: ta.has-hover; }
    if !Theme.material: Rectangle {
        border-radius: Theme.radius-control - 2px;
        background: ta.pressed ? Theme.fill-pressed : ta.has-hover || root.open ? Theme.fill-hover : Theme.fill;
        animate background { duration: SM.hover; }
    }
    lt := Text {
        x: Theme.material ? 16px : 10px;
        width: parent.width - self.x - (Theme.material ? 34px : 25px);
        text: said;
        overflow: elide;
        vertical-alignment: center;
        color: current >= 0 ? Theme.label : Theme.secondary;
        font-size: Theme.material ? 14px : Theme.body;
        accessible-role: AccessibleRole.none;
    }
    SIcon {
        x: parent.width - self.width - 8px;
        g: Theme.material ? SG.caret-down : SG.caret-up-down;
        bold: !Theme.material;
        size: Theme.material ? 20px : 11px;
        color: Theme.secondary;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { show(); }
    }
}

// ── Button (SettingsButton.qml) ─────────────────────────────────────────
// style: 0 normal, 1 primary, 2 danger, 3 minor; an icon alone: a round
// icon button (the dock's remove)
export component SButton {
    in property <string> text;
    in property <SIc> icon;
    in property <int> style;
    in property <bool> busy;
    in property <bool> enabled: true;
    in property <string> label; // (what it's for, for screen readers: its row's label)
    callback clicked();
    property <bool> active: enabled && !busy;
    property <bool> round: text == "" && (icon.p != "" || icon.m != "");
    property <color> m3-container: !enabled ? Theme.m3-on-surface.with-alpha(0.12) : style == 1 ? Theme.m3-primary : style == 2 ? Theme.m3-error-container : style == 3 ? transparent : Theme.m3-secondary-container;
    property <color> m3-content: !enabled ? Theme.m3-on-surface.with-alpha(0.38) : style == 1 ? Theme.m3-on-primary : style == 2 ? Theme.m3-on-error-container : style == 3 ? Theme.m3-primary : Theme.m3-on-secondary-container;
    property <float> layer: ta.pressed ? 0.1 : ta.has-hover ? 0.08 : 0;
    property <color> ink: Theme.material ? m3-content : style == 1 ? Theme.on-accent : style == 2 ? Theme.danger : Theme.label;
    width: round ? (Theme.material ? 40px : 26px) : row.preferred-width + (Theme.material ? (style == 3 ? 24px : 32px) : 24px);
    height: round ? self.width : Theme.material ? 40px : 28px;
    opacity: Theme.material || enabled ? 1 : 0.45;
    accessible-role: AccessibleRole.button;
    accessible-label: text != "" ? text : label;
    accessible-description: label;
    accessible-enabled: active;
    accessible-action-default => { if active { clicked(); } }
    forward-focus: fs;
    fs := FocusScope {
        key-pressed(e) => {
            if active && !e.repeat && (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; }
            reject
        }
    }
    SFocusRing { shown: fs.has-focus; radius: bg.border-radius; }
    bg := Rectangle {
        x: Theme.material ? 0 : (parent.width - self.width) / 2;
        y: Theme.material ? 0 : (parent.height - self.height) / 2;
        width: Theme.material ? parent.width : parent.width * (ta.pressed ? 0.97 : 1);
        height: Theme.material ? parent.height : parent.height * (ta.pressed ? 0.97 : 1);
        animate width, height { duration: SM.press; }
        border-radius: Theme.material ? (ta.pressed && !round ? 8px : self.height / 2) : round ? self.height / 2 : Theme.radius-control;
        animate border-radius { duration: 300ms; easing: spring(0.6); }
        background: Theme.material ? (style == 3 ? m3-content.with-alpha(layer) : m3-container.mix(m3-content, 1 - layer))
            : style == 1 ? (ta.pressed ? Theme.accent.darker(0.2) : ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent)
            : ta.pressed ? Theme.fill-pressed : ta.has-hover ? Theme.fill-hover : Theme.fill;
        animate background { duration: SM.hover; }
    }
    row := HorizontalLayout {
        alignment: center;
        spacing: Theme.material ? 8px : 6px;
        if busy && Theme.material: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                Busy { transform-scale: 0.45; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
        }
        if busy && !Theme.material: SIcon {
            g: SG.notch;
            bold: true;
            size: 12px;
            color: ink;
            property <duration> t: animation-tick();
            transform-rotation: mod(t / 900ms, 1) * 360deg;
        }
        if !busy && (icon.p != "" || icon.m != ""): SIcon {
            g: icon;
            bold: !Theme.material;
            size: round ? (Theme.material ? 20px : 12px) : Theme.material ? 18px : 12px;
            color: ink;
        }
        if text != "": Text {
            text: root.text;
            color: ink;
            vertical-alignment: center;
            font-size: Theme.material ? 14px : Theme.small;
            font-weight: Theme.material ? 500 : style == 1 ? 600 : 500;
            letter-spacing: Theme.material ? 0.1px : 0;
            accessible-role: AccessibleRole.none;
        }
    }
    ta := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            fs.clear-focus();
            root.clicked();
        }
    }
}

// ── TextField (TextField.qml): commits on Enter and when it loses focus ─
export component SField {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> secret;
    in property <bool> enabled: true;
    in property <string> label;
    out property <bool> editing: input.has-focus;
    callback edited(string);
    callback committed(string);
    // (typed in, the field keeps its own text; a new one from the page
    // replaces it: a value read again, a field cleared after saving)
    changed text => { input.text = root.text; }
    preferred-width: 220px;
    height: Theme.material ? 40px : 28px;
    opacity: enabled ? 1 : 0.45;
    if Theme.material: SFilled { active: input.has-focus; hovered: ta.has-hover; }
    if !Theme.material: Rectangle {
        border-radius: Theme.radius-control - 2px;
        background: Theme.fill;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.separator;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    Rectangle {
        x: Theme.material ? 16px : 10px;
        width: parent.width - 2 * self.x;
        clip: true;
        input := TextInput {
            width: 100%;
            height: 100%;
            text: root.text;
            enabled: root.enabled;
            vertical-alignment: center;
            single-line: true;
            input-type: root.secret ? InputType.password : InputType.text;
            color: Theme.label;
            selection-background-color: Theme.material ? Theme.m3-primary.with-alpha(0.3) : Theme.accent.with-alpha(0.4);
            font-size: Theme.body;
            accessible-label: root.label != "" ? root.label : root.placeholder;
            edited => { root.edited(self.text); }
            accepted => { root.committed(self.text); }
            changed has-focus => {
                if !self.has-focus { root.committed(self.text); }
            }
        }
        if input.text == "" && !input.has-focus: Text {
            width: 100%;
            height: 100%;
            text: root.placeholder;
            color: Theme.tertiary;
            font-size: Theme.body;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: AccessibleRole.none;
        }
    }
}

// ── Chip (Chip.qml) ─────────────────────────────────────────────────────
export component SChip {
    in property <string> text;
    in property <bool> on;
    in property <bool> solid: true;
    in property <bool> enabled: true;
    callback clicked();
    property <bool> ticked: Theme.material && on;
    property <float> layer: ta.pressed ? 0.1 : ta.has-hover ? 0.08 : 0;
    width: t.preferred-width + (Theme.material ? (ticked ? 8px + 18px + 8px + 16px : 32px) : 20px);
    height: Theme.material ? 32px : 26px;
    opacity: enabled ? 1 : Theme.material ? 0.38 : 0.45;
    accessible-role: AccessibleRole.checkbox;
    accessible-label: text;
    accessible-checked: on;
    accessible-action-default => { clicked(); }
    Rectangle {
        border-radius: Theme.material ? 8px : self.height / 2;
        background: Theme.material ? (on ? Theme.m3-secondary-container.mix(Theme.m3-on-secondary-container, 1 - layer) : Theme.m3-on-surface-variant.with-alpha(layer))
            : on ? (solid ? (ta.pressed ? Theme.accent.darker(0.15) : Theme.accent) : Theme.accent-tint)
            : ta.pressed ? Theme.fill-pressed : ta.has-hover ? Theme.fill-hover : Theme.fill;
        border-width: Theme.material ? (on ? 0 : 1px) : on && !solid ? 1px : 0;
        border-color: Theme.material ? Theme.m3-outline-variant : Theme.accent;
        animate background { duration: SM.hover; }
    }
    if ticked: SIcon {
        x: 8px;
        g: SG.check;
        size: 18px;
        color: Theme.m3-on-secondary-container;
    }
    t := Text {
        x: ticked ? parent.width - 16px - self.width : (parent.width - self.width) / 2;
        width: self.preferred-width;
        text: root.text;
        vertical-alignment: center;
        color: Theme.material ? (on ? Theme.m3-on-secondary-container : Theme.m3-on-surface-variant) : on && solid ? Theme.on-accent : Theme.label;
        font-size: Theme.material ? 14px : Theme.small;
        font-weight: 500;
        accessible-role: AccessibleRole.none;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── A colour swatch (Appearance's accent and seed colours) ──────────────
export component SSwatch inherits Rectangle {
    in property <SOpt> o;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: o.color;
    border-width: o.on ? 3px : 0;
    border-color: Theme.material ? Theme.label : Theme.dark ? white : #00000080;
    accessible-role: AccessibleRole.radio-button;
    accessible-label: o.text;
    accessible-checked: o.on;
    accessible-action-default => { clicked(); }
    if o.icon.p != "": SIcon { g: o.icon; fill: true; size: 11px; color: white; }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
