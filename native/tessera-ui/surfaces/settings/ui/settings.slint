// Settings (rust.surfaces: settings): the window, its sidebar and search,
// and the page Rust builds as blocks of rows (src/surfaces/settings).
// Compare shell/modules/settings: Settings.qml (the window's logic),
// SettingsGlass.qml (a translucent sidebar beside the pane) and
// SettingsMaterial.qml (Android's two panes), Group.qml, Row.qml,
// SubpageLink.qml, MoreOptions.qml, PagePart.qml, ActionMenu.qml, Toast.qml.
// The controls are settings-kit.slint's; the views only some pages have
// (previews, lists, editors) are each page group's own file below.

import { Theme } from "@tessera/theme.slint";
import { Busy } from "@tessera/widgets.slint";
import { SIc, SOpt, SetRow, SBlock, SPage, SSection, SResult, SBus, SG, SM, SIcon, SFocusRing, SSwitch, SSlider, SWordSlider, SSegmented, SChoice, SButton, SField, SChip, SSwatch, SFilled } from "settings-kit.slint";
import { LookBlock, LookCtl } from "settings-look.slint";
import { NotifyBlock, NotifyCtl } from "settings-notify.slint";
import { DevicesBlock, DevicesCtl } from "settings-devices.slint";
import { InputBlock, InputCtl } from "settings-input.slint";
import { AccountsBlock, AccountsCtl } from "settings-accounts.slint";
import { SystemBlock, SystemCtl } from "settings-system.slint";
import { AboutBlock, AboutCtl } from "settings-about.slint";

export { SIc, SOpt, SetRow, SBlock, SPage, SSection, SResult, SBus }

// ── A row's control (Row.qml's slot) ────────────────────────────────────
component Control {
    in property <SetRow> r;
    in property <string> menu-open; // the id whose list is open
    property <length> w: r.width > 0 ? r.width : 220px;
    // a custom control that sizes itself (a slider, a check, buttons), not a whole-row one
    property <bool> inline: (r.group == "devices" && (r.sub == "level" || r.sub == "btn-switch" || r.sub == "check" || r.sub == "signal"))
        || (r.group == "notify" && (r.sub == "sound" || r.sub == "days" || r.sub == "stepper" || r.sub == "size" || r.sub == "entry" || r.sub == "icons"))
        || (r.group == "accounts" && (r.sub == "field" || r.sub == "source"))
        || (r.group == "system" && (r.sub == "pick-add" || r.sub == "energy"))
        // (About's row controls all size themselves: Health's status spilled past the card)
        || r.group == "about";
    // (in a layout, so the row reserves what the control takes: a long
    // label no longer pushes it past the row's edge)
    min-width: body.min-width;
    preferred-width: body.preferred-width;
    min-height: body.min-height;
    preferred-height: body.preferred-height;
    body := HorizontalLayout {
        alignment: end;
        if r.control == "switch": SSwitch {
            on: r.on;
            enabled: r.enabled;
            label: r.label;
            toggled => { SBus.act(r.id, 0, 0, "toggle"); }
        }
        if r.control == "slider" && r.low == "" && r.high == "": SSlider {
            width: w;
            value: r.num;
            from: r.from;
            to: r.to;
            step: r.step;
            enabled: r.enabled;
            label: r.label;
            moved(v) => { SBus.act(r.id, 0, v, ""); }
            // (let go: i 1, the page may act on it: a sound at the level)
            released(v) => { SBus.act(r.id, 1, v, ""); }
        }
        if r.control == "slider" && (r.low != "" || r.high != ""): SWordSlider {
            width: w;
            value: r.num;
            from: r.from;
            to: r.to;
            step: r.step;
            low: r.low;
            high: r.high;
            enabled: r.enabled;
            label: r.label;
            moved(v) => { SBus.act(r.id, 0, v, ""); }
            released(v) => { SBus.act(r.id, 1, v, ""); }
        }
        if r.control == "segmented": SSegmented {
            width: r.width > 0 ? r.width : self.preferred-width;
            opts: r.opts;
            current: r.index;
            enabled: r.enabled;
            label: r.label;
            selected(i) => { SBus.act(r.id, i, 0, ""); }
        }
        if r.control == "choice": SChoice {
            width: r.width > 0 ? r.width : self.preferred-width;
            cid: r.id;
            opts: r.opts;
            current: r.index;
            placeholder: r.placeholder != "" ? r.placeholder : "Choose";
            enabled: r.enabled;
            dropdown: mod(r.style, 16) >= 8;
            open: root.menu-open == r.id;
            label: r.label;
        }
        if r.control == "button": SButton {
            text: r.text;
            // (no icon: r.icon is the row's own, drawn before its label)
            style: r.style;
            busy: r.busy;
            enabled: r.enabled;
            label: r.label;
            compact: r.secret;
            clicked => { SBus.act(r.id, 0, 0, ""); }
        }
        if r.control == "buttons": HorizontalLayout {
            spacing: 8px;
            alignment: end;
            for o[i] in r.opts: VerticalLayout {
                alignment: center;
                SButton {
                    text: o.text;
                    icon: o.icon;
                    style: o.style;
                    busy: o.on;
                    enabled: r.enabled && !o.off;
                    label: r.label;
                    clicked => { SBus.act(r.id, i, 0, ""); }
                }
            }
        }
        if r.control == "field": SField {
            width: w;
            text: r.text;
            placeholder: r.placeholder;
            secret: r.secret;
            enabled: r.enabled;
            label: r.label;
            edited(t) => { SBus.act(r.id, 0, 0, t); }
            committed(t) => { SBus.act(r.id, 1, 0, t); }
        }
        if r.control == "path": HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                SField {
                    width: r.width > 0 ? r.width : 200px;
                    text: r.text;
                    placeholder: r.placeholder;
                    enabled: r.enabled;
                    label: r.label;
                    committed(t) => { SBus.act(r.id, 1, 0, t); }
                }
            }
            VerticalLayout {
                alignment: center;
                SButton {
                    text: r.busy || SBus.picker-busy ? "Choosing…" : "Choose…";
                    enabled: r.enabled && !r.busy && !SBus.picker-busy;
                    label: r.label;
                    clicked => { SBus.act(r.id, 2, 0, ""); }
                }
            }
        }
        // (style: 1 solid chips, 2 wrapped onto lines (a QML Flow) within
        // the row's width: each chip's line in its num, the lines in r.num)
        if r.control == "chips" && mod(r.style, 4) < 2: HorizontalLayout {
            spacing: 6px;
            alignment: end;
            for o[i] in r.opts: VerticalLayout {
                alignment: center;
                SChip {
                    text: o.text;
                    on: o.on;
                    solid: mod(r.style, 2) == 1;
                    enabled: r.enabled && !o.off;
                    clicked => { SBus.act(r.id, i, 0, ""); }
                }
            }
        }
        if r.control == "chips" && mod(r.style, 4) >= 2: VerticalLayout {
            width: w;
            spacing: 6px;
            for line in round(r.num): HorizontalLayout {
                // (no spacing: the other lines' chips leave empty places)
                spacing: 0;
                alignment: start;
                for o[i] in r.opts: VerticalLayout {
                    alignment: center;
                    padding-right: round(o.num) == line ? 6px : 0;
                    if round(o.num) == line: SChip {
                        text: o.text;
                        on: o.on;
                        solid: mod(r.style, 2) == 1;
                        enabled: r.enabled && !o.off;
                        clicked => { SBus.act(r.id, i, 0, ""); }
                    }
                }
            }
        }
        if r.control == "swatches": HorizontalLayout {
            spacing: 8px;
            alignment: end;
            for o[i] in r.opts: VerticalLayout {
                alignment: center;
                SSwatch {
                    o: o;
                    clicked => { SBus.act(r.id, i, 0, ""); }
                }
            }
        }
        if r.control == "value": Text {
            text: r.value;
            color: Theme.secondary;
            font-size: 13px; // (the pages' value Texts: Theme.font.body, 13 in both looks)
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        if r.control == "spinner": Busy {}
        if r.control == "custom" && r.group == "look": LookCtl { r: r; }
        // (the controls that size themselves: in the layout, so the row
        // reserves their width; outside it they spilled past the card: Scan
        // again, Sound's level and check mark)
        if r.control == "custom" && inline && r.group == "devices": DevicesCtl { r: r; }
        if r.control == "custom" && inline && r.group == "notify": NotifyCtl { r: r; }
        if r.control == "custom" && inline && r.group == "accounts": AccountsCtl { r: r; }
        if r.control == "custom" && inline && r.group == "system": SystemCtl { r: r; }
        if r.control == "custom" && inline && r.group == "about": AboutCtl { r: r; }
    }
    // (outside the layout: the whole-row ones size themselves from the row,
    // and inside it they would size the row from themselves, a loop)
    if r.control == "custom" && !inline && r.group == "notify": NotifyCtl { r: r; }
    if r.control == "custom" && !inline && r.group == "devices": DevicesCtl { r: r; }
    if r.control == "custom" && r.group == "input": InputCtl { r: r; }
    if r.control == "custom" && !inline && r.group == "accounts": AccountsCtl { r: r; }
    if r.control == "custom" && !inline && r.group == "system": SystemCtl { r: r; }
}

// Where a search result landed: it says where it is (the page scrolls
// there) and a ring fades in and out (Glass: the accent ring; Material: a
// primary tint, as Android marks the setting a search opened)
component Flash inherits Rectangle {
    in property <bool> on;
    property <float> shown: on ? 1 : 0;
    animate shown { duration: on ? 150ms : 400ms; easing: on ? ease-out : ease-in; }
    function tell() {
        SBus.reveal-y = self.absolute-position.y;
        SBus.reveal-h = self.height;
        SBus.reveal-seq += 1;
        my-seq = SBus.reveal-seq;
    }
    property <int> my-seq: -1;
    property <bool> mine; // (the one shown last)
    changed on => { if on { mine = true; tell(); } }
    // (made already on: a row made anew with the page says so too)
    init => { if on { mine = true; tell(); } }
    // (the page still settling after, rows coming in above it as their
    // data arrives (Wi-Fi's networks): scrolled there again for a few
    // seconds, as Settings.qml's revealSettle; Bluetooth was left short)
    property <length> page-h: SBus.page-h;
    changed page-h => { if mine && my-seq == SBus.reveal-seq && (on || SBus.reveal-hold) { tell(); } }
    // (it fills what it's in; the ring reaches 4 px past its sides)
    background: transparent;
    Rectangle {
        x: -4px;
        width: root.width + 8px;
        border-radius: Theme.material ? 16px : 12px;
        background: Theme.material ? Theme.m3-primary.with-alpha(0.16 * root.shown) : transparent;
        border-width: 2px;
        border-color: (Theme.material ? Theme.m3-primary : Theme.accent).with-alpha(root.shown);
    }
}

// A wrapped text in a block (a footer, a note, a part's heading) that
// asks for the height it takes at the page's width: a wrapped Text in a
// layout was measured as one line, so the page came out short (the last
// rows past its end, a search hit scrolled short of its place)
component WrapText {
    in property <string> text;
    in property <color> color;
    in property <length> font-size;
    in property <int> font-weight: 400;
    in property <length> letter-spacing;
    in property <length> avail; // the width it wraps at
    min-height: mt.preferred-height;
    preferred-height: mt.preferred-height;
    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        wrap: word-wrap;
        vertical-alignment: top;
        color: root.color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
    }
    mt := Text {
        visible: false;
        width: root.avail;
        text: root.text;
        wrap: word-wrap;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        accessible-role: none;
    }
}

// ── A row (Row.qml / SubpageLink.qml), with Material's tile ─────────────
component RowView {
    in property <SetRow> r;
    in property <bool> first;
    in property <bool> last;
    in property <string> menu-open;
    property <length> pad: Theme.material ? 20px : 14px;
    property <bool> link: r.kind == "link";
    property <bool> has-icon: r.icon.p != "" || r.icon.m != "";
    min-height: max(r.kind == "custom" ? 0 : Theme.material ? 56px : 44px, body.preferred-height);
    // Material: the row's tile, the group's outer corners round
    if Theme.material && r.kind != "custom": Rectangle {
        border-top-left-radius: first ? 24px : 4px;
        border-top-right-radius: first ? 24px : 4px;
        border-bottom-left-radius: last ? 24px : 4px;
        border-bottom-right-radius: last ? 24px : 4px;
        background: hover.has-hover ? Theme.m3-surface-container-high.mix(Theme.m3-on-surface, 0.92) : Theme.m3-surface-container-high;
        animate background { duration: SM.hover; }
    }
    // Glass: a hairline above every row but the first; a link's hover fill
    if !Theme.material && !first: Rectangle {
        x: 14px;
        y: 0;
        width: parent.width - 28px;
        height: 1px;
        background: Theme.separator;
    }
    if !Theme.material && link: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 8px;
        background: hover.pressed ? Theme.fill-hover : hover.has-hover ? Theme.fill : transparent;
        animate background { duration: SM.hover; }
    }
    hover := TouchArea {
        opacity: r.faded ? 0.5 : 1;
        mouse-cursor: link ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if link && r.enabled { SBus.act(r.id, 0, 0, ""); } }
        // (in a layout, so the row grows with what it holds: a TouchArea
        // is no layout, and the row stayed at its minimum height)
        body := VerticalLayout {
            if r.kind == "custom" && r.group == "look": LookCtl { r: r; }
            if r.kind == "custom" && r.group == "notify": NotifyCtl { r: r; }
            if r.kind == "custom" && r.group == "devices": DevicesCtl { r: r; }
            if r.kind == "custom" && r.group == "input": InputCtl { r: r; }
            if r.kind == "custom" && r.group == "accounts": AccountsCtl { r: r; }
            if r.kind == "custom" && r.group == "system": SystemCtl { r: r; }
            if r.kind == "custom" && r.group == "about": AboutCtl { r: r; }
            if r.kind == "text": HorizontalLayout {
                padding-left: pad;
                padding-right: pad;
                padding-top: Theme.material ? 14px : 10px;
                padding-bottom: Theme.material ? 14px : 10px;
                WrapText {
                    avail: root.width - 2 * pad;
                    text: r.label;
                    color: r.tone == 2 ? Theme.danger : r.tone == 0 ? Theme.label : Theme.secondary;
                    font-size: Theme.material ? 14px : Theme.small;
                }
            }
            if r.kind == "row" || r.kind == "link": HorizontalLayout {
                // (the text column's width, worked out from the parts beside
                // it: a wrapped Text in a layout is measured at the width it's
                // handed, or its own; nested here it got the row's, so a long
                // description was given one line and spilled into the next row)
                property <bool> has-ctl: !link && r.control != "";
                property <length> text-w: max(40px, root.width - self.padding-left - self.padding-right
                    - iconbox.preferred-width - linkbox.preferred-width - ctlbox.preferred-width - textcol.padding-right);
                padding-left: pad;
                padding-right: link ? (Theme.material ? 16px : 12px) : pad;
                spacing: 0;
                iconbox := VerticalLayout {
                    // (a layout stretches by default: empty, it still took a share
                    // of the spare width and pushed the text right)
                    horizontal-stretch: 0;
                    alignment: center;
                    padding-right: !has-icon ? 0 : link ? (Theme.material ? 16px : 10px) : (Theme.material ? 16px : 12px);
                    if has-icon: SIcon {
                        g: r.icon;
                        size: link ? (Theme.material ? 24px : 18px) : Theme.material ? 24px : 20px;
                        color: link ? Theme.secondary : Theme.material ? Theme.m3-on-surface-variant : Theme.tertiary;
                    }
                }
                textcol := VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    padding-top: Theme.material ? 12px : 10px;
                    padding-bottom: Theme.material ? 12px : 10px;
                    padding-right: link ? 12px : r.control != "" ? (Theme.material ? 16px : 12px) : 0;
                    // (each a box as tall as its text wrapped at text-w, measured
                    // by a hidden copy: only heights flow back, no width loop)
                    Rectangle {
                        min-height: ml.preferred-height;
                        Text {
                            // (pinned to its box: a Text left to size itself takes
                            // its one-line width and is centred in its parent)
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: r.label;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            color: r.tone == 1 ? Theme.secondary : r.tone == 2 ? Theme.danger : r.tone == 3 ? Theme.success : r.tone == 4 ? (Theme.material ? Theme.m3-primary : Theme.accent-ink) : Theme.label;
                            font-size: Theme.material ? 16px : Theme.body;
                        }
                        ml := Text {
                            visible: false;
                            width: text-w;
                            text: r.label;
                            wrap: word-wrap;
                            font-size: Theme.material ? 16px : Theme.body;
                            accessible-role: none;
                        }
                    }
                    if r.detail != "": Rectangle {
                        min-height: md.preferred-height;
                        Text {
                            // (pinned to its box: a Text left to size itself takes
                            // its one-line width and is centred in its parent)
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: r.detail;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            color: Theme.secondary;
                            font-size: Theme.material ? 14px : Theme.caption;
                        }
                        md := Text {
                            visible: false;
                            width: text-w;
                            text: r.detail;
                            wrap: word-wrap;
                            font-size: Theme.material ? 14px : Theme.caption;
                            accessible-role: none;
                        }
                    }
                }
                linkbox := HorizontalLayout {
                    // (a layout stretches by default: empty, it still took a share
                    // of the spare width and pushed the text right)
                    horizontal-stretch: 0;
                    spacing: link && r.value != "" ? (Theme.material ? 8px : 6px) : 0;
                    if link && r.value != "": Text {
                        text: r.value;
                        vertical-alignment: center;
                        color: Theme.secondary;
                        font-size: Theme.material ? 14px : Theme.body;
                        accessible-role: AccessibleRole.none;
                    }
                    if link: VerticalLayout {
                        alignment: center;
                        SIcon {
                            g: SG.caret-right;
                            bold: !Theme.material;
                            size: Theme.material ? 24px : 12px;
                            color: Theme.tertiary;
                        }
                    }
                }
                ctlbox := VerticalLayout {
                    // (a layout stretches by default: empty, it still took a share
                    // of the spare width and pushed the text right)
                    horizontal-stretch: 0;
                    alignment: center;
                    padding-top: has-ctl ? 8px : 0;
                    padding-bottom: has-ctl ? 8px : 0;
                    if has-ctl: Control { r: r; menu-open: root.menu-open; }
                }
            }
        }
    }
    // (a link is one button for screen readers)
    if link: Rectangle {
        accessible-role: AccessibleRole.button;
        accessible-label: r.label;
        accessible-description: r.detail;
        accessible-action-default => { SBus.act(r.id, 0, 0, ""); }
    }
    if link: Rectangle {
        lfs := FocusScope {
            key-pressed(e) => {
                if r.enabled && !e.repeat && (e.text == Key.Return || e.text == " ") { SBus.act(r.id, 0, 0, ""); return accept; }
                reject
            }
        }
        SFocusRing { shown: lfs.has-focus; radius: Theme.material ? 4px : 8px; }
    }
    Flash { on: r.flash; }
}

// ── A group (Group.qml): its caption, the platter, its footer ───────────
component GroupView inherits VerticalLayout {
    in property <SBlock> b;
    in property <string> menu-open;
    spacing: Theme.material ? 8px : 6px;
    opacity: b.dim ? 0.45 : 1;
    if b.title != "": Text {
        x: Theme.material ? 16px : 4px;
        text: b.title;
        color: Theme.material ? Theme.m3-primary : Theme.secondary;
        font-size: Theme.material ? 14px : Theme.small;
        font-weight: Theme.material ? 500 : 600;
        letter-spacing: Theme.material ? 0.1px : 0;
        accessible-role: AccessibleRole.text;
    }
    Rectangle {
        border-radius: 12px;
        background: Theme.material ? transparent : Theme.dark ? #ffffff0d : white;
        border-width: Theme.material ? 0 : 1px;
        border-color: Theme.separator;
        VerticalLayout {
            spacing: Theme.material ? 2px : 0;
            for row[i] in b.rows: RowView {
                r: row;
                first: i == 0;
                last: i == b.rows.length - 1;
                menu-open: root.menu-open;
            }
        }
        // (dimmed: its rows can't be used now)
        if b.dim: TouchArea {}
    }
    if b.footer != "": HorizontalLayout {
        padding-left: Theme.material ? 16px : 4px;
        padding-right: Theme.material ? 16px : 4px;
        WrapText {
            avail: SBus.page-width - (Theme.material ? 32px : 8px);
            text: b.footer;
            color: Theme.material ? Theme.m3-on-surface-variant : Theme.tertiary;
            font-size: Theme.material ? 12px : Theme.caption;
            letter-spacing: Theme.material ? 0.4px : 0;
        }
    }
}

// MoreOptions.qml's button: Glass a text button in the accent; Material a
// tonal pill
component MoreButton {
    in property <SBlock> b;
    height: 44px;
    accessible-role: AccessibleRole.button;
    accessible-label: b.on ? "Fewer options" : "More options";
    accessible-action-default => { SBus.act(b.id, 0, 0, ""); }
    forward-focus: fs;
    fs := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return { SBus.act(b.id, 0, 0, ""); return accept; }
            reject
        }
    }
    pill := Rectangle {
        x: Theme.material ? 0 : -4px;
        y: (parent.height - self.height) / 2;
        width: lr.preferred-width + (Theme.material ? 32px : 16px);
        height: Theme.material ? 40px : 30px;
        border-radius: self.height / 2;
        background: Theme.material ? Theme.m3-secondary-container.mix(Theme.m3-on-secondary-container, ta.pressed ? 0.9 : ta.has-hover ? 0.92 : 1) : ta.has-hover ? Theme.fill : transparent;
        animate background { duration: SM.hover; }
        SFocusRing { shown: fs.has-focus; radius: parent.border-radius; }
        lr := HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Text {
                text: b.on ? "Fewer options" : "More options";
                vertical-alignment: center;
                color: Theme.material ? Theme.m3-on-secondary-container : Theme.accent-ink;
                font-size: Theme.material ? 14px : Theme.body;
                font-weight: 500;
                accessible-role: AccessibleRole.none;
            }
            SIcon {
                g: SG.caret-down;
                bold: true;
                size: 12px;
                color: Theme.material ? Theme.m3-on-secondary-container : Theme.accent-ink;
                transform-rotation: b.on ? 180deg : 0deg;
                animate transform-rotation { duration: SM.hover; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { SBus.act(b.id, 0, 0, ""); }
        }
    }
}

// ── A block on the page ─────────────────────────────────────────────────
component BlockView inherits VerticalLayout {
    in property <SBlock> b;
    in property <string> menu-open;
    padding-top: b.above;
    if b.kind == "group": GroupView { b: b; menu-open: root.menu-open; }
    // A part's heading (PagePart.qml)
    if b.kind == "heading": Rectangle {
        HorizontalLayout {
            padding-top: Theme.material ? 16px : 12px;
            padding-left: Theme.material ? 0 : 4px;
            WrapText {
                avail: SBus.page-width - (Theme.material ? 0 : 4px);
                text: b.title;
                color: Theme.label;
                font-size: Theme.material ? 22px : Theme.title;
                font-weight: Theme.material ? 400 : 600;
            }
        }
        Flash { on: b.flash; }
    }
    if b.kind == "more": MoreButton { b: b; }
    if b.kind == "text": HorizontalLayout {
        padding-left: Theme.material ? 16px : 4px;
        padding-right: Theme.material ? 16px : 4px;
        WrapText {
            avail: SBus.page-width - (Theme.material ? 32px : 8px);
            text: b.text;
            color: Theme.material ? Theme.m3-on-surface-variant : Theme.secondary;
            font-size: Theme.material ? 14px : Theme.caption;
        }
    }
    if b.kind == "custom" && b.group == "look": LookBlock { b: b; }
    if b.kind == "custom" && b.group == "notify": NotifyBlock { b: b; }
    if b.kind == "custom" && b.group == "devices": DevicesBlock { b: b; }
    if b.kind == "custom" && b.group == "input": InputBlock { b: b; }
    if b.kind == "custom" && b.group == "accounts": AccountsBlock { b: b; }
    if b.kind == "custom" && b.group == "system": SystemBlock { b: b; }
    if b.kind == "custom" && b.group == "about": AboutBlock { b: b; }
}

// ── A page: its blocks. Kept once made (hidden while another shows), so
// going back to a page is instant; only the shown one sizes the scroller ──
component PageView inherits VerticalLayout {
    in property <bool> shown;
    in property <[SBlock]> blocks;
    in property <string> menu-open;
    alignment: start;
    property <length> h: self.preferred-height;
    changed h => { if shown { SBus.page-h = h; } }
    changed shown => { if shown { SBus.page-h = h; } }
    init => { if shown { SBus.page-h = h; } }
    for b in blocks: BlockView { b: b; menu-open: root.menu-open; }
}

// A thin overlay scrollbar (ScrollIndicator.qml): shown while the content
// scrolls (and 900 ms after) or the pointer is on it, fading out after;
// hidden when everything fits. Drag the thumb or click the track to move.
component ScrollBar inherits Rectangle {
    in-out property <length> content-y; // (two-way with the Flickable's content-y)
    in property <length> viewport-h;
    in property <length> visible-h;
    property <bool> needed: viewport-h > visible-h + 1px;
    property <length> span: max(1px, viewport-h - visible-h);
    property <bool> recent;
    property <bool> active: ta.has-hover || ta.pressed || recent;
    property <length> grab; // where in the thumb it was taken
    // (the list scrolled by a person: shown, and hidden 900 ms after)
    public function poke() {
        recent = true;
        idle.restart();
    }
    idle := Timer {
        interval: 900ms;
        running: false;
        triggered => {
            recent = false;
            self.running = false;
        }
    }
    width: 12px;
    background: transparent;
    visible: needed;
    thumb := Rectangle {
        x: (parent.width - self.width) / 2;
        width: ta.has-hover || ta.pressed ? 8px : 6px;
        animate width { duration: 150ms; }
        height: max(28px, parent.height * visible-h / max(1px, viewport-h));
        y: (parent.height - self.height) * max(0, min(1, -content-y / span));
        border-radius: self.width / 2;
        background: (Theme.dark ? #ffffff : #000000).with-alpha(ta.pressed ? 0.5 : 0.32);
        opacity: active ? 1 : 0;
        animate opacity { duration: active ? 150ms : 400ms; easing: ease-out; }
    }
    ta := TouchArea {
        function to(y: length) {
            content-y = -max(0px, min(span, (y - grab) / max(1px, root.height - thumb.height) * span));
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                // (on the thumb: dragged from where it was taken; on the
                // track: the thumb centres there)
                if self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height {
                    grab = self.mouse-y - thumb.y;
                } else {
                    grab = thumb.height / 2;
                    to(self.mouse-y);
                }
            }
        }
        moved => {
            if self.pressed {
                to(self.mouse-y);
                poke();
            }
        }
    }
}

// ── The window ──────────────────────────────────────────────────────────
export component SettingsWindow inherits Window {
    in property <length> win-w: 860px;
    in property <length> win-h: 620px;
    in property <length> radius: 20px;
    in property <[SSection]> sections;
    in property <[SResult]> results;
    in property <bool> searching; // a query is typed: results in place of the sections
    in property <[SPage]> pages; // the pages made so far, one shown
    in property <string> page-title; // the page's (a subpage's pageTitle, else its section's name)
    in property <string> crumb; // the section's name, on a subpage
    in property <bool> is-sub;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <string> section-id;
    // the menu open (a Choice's list, ActionMenu.qml: its own popup,
    // settings-menu.slint): whose it is, so that Choice shows itself open
    in property <bool> menu-open;
    in property <string> menu-id;
    // the toast (Toast.qml)
    in property <string> toast-text;
    in property <bool> toast-undo;
    in property <bool> toast-shown;
    in property <bool> spin: true; // (Material's open page cookie turns; not with Reduce motion)
    in property <string> cookie; // Material's cookie9 outline (shapes.rs), 0..100
    // the cookie's turn (24 s a round), stepped by Rust a few times a second:
    // animation-tick() redrew the whole window every frame while it was open
    in property <angle> spin-angle;
    // Material: where the open page's pill sits in the list (it springs
    // there when you change page, and is simply put there when the list is made)
    property <length> pill-y;
    // the search result the arrow keys are on (-1: none)
    property <int> res-cur: -1;
    property <bool> pill-placed;
    callback go(string);
    callback query(string);
    callback query-commit();
    callback back();
    callback forward();
    callback crumb-clicked();
    callback menu-pick(int);
    callback menu-dismiss();
    callback undo();
    callback close-window();
    callback drag(length, length);
    callback key-nav(int); // the sidebar's keys: -1 up, 1 down, -2 home, 2 end
    // a key for the open menu (it's its own popup; when the compositor
    // leaves the keyboard with this window, they come here)
    callback menu-key(string);

    public function page-changed() {
        page-scroll.content-y = 0;
    }
    public function focus-search() {
        search-input.focus();
    }
    public function clear-search() {
        search-input.text = "";
    }

    preferred-width: win-w;
    preferred-height: win-h;
    min-width: 640px;
    min-height: 480px;
    background: transparent;
    default-font-family: Theme.font;
    default-font-size: Theme.body;
    title: "Tessera Settings";

    // A search landed on a row: scroll it into view, 80 px from the top
    property <int> reveal-seq: SBus.reveal-seq;
    changed reveal-seq => {
        let top = SBus.reveal-y - page-scroll.absolute-position.y - page-scroll.content-y;
        page-scroll.content-y = -max(0px, min(page-scroll.content-height - page-scroll.height, top - 80px));
    }

    forward-focus: side-keys;
    keys := FocusScope {
        key-pressed(e) => {
            if menu-open && (e.text == Key.Escape || e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Return || e.text == " " || e.text == Key.Home || e.text == Key.End) {
                root.menu-key(e.text);
                return accept;
            }
            if e.modifiers.alt && e.text == Key.LeftArrow { root.back(); return accept; }
            if e.modifiers.alt && e.text == Key.RightArrow { root.forward(); return accept; }
            if e.modifiers.control && e.text == "f" { search-input.focus(); return accept; }
            if e.modifiers.control && e.text == "z" && toast-shown && toast-undo { root.undo(); return accept; }
            if e.text == Key.Escape {
                if menu-open { root.menu-dismiss(); return accept; }
                root.close-window();
                return accept;
            }
            reject
        }

    // (everything inside the window's keys: what a control doesn't take
    // comes up to them; the pages list's arrows are its own, side-keys)
    frame := Rectangle {
        clip: true;
        border-radius: root.radius;
        background: Theme.material ? Theme.m3-surface : transparent;

        // ── The sidebar: Glass's translucent list, Material's list pane ──
        side := Rectangle {
            // (x and y given: Slint centres an element with a width but no x,
            // and the pane, drawn after it, then covered the whole sidebar)
            x: 0;
            y: 0;
            width: Theme.material ? 300px : 230px;
            height: parent.height;
            background: Theme.material ? Theme.m3-surface-container : Theme.dark ? #1f1f24c7 : #f0f0f5cc;

            // Glass: scrolled down and idle, the search folds into a magnifier
            property <bool> folded: !Theme.material && side-scroll.content-y < -4px && !search-input.has-focus && !searching && !fold-hover.has-hover;

            search := Rectangle {
                x: Theme.material ? 16px : 10px;
                y: Theme.material ? 16px : 14px;
                width: parent.width - (Theme.material ? 32px : 20px);
                height: Theme.material ? 52px : 28px;
                fold-hover := TouchArea {
                    mouse-cursor: MouseCursor.text;
                    clicked => { search-input.focus(); }
                }
                field := Rectangle {
                    width: side.folded ? 28px : parent.width;
                    animate width { duration: SM.hover; easing: ease-out; }
                    opacity: side.folded ? 0 : 1;
                    animate opacity { duration: SM.hover; }
                    border-radius: Theme.material ? self.height / 2 : Theme.radius-control - 2px;
                    background: Theme.material ? (search-input.has-focus ? Theme.m3-surface-container-highest : fold-hover.has-hover ? Theme.m3-surface-container-high.mix(Theme.m3-on-surface, 0.92) : Theme.m3-surface-container-high) : Theme.fill;
                    animate background { duration: SM.hover; }
                    border-width: Theme.material ? 0 : 1px;
                    border-color: search-input.has-focus ? Theme.accent : transparent;
                    if Theme.material: SIcon {
                        x: 16px;
                        g: SG.search;
                        size: 22px;
                        color: Theme.m3-on-surface-variant;
                    }
                    Rectangle {
                        x: Theme.material ? 50px : 10px;
                        width: parent.width - self.x - (clear.visible ? 48px : Theme.material ? 20px : 10px);
                        clip: true;
                        search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            single-line: true;
                            color: Theme.label;
                            selection-background-color: Theme.material ? Theme.m3-primary.with-alpha(0.3) : Theme.accent.with-alpha(0.4);
                            font-size: Theme.material ? 16px : Theme.body;
                            accessible-label: "Search settings";
                            edited => {
                                root.res-cur = -1;
                                root.query(self.text);
                            }
                            // (Enter: the result the keys are on, else the first)
                            accepted => {
                                if root.res-cur >= 0 && root.res-cur < results.length {
                                    SBus.act("search:" + results[root.res-cur].page, results[root.res-cur].section ? 1 : 0, 0, results[root.res-cur].text);
                                } else {
                                    root.query-commit();
                                }
                            }
                            key-pressed(e) => {
                                // Down: into the results, or (no query) to the pages
                                if e.text == Key.DownArrow {
                                    if searching {
                                        root.res-cur = min(root.res-cur + 1, results.length - 1);
                                    } else {
                                        self.clear-focus();
                                        side-keys.focus();
                                    }
                                    return accept;
                                }
                                if e.text == Key.UpArrow && searching && root.res-cur >= 0 {
                                    root.res-cur -= 1;
                                    return accept;
                                }
                                if e.text == Key.Escape {
                                    self.text = "";
                                    root.query("");
                                    self.clear-focus();
                                    side-keys.focus();
                                    return accept;
                                }
                                reject
                            }
                        }
                        if search-input.text == "": Text {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            text: Theme.material ? "Search settings" : "Search";
                            color: Theme.material ? Theme.m3-on-surface-variant : Theme.tertiary;
                            font-size: Theme.material ? 16px : Theme.body;
                            accessible-role: AccessibleRole.none;
                        }
                    }
                    clear := Rectangle {
                        visible: Theme.material && search-input.text != "";
                        x: parent.width - 48px;
                        y: (parent.height - 40px) / 2;
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.m3-on-surface-variant.with-alpha(clear-ta.has-hover ? 0.08 : 0);
                        accessible-role: AccessibleRole.button;
                        accessible-label: "Clear search";
                        accessible-action-default => { search-input.text = ""; root.query(""); }
                        SIcon { g: SG.x; size: 20px; color: Theme.m3-on-surface-variant; }
                        clear-ta := TouchArea {
                            clicked => {
                                search-input.text = "";
                                root.query("");
                                search-input.focus();
                            }
                        }
                    }
                }
                // (folded: the magnifier)
                if side.folded: Rectangle {
                    x: 0;
                    width: 28px;
                    height: 28px;
                    border-radius: Theme.radius-control - 2px;
                    background: fold-hover.has-hover ? Theme.fill : transparent;
                    accessible-role: AccessibleRole.button;
                    accessible-label: "Search";
                    accessible-action-default => { search-input.focus(); }
                    SIcon { g: SG.search; size: 16px; color: Theme.secondary; }
                    // (no TouchArea of its own: the search's, under it, sees the
                    // hover, and the search opens as the pointer comes, as the QML)
                }
            }

            // The pages list's keys (one Tab stop: Up, Down, Home, End open
            // the previous, next, first, last page)
            side-keys := FocusScope {
                width: 0;
                height: 0;
                // (the ring is for focus from the keyboard only: FocusRing.qml)
                in-out property <bool> by-keys;
                focus-gained(r) => { self.by-keys = r == FocusReason.tab-navigation; }
                key-pressed(e) => {
                    self.by-keys = true;
                    if e.text == Key.UpArrow { root.key-nav(-1); return accept; }
                    if e.text == Key.DownArrow { root.key-nav(1); return accept; }
                    if e.text == Key.Home { root.key-nav(-2); return accept; }
                    if e.text == Key.End { root.key-nav(2); return accept; }
                    reject
                }
            }
            side-scroll := Flickable {
                flicked => { side-bar.poke(); }
                y: search.y + search.height + (Theme.material ? 12px : 10px);
                height: parent.height - self.y;
                content-height: side-list.preferred-height + 16px;
                side-list := VerticalLayout {
                    x: Theme.material ? 12px : 10px;
                    width: side.width - (Theme.material ? 24px : 20px);
                    alignment: start;
                    spacing: 2px;
                    // The pages, under their group headings
                    if !searching: side-holder := Rectangle {
                        // Material: the open page's pill, springing from page
                        // to page (SettingsMaterial.qml's indicator)
                        if Theme.material: Rectangle {
                            y: root.pill-y;
                            height: 48px;
                            border-radius: 24px;
                            background: Theme.m3-secondary-container;
                            // (SpringAnimation spring 12.8, damping 0.54: settles in about
                            // 200 ms, a touch past; measured 140–220 ms in the QML)
                            animate y { duration: root.pill-placed ? 200ms : 0ms; easing: cubic-bezier(0.3, 1.25, 0.5, 1); }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            for s[i] in sections: VerticalLayout {
                                if s.group != "": HorizontalLayout {
                                    padding-left: Theme.material ? 16px : 8px;
                                    padding-top: i == 0 ? (Theme.material ? 4px : 0) : (Theme.material ? 18px : 12px);
                                    padding-bottom: Theme.material ? 8px : 4px;
                                    Text {
                                        text: s.group;
                                        color: Theme.material ? Theme.m3-on-surface-variant : Theme.tertiary;
                                        font-size: Theme.material ? 12px : Theme.caption;
                                        font-weight: Theme.material ? 500 : 600;
                                        letter-spacing: Theme.material ? 0.5px : 0;
                                    }
                                }
                                item := Rectangle {
                                    height: Theme.material ? 48px : 32px;
                                    border-radius: Theme.material ? 24px : 8px;
                                    // (Material: the pill above is the open page's fill)
                                    background: Theme.material ? transparent
                                        : s.current ? Theme.accent : ita.has-hover ? Theme.fill : transparent;
                                    property <bool> cur: s.current;
                                    changed cur => {
                                        if cur {
                                            root.pill-placed = true;
                                            root.pill-y = self.absolute-position.y - side-holder.absolute-position.y;
                                        }
                                    }
                                    init => {
                                        if cur {
                                            root.pill-placed = false;
                                            root.pill-y = self.absolute-position.y - side-holder.absolute-position.y;
                                        }
                                    }
                                    accessible-role: AccessibleRole.tab;
                                    accessible-label: s.name;
                                    accessible-item-selected: s.current;
                                    accessible-action-default => { root.go(s.id); }
                                    // (Material: the state layer)
                                    if Theme.material: Rectangle {
                                        border-radius: 24px;
                                        background: (s.current ? Theme.m3-on-secondary-container : Theme.m3-on-surface).with-alpha(ita.pressed ? 0.1 : ita.has-hover ? 0.08 : 0);
                                        animate background { duration: SM.hover; }
                                    }
                                    // Glass: the icon on its coloured tile
                                    if !Theme.material: Rectangle {
                                        x: 6px;
                                        y: (parent.height - 22px) / 2;
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 6px;
                                        background: s.color;
                                        SIcon { g: { p: s.icon.p, m: "" }; fill: true; size: 13px; color: white; }
                                    }
                                    // Material: a tonal circle; the open page's a
                                    // primary cookie, turning slowly
                                    if Theme.material: Rectangle {
                                        x: 8px;
                                        y: (parent.height - 34px) / 2;
                                        width: 34px;
                                        height: 34px;
                                        if !s.current: Rectangle {
                                            border-radius: 17px;
                                            background: Theme.m3-secondary-container;
                                        }
                                        if s.current: Path {
                                            width: 100%;
                                            height: 100%;
                                            viewbox-width: 100;
                                            viewbox-height: 100;
                                            commands: root.cookie;
                                            fill: Theme.m3-primary;
                                            transform-rotation: root.spin ? root.spin-angle : 0deg;
                                        }
                                        SIcon {
                                            g: s.icon;
                                            fill: true;
                                            size: 19px;
                                            color: s.current ? Theme.m3-on-primary : Theme.m3-on-secondary-container;
                                        }
                                    }
                                    Text {
                                        x: Theme.material ? 8px + 34px + 14px : 6px + 22px + 10px;
                                        width: parent.width - self.x - 16px;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        text: s.name;
                                        color: Theme.material ? (s.current ? Theme.m3-on-secondary-container : Theme.m3-on-surface) : s.current ? Theme.on-accent : Theme.label;
                                        font-size: Theme.material ? 15px : Theme.body;
                                        font-weight: s.current ? 600 : 400;
                                        accessible-role: AccessibleRole.none;
                                    }
                                    // (the list is one Tab stop: the open page, ringed)
                                    SFocusRing { shown: side-keys.has-focus && side-keys.by-keys && s.current; radius: Theme.material ? 28px : 10px; }
                                    ita := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            side-keys.focus();
                                            side-keys.by-keys = false;
                                            root.go(s.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Search results: pages first, then the settings in them
                    if searching: Rectangle {
                        VerticalLayout {
                            spacing: 2px;
                            for res[ri] in results: Rectangle {
                                property <bool> keyed: ri == root.res-cur && search-input.has-focus;
                                min-height: Theme.material ? 56px : 36px;
                                border-radius: Theme.material ? min(28px, self.height / 2) : 8px;
                                background: Theme.material ? Theme.m3-on-surface.with-alpha(rta.pressed ? 0.1 : rta.has-hover || self.keyed ? 0.08 : 0) : rta.has-hover || self.keyed ? Theme.fill : transparent;
                                SFocusRing { shown: parent.keyed; radius: Theme.material ? 32px : 10px; }
                                animate background { duration: SM.hover; }
                                accessible-role: AccessibleRole.list-item;
                                accessible-label: res.text;
                                accessible-description: res.where;
                                accessible-action-default => { SBus.act("search:" + res.page, res.section ? 1 : 0, 0, res.text); }
                                HorizontalLayout {
                                    padding-left: Theme.material ? 8px : 6px;
                                    padding-right: Theme.material ? 16px : 6px;
                                    padding-top: Theme.material ? 8px : 6px;
                                    padding-bottom: Theme.material ? 8px : 6px;
                                    spacing: Theme.material ? 16px : 10px;
                                    VerticalLayout {
                                        alignment: Theme.material ? center : start;
                                        padding-top: Theme.material ? 0 : 2px;
                                        Rectangle {
                                            width: Theme.material ? 40px : 22px;
                                            height: self.width;
                                            border-radius: Theme.material ? 20px : 6px;
                                            background: Theme.material ? Theme.m3-secondary-container : res.color;
                                            SIcon {
                                                g: Theme.material ? res.icon : { p: res.icon.p, m: "" };
                                                fill: !Theme.material;
                                                size: Theme.material ? 22px : 13px;
                                                color: Theme.material ? Theme.m3-on-secondary-container : white;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: Theme.material ? 0 : 1px;
                                        Text {
                                            text: res.text;
                                            overflow: elide;
                                            color: Theme.label;
                                            font-size: Theme.material ? 16px : Theme.body;
                                        }
                                        if !res.section: Text {
                                            text: res.where;
                                            overflow: elide;
                                            color: Theme.secondary;
                                            font-size: Theme.material ? 14px : Theme.caption;
                                        }
                                    }
                                }
                                rta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { SBus.act("search:" + res.page, res.section ? 1 : 0, 0, res.text); }
                                }
                            }
                        }
                    }
                    // No results
                    if searching && results.length == 0: VerticalLayout {
                        padding-top: Theme.material ? 32px : 24px;
                        spacing: Theme.material ? 8px : 4px;
                        if Theme.material: SIcon { g: SG.search; size: 32px; color: Theme.m3-on-surface-variant; }
                        Text {
                            horizontal-alignment: center;
                            text: "No results";
                            color: Theme.label;
                            font-size: Theme.material ? 16px : Theme.body;
                            font-weight: Theme.material ? 500 : 600;
                        }
                        Text {
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            text: "Try a shorter word, like \"dock\" or \"sound\".";
                            color: Theme.secondary;
                            font-size: Theme.material ? 14px : Theme.caption;
                        }
                    }
                }
            }
            side-bar := ScrollBar {
                x: parent.width - 12px - 2px;
                y: side-scroll.y;
                height: side-scroll.height;
                content-y <=> side-scroll.content-y;
                viewport-h: side-scroll.content-height;
                visible-h: side-scroll.height;
            }
        }

        // ── The pane: the toolbar and the page ──
        pane := Rectangle {
            x: side.width;
            width: parent.width - side.width;
            height: parent.height;
            background: Theme.material ? Theme.m3-surface : Theme.dark ? #1e1e21 : #f5f5f7;
            property <length> bar-h: Theme.material ? 64px : 52px;
            // Material: the headline has scrolled under the top bar
            property <bool> collapsed: Theme.material && page-scroll.content-y < -(headline.y + headline.height - 8px);

            page-scroll := Flickable {
                // (scrolled by a person: a reveal no longer holds the page there)
                flicked => { page-bar.poke(); SBus.reveal-hold = false; }
                y: pane.bar-h;
                height: parent.height - pane.bar-h;
                content-height: page.preferred-height + 64px;
                page := VerticalLayout {
                    x: Theme.material ? max(32px, (pane.width - self.width) / 2) : 28px;
                    y: Theme.material ? 4px : 8px;
                    width: Theme.material ? min(880px, pane.width - 64px) : pane.width - 56px;
                    alignment: start;
                    init => { SBus.page-width = self.width; }
                    changed width => { SBus.page-width = self.width; }
                    // Material: a subpage names its section above the
                    // headline (back up to it), then the large headline
                    if Theme.material && is-sub: HorizontalLayout {
                        padding-bottom: 4px;
                        alignment: start;
                        Text {
                            text: crumb;
                            color: crumb-ta.has-hover ? Theme.m3-on-surface : Theme.m3-primary;
                            font-size: 14px;
                            font-weight: 500;
                            letter-spacing: 0.1px;
                            accessible-role: AccessibleRole.button;
                            accessible-label: crumb;
                            accessible-action-default => { root.crumb-clicked(); }
                            crumb-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.crumb-clicked(); }
                            }
                        }
                    }
                    headline := HorizontalLayout {
                        visible: Theme.material;
                        // (Glass has no headline: no line for it either)
                        height: Theme.material ? self.preferred-height : 0px;
                        padding-bottom: Theme.material ? 24px : 0;
                        Text {
                            text: Theme.material ? page-title : "";
                            wrap: word-wrap;
                            color: Theme.m3-on-surface;
                            font-size: 32px;
                            font-weight: 500;
                            accessible-role: AccessibleRole.text;
                        }
                    }
                    Rectangle {
                        min-height: SBus.page-h;
                        preferred-height: SBus.page-h;
                        for pg in pages: PageView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: self.preferred-height;
                            visible: pg.shown;
                            shown: pg.shown;
                            blocks: pg.blocks;
                            menu-open: root.menu-open ? root.menu-id : "";
                        }
                    }
                }
            }
            page-bar := ScrollBar {
                x: parent.width - 12px - 2px;
                y: page-scroll.y;
                height: page-scroll.height;
                content-y <=> page-scroll.content-y;
                viewport-h: page-scroll.content-height;
                visible-h: page-scroll.height;
            }

            // Toolbar: back and forward, and where you are
            toolbar := Rectangle {
                height: pane.bar-h;
                y: 0;
                background: Theme.material ? (page-scroll.content-y < -2px ? Theme.m3-surface-container : Theme.m3-surface) : transparent;
                animate background { duration: SM.hover; }
                // (moving the window: drag its top bar)
                drag-area := TouchArea {
                    property <length> px;
                    property <length> py;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            self.px = self.mouse-x;
                            self.py = self.mouse-y;
                        }
                    }
                    moved => {
                        if self.pressed { root.drag(self.mouse-x - self.px, self.mouse-y - self.py); }
                    }
                }
                arrows := HorizontalLayout {
                    x: 16px;
                    y: (parent.height - self.preferred-height) / 2;
                    spacing: Theme.material ? 4px : 2px;
                    for d[i] in [-1, 1]: Rectangle {
                        property <bool> usable: d < 0 ? can-back : can-forward;
                        width: Theme.material ? 40px : 28px;
                        height: self.width;
                        opacity: usable ? 1 : (Theme.material ? 0.38 : 0.35);
                        border-radius: Theme.material ? self.height / 2 : Theme.radius-control - 2px;
                        background: Theme.material ? Theme.m3-on-surface-variant.with-alpha(ata.pressed ? 0.1 : ata.has-hover ? 0.08 : 0) : ata.pressed ? Theme.fill-pressed : ata.has-hover ? Theme.fill : transparent;
                        accessible-role: AccessibleRole.button;
                        accessible-label: d < 0 ? "Back" : "Forward";
                        accessible-enabled: usable;
                        accessible-action-default => { if d < 0 { root.back(); } else { root.forward(); } }
                        SIcon {
                            g: d < 0 ? SG.caret-left : SG.caret-right;
                            size: Theme.material ? 22px : 16px;
                            color: Theme.material ? Theme.m3-on-surface-variant : Theme.secondary;
                        }
                        ata := TouchArea {
                            enabled: usable;
                            clicked => { if d < 0 { root.back(); } else { root.forward(); } }
                        }
                    }
                }
                // Glass: Section › Subpage (the section goes back up to it)
                if !Theme.material: HorizontalLayout {
                    x: arrows.x + arrows.preferred-width + 12px;
                    width: min(self.preferred-width, parent.width - self.x - 16px);
                    height: parent.height;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        vertical-alignment: center;
                        text: is-sub ? crumb : page-title;
                        color: is-sub ? (cta.has-hover ? Theme.label : Theme.secondary) : Theme.label;
                        font-size: Theme.title;
                        font-weight: 600;
                        accessible-role: AccessibleRole.text;
                        cta := TouchArea {
                            enabled: is-sub;
                            mouse-cursor: pointer;
                            clicked => { root.crumb-clicked(); }
                        }
                        // (in the crumb, not the layout: a third item took a
                        // second spacing before the caret)
                        if is-sub: Rectangle {
                            width: 0;
                            accessible-role: AccessibleRole.button;
                            accessible-label: crumb;
                            accessible-action-default => { root.crumb-clicked(); }
                        }
                    }
                    if is-sub: SIcon { g: { p: SG.caret-right.p, m: "" }; bold: true; size: 12px; color: Theme.tertiary; }
                    if is-sub: Text {
                        vertical-alignment: center;
                        text: page-title;
                        color: Theme.label;
                        font-size: Theme.title;
                        font-weight: 600;
                    }
                }
                // Material: the title, once the headline is gone
                if Theme.material: Text {
                    x: arrows.x + arrows.preferred-width + 16px;
                    width: parent.width - self.x - 24px;
                    height: parent.height;
                    vertical-alignment: center;
                    overflow: elide;
                    text: page-title;
                    color: Theme.m3-on-surface;
                    font-size: 22px;
                    opacity: pane.collapsed ? 1 : 0;
                    animate opacity { duration: SM.hover; }
                    accessible-role: AccessibleRole.none;
                }
                // Glass: a hairline once the page scrolls under it
                if !Theme.material: Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                    opacity: page-scroll.content-y < -2px ? 1 : 0;
                    animate opacity { duration: SM.hover; }
                }
            }
        }
        // Glass: the line between the sidebar and the pane
        if !Theme.material: Rectangle {
            x: side.width;
            width: 1px;
            background: Theme.separator;
        }

        // (the menu, ActionMenu.qml, is its own popup window: settings-menu.slint)

        // ── The toast (Toast.qml): what just changed, with Undo ──
        toast := Rectangle {
            property <float> p: toast-shown ? 1 : 0;
            animate p { duration: toast-shown ? 200ms : 140ms; easing: toast-shown ? cubic-bezier(0.33, 1, 0.68, 1) : cubic-bezier(0.32, 0, 0.67, 0); }
            visible: self.p > 0.01;
            opacity: self.p;
            width: Theme.material ? max(288px, min(560px, toast-row.preferred-width)) : min(520px, toast-row.preferred-width);
            height: Theme.material ? 48px : 44px;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 24px + (Theme.material && toast-shown ? (1 - self.p) * 8px : 0);
            border-radius: Theme.material ? 4px : 14px;
            background: Theme.material ? Theme.m3-inverse-surface : Theme.dark ? #3a3a40 : #18181b;
            border-width: Theme.dark && !Theme.material ? 1px : 0;
            border-color: #ffffff29;
            accessible-role: AccessibleRole.text;
            accessible-label: toast-text;
            toast-row := HorizontalLayout {
                padding-left: 16px;
                padding-right: toast-undo ? 8px : 16px;
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                    text: toast-text;
                    color: Theme.material ? Theme.m3-inverse-on-surface : Theme.dark ? #ededef : #fafafa;
                    font-size: Theme.material ? 14px : Theme.body;
                    letter-spacing: Theme.material ? 0.25px : 0;
                }
                if toast-undo: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: ul.preferred-width + (Theme.material ? 24px : 20px);
                        height: Theme.material ? 40px : 28px;
                        border-radius: Theme.material ? 20px : Theme.radius-control;
                        background: Theme.material ? Theme.m3-inverse-primary.with-alpha(uta.pressed ? 0.1 : uta.has-hover ? 0.08 : 0) : #ffffff.with-alpha(uta.pressed ? 0.2 : uta.has-hover ? 0.12 : 0);
                        animate background { duration: SM.hover; }
                        // (pressed: Material swells, Glass gives a little)
                        transform-scale: uta.pressed ? (Theme.material ? 1.06 : 0.97) : 1;
                        animate transform-scale { duration: uta.pressed ? SM.press : 300ms; easing: uta.pressed ? ease-out : cubic-bezier(0.3, 1.6, 0.5, 1); }
                        accessible-role: AccessibleRole.button;
                        accessible-label: "Undo";
                        accessible-action-default => { root.undo(); }
                        ul := Text {
                            text: "Undo";
                            color: Theme.material ? Theme.m3-inverse-primary : Theme.dark ? #ededef : #fafafa;
                            font-size: Theme.material ? 14px : Theme.small;
                            font-weight: Theme.material ? 500 : 600;
                            accessible-role: AccessibleRole.none;
                        }
                        uta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.undo(); }
                        }
                    }
                }
            }
        }
    }
    }
    // (a thin edge, as a window's border, over everything)
    Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: Theme.material ? Theme.m3-outline-variant.with-alpha(0.6) : Theme.dark ? #ffffff26 : #0000001f;
        background: transparent;
    }
}
