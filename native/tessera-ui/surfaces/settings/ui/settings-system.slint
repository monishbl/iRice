// Settings: the views only the "system" page group's pages have (custom blocks
// and row controls; src/surfaces/settings/pages/system/*.rs fills them). The
// block's or row's `sub` says which view; its data, num, image and rows
// carry what it shows; it reports through SBus.act(id, int, float, string).
//
//   fp-sheet (a block): adding a finger (FingerprintSheet.qml with
//     FingerprintArt.qml): b.title, b.text (red while b.dim), b.footer (the
//     section caption), b.on (done), b.num (the next section, -1 none),
//     b.data[0..11] the print's sections (text: path commands in a 200×248
//     box; on: taken; off: the next; style 1: flashing red), b.data[11]
//     ("meta": num the misses, style the takes: each shakes or bumps the
//     print), b.rows its buttons
//   pick-add (a row control): a finger's Dropdown and Add (data[0])
//   energy (a row control): an app's share of the CPU time (num, 0..1),
//     and Quit (data[0]) unless it's a bare process

import { Theme } from "@tessera/theme.slint";
import { SIc, SOpt, SetRow, SBlock, SBus, SG, SM, SIcon, SFocusRing, SSwitch, SSlider, SSegmented, SChoice, SButton, SField, SChip, SSwatch, SFilled } from "settings-kit.slint";

// ── The add-a-finger sheet ──────────────────────────────────────────────
component FpSheet inherits Rectangle {
    in property <SBlock> b;
    property <bool> done: b.on;
    property <int> target: b.num;
    property <bool> has-meta: b.data.length > 11;
    property <float> misses: has-meta ? b.data[11].num : 0;
    property <int> takes: has-meta ? b.data[11].style : 0;
    // a miss shakes the print; a touch taken bumps it
    property <int> shake-step: 5;
    property <length> shake-x: shake-step == 0 ? -8px : shake-step == 1 ? 7px : shake-step == 2 ? -5px : shake-step == 3 ? 3px : 0px;
    animate shake-x { duration: 50ms; }
    changed misses => {
        shake-step = 0;
        shaker.running = true;
    }
    shaker := Timer {
        interval: 55ms;
        running: false;
        triggered => {
            root.shake-step += 1;
            if root.shake-step >= 5 {
                self.running = false;
            }
        }
    }
    property <bool> bumped;
    changed takes => {
        bumped = true;
        bumper.running = true;
    }
    bumper := Timer {
        interval: 80ms;
        running: false;
        triggered => {
            root.bumped = false;
            self.running = false;
        }
    }
    property <float> bump: bumped ? 0.96 : 1;
    animate bump { duration: bumped ? 80ms : 260ms; easing: bumped ? ease-out : ease-out-back; }

    property <color> card-color: Theme.material ? Theme.m3-surface-container-high : Theme.dark ? #232327 : white;
    property <color> faint: Theme.dark ? #ffffff29 : #00000021;

    // (modal: what's behind is dimmed and takes no clicks)
    border-radius: 16px;
    property <float> progress: 0;
    // (Cancel or Done: it fades and shrinks away, 0.66 × as long, InCubic)
    property <bool> closing: has-meta && b.data[11].on;
    init => { progress = 1; keys.focus(); }
    changed closing => { progress = closing ? 0 : 1; }
    animate progress { duration: closing ? 200ms : 300ms; easing: closing ? cubic-bezier(0.3333, 0, 0.6667, 0) : cubic-bezier(0.3333, 1, 0.6667, 1); }
    background: (Theme.dark ? #000000 : #000000).with-alpha((Theme.dark ? 0.5 : 0.3) * progress);
    TouchArea {}
    // Esc: Cancel (or Done), the sheet's last button (FingerprintSheet.qml 118–122)
    keys := FocusScope {
        // (a click goes to what's under it: keys only; it covered link rows and choices, which then took two clicks or none)
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Escape {
                if b.rows.length > 0 { SBus.act(b.rows[b.rows.length - 1].id, 0, 0, ""); }
                return accept;
            }
            reject
        }
    }
    VerticalLayout {
        padding: 24px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            card := Rectangle {
                width: 420px;
                opacity: root.progress;
                transform-scale: 0.96 + 0.04 * root.progress;
                border-radius: Theme.material ? 28px : 20px;
                background: root.card-color;
                border-width: Theme.material ? 0 : 1px;
                border-color: Theme.separator;
                accessible-role: AccessibleRole.groupbox;
                accessible-label: b.title;
                VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    Text {
                        horizontal-alignment: center;
                        text: b.title;
                        color: Theme.label;
                        font-size: Theme.material ? 24px : 20px;
                        font-weight: Theme.material ? 400 : 600;
                    }
                    Text {
                        height: 40px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        text: b.text;
                        color: b.dim ? Theme.danger : Theme.secondary;
                        font-size: 14px;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 200px;
                            height: 248px;
                            accessible-role: AccessibleRole.image;
                            accessible-label: done ? "All 11 sections recorded" : "Section " + (target + 1) + " of 11";
                            art := Rectangle {
                                x: root.shake-x;
                                width: parent.width;
                                height: parent.height;
                                transform-scale-x: root.bump * 100%;
                                transform-scale-y: root.bump * 100%;
                                for o in b.data: Path {
                                    visible: o.id != "meta";
                                    x: 0;
                                    y: 0;
                                    width: 200px;
                                    height: 248px;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 200;
                                    viewbox-height: 248;
                                    commands: o.text;
                                    stroke-width: 7px;
                                    stroke-line-cap: round;
                                    stroke: done ? Theme.success : o.on ? Theme.accent : o.off ? (o.style == 1 ? Theme.danger : Theme.accent.with-alpha(0.42)) : root.faint;
                                    // (to red in 60 ms; a section taken fills in over 380 ms OutCubic;
                                    // the miss's red fades back over 700 ms InCubic: FingerprintArt.qml 251–286)
                                    animate stroke { duration: o.style == 1 ? 60ms : o.on ? 380ms : 700ms; easing: o.style == 1 ? ease-out : o.on ? cubic-bezier(0.33, 1, 0.68, 1) : cubic-bezier(0.32, 0, 0.67, 0); }
                                }
                            }
                            // done: a check at the bottom right of the print
                            Rectangle {
                                property <float> s: done ? 1 : 0.4;
                                animate s { duration: 260ms; easing: ease-out-back; }
                                x: parent.width - 52px;
                                y: parent.height - 58px;
                                width: 44px;
                                height: 44px;
                                opacity: done ? 1 : 0;
                                transform-scale-x: self.s * 100%;
                                transform-scale-y: self.s * 100%;
                                border-radius: 22px;
                                background: Theme.success;
                                border-width: 3px;
                                border-color: root.card-color;
                                SIcon { g: SG.check; bold: true; size: 22px; color: white; }
                            }
                        }
                    }
                    // the 11 sections, as dots: taken, the next one, still to come
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        padding-top: 4px;
                        for i in 11: Rectangle {
                            width: i == target ? 16px : 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: done ? Theme.success : (i < b.data.length && b.data[i].on) ? Theme.accent : i == target ? Theme.accent.with-alpha(0.5) : Theme.toggle-off;
                            animate width, background { duration: SM.hover; }
                        }
                    }
                    Text {
                        horizontal-alignment: center;
                        text: b.footer;
                        color: Theme.tertiary;
                        font-size: 12px;
                    }
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        for r in b.rows: SButton {
                            text: r.text;
                            style: r.style;
                            label: b.title;
                            clicked => { SBus.act(r.id, 0, 0, ""); }
                        }
                    }
                }
            }
        }
    }
}

// ── Health's bar chart (a whole row) ────────────────────────────────────
// r.label the title, r.value what it is now (a hovered bar says its own),
// r.text the scale's top, r.low / r.high the time at each end, r.detail
// the chart in words (for screen readers); r.data one bar a slot: num its
// height (0..1), detail what it says, style 0 the accent, 1 a warning (a
// slot with long stalls), 3 no record. r.from / r.to: Material's tile
// rounds at the group's ends.
component HealthChart {
    in property <SetRow> r;
    property <int> hovered: -1;
    property <length> pad: Theme.material ? 20px : 14px;
    property <color> ink: Theme.material ? Theme.m3-primary : Theme.accent;
    min-height: body.preferred-height;
    if Theme.material: Rectangle {
        border-top-left-radius: r.from > 0 ? 24px : 4px;
        border-top-right-radius: r.from > 0 ? 24px : 4px;
        border-bottom-left-radius: r.to > 0 ? 24px : 4px;
        border-bottom-right-radius: r.to > 0 ? 24px : 4px;
        background: Theme.m3-surface-container-high;
    }
    body := VerticalLayout {
        padding-left: pad;
        padding-right: pad;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: r.label;
                color: Theme.label;
                font-size: Theme.material ? 14px : Theme.body;
                font-weight: 500;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                text: root.hovered >= 0 && root.hovered < r.data.length ? r.data[root.hovered].detail : r.value;
                color: Theme.secondary;
                font-size: Theme.small;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                height: 72px;
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.image;
                accessible-label: r.detail;
                // (the scale's top and the baseline)
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.separator;
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.separator;
                }
                HorizontalLayout {
                    spacing: r.data.length > 26 ? 2px : 3px;
                    for o[i] in r.data: Rectangle {
                        horizontal-stretch: 1;
                        min-width: 2px;
                        property <length> h: o.style == 3 ? 0px : max(2px, self.height * o.num);
                        Rectangle {
                            y: parent.height - parent.h;
                            height: parent.h;
                            border-top-left-radius: min(2px, self.width / 2);
                            border-top-right-radius: min(2px, self.width / 2);
                            background: o.style == 1 ? Theme.warning : root.ink;
                            opacity: root.hovered < 0 || root.hovered == i ? 1 : 0.45;
                            animate opacity { duration: SM.hover; }
                        }
                        TouchArea {
                            changed has-hover => {
                                if self.has-hover {
                                    root.hovered = i;
                                } else if root.hovered == i {
                                    root.hovered = -1;
                                }
                            }
                        }
                    }
                }
            }
            Text {
                text: r.text;
                font-size: Theme.caption;
                color: Theme.tertiary;
                vertical-alignment: top;
                min-width: 40px;
            }
        }
        HorizontalLayout {
            padding-right: 48px;
            Text {
                text: r.low;
                font-size: Theme.caption;
                color: Theme.tertiary;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: r.high;
                font-size: Theme.caption;
                color: Theme.tertiary;
            }
        }
    }
}

// A custom block (`b.kind == "custom" && b.group == "system"`)
export component SystemBlock inherits VerticalLayout {
    in property <SBlock> b;
    if b.sub == "fp-sheet": FpSheet { b: root.b; }
}

// A custom row or row control (`r.group == "system"`)
export component SystemCtl inherits VerticalLayout {
    in property <SetRow> r;
    alignment: center;
    // Health's charts
    if r.sub == "chart": HealthChart { r: r; }
    // A finger to add: its Dropdown, and Add
    if r.sub == "pick-add": HorizontalLayout {
        spacing: 8px;
        alignment: end;
        VerticalLayout {
            alignment: center;
            SChoice {
                width: r.width > 0 ? r.width : self.preferred-width;
                cid: r.id;
                opts: r.opts;
                current: r.index;
                dropdown: true;
                enabled: r.enabled;
                label: r.label;
            }
        }
        if r.data.length > 0: VerticalLayout {
            alignment: center;
            SButton {
                text: r.data[0].text;
                icon: r.data[0].icon;
                style: 1;
                enabled: !r.data[0].off;
                label: r.label;
                clicked => { SBus.act(r.data[0].id, 0, 0, ""); }
            }
        }
    }
    // An app's energy: its bar, and Quit
    if r.sub == "energy": HorizontalLayout {
        spacing: 12px;
        alignment: end;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 120px;
                height: 6px;
                border-radius: 3px;
                background: Theme.fill;
                accessible-role: AccessibleRole.progress-indicator;
                accessible-label: r.detail;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: max(6px, parent.width * r.num);
                    height: parent.height;
                    border-radius: 3px;
                    background: Theme.secondary;
                }
            }
        }
        if r.data.length > 0: VerticalLayout {
            alignment: center;
            SButton {
                text: r.data[0].text;
                label: r.label;
                clicked => { SBus.act(r.id, 0, 0, ""); }
            }
        }
    }
}
