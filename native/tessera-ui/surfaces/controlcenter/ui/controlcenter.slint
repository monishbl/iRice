// Control Center (src/surfaces/controlcenter): Glass's Control Center
// (ControlCenterGlass.qml, ModuleView.qml, CapsuleSlider.qml,
// ControlCenterFooter.qml, detail pages in a second popover beside it) and
// Material's Quick Settings (QuickSettings.qml, QSTile.qml, QSSlider.qml,
// QSMedia.qml, pages sliding in inside the panel), drawn from one model the
// part fills. Pages are blocks (rows, headings, notes, segmented controls,
// sliders) in ListRow.qml's and DetailPage.qml's looks.

import { Theme } from "@tessera/theme.slint";

// An icon: Phosphor, or in Material the matching Material Symbols glyph (sym)
export struct CcIc {
    t: string,
    s: bool,
}

export struct CcMod {
    id: string,
    kind: int, // 0 toggle, 1 action, 2 slider, 3 media, 4 info
    cols: int,
    rows: int,
    x: length,
    y: length,
    w: length,
    h: length,
    sq-dx: float, // Material's press: how far it moves and widens per unit of squeeze
    sq-dw: float,
    label: string,
    status: string,
    icon: CcIc,
    on: bool,
    page: bool, // it has a page
    menu: bool, // it has choices
    value: float,
    title: string, // info: the reading
    sub: string,
    order: int,
    focused: bool, // its page is open (Glass: it stays sharp)
}

export struct CcGal {
    id: string,
    label: string,
    icon: CcIc,
    why: string,
    sizes: string,
}

export struct CcBlock {
    kind: int, // 0 head, 1 row, 2 note, 3 seg, 4 slider, 5 pass, 6 notice, 7 app, 8 gap
    id: string,
    icon: CcIc,
    pic: image,
    has-pic: bool,
    title: string,
    status: string,
    hl: bool,
    trail: CcIc,
    busy: bool,
    act: CcIc,
    dis: bool,
    value: float,
    tone: int, // 0 secondary, 1 tertiary, 2 danger
    center: bool,
    options: [string],
    cur: int,
    flag: bool,
    gap: length,
    first: bool,
    last: bool,
}

export struct CcMenuItem {
    text: string,
    checked: bool,
    sep: bool,
    danger: bool,
}

export struct CcMedia {
    has: bool,
    identity: string,
    title: string,
    artist: string,
    playing: bool,
    art: image,
    has-art: bool,
    prev: bool,
    next: bool,
    toggle: bool,
    seek: bool,
    progress: float,
    timed: bool,
}

export struct CcGlyphs {
    back: CcIc,
    refresh: CcIc,
    plus: CcIc,
    plus-circle: CcIc,
    gear: CcIc,
    power: CcIc,
    pencil: CcIc,
    prev: CcIc,
    next: CcIc,
    play: CcIc,
    pause: CcIc,
    notes: CcIc,
    user: CcIc,
    more: CcIc,
    check: CcIc,
    cast: CcIc,
    caret-right: CcIc,
    caret-down: CcIc,
    spinner: CcIc,
    battery: CcIc,
    battery-charging: CcIc,
    battery-low: CcIc,
    speaker-x: CcIc,
    bolt: CcIc,
}

component Ic {
    in property <CcIc> icon;
    in property <color> color: Theme.label;
    in property <length> size: 16px;
    in property <bool> fill;
    in property <bool> bold;
    t := Text {
        width: 100%;
        height: 100%;
        text: icon.t;
        color: root.color;
        font-size: icon.s ? round(size * 1.2 / 1px) * 1px : size;
        font-family: icon.s ? "Tessera Symbols" : fill ? "Phosphor-Fill" : bold ? "Phosphor-Bold" : "Phosphor";
        vertical-alignment: center;
        horizontal-alignment: center;
        accessible-role: none;
    }
}

// A spinner (ListRow's busy): the circle-notch turning
component Spin {
    in property <CcIc> icon;
    in property <color> color: Theme.secondary;
    in property <length> size: 14px;
    Ic {
        icon: icon;
        size: size;
        color: color;
        transform-rotation: mod(animation-tick() / 800ms, 1) * 360deg;
    }
}

// A ghost icon button (IconButton.qml)
component GhostButton inherits Rectangle {
    in property <CcIc> icon;
    in property <bool> fill;
    in property <color> icon-color: Theme.secondary;
    in property <length> icon-size: 16px;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> dim-disabled: true;
    callback clicked();
    border-radius: Theme.material ? (t.pressed ? min(8px, self.height / 2) : self.height / 2) : Theme.radius-control - 2px;
    background: !enabled ? transparent : Theme.material ? (t.pressed ? Theme.m3-on-surface-variant.with-alpha(0.1) : t.has-hover ? Theme.m3-on-surface-variant.with-alpha(0.08) : transparent)
        : t.pressed ? Theme.fill-pressed : t.has-hover ? Theme.fill : transparent;
    animate background { duration: 150ms; }
    opacity: enabled || !dim-disabled ? 1 : 0.38;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    Ic {
        icon: icon;
        fill: root.fill;
        color: icon-color;
        size: icon-size;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Glass's slider (CapsuleSlider.qml): the capsule fills with white; wide it
// fills from the left, standing from the bottom; drag, click or scroll;
// right-click or press and hold for its page
component CapsuleSlider {
    in property <CcIc> icon;
    in property <float> value;
    in property <bool> has-more;
    in property <bool> enabled: true;
    in property <color> accent-glyph;
    callback moved(float);
    callback more();
    property <bool> vertical: self.height > self.width;
    property <length> thick: vertical ? self.width : self.height;
    property <float> v: max(0, min(1, value));
    property <float> before;
    property <bool> held;
    accessible-role: slider;
    accessible-value: round(v * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-action-increment => { moved(min(1, value + 0.05)); }
    accessible-action-decrement => { moved(max(0, value - 0.05)); }
    Rectangle {
        border-radius: thick / 2;
        background: Theme.toggle-off;
        clip: true;
        fill := Rectangle {
            property <length> len: max(thick, (vertical ? root.height : root.width) * v);
            animate len { duration: touch.pressed ? 0ms : 150ms; }
            x: 0;
            y: vertical ? root.height - self.len : 0;
            width: vertical ? root.width : self.len;
            height: vertical ? self.len : root.height;
            border-radius: thick / 2;
            background: Theme.dark ? #ffffffeb : #ffffff;
        }
    }
    Ic {
        property <length> sz: round(min(22px, thick * 0.36) / 1px) * 1px;
        property <length> inset: round((thick - sz) / 2 / 1px) * 1px;
        x: vertical ? (root.width - sz) / 2 : inset;
        y: vertical ? root.height - sz - inset : (root.height - sz) / 2;
        width: sz;
        height: sz;
        icon: icon;
        fill: true;
        size: sz;
        color: accent-glyph;
    }
    function at() -> float {
        return max(0, min(1, vertical ? 1 - touch.mouse-y / root.height : touch.mouse-x / root.width));
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                if e.button == PointerEventButton.right {
                    if has-more { more(); }
                } else if e.button == PointerEventButton.left {
                    held = false;
                    before = value;
                    if has-more { hold.running = true; }
                    moved(at());
                }
            }
            if e.kind == PointerEventKind.up { hold.running = false; }
        }
        moved => {
            if held { return; }
            if abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 6px { hold.running = false; }
            moved(at());
        }
        scroll-event(e) => {
            if e.delta-y != 0 {
                moved(max(0, min(1, value + (e.delta-y > 0 ? 0.05 : -0.05))));
                return accept;
            }
            return reject;
        }
    }
    hold := Timer {
        interval: 550ms;
        running: false;
        triggered => {
            self.running = false;
            held = true;
            moved(before);
            more();
        }
    }
}

// ── Glass: a module (ModuleView.qml) ────────────────────────────────────────
component GlassModule {
    in property <CcMod> m;
    in property <length> unit;
    in property <bool> chip;
    in property <bool> editing;
    in property <bool> dimmed;
    in property <bool> kbd-focus;
    in property <color> accent-glyph;
    in property <CcMedia> media;
    in property <CcGlyphs> g;
    in property <bool> cast;
    in property <bool> casting;
    callback act();
    callback open-page();
    callback secondary(length, length);
    callback remove();
    callback resize();
    callback dropped(length, length);
    callback slide(float);
    callback media-do(string);

    property <bool> is-round: m.cols == 1 && m.rows == 1 && (m.kind == 0 || m.kind == 1);
    property <bool> pill: m.rows == 1 && m.cols == 2 && (m.kind == 0 || m.kind == 1 || m.kind == 4);
    property <length> shape-radius: is-round || pill || m.kind == 2 ? min(self.width, self.height) / 2 : min(unit / 2, min(self.width, self.height) / 2);
    property <color> idle: chip ? #ffffff.with-alpha(Theme.dark ? 0.07 : 0.28) : Theme.platter;
    property <float> dim: dimmed ? 1 : 0;
    animate dim { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    out property <length> drag-dx;
    out property <length> drag-dy;
    out property <bool> dragging: editing && bg.pressed && (abs(drag-dx) > 3px || abs(drag-dy) > 3px);
    property <bool> held;

    // (QML: the others blur and fade back; Slint has no blur, they fade)
    opacity: 1 - 0.6 * dim; // (QML: 0.45 and a blur; without the blur, a deeper fade)
    transform-scale: (m.focused ? 1.04 : 1) * (bg.pressed && !editing && m.kind != 2 ? 0.95 : 1);
    animate transform-scale { duration: 300ms; easing: spring(0.35); }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    accessible-role: button;
    accessible-label: m.label;
    accessible-description: m.status;
    accessible-checkable: m.kind == 0;
    accessible-checked: m.on;
    accessible-action-default => { act(); }

    // (Glass draws the chip's glass under it: the part's shapes)
    if chip: Rectangle {
        border-radius: shape-radius;
        background: Theme.panel;
    }
    if chip && m.kind == 2: Rectangle {
        border-radius: shape-radius;
        background: Theme.toggle-off;
    }
    if m.kind != 2: Rectangle {
        border-radius: shape-radius;
        background: is-round ? (m.on ? #ffffff : bg.has-hover ? Theme.fill-hover : idle) : idle;
        animate background { duration: 150ms; }
        border-width: 1px;
        border-color: #ffffff.with-alpha(Theme.dark ? 0.06 : 0.3);
    }
    if kbd-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: shape-radius + 4px;
        border-width: 2px;
        border-color: Theme.accent;
    }

    bg := TouchArea {
        mouse-cursor: editing ? (self.pressed ? grabbing : grab) : pointer;
        enabled: m.kind != 2 || editing;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                drag-dx = 0;
                drag-dy = 0;
                held = false;
                if !editing { hold.running = true; }
            }
            if e.kind == PointerEventKind.up {
                hold.running = false;
                if e.button == PointerEventButton.right && !editing {
                    secondary(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                if editing && e.button == PointerEventButton.left && (abs(drag-dx) > 3px || abs(drag-dy) > 3px) {
                    dropped(m.x + drag-dx + root.width / 2, m.y + drag-dy + root.height / 2);
                }
            }
        }
        moved => {
            if editing {
                drag-dx += self.mouse-x - self.pressed-x;
                drag-dy += self.mouse-y - self.pressed-y;
            } else if abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 6px {
                hold.running = false;
            }
        }
        clicked => {
            if held { return; }
            if editing {
                if abs(drag-dx) <= 3px && abs(drag-dy) <= 3px { resize(); }
            } else if m.menu && !is-round {
                secondary(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            } else if !is-round && m.page {
                open-page();
            } else {
                act();
            }
        }
    }
    hold := Timer {
        interval: 800ms;
        running: false;
        triggered => {
            self.running = false;
            held = true;
            secondary(bg.absolute-position.x + bg.mouse-x, bg.absolute-position.y + bg.mouse-y);
        }
    }

    // 1×1 toggles and actions: the icon
    if is-round: Ic {
        icon: m.icon;
        fill: m.on;
        size: round(root.width * 0.36 / 1px) * 1px;
        color: m.on ? accent-glyph : Theme.label;
    }

    // 2×1 / 2×2 toggles and actions: the button, title and status
    if !is-round && (m.kind == 0 || m.kind == 1): Rectangle {
        property <length> size: min(40px, root.height - 20px);
        btn := Rectangle {
            x: pill ? round((root.height - self.width) / 2 / 1px) * 1px : 10px;
            y: m.rows == 1 ? (root.height - self.height) / 2 : 14px;
            width: size;
            height: size;
            border-radius: self.width / 2;
            background: m.on ? #ffffff : bt.has-hover ? Theme.fill-hover : Theme.toggle-off;
            animate background { duration: 150ms; }
            transform-scale: bt.pressed ? 0.95 : 1;
            animate transform-scale { duration: 150ms; }
            Ic {
                icon: m.icon;
                fill: m.on;
                size: round(size * 0.5 / 1px) * 1px;
                color: m.on ? accent-glyph : Theme.label;
            }
            bt := TouchArea {
                enabled: !editing;
                mouse-cursor: pointer;
                clicked => { act(); }
            }
        }
        VerticalLayout {
            x: m.rows == 1 ? btn.x + btn.width + 10px : 14px;
            width: root.width - self.x - 10px;
            y: m.rows == 1 ? (root.height - self.preferred-height) / 2 : root.height - self.preferred-height - 14px;
            height: self.preferred-height;
            Text {
                text: m.label;
                overflow: elide;
                color: Theme.label;
                font-size: Theme.small;
                font-weight: 600;
            }
            if m.status != "": Text {
                text: m.status;
                overflow: elide;
                color: Theme.secondary;
                font-size: Theme.caption;
            }
        }
    }

    // Sliders (4×1 across, 1×2 standing): the capsule
    if m.kind == 2: CapsuleSlider {
        width: root.width;
        height: root.height;
        icon: m.icon;
        value: m.value;
        has-more: m.page && !editing;
        enabled: !editing;
        accent-glyph: accent-glyph;
        moved(v) => { slide(v); }
        more => { open-page(); }
    }

    // Now Playing
    if m.kind == 3: Rectangle {
        property <length> inset: m.rows == 2 ? 12px : 10px;
        art := Rectangle {
            x: inset;
            y: m.rows == 2 ? 12px : (root.height - self.height) / 2;
            width: m.rows == 2 ? 56px : root.height - 20px;
            height: self.width;
            border-radius: max(6px, shape-radius - inset);
            background: Theme.fill;
            clip: true;
            if media.has-art: Image {
                width: 100%;
                height: 100%;
                source: media.art;
                image-fit: cover;
            }
            if !media.has-art: Ic {
                icon: g.notes;
                size: 22px;
                color: Theme.tertiary;
            }
        }
        VerticalLayout {
            x: m.rows == 2 ? 12px : art.x + art.width + 10px;
            width: (m.rows == 2 ? root.width - 10px : controls.x - 10px) - self.x;
            y: m.rows == 2 ? art.y + art.height + 8px : (root.height - self.preferred-height) / 2;
            height: self.preferred-height;
            Text {
                text: media.title != "" ? media.title : "Not Playing";
                overflow: elide;
                color: Theme.label;
                font-size: Theme.small;
                font-weight: 600;
            }
            Text {
                text: media.artist;
                overflow: elide;
                color: Theme.secondary;
                font-size: Theme.caption;
            }
        }
        if (cast || casting) && m.rows == 2: GhostButton {
            x: root.width - self.width - 4px;
            y: 4px;
            width: 28px;
            height: 28px;
            icon: g.cast;
            fill: casting;
            icon-size: 15px;
            icon-color: casting ? Theme.accent : Theme.secondary;
            label: "Cast to a TV";
            enabled: !editing;
            clicked => { media-do("cast"); }
        }
        controls := HorizontalLayout {
            width: 96px;
            height: 32px;
            x: m.rows == 2 ? (root.width - self.width) / 2 : root.width - self.width - 6px;
            y: m.rows == 2 ? root.height - 32px - 6px : (root.height - 32px) / 2;
            GhostButton {
                width: 32px;
                height: 32px;
                icon: g.prev;
                fill: true;
                icon-size: 16px;
                icon-color: Theme.label;
                label: "Previous";
                dim-disabled: false;
                enabled: !editing && media.has;
                clicked => { media-do("previous"); }
            }
            GhostButton {
                width: 32px;
                height: 32px;
                icon: media.playing ? g.pause : g.play;
                fill: true;
                icon-size: 16px;
                icon-color: Theme.label;
                label: media.playing ? "Pause" : "Play";
                dim-disabled: false;
                enabled: !editing && media.has;
                clicked => { media-do("toggle"); }
            }
            GhostButton {
                width: 32px;
                height: 32px;
                icon: g.next;
                fill: true;
                icon-size: 16px;
                icon-color: Theme.label;
                label: "Next";
                dim-disabled: false;
                enabled: !editing && media.has;
                clicked => { media-do("next"); }
            }
        }
    }

    // Info cards: battery, CPU & memory, weather
    if m.kind == 4: Rectangle {
        property <bool> one: m.cols == 1 && m.rows == 1;
        property <length> isz: pill ? min(40px, root.height - 20px) : 20px;
        property <length> margin: pill ? round((root.height - isz) / 2 / 1px) * 1px : 12px;
        ic := Rectangle {
            visible: one || m.rows == 1;
            x: one ? (root.width - self.width) / 2 : margin;
            y: one ? margin : (root.height - self.height) / 2;
            width: isz;
            height: isz;
            border-radius: self.width / 2;
            background: pill ? Theme.toggle-off : transparent;
            Ic {
                icon: m.icon;
                size: pill ? round(isz * 0.5 / 1px) * 1px : 20px;
                color: Theme.label;
            }
        }
        if !one: VerticalLayout {
            x: ic.visible ? ic.x + ic.width + 10px : margin;
            width: root.width - self.x - margin;
            y: m.rows == 1 ? (root.height - self.preferred-height) / 2 : margin;
            height: self.preferred-height;
            spacing: 2px;
            Text {
                text: m.title;
                color: Theme.label;
                font-size: m.rows == 2 ? Theme.large : Theme.small;
                font-weight: 600;
            }
            Text {
                text: m.sub;
                overflow: elide;
                color: Theme.secondary;
                font-size: Theme.caption;
            }
        }
        if one: Text {
            y: root.height - self.preferred-height - margin;
            width: root.width;
            horizontal-alignment: center;
            text: m.title;
            color: Theme.secondary;
            font-size: Theme.caption;
        }
    }

    // The remove badge
    if editing: Rectangle {
        x: -6px;
        y: -6px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.dark ? #3a3a40 : #E4E4E7;
        border-width: 1px;
        border-color: Theme.separator;
        accessible-role: button;
        accessible-label: "Remove " + m.label;
        accessible-action-default => { remove(); }
        Rectangle {
            width: 9px;
            height: 2px;
            border-radius: 1px;
            background: Theme.label;
        }
        TouchArea {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            mouse-cursor: pointer;
            clicked => { remove(); }
        }
    }
}

// Material's slider (QSSlider.qml): the done part (primary) and the rest
// (secondaryContainer) split by a thin handle with a gap each side; the icon
// in the done part while it fits, else past the handle; standing (1×2) it
// rises from the bottom
component QsSlider {
    in property <CcIc> icon;
    in property <float> value;
    in property <bool> has-more;
    in property <length> track: 52px;
    in property <bool> vertical;
    in property <bool> enabled: true;
    callback moved(float);
    callback more();
    property <length> along: vertical ? self.height : self.width;
    property <length> across: vertical ? self.width : self.height;
    property <float> v: max(0, min(1, value));
    property <float> shown: v;
    animate shown { duration: touch.pressed ? 0ms : 150ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    property <length> corner: touch.pressed ? 8px : track / 2;
    animate corner { duration: 290ms; easing: spring(0.5); }
    property <length> gap: 6px;
    property <length> handle: touch.pressed ? 2px : 4px;
    animate handle { duration: 100ms; }
    property <length> hx: shown * (along - handle);
    property <length> t0: (across - track) / 2;
    property <float> before;
    property <bool> held;
    accessible-role: slider;
    accessible-value: round(v * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-action-increment => { moved(min(1, value + 0.05)); }
    accessible-action-decrement => { moved(max(0, value - 0.05)); }

    property <length> done-len: max(0, hx - gap);
    property <length> rest-x: hx + handle + gap;
    // the done part
    if done-len > 0: Rectangle {
        x: vertical ? t0 : 0;
        y: vertical ? along - done-len : t0;
        width: vertical ? track : done-len;
        height: vertical ? done-len : track;
        border-top-left-radius: vertical ? 2px : corner;
        border-top-right-radius: 2px;
        border-bottom-left-radius: corner;
        border-bottom-right-radius: vertical ? corner : 2px;
        background: enabled ? Theme.m3-primary : Theme.m3-on-surface.with-alpha(0.38);
    }
    // the rest, with its stop dot
    if along - rest-x > 0: Rectangle {
        x: vertical ? t0 : rest-x;
        y: vertical ? 0 : t0;
        width: vertical ? track : along - rest-x;
        height: vertical ? along - rest-x : track;
        border-top-left-radius: vertical ? corner : 2px;
        border-top-right-radius: corner;
        border-bottom-left-radius: 2px;
        border-bottom-right-radius: vertical ? 2px : corner;
        background: enabled ? Theme.m3-secondary-container : Theme.m3-on-surface.with-alpha(0.12);
        if (vertical ? self.height : self.width) > track: Rectangle {
            x: vertical ? (parent.width - 4px) / 2 : parent.width - (track + 4px) / 2;
            y: vertical ? (track - 4px) / 2 : (parent.height - 4px) / 2;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: Theme.m3-on-secondary-container;
        }
    }
    // the handle
    Rectangle {
        x: vertical ? 0 : hx;
        y: vertical ? along - hx - handle : 0;
        width: vertical ? across : handle;
        height: vertical ? handle : across;
        border-radius: handle / 2;
        background: enabled ? Theme.m3-primary : Theme.m3-on-surface.with-alpha(0.38);
    }
    Ic {
        property <length> sz: round(track * 0.42 / 1px) * 1px;
        property <length> inset: round((track - sz) / 2 / 1px) * 1px;
        property <bool> inside: hx - gap >= inset + sz + 6px;
        property <length> pos: inside ? inset : hx + handle + gap + inset * 0.6;
        animate pos { duration: touch.pressed ? 0ms : 150ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        x: vertical ? (root.width - sz) / 2 : pos;
        y: vertical ? along - pos - sz : (root.height - sz) / 2;
        width: sz;
        height: sz;
        icon: icon;
        fill: true;
        size: sz;
        color: inside ? Theme.m3-on-primary : Theme.m3-on-secondary-container;
        animate color { duration: 150ms; }
    }
    function at() -> float {
        return max(0, min(1, vertical ? 1 - touch.mouse-y / root.height : touch.mouse-x / root.width));
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                if e.button == PointerEventButton.right {
                    if has-more { more(); }
                } else if e.button == PointerEventButton.left {
                    held = false;
                    before = value;
                    if has-more { hold.running = true; }
                    moved(at());
                }
            }
            if e.kind == PointerEventKind.up { hold.running = false; }
        }
        moved => {
            if held { return; }
            if abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 6px { hold.running = false; }
            moved(at());
        }
        scroll-event(e) => {
            if e.delta-y != 0 {
                moved(max(0, min(1, value + (e.delta-y > 0 ? 0.05 : -0.05))));
                return accept;
            }
            return reject;
        }
    }
    hold := Timer {
        interval: 550ms;
        running: false;
        triggered => {
            self.running = false;
            held = true;
            moved(before);
            more();
        }
    }
}

// A round tonal icon button (QuickSettings' TonalButton): strong is
// primaryContainer and wider (Power); a press squares it off
component TonalButton inherits Rectangle {
    in property <CcIc> icon;
    in property <string> tip;
    in property <bool> strong;
    in property <length> corner: self.height / 2;
    callback clicked();
    width: 40px;
    height: 40px;
    property <color> ink: strong ? Theme.m3-on-primary-container : Theme.m3-on-surface-variant;
    border-radius: t.pressed ? min(12px, corner) : corner;
    animate border-radius { duration: 222ms; easing: spring(0.4); }
    background: (strong ? Theme.m3-primary-container : Theme.m3-surface-container-highest).mix(ink, t.pressed ? 0.9 : t.has-hover ? 0.92 : 1);
    animate background { duration: 150ms; }
    accessible-role: button;
    accessible-label: tip;
    accessible-action-default => { clicked(); }
    Ic {
        icon: icon;
        fill: strong;
        size: 20px;
        color: ink;
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Material: a tile (QSTile.qml) ───────────────────────────────────────────
component QsTile {
    in property <CcMod> m;
    in property <bool> editing;
    in property <bool> kbd-focus;
    in property <{down: CcIc, right: CcIc}> chevrons;
    callback act();
    callback detail(length, length); // a large tile's name: its choices, page, else the switch
    callback secondary(length, length);
    callback remove();
    callback resize();
    callback pressed-changed(bool);
    callback dropped(length, length);
    out property <bool> pressed: tile.pressed || icon-touch.pressed;
    out property <length> drag-dx;
    out property <length> drag-dy;
    out property <bool> dragging: editing && tile.pressed && (abs(drag-dx) > 3px || abs(drag-dy) > 3px);
    property <bool> large: m.cols >= 2;
    property <bool> info: m.kind == 4;
    property <bool> on: !editing && m.on;
    property <color> container: on ? (large ? Theme.m3-primary-container : Theme.m3-primary) : Theme.m3-surface-container-highest;
    property <color> ink: on ? (large ? Theme.m3-on-primary-container : Theme.m3-on-primary) : Theme.m3-on-surface;
    property <color> sub-ink: on ? Theme.m3-on-primary-container.with-alpha(0.8) : Theme.m3-on-surface-variant;
    property <string> title: m.kind == 4 ? m.title : m.label;
    property <string> subtitle: m.kind == 4 ? m.sub : m.status;
    property <length> rest-corner: on ? min(self.height, 72px) / 2 : 20px;
    property <length> corner: pressed ? rest-corner * 0.7 : rest-corner;
    animate corner { duration: 290ms; easing: spring(0.5); }
    property <bool> held;
    changed pressed => { pressed-changed(pressed); }
    accessible-role: button;
    accessible-label: info ? m.label + ", " + title : m.label;
    accessible-description: subtitle;
    accessible-checkable: m.kind == 0;
    accessible-checked: on;
    accessible-action-default => { act(); }

    Rectangle {
        border-radius: corner;
        background: container.mix(ink, tile.pressed ? 0.9 : tile.has-hover && !icon-touch.has-hover && !editing ? 0.92 : 1);
        animate background { duration: 150ms; }
    }
    if kbd-focus: Rectangle {
        x: -5px;
        y: -5px;
        width: parent.width + 10px;
        height: parent.height + 10px;
        border-radius: corner + 5px;
        border-width: 2px;
        border-color: Theme.m3-primary;
    }
    tile := TouchArea {
        mouse-cursor: editing ? (self.pressed ? grabbing : grab) : pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                drag-dx = 0;
                drag-dy = 0;
                held = false;
                if !editing { hold.running = true; }
            }
            if e.kind == PointerEventKind.up {
                hold.running = false;
                if e.button == PointerEventButton.right && !editing {
                    secondary(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                if editing && e.button == PointerEventButton.left && (abs(drag-dx) > 3px || abs(drag-dy) > 3px) {
                    dropped(m.x + drag-dx + root.width / 2, m.y + drag-dy + root.height / 2);
                }
            }
        }
        moved => {
            if editing {
                drag-dx += self.mouse-x - self.pressed-x;
                drag-dy += self.mouse-y - self.pressed-y;
            } else if abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 6px {
                hold.running = false;
            }
        }
        clicked => {
            if held { return; }
            if editing {
                if abs(drag-dx) <= 3px && abs(drag-dy) <= 3px { resize(); }
            } else if large {
                detail(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            } else {
                act();
            }
        }
    }
    hold := Timer {
        interval: 550ms;
        running: false;
        triggered => {
            self.running = false;
            held = true;
            secondary(tile.absolute-position.x + tile.mouse-x, tile.absolute-position.y + tile.mouse-y);
        }
    }

    // Small: the icon (the battery's reading under it)
    if !large: Ic {
        y: (root.height - 22px) / 2 - (info && m.id == "battery" ? 9px : 0);
        height: 22px;
        icon: m.icon;
        fill: on;
        size: 22px;
        color: ink;
    }
    if !large && info && m.id == "battery": Text {
        y: root.height / 2 + 14px - self.preferred-height / 2;
        width: root.width;
        horizontal-alignment: center;
        text: title;
        color: sub-ink;
        font-size: 12px;
        font-weight: 500;
    }

    // Large: the icon button, the name and state, a chevron
    Rectangle {
        visible: large;
        property <length> size: min(root.height, 72px) - 24px;
        ib := Rectangle {
            x: round((min(root.height, 72px) - size) / 2 / 1px) * 1px;
            y: (root.height - size) / 2;
            width: size;
            height: size;
            border-radius: (on ? size / 2 : 16px) * (icon-touch.pressed ? 0.7 : 1);
            animate border-radius { duration: 222ms; easing: spring(0.4); }
            background: on ? Theme.m3-primary.mix(Theme.m3-on-primary, icon-touch.pressed ? 0.9 : icon-touch.has-hover ? 0.92 : 1)
                : container.mix(Theme.m3-on-surface, icon-touch.pressed ? 0.82 : icon-touch.has-hover ? 0.86 : 0.92);
            animate background { duration: 150ms; }
            Ic {
                icon: m.icon;
                fill: on;
                size: 20px;
                color: on ? Theme.m3-on-primary : Theme.m3-on-surface;
            }
            icon-touch := TouchArea {
                x: -6px;
                y: -6px;
                width: parent.width + 12px;
                height: parent.height + 12px;
                enabled: !editing;
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                        secondary(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                clicked => { act(); }
            }
        }
        property <bool> chev: !editing && (m.menu || m.page);
        VerticalLayout {
            x: ib.x + ib.width + 12px;
            width: (chev ? root.width - 14px - 16px - 4px : root.width - 16px) - self.x;
            y: (root.height - self.preferred-height) / 2;
            height: self.preferred-height;
            Text {
                text: title;
                overflow: elide;
                color: ink;
                font-size: 14px;
                font-weight: 500;
            }
            if subtitle != "": Text {
                text: subtitle;
                overflow: elide;
                color: sub-ink;
                font-size: 12px;
            }
        }
    }

    if large && !editing && (m.menu || m.page): Ic {
        x: root.width - 14px - 16px;
        width: 16px;
        icon: m.menu ? chevrons.down : chevrons.right;
        size: 16px;
        color: sub-ink;
    }

    // Edit controls: the remove badge
    if editing: Rectangle {
        x: -6px;
        y: -6px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Theme.m3-inverse-surface;
        accessible-role: button;
        accessible-label: "Remove " + m.label;
        accessible-action-default => { remove(); }
        Rectangle {
            width: 10px;
            height: 2px;
            border-radius: 1px;
            background: Theme.m3-inverse-on-surface;
        }
        TouchArea {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            mouse-cursor: pointer;
            clicked => { remove(); }
        }
    }
}

// ── Material: the media card (QSMedia.qml) ──────────────────────────────────
component QsMedia {
    in property <CcMedia> media;
    in property <CcGlyphs> g;
    in property <bool> active: true;
    in property <bool> cast;
    in property <bool> casting;
    callback media-do(string);
    property <bool> slim: self.height < 100px;
    property <bool> compact: !slim && self.width < 300px;
    property <color> ink: Theme.m3-on-secondary-container;
    Rectangle {
        border-radius: 28px;
        background: Theme.m3-secondary-container;
    }
    art := Rectangle {
        x: slim ? 12px : 16px;
        y: slim ? (root.height - self.height) / 2 : 16px;
        width: slim ? root.height - 24px : compact ? 56px : root.height - 32px;
        height: self.width;
        // (QML: a cookie while playing, a circle paused; here a circle that
        // squares a little while playing)
        border-radius: media.playing ? self.width * 0.32 : self.width / 2;
        animate border-radius { duration: 322ms; easing: spring(0.2); }
        background: Theme.m3-tertiary-container;
        clip: true;
        if media.has-art: Image {
            width: 100%;
            height: 100%;
            source: media.art;
            image-fit: cover;
        }
        if !media.has-art: Ic {
            icon: g.notes;
            fill: true;
            size: 32px;
            color: Theme.m3-on-tertiary-container;
        }
    }
    VerticalLayout {
        x: art.x + art.width + (compact ? 12px : 16px);
        width: (slim ? controls.x : compact ? root.width : play.x) - self.x - (compact ? 16px : 12px);
        y: slim ? (root.height - self.preferred-height) / 2 : 16px;
        height: self.preferred-height;
        if media.identity != "": Text {
            text: media.identity;
            overflow: elide;
            color: ink.with-alpha(0.72);
            font-size: 12px;
            font-weight: 500;
        }
        Text {
            text: media.title != "" ? media.title : "Not playing";
            overflow: elide;
            color: ink;
            font-size: 16px;
            font-weight: 500;
        }
        if media.artist != "": Text {
            text: media.artist;
            overflow: elide;
            color: ink.with-alpha(0.8);
            font-size: 14px;
        }
    }
    controls := Rectangle {
        x: slim ? root.width - 12px - 136px : compact ? 12px : art.x + art.width + 8px;
        width: slim ? 136px : compact ? root.width - 24px : root.width - (art.x + art.width + 8px) - 8px;
        y: compact ? root.height - self.height - 12px : slim ? (root.height - self.height) / 2 : art.y + art.height - self.height + 4px;
        height: 40px;
        GhostButton {
            x: 0;
            width: 40px;
            height: 40px;
            icon: g.prev;
            fill: true;
            icon-size: 20px;
            icon-color: ink;
            label: "Previous";
            enabled: active && media.prev;
            clicked => { media-do("previous"); }
        }
        if !slim && !compact: Rectangle {
            x: 44px;
            width: parent.width - 88px - (cast-btn.visible ? 40px : 0);
            height: 20px;
            y: 10px;
            Rectangle {
                y: 8px;
                width: media.timed ? max(4px, parent.width * media.progress) : 0;
                height: 4px;
                border-radius: 2px;
                background: Theme.m3-primary;
            }
            Rectangle {
                x: media.timed ? parent.width * media.progress + 4px : 0;
                y: 8px;
                width: max(0, parent.width - self.x);
                height: 4px;
                border-radius: 2px;
                background: ink.with-alpha(0.18);
            }
            TouchArea {
                enabled: media.seek && media.timed && active;
                mouse-cursor: pointer;
                clicked => { media-do("seek:" + max(0, min(1, self.mouse-x / self.width))); }
            }
        }
        GhostButton {
            x: parent.width - 40px - (cast-btn.visible ? 40px : 0);
            width: 40px;
            height: 40px;
            icon: g.next;
            fill: true;
            icon-size: 20px;
            icon-color: ink;
            label: "Next";
            enabled: active && media.next;
            clicked => { media-do("next"); }
        }
        cast-btn := GhostButton {
            visible: (cast || casting) && !slim && !compact;
            x: parent.width - 40px;
            width: 40px;
            height: 40px;
            icon: g.cast;
            fill: casting;
            icon-size: 18px;
            icon-color: casting ? Theme.m3-primary : ink;
            label: "Cast to a TV";
            clicked => { media-do("cast"); }
        }
    }
    play := Rectangle {
        property <bool> can: active && media.toggle;
        x: compact ? (root.width - self.width) / 2 : slim ? controls.x + (controls.width - self.width) / 2 : root.width - self.width - 16px;
        y: compact ? controls.y + (controls.height - self.height) / 2 : slim ? (root.height - self.height) / 2 : 16px;
        width: 48px;
        height: 48px;
        border-radius: pt.pressed ? 10px : media.playing ? 16px : 24px;
        animate border-radius { duration: 222ms; easing: spring(0.4); }
        background: can ? Theme.m3-primary.mix(Theme.m3-on-primary, pt.pressed ? 0.9 : pt.has-hover ? 0.92 : 1) : Theme.m3-on-surface.with-alpha(0.12);
        animate background { duration: 150ms; }
        accessible-role: button;
        accessible-label: media.playing ? "Pause" : "Play";
        accessible-action-default => { media-do("toggle"); }
        Ic {
            icon: media.playing ? g.pause : g.play;
            fill: true;
            size: 22px;
            color: play.can ? Theme.m3-on-primary : Theme.m3-on-surface.with-alpha(0.38);
        }
        pt := TouchArea {
            enabled: play.can;
            mouse-cursor: pointer;
            clicked => { media-do("toggle"); }
        }
    }
}

// ── A page's block (ListRow.qml and friends), both looks ────────────────────
component Block inherits VerticalLayout {
    in property <CcBlock> b;
    in property <bool> focused; // the keyboard is on it
    in property <CcGlyphs> g;
    in property <color> accent-glyph;
    callback do(string, string); // what, text
    callback menu-at(length, length);
    callback slide(float);
    property <bool> m3: Theme.material;
    property <length> row-h: m3 ? (b.status != "" ? 56px : 48px) : 40px;

    // Head
    if b.kind == 0: VerticalLayout {
        padding-left: 6px;
        padding-top: b.gap >= 1px ? (m3 ? 12px : 8px) : 0;
        padding-bottom: m3 ? 6px : 2px;
        Text {
            text: b.title;
            color: m3 ? Theme.m3-primary : Theme.tertiary;
            font-size: m3 ? 14px : Theme.caption;
            font-weight: m3 ? 500 : 600;
        }
    }

    // Row
    if b.kind == 1: Rectangle {
        height: row-h;
        opacity: b.dis ? 0.5 : 1;
        property <length> inner: b.hl || rt.pressed ? 16px : rt.has-hover ? 12px : 4px;
        animate inner { duration: 222ms; easing: spring(0.4); }
        // Material: the segment (Glass: a hover fill)
        Rectangle {
            border-radius: m3 ? 0 : Theme.radius-control;
            border-top-left-radius: m3 ? (b.first ? 20px : inner) : Theme.radius-control;
            border-top-right-radius: m3 ? (b.first ? 20px : inner) : Theme.radius-control;
            border-bottom-left-radius: m3 ? (b.last ? 20px : inner) : Theme.radius-control;
            border-bottom-right-radius: m3 ? (b.last ? 20px : inner) : Theme.radius-control;
            background: m3 ? (b.hl ? Theme.m3-primary-container : Theme.m3-surface-container-high).mix(b.hl ? Theme.m3-on-primary-container : Theme.m3-on-surface, rt.pressed ? 0.9 : rt.has-hover ? 0.92 : 1)
                : rt.pressed ? Theme.fill-pressed : rt.has-hover ? Theme.fill : transparent;
            animate background { duration: 150ms; }
        }
        if focused: Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: (m3 ? 20px : Theme.radius-control) + 3px;
            border-width: 2px;
            border-color: m3 ? Theme.m3-primary : Theme.accent;
        }
        rt := TouchArea {
            enabled: !b.dis;
            pointer-event(e) => {
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                    menu-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            clicked => { do("click", ""); }
        }
        badge := Rectangle {
            x: m3 ? 10px : 6px;
            width: m3 ? 36px : 28px;
            height: self.width;
            border-radius: self.width / 2;
            background: b.has-pic ? transparent : b.hl ? Theme.accent : Theme.toggle-off;
            if b.has-pic: Image {
                width: 100%;
                height: 100%;
                source: b.pic;
                image-fit: contain;
            }
            if !b.has-pic: Ic {
                icon: b.icon;
                fill: b.hl;
                size: m3 ? 18px : 15px;
                color: b.hl ? Theme.on-accent : Theme.label;
            }
            if b.has-pic && b.hl: Rectangle {
                x: parent.width - 8px;
                y: parent.height - 8px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Theme.accent;
                border-width: 2px;
                border-color: Theme.glass-solid;
            }
        }
        property <length> right-edge: root.width - (m3 ? 16px : 10px) - (b.trail.t != "" || b.busy ? (m3 ? 22px : 14px) : 0) - (b.act.t != "" ? 32px : 0) - 8px;
        VerticalLayout {
            x: badge.x + badge.width + (m3 ? 14px : 10px);
            width: right-edge - self.x;
            y: (parent.height - self.preferred-height) / 2;
            height: self.preferred-height;
            Text {
                text: b.title;
                overflow: elide;
                color: m3 && b.hl ? Theme.m3-on-primary-container : Theme.label;
                font-size: m3 ? 14px : Theme.body;
                font-weight: b.hl ? (m3 ? 500 : 600) : 400;
            }
            if b.status != "": Text {
                text: b.status;
                overflow: elide;
                color: m3 && b.hl ? Theme.m3-on-primary-container.with-alpha(0.8) : Theme.secondary;
                font-size: m3 ? 12px : Theme.caption;
            }
        }
        if b.busy: Spin {
            x: parent.width - (m3 ? 14px : 10px) - self.width;
            width: m3 ? 22px : 14px;
            icon: g.spinner;
            size: m3 ? 20px : 14px;
            color: m3 && b.hl ? Theme.m3-on-primary-container : Theme.secondary;
        }
        if !b.busy && b.trail.t != "": Ic {
            x: parent.width - (m3 ? 16px : 10px) - self.width;
            width: m3 ? 18px : 14px;
            icon: b.trail;
            size: m3 ? 18px : 14px;
            color: m3 && b.hl ? Theme.m3-on-primary-container : Theme.secondary;
        }
        if b.act.t != "": GhostButton {
            x: parent.width - (m3 ? 16px : 10px) - (b.trail.t != "" ? (m3 ? 18px : 14px) + 4px : 0) - self.width;
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            icon: b.act;
            icon-size: 15px;
            label: "Share this network";
            clicked => { do("action", ""); }
        }
    }

    // Note
    if b.kind == 2: VerticalLayout {
      padding-left: 6px;
      padding-right: 6px;
      padding-top: b.center ? 12px : 0;
      padding-bottom: b.center ? 12px : 0;
      Text {
        // (Slint measures wrapped text in a layout as one line: the part
        // estimates its lines)
        min-height: b.gap;
        wrap: word-wrap;
        horizontal-alignment: b.center ? center : left;
        text: b.title;
        color: b.tone == 2 ? Theme.danger : b.tone == 1 ? Theme.tertiary : Theme.secondary;
        font-size: b.tone == 1 ? Theme.caption : Theme.small;
      }
    }

    // Segmented
    if b.kind == 3: Rectangle {
        height: m3 ? 36px : 30px;
        property <int> n: max(1, b.options.length);
        property <length> gap: m3 ? 2px : 0;
        property <length> seg: (root.width - (m3 ? 0 : 4px) - gap * (n - 1)) / n;
        border-radius: self.height / 2;
        background: m3 ? transparent : Theme.toggle-off;
        if !m3: Rectangle {
            x: 2px + b.cur * seg;
            y: 2px;
            width: seg;
            height: parent.height - 4px;
            border-radius: self.height / 2;
            background: Theme.dark ? #ffffff33 : #ffffff;
            animate x { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        }
        for o[i] in b.options: Rectangle {
            x: (m3 ? 0 : 2px) + i * (seg + gap);
            width: seg;
            height: parent.height;
            property <bool> chosen: i == b.cur;
            border-top-left-radius: !m3 ? 0 : chosen || i == 0 ? self.height / 2 : 8px;
            border-bottom-left-radius: self.border-top-left-radius;
            border-top-right-radius: !m3 ? 0 : chosen || i == n - 1 ? self.height / 2 : 8px;
            border-bottom-right-radius: self.border-top-right-radius;
            background: !m3 ? transparent : (chosen ? Theme.m3-primary : Theme.m3-surface-container-highest).mix(chosen ? Theme.m3-on-primary : Theme.m3-on-surface-variant, st.pressed ? 0.9 : st.has-hover ? 0.92 : 1);
            animate background { duration: 150ms; }
            accessible-role: tab;
            accessible-label: o;
            accessible-action-default => { do("seg", i); }
            Text {
                width: parent.width - 8px;
                horizontal-alignment: center;
                overflow: elide;
                text: o;
                color: m3 ? (chosen ? Theme.m3-on-primary : Theme.m3-on-surface-variant) : chosen ? Theme.label : Theme.secondary;
                font-size: m3 ? Theme.body : Theme.small;
                font-weight: m3 ? 500 : 600;
            }
            st := TouchArea {
                mouse-cursor: pointer;
                clicked => { do("seg", i); }
            }
        }
    }

    // Slider (CCSlider.qml): Glass's thin track, Material's medium slider
    if b.kind == 4: Rectangle {
      height: (m3 ? 48px : 26px) + 6px;
      if !m3: Rectangle {
        y: 0;
        height: 26px;
        border-radius: 13px;
        background: Theme.toggle-off;
        clip: true;
        Rectangle {
            x: 0;
            width: max(parent.height, parent.width * max(0, min(1, b.value)));
            animate width { duration: sl.pressed ? 0ms : 150ms; }
            height: parent.height;
            border-radius: 13px;
            background: Theme.dark ? #ffffffeb : #ffffff;
        }
        Ic {
            x: 8px;
            width: 14px;
            icon: b.icon;
            fill: true;
            size: 14px;
            color: #00000099;
        }
        sl := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { slide(max(0, min(1, self.mouse-x / self.width))); }
            }
            moved => { slide(max(0, min(1, self.mouse-x / self.width))); }
            scroll-event(e) => {
                if e.delta-y != 0 {
                    slide(max(0, min(1, b.value + (e.delta-y > 0 ? 0.05 : -0.05))));
                    return accept;
                }
                return reject;
            }
        }
    }
      if m3: QsSlider {
        y: 0;
        height: 48px;
        track: 40px;
        icon: b.icon;
        value: b.value;
        moved(v) => { slide(v); }
      }
    }

    // A Wi-Fi password: the field and Join, Other options…
    if b.kind == 5: VerticalLayout {
        padding-left: 44px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            height: m3 ? 48px : 40px;
            alignment: start;
            Rectangle {
                width: 180px;
                height: m3 ? 40px : 30px;
                y: (parent.height - self.height) / 2;
                border-radius: m3 ? 20px : Theme.radius-control - 2px;
                background: Theme.field-bg;
                border-width: pw.has-focus ? (m3 ? 2px : 1px) : 0;
                border-color: Theme.field-focus;
                if pw.text == "": Text {
                    x: 12px;
                    text: "Password";
                    color: Theme.tertiary;
                    font-size: Theme.body;
                    vertical-alignment: center;
                    height: parent.height;
                }
                pw := TextInput {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    vertical-alignment: center;
                    input-type: password;
                    color: Theme.label;
                    font-size: Theme.body;
                    single-line: true;
                    accessible-label: "Password";
                    accepted => { do("commit", self.text); }
                    key-pressed(e) => {
                        if e.text == Key.Escape {
                            do("cancel", "");
                            return accept;
                        }
                        return reject;
                    }
                }
            }
            Rectangle {
                property <bool> ready: (pw.text.character-count >= 8 && pw.text.character-count <= 63) || pw.text.character-count == 5 || pw.text.character-count == 13 || pw.text.character-count == 10 || pw.text.character-count == 26;
                width: jl.preferred-width + (m3 ? 32px : 24px);
                height: m3 ? 40px : 30px;
                y: (parent.height - self.height) / 2;
                border-radius: m3 ? self.height / 2 : Theme.radius-control - 2px;
                background: ready ? (m3 ? Theme.m3-primary : Theme.accent) : (m3 ? Theme.m3-secondary-container : Theme.fill);
                accessible-role: button;
                accessible-label: "Join";
                accessible-action-default => { do("commit", pw.text); }
                jl := Text {
                    text: "Join";
                    color: parent.ready ? (m3 ? Theme.m3-on-primary : Theme.on-accent) : Theme.label;
                    font-size: Theme.body;
                    font-weight: 500;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { do("commit", pw.text); }
                }
            }
        }
        if b.status != "": Text {
            text: b.status;
            color: Theme.danger;
            font-size: Theme.small;
        }
        Text {
            text: "Other options…";
            color: ot.has-hover ? Theme.accent : Theme.secondary;
            font-size: Theme.small;
            ot := TouchArea {
                mouse-cursor: pointer;
                clicked => { do("other", ""); }
            }
        }
    }

    // Why it doesn't work, and the fix (ServiceNotice.qml)
    if b.kind == 6: VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        Ic {
            height: 24px;
            icon: b.icon;
            size: 24px;
            color: Theme.tertiary;
        }
        Text {
            horizontal-alignment: center;
            wrap: word-wrap;
            text: b.title;
            color: Theme.label;
            font-size: Theme.body;
            font-weight: 600;
        }
        if b.status != "": Text {
            min-height: b.gap;
            horizontal-alignment: center;
            wrap: word-wrap;
            text: b.status;
            color: Theme.secondary;
            font-size: Theme.small;
        }
        if b.options.length > 0: HorizontalLayout {
            alignment: center;
            padding-top: 4px;
            Rectangle {
                width: nl.preferred-width + (m3 ? 48px : 28px);
                height: m3 ? 40px : 30px;
                border-radius: m3 ? self.height / 2 : Theme.radius-control;
                opacity: b.busy ? 0.6 : 1;
                background: m3 ? Theme.m3-primary.mix(Theme.m3-on-primary, nt.pressed ? 0.9 : nt.has-hover ? 0.92 : 1) : nt.pressed ? Theme.accent.darker(0.15) : nt.has-hover ? Theme.accent.darker(0.07) : Theme.accent;
                accessible-role: button;
                accessible-label: b.options[0];
                accessible-action-default => { do("click", ""); }
                nl := Text {
                    text: b.busy ? "Working…" : b.options[0];
                    color: Theme.on-accent;
                    font-size: Theme.small;
                    font-weight: 600;
                }
                nt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { do("click", ""); }
                }
            }
        }
    }

    // An app playing sound: its icon mutes it
    if b.kind == 8: Rectangle {
        height: b.gap;
    }
    if b.kind == 9: Rectangle {
        height: m3 ? 40px : 30px;
        border-radius: m3 ? 20px : Theme.radius-control - 2px;
        background: Theme.field-bg;
        border-width: tf.has-focus ? (m3 ? 2px : 1px) : 0;
        border-color: Theme.field-focus;
        if tf.text == "": Text {
            x: 12px;
            height: parent.height;
            vertical-alignment: center;
            text: b.status;
            color: Theme.tertiary;
            font-size: Theme.body;
        }
        tf := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            text: b.title;
            color: Theme.label;
            font-size: Theme.body;
            accessible-label: b.status;
            accepted => { do("commit", self.text); }
            changed has-focus => {
                if !self.has-focus && self.text != b.title { do("commit", self.text); }
            }
        }
    }
    if b.kind == 7: Rectangle {
        height: 34px;
        Rectangle {
            x: 2px;
            y: 0;
            width: 28px;
            height: 28px;
            border-radius: m3 ? 14px : 6px;
            background: mt.pressed ? Theme.fill-pressed : mt.has-hover ? Theme.fill : transparent;
            animate background { duration: 150ms; }
            accessible-role: button;
            accessible-label: (b.flag ? "Unmute " : "Mute ") + b.title;
            accessible-action-default => { do("mute", ""); }
            Ic {
                icon: b.icon;
                size: 20px;
                color: Theme.label;
                opacity: b.flag ? 0.35 : 1;
            }
            if b.flag: Rectangle {
                x: parent.width - 13px;
                y: parent.height - 13px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: Theme.glass-solid;
                border-width: 1px;
                border-color: Theme.separator;
                Ic {
                    icon: g.speaker-x;
                    fill: true;
                    size: 9px;
                    color: Theme.label;
                }
            }
            mt := TouchArea {
                mouse-cursor: pointer;
                clicked => { do("mute", ""); }
            }
        }
        Text {
            x: 38px;
            y: 0;
            height: 28px;
            width: parent.width - 38px;
            vertical-alignment: center;
            overflow: elide;
            text: b.title;
            color: Theme.label;
            font-size: Theme.body;
            font-weight: 600;
        }
    }
}

// The page's header (DetailPage.qml): Glass: title, refresh and the switch
// in one row; Material: back arrow, title at 22 px, refresh, and the switch
// as Android's main switch bar
component PageHeader {
    in property <string> title;
    in property <bool> back;
    in property <bool> has-switch;
    in property <bool> switch-on;
    in property <string> switch-label;
    in property <bool> refresh;
    in property <CcGlyphs> g;
    callback go-back();
    callback toggled();
    callback refreshed();
    property <bool> m3: Theme.material;
    property <angle> spin;
    animate spin { duration: 500ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    preferred-height: (m3 ? 48px : 30px) + (m3 && has-switch ? 56px + 10px : 0);

    if !m3: Rectangle {
        height: 30px;
        width: root.width;
        y: 0;
        Text {
            x: 2px;
            text: title;
            color: Theme.label;
            font-size: Theme.title;
            font-weight: 600;
            vertical-alignment: center;
            height: parent.height;
        }
        if refresh: Rectangle {
            x: parent.width - (has-switch ? 38px + 10px : 0) - 28px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: rf.pressed ? Theme.fill-pressed : rf.has-hover ? Theme.fill-hover : transparent;
            accessible-role: button;
            accessible-label: "Refresh";
            accessible-action-default => { spin += 360deg; refreshed(); }
            Ic {
                icon: g.refresh;
                size: 14px;
                color: Theme.secondary;
                transform-rotation: spin;
            }
            rf := TouchArea {
                mouse-cursor: pointer;
                clicked => { spin += 360deg; refreshed(); }
            }
        }
        if has-switch: Rectangle {
            x: parent.width - 38px;
            width: 38px;
            height: 22px;
            border-radius: 11px;
            background: switch-on ? Theme.accent : Theme.toggle-off;
            animate background { duration: 150ms; }
            accessible-role: switch;
            accessible-label: switch-label;
            accessible-checkable: true;
            accessible-checked: switch-on;
            accessible-action-default => { toggled(); }
            Rectangle {
                x: switch-on ? parent.width - self.width - 2px : 2px;
                animate x { duration: 220ms; easing: cubic-bezier(0.2, 0.9, 0.1, 1.0); }
                width: parent.height - 4px;
                height: self.width;
                border-radius: self.width / 2;
                background: #ffffff;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { toggled(); }
            }
        }
    }
    if m3: Rectangle {
        y: 0;
        width: root.width;
        height: 48px;
        GhostButton {
            x: 0;
            width: back ? 40px : 0;
            height: 40px;
            visible: back;
            icon: g.back;
            icon-size: 22px;
            icon-color: Theme.m3-on-surface;
            label: "Back";
            clicked => { go-back(); }
        }
        Text {
            x: back ? 48px : 4px;
            width: parent.width - self.x - (refresh ? 48px : 8px);
            height: parent.height;
            vertical-alignment: center;
            overflow: elide;
            text: title;
            color: Theme.m3-on-surface;
            font-size: 22px;
        }
        if refresh: GhostButton {
            x: parent.width - 40px;
            width: 40px;
            height: 40px;
            icon: g.refresh;
            icon-size: 20px;
            icon-color: Theme.m3-on-surface-variant;
            label: "Refresh";
            clicked => { refreshed(); }
        }
    }
    if m3 && has-switch: Rectangle {
        y: 48px + 10px;
        width: root.width;
        height: 56px;
        border-radius: 28px;
        property <color> ink: switch-on ? Theme.m3-on-primary-container : Theme.m3-on-surface;
        background: (switch-on ? Theme.m3-primary-container : Theme.m3-surface-container-highest).mix(ink, bar.pressed ? 0.9 : bar.has-hover ? 0.92 : 1);
        animate background { duration: 150ms; }
        accessible-role: switch;
        accessible-label: switch-label;
        accessible-checkable: true;
        accessible-checked: switch-on;
        accessible-action-default => { toggled(); }
        Text {
            x: 24px;
            width: parent.width - 24px - 52px - 28px;
            height: parent.height;
            vertical-alignment: center;
            overflow: elide;
            text: switch-label;
            color: parent.ink;
            font-size: 16px;
            font-weight: 500;
        }
        bar := TouchArea {
            mouse-cursor: pointer;
            clicked => { toggled(); }
        }
        // Material 3 Expressive's switch: an outlined track, the handle grows when on
        Rectangle {
            x: parent.width - 16px - 52px;
            y: (parent.height - 32px) / 2;
            width: 52px;
            height: 32px;
            border-radius: 16px;
            background: switch-on ? Theme.m3-primary : Theme.m3-surface-container-highest;
            border-width: switch-on ? 0 : 2px;
            border-color: Theme.m3-outline;
            animate background { duration: 150ms; }
            Rectangle {
                property <length> size: bar.pressed ? 28px : switch-on ? 24px : 16px;
                animate size { duration: 222ms; easing: spring(0.4); }
                width: size;
                height: size;
                border-radius: size / 2;
                x: switch-on ? parent.width - 16px - size / 2 : 16px - size / 2;
                animate x { duration: 222ms; easing: spring(0.4); }
                y: (parent.height - size) / 2;
                background: switch-on ? Theme.m3-on-primary : Theme.m3-outline;
                if switch-on: Ic {
                    icon: g.check;
                    size: 16px;
                    bold: true;
                    color: Theme.m3-on-primary-container;
                }
            }
        }
    }
}

// The page: its header, then its blocks scrolling once taller than `cap`
component PageView {
    in property <string> title;
    in property <bool> back;
    in property <bool> has-switch;
    in property <bool> switch-on;
    in property <string> switch-label;
    in property <bool> refresh;
    in property <[CcBlock]> blocks;
    in property <CcGlyphs> g;
    in property <color> accent-glyph;
    in property <length> cap: 360px;
    in property <int> kbd: -1;
    callback go-back();
    callback toggled();
    callback refreshed();
    callback block(int, string, string);
    callback block-menu(int, length, length);
    callback block-slide(int, float);
    preferred-height: hdr.preferred-height + 10px + list.height;
    hdr := PageHeader {
        y: 0;
        width: root.width;
        height: self.preferred-height;
        title: title;
        back: back;
        has-switch: has-switch;
        switch-on: switch-on;
        switch-label: switch-label;
        refresh: refresh;
        g: g;
        go-back => { go-back(); }
        toggled => { toggled(); }
        refreshed => { refreshed(); }
    }
    list := Flickable {
        y: hdr.height + 10px;
        width: root.width;
        height: min(col.preferred-height, cap);
        content-height: col.preferred-height;
        interactive: col.preferred-height > cap + 1px;
        col := VerticalLayout {
            width: list.width;
            spacing: 2px;
            for b[i] in blocks: Block {
                b: b;
                focused: i == kbd;
                g: g;
                accent-glyph: accent-glyph;
                do(what, text) => { block(i, what, text); }
                menu-at(x, y) => { block-menu(i, x, y); }
                slide(v) => { block-slide(i, v); }
            }
        }
    }
}

// Glass's footer button (ControlCenterFooter's FooterButton): round on a
// platter; with text, a pill in the accent (Done)
component GlassFooterButton inherits Rectangle {
    in property <CcIc> icon;
    in property <string> text;
    in property <string> label;
    in property <bool> accent;
    in property <bool> chip;
    callback clicked();
    width: text != "" ? w.preferred-width + 32px : 40px;
    animate width { duration: 150ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    height: 40px;
    border-radius: 20px;
    background: accent ? (t.has-hover ? Theme.accent.darker(0.08) : Theme.accent)
        : t.pressed ? Theme.fill-pressed : t.has-hover ? Theme.fill-hover : chip ? Theme.panel.mix(#ffffff, 0.93) : Theme.platter;
    border-width: chip && !accent ? 1px : 0;
    border-color: #ffffff.with-alpha(Theme.dark ? 0.06 : 0.3);
    transform-scale: t.pressed ? 0.95 : 1;
    animate transform-scale { duration: 150ms; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    if text == "": Ic {
        icon: icon;
        size: 18px;
        color: Theme.label;
    }
    w := Text {
        visible: text != "";
        text: root.text;
        color: Theme.on-accent;
        font-size: Theme.body;
        font-weight: 600;
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── The window ──────────────────────────────────────────────────────────────
export component ControlCenter inherits Window {
    in property <bool> shown;
    in property <bool> bare; // Glass: every control its own glass chip
    in property <bool> editing;
    in property <[CcMod]> modules;
    in property <length> grid-height;
    in property <[CcGal]> gallery;
    in property <bool> paging; // a page is open
    in property <string> page-title;
    in property <bool> page-switch;
    in property <bool> page-switch-on;
    in property <string> page-switch-label;
    in property <bool> page-refresh;
    in property <[CcBlock]> blocks;
    in property <length> sub-y; // Glass: where the control that opened the page is
    in property <bool> battery;
    in property <float> battery-level;
    in property <bool> charging;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <string> user;
    in property <CcMedia> media;
    in property <bool> cast;
    in property <bool> casting;
    in property <CcGlyphs> g;
    in property <color> accent-glyph;
    in property <color> accent-ink;
    in property <bool> press-now;
    in property <int> kbd; // the control the keyboard is on (-1: none)
    in property <[CcMenuItem]> menu;
    in property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <bool> bounce: true; // Material's press bounce (Reduce motion: off)
    in property <int> page-kbd: -1; // the page's row the keyboard is on
    in property <length> page-cap: 4000px; // its list scrolls past this (Wi-Fi, Bluetooth: 360)

    out property <float> openness: shown ? 1 : 0;
    out property <length> panel-x: self.width - 24px - panel-w;
    out property <length> panel-y: 34px - (1 - min(1, openness)) * 8px;
    out property <length> panel-w: content-w + 2 * pad;
    out property <length> panel-h: body-h + 2 * pad;
    out property <float> panel-opacity: min(1, max(0, openness));
    out property <float> sub-show: paging && !Theme.material ? 1 : 0;
    out property <length> sub-w: 320px + 32px;
    out property <length> sub-h: sub-page.preferred-height + 32px;
    out property <length> sub-x: panel-x - sub-w - 10px;
    out property <length> sub-top: max(panel-y, min(sub-y - 16px, self.height - sub-h - 12px));
    out property <length> footer-y: Theme.material ? 0 : grid-height + 12px;
    out property <length> battery-w: bat-row.preferred-width + 28px;
    out property <length> gallery-h: gal-col.preferred-height;
    out property <float> page-t: paging && Theme.material ? 1 : 0;

    callback act(int);
    callback open-page(int, length);
    callback secondary(int, length, length);
    callback remove(int);
    callback resize(int);
    callback dropped(int, length, length);
    callback slide(int, float);
    callback press(int, bool);
    callback media-do(string);
    callback add(string);
    callback reset-layout();
    callback toggle-editing();
    callback settings();
    callback power();
    callback back();
    callback page-switched();
    callback page-refreshed();
    callback block(int, string, string);
    callback block-menu(int, length, length);
    callback block-slide(int, float);
    callback menu-pick(int);
    callback menu-close();
    callback dismissed();
    callback key(string, bool) -> bool; // text, shift: handled?
    callback closed();

    background: transparent;
    no-frame: true;
    title: "Control Center";
    default-font-family: Theme.font;

    property <length> pad: 16px;
    property <length> gap: Theme.material ? 8px : 10px;
    property <length> content-w: Theme.material ? 368px : editing ? 320px + 16px + 260px : 320px;
    animate content-w { duration: 150ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    property <length> max-h: self.height - 34px - 2 * pad - 16px;
    // Glass: the grid, 12, the footer (the gallery beside it while editing)
    property <length> glass-h: max(grid-height + 12px + 40px, editing ? gal-col.preferred-height : 0);
    // Material: the editor's header, the grid, the gallery or the footer
    property <length> home-h: (editing ? edit-head.preferred-height + 12px : 0) + (grid-height > 0 ? grid-height + 12px : 0) + (editing ? m-gal.preferred-height : 48px);
    property <length> m-target: min(max-h, page-t > 0.5 ? m-page.preferred-height : home-h);
    property <length> m-h: m-target;
    animate m-h { duration: 322ms; easing: spring(0.2); }
    property <length> body-h: Theme.material ? m-h : glass-h;
    property <float> stagger: shown ? 1 : 0;
    animate stagger { duration: shown ? 360ms : 0ms; }
    property <float> squeeze: press-now && bounce ? 1 : 0;
    animate squeeze { duration: 290ms; easing: spring(0.57); }
    property <float> page-shown: page-t;
    animate page-shown { duration: 322ms; easing: spring(0.2); }
    out property <float> sub-shown: sub-show;
    animate sub-shown { duration: 363ms; easing: spring(0.31); }
    property <float> dim-shown: paging && !Theme.material ? 1 : 0;
    animate dim-shown { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

    animate openness {
        duration: shown ? 370ms : 154ms;
        easing: shown ? spring(0.3) : cubic-bezier(0.4, 0.0, 1.0, 1.0);
    }
    changed openness => {
        if !shown && openness <= 0.001 { closed(); }
    }

    fs := FocusScope {
        key-pressed(e) => {
            if key(e.text, e.modifiers.shift) { return accept; }
            return reject;
        }
        // A click outside closes it
        TouchArea {
            enabled: shown;
            clicked => { dismissed(); }
        }

        // ── The panel ──
        body := Rectangle {
            x: panel-x;
            y: panel-y;
            width: panel-w;
            height: panel-h;
            opacity: panel-opacity;
            border-radius: Theme.material ? 28px : 36px + pad;
            // (Glass: the plugin's glass under it, its tint over it; bare: none)
            background: Theme.material ? Theme.m3-surface-container.with-alpha(Theme.panel-alpha) : bare ? transparent : Theme.panel;
            border-width: Theme.material || bare ? 0 : 0.5px;
            border-color: Theme.separator;
            drop-shadow-blur: Theme.material ? 24px : 0;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: Theme.material ? 4px : 0;
            // clicks on the panel's empty parts stay here
            TouchArea { }

            // ── Glass ──
            Rectangle {
                visible: !Theme.material;
                x: pad;
                y: pad;
                width: content-w;
                height: glass-h;
                // the dim while a page is open
                Rectangle {
                    x: -pad;
                    y: -pad;
                    width: parent.width + 2 * pad;
                    height: parent.height + 2 * pad;
                    border-radius: body.border-radius;
                    background: #000000.with-alpha(0.14 * dim-shown);
                    visible: !bare && dim-shown > 0.001;
                }
                // (without a panel, the gallery gets glass of its own)
                if bare && editing: Rectangle {
                    x: -pad;
                    y: -pad;
                    width: 260px + 2 * pad;
                    height: gal-col.preferred-height + 2 * pad;
                    border-radius: 36px + pad;
                    background: Theme.panel;
                }
                // The gallery: everything not in Control Center yet
                gal-col := VerticalLayout {
                    visible: editing;
                    x: 0;
                    y: 0;
                    width: 260px;
                    height: self.preferred-height;
                    spacing: 8px;
                    Text {
                        text: "Add controls";
                        color: Theme.label;
                        font-size: Theme.title;
                        font-weight: 600;
                    }
                    Text {
                        wrap: word-wrap;
                        text: "Click a control to add it. In Quick Settings, click one to change its size, drag to move it, or use − to remove it.";
                        color: Theme.secondary;
                        font-size: Theme.caption;
                    }
                    Flickable {
                        height: min(gl.preferred-height, 440px);
                        content-height: gl.preferred-height;
                        gl := VerticalLayout {
                            spacing: 2px;
                            for it in gallery: Rectangle {
                                height: 40px;
                                border-radius: Theme.radius-control;
                                background: at.has-hover && it.why == "" ? Theme.fill : transparent;
                                accessible-role: button;
                                accessible-label: it.label + (it.why != "" ? ", " + it.why : "");
                                accessible-action-default => { if it.why == "" { add(it.id); } }
                                Rectangle {
                                    x: 6px;
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: Theme.platter;
                                    Ic {
                                        icon: it.icon;
                                        size: 14px;
                                        color: it.why != "" ? Theme.tertiary : Theme.label;
                                    }
                                }
                                VerticalLayout {
                                    x: 44px;
                                    width: parent.width - 44px - (it.why == "" ? 10px + 18px + 8px + sz.preferred-width + 8px : 8px);
                                    y: (parent.height - self.preferred-height) / 2;
                                    height: self.preferred-height;
                                    Text {
                                        text: it.label;
                                        overflow: elide;
                                        color: it.why != "" ? Theme.secondary : Theme.label;
                                        font-size: Theme.body;
                                    }
                                    if it.why != "": Text {
                                        text: it.why;
                                        overflow: elide;
                                        color: Theme.tertiary;
                                        font-size: Theme.caption;
                                    }
                                }
                                sz := Text {
                                    visible: it.why == "";
                                    x: parent.width - 10px - 18px - 8px - self.preferred-width;
                                    text: it.sizes;
                                    color: Theme.tertiary;
                                    font-size: Theme.caption;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                                if it.why == "": Ic {
                                    x: parent.width - 10px - 18px;
                                    width: 18px;
                                    icon: g.plus-circle;
                                    fill: true;
                                    size: 18px;
                                    color: Theme.success;
                                }
                                at := TouchArea {
                                    enabled: it.why == "";
                                    mouse-cursor: pointer;
                                    clicked => { add(it.id); }
                                }
                            }
                        }
                    }
                    Text {
                        text: "Reset to default";
                        color: accent-ink;
                        font-size: Theme.small;
                        font-weight: 500;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { reset-layout(); }
                        }
                    }
                }

                // The module grid and the footer
                Rectangle {
                    x: editing ? 260px + 16px + (bare ? 2 * pad : 0) : 0;
                    width: 320px;
                    height: parent.height;
                    for m[i] in modules: gm := GlassModule {
                        x: m.x + self.drag-dx;
                        y: m.y + self.drag-dy;
                        width: m.w;
                        height: m.h;
                        z: self.dragging ? 5 : m.focused ? 4 : 0;
                        animate x, y { duration: gm.dragging ? 0ms : 363ms; easing: spring(0.31); }
                        animate width, height { duration: 363ms; easing: spring(0.31); }
                        m: m;
                        unit: (320px - 3 * gap) / 4;
                        chip: bare;
                        editing: editing;
                        dimmed: paging && !m.focused;
                        kbd-focus: kbd == i;
                        accent-glyph: accent-glyph;
                        media: media;
                        g: g;
                        cast: cast;
                        casting: casting;
                        act => { act(i); }
                        open-page => { open-page(i, self.absolute-position.y); }
                        secondary(x, y) => { secondary(i, x, y); }
                        remove => { remove(i); }
                        resize => { resize(i); }
                        dropped(x, y) => { dropped(i, x, y); }
                        slide(v) => { slide(i, v); }
                        media-do(w) => { media-do(w); }
                    }
                    // You, the battery, Settings, Power, Edit controls
                    Rectangle {
                        y: grid-height + 12px;
                        height: 40px;
                        opacity: paging ? 0.45 : 1;
                        animate opacity { duration: 220ms; }
                        Rectangle {
                            x: 0;
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: bare ? Theme.panel.mix(#ffffff, 0.93) : Theme.platter;
                            border-width: bare ? 1px : 0;
                            border-color: #ffffff.with-alpha(Theme.dark ? 0.06 : 0.3);
                            clip: true;
                            accessible-role: text;
                            accessible-label: user;
                            if has-avatar: Image {
                                width: 100%;
                                height: 100%;
                                source: avatar;
                                image-fit: cover;
                            }
                            if !has-avatar: Ic {
                                icon: g.user;
                                fill: true;
                                size: 18px;
                                color: Theme.secondary;
                            }
                        }
                        Rectangle {
                            visible: battery;
                            x: 48px;
                            width: battery-w;
                            height: 40px;
                            border-radius: 20px;
                            background: bare ? Theme.panel.mix(#ffffff, 0.93) : Theme.platter;
                            border-width: bare ? 1px : 0;
                            border-color: #ffffff.with-alpha(Theme.dark ? 0.06 : 0.3);
                            accessible-role: text;
                            accessible-label: "Battery " + round(battery-level * 100) + "%" + (charging ? ", charging" : "");
                            bat-row := HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                // (BatteryGlyph.qml: iOS's solid capsule, the charge in the
                                // label colour, the rest faint, a bolt while charging)
                                Rectangle {
                                    width: 26px;
                                    height: 14px;
                                    y: (40px - 14px) / 2;
                                    Rectangle {
                                        x: 0;
                                        y: 1.5px;
                                        width: 23px;
                                        height: 11px;
                                        border-radius: 4px;
                                        clip: true;
                                        background: Theme.label.with-alpha(0.35);
                                        Rectangle {
                                            x: 0;
                                            width: round(23 * max(0, min(1, battery-level))) * 1px;
                                            height: 11px;
                                            background: !charging && battery-level <= 0.2 ? Theme.danger : Theme.label;
                                        }
                                    }
                                    Rectangle {
                                        x: 24px;
                                        y: 5px;
                                        width: 2px;
                                        height: 4px;
                                        border-radius: 1px;
                                        background: Theme.label.with-alpha(0.35);
                                    }
                                    if charging: Ic {
                                        x: 4px;
                                        width: 15px;
                                        icon: g.bolt;
                                        fill: true;
                                        size: 14px;
                                        color: Theme.dark ? #1e1e22 : #ffffff;
                                    }
                                }
                                Text {
                                    text: round(battery-level * 100) + "%";
                                    color: Theme.label;
                                    font-size: Theme.body;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        HorizontalLayout {
                            x: parent.width - self.preferred-width;
                            width: self.preferred-width;
                            spacing: 8px;
                            GlassFooterButton {
                                icon: g.gear;
                                label: "Open Settings";
                                chip: bare;
                                clicked => { settings(); }
                            }
                            GlassFooterButton {
                                icon: g.power;
                                label: "Show power options";
                                chip: bare;
                                clicked => { power(); }
                            }
                            GlassFooterButton {
                                icon: g.pencil;
                                text: editing ? "Done" : "";
                                accent: editing;
                                label: editing ? "Done editing controls" : "Edit controls";
                                chip: bare;
                                clicked => { toggle-editing(); }
                            }
                        }
                    }
                }
            }

            // (Glass: a press on the panel while its page is open closes the page)
            if paging && !Theme.material: TouchArea {
                clicked => { back(); }
            }

            // ── Material ──
            Rectangle {
                visible: Theme.material;
                x: pad;
                y: pad;
                width: content-w;
                height: m-h;
                clip: abs(m-h - m-target) > 0.5px || (page-shown > 0.01 && page-shown < 0.99) || home-h > max-h;
                // Home: the editor's header, the tiles, the gallery or the footer
                Rectangle {
                    x: -40px * page-shown;
                    opacity: 1 - max(0, min(1, page-shown));
                    visible: page-shown < 0.99;
                    edit-head := VerticalLayout {
                        visible: editing;
                        y: 0;
                        height: editing ? self.preferred-height : 0;
                        spacing: 4px;
                        Rectangle {
                            height: 48px;
                            GhostButton {
                                x: 0;
                                width: 40px;
                                height: 40px;
                                icon: g.back;
                                icon-size: 22px;
                                icon-color: Theme.m3-on-surface;
                                label: "Done";
                                clicked => { toggle-editing(); }
                            }
                            Text {
                                x: 48px;
                                width: parent.width - 48px - rb.width - 8px;
                                height: parent.height;
                                vertical-alignment: center;
                                overflow: elide;
                                text: "Edit controls";
                                color: Theme.m3-on-surface;
                                font-size: 22px;
                            }
                            rb := Rectangle {
                                x: parent.width - self.width;
                                width: rbl.preferred-width + 24px;
                                height: 36px;
                                border-radius: 18px;
                                background: Theme.m3-primary.with-alpha(rbt.pressed ? 0.1 : rbt.has-hover ? 0.08 : 0);
                                accessible-role: button;
                                accessible-label: "Reset layout";
                                accessible-action-default => { reset-layout(); }
                                rbl := Text {
                                    text: "Reset layout";
                                    color: Theme.m3-primary;
                                    font-size: 14px;
                                    font-weight: 500;
                                }
                                rbt := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { reset-layout(); }
                                }
                            }
                        }
                        Text {
                            wrap: word-wrap;
                            text: "Click a control to change its size, drag it to move it, or use − to remove it.";
                            color: Theme.m3-on-surface-variant;
                            font-size: 13px;
                        }
                    }
                    Rectangle {
                        y: editing ? edit-head.preferred-height + 12px : 0;
                        height: grid-height;
                        for m[i] in modules: mc := Rectangle {
                            property <bool> due: stagger >= 1 || stagger * 24 >= m.order + 1;
                            property <float> rise: due ? 1 : 0;
                            animate rise { duration: 222ms; easing: spring(0.58); }
                            property <bool> lifted: tile.dragging;
                            x: m.x + m.sq-dx * squeeze * 1px + tile.drag-dx;
                            y: m.y + tile.drag-dy;
                            animate x, y { duration: lifted ? 0ms : 322ms; easing: spring(0.2); }
                            width: m.w;
                            height: m.h;
                            animate width, height { duration: 322ms; easing: spring(0.2); }
                            z: lifted ? 5 : 0;
                            opacity: min(1, rise);
                            transform-scale: (0.86 + 0.14 * rise) * (lifted ? 1.05 : 1);
                            transform-origin: { x: self.width / 2, y: self.height / 2 };
                            property <bool> plain: editing || (m.kind != 2 && m.kind != 3);
                            tile := QsTile {
                                visible: plain;
                                x: 0;
                                width: parent.width + m.sq-dw * squeeze * 1px;
                                height: parent.height;
                                m: m;
                                editing: editing;
                                kbd-focus: kbd == i && plain;
                                chevrons: { down: g.caret-down, right: g.caret-right };
                                act => { act(i); }
                                detail(x, y) => { secondary(i, -x - 1px, y); }
                                secondary(x, y) => { secondary(i, x, y); }
                                remove => { remove(i); }
                                resize => { resize(i); }
                                dropped(x, y) => { dropped(i, x, y); }
                                pressed-changed(p) => { press(i, p && !editing); }
                            }
                            // A slider: across, with its page's button; or standing
                            if !plain && m.kind == 2: Rectangle {
                                property <bool> standing: m.rows > m.cols;
                                property <bool> more: m.page && !standing;
                                QsSlider {
                                    x: 0;
                                    y: standing ? 0 : (parent.height - 60px) / 2;
                                    width: parent.width - (more ? 60px : 0);
                                    height: standing ? parent.height : 60px;
                                    vertical: standing;
                                    track: standing ? parent.width - 8px : 52px;
                                    icon: m.icon;
                                    value: m.value;
                                    has-more: m.page;
                                    moved(v) => { slide(i, v); }
                                    more => { open-page(i, 0); }
                                }
                                if more: TonalButton {
                                    x: parent.width - 52px;
                                    y: (parent.height - 52px) / 2;
                                    width: 52px;
                                    height: 52px;
                                    corner: 16px;
                                    icon: g.more;
                                    tip: m.label + " options";
                                    clicked => { open-page(i, 0); }
                                }
                                if kbd == i: Rectangle {
                                    x: -5px;
                                    y: -5px;
                                    width: parent.width + 10px;
                                    height: parent.height + 10px;
                                    border-radius: 31px;
                                    border-width: 2px;
                                    border-color: Theme.m3-primary;
                                }
                            }
                            if !plain && m.kind == 3: QsMedia {
                                width: parent.width;
                                height: parent.height;
                                media: media;
                                g: g;
                                cast: cast;
                                casting: casting;
                                media-do(w) => { media-do(w); }
                            }
                        }
                    }
                    // Edit controls: the controls to add
                    m-gal := VerticalLayout {
                        visible: editing;
                        y: (editing ? edit-head.preferred-height + 12px : 0) + (grid-height > 0 ? grid-height + 12px : 0);
                        height: editing ? self.preferred-height : 0;
                        spacing: 8px;
                        Text {
                            text: "Add controls";
                            color: Theme.m3-primary;
                            font-size: 14px;
                            font-weight: 500;
                        }
                        Flickable {
                            height: min(mgl.preferred-height, max(176px, max-h - edit-head.preferred-height - grid-height - 36px - 40px));
                            content-height: mgl.preferred-height;
                            mgl := VerticalLayout {
                                spacing: 2px;
                                for it[k] in gallery: Block {
                                    b: {
                                        kind: 1,
                                        id: it.id,
                                        icon: it.icon,
                                        title: it.label,
                                        status: it.why,
                                        trail: it.why == "" ? g.plus : { t: "", s: false },
                                        dis: it.why != "",
                                        first: k == 0,
                                        last: k == gallery.length - 1,
                                    };
                                    g: g;
                                    do(w, t) => { add(it.id); }
                                }
                            }
                        }
                    }
                    // The footer: you and the battery; Settings, Power, Edit
                    Rectangle {
                        visible: !editing;
                        property <bool> due: stagger >= 1 || stagger * 24 >= modules.length + 2;
                        property <float> rise: due ? 1 : 0;
                        animate rise { duration: 222ms; easing: spring(0.58); }
                        y: (grid-height > 0 ? grid-height + 12px : 0) + 12px * (1 - rise);
                        height: 48px;
                        opacity: min(1, rise);
                        Rectangle {
                            x: 0;
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: Theme.m3-tertiary-container;
                            clip: true;
                            accessible-role: text;
                            accessible-label: user;
                            if has-avatar: Image {
                                width: 100%;
                                height: 100%;
                                source: avatar;
                                image-fit: cover;
                            }
                            if !has-avatar: Ic {
                                icon: g.user;
                                fill: true;
                                size: 18px;
                                color: Theme.m3-on-tertiary-container;
                            }
                        }
                        if battery: Rectangle {
                            x: 48px;
                            width: mb.preferred-width + 28px;
                            height: 40px;
                            border-radius: 20px;
                            background: Theme.m3-surface-container-high;
                            accessible-role: text;
                            accessible-label: "Battery " + round(battery-level * 100) + "%" + (charging ? ", charging" : "");
                            mb := HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Ic {
                                    width: 22px;
                                    icon: charging ? g.battery-charging : battery-level < 0.2 ? g.battery-low : g.battery;
                                    fill: true;
                                    size: 18px;
                                    color: battery-level < 0.2 && !charging ? Theme.m3-error : Theme.m3-on-surface-variant;
                                }
                                Text {
                                    text: round(battery-level * 100) + "%";
                                    color: Theme.m3-on-surface;
                                    font-size: 14px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        HorizontalLayout {
                            x: parent.width - self.preferred-width;
                            width: self.preferred-width;
                            y: 4px;
                            height: 40px;
                            spacing: 8px;
                            TonalButton {
                                icon: g.gear;
                                tip: "Open Settings";
                                clicked => { settings(); }
                            }
                            TonalButton {
                                width: 56px;
                                strong: true;
                                icon: g.power;
                                tip: "Power options";
                                clicked => { power(); }
                            }
                            TonalButton {
                                icon: g.pencil;
                                tip: "Edit controls";
                                clicked => { toggle-editing(); }
                            }
                        }
                    }
                }
                // A tile's page, sliding in from the side
                m-page := PageView {
                    visible: page-shown > 0.01;
                    x: 40px * (1 - page-shown);
                    y: 0;
                    width: content-w;
                    opacity: max(0, min(1, page-shown));
                    cap: min(page-cap, max-h - 48px - (page-switch ? 66px : 0) - 10px);
                    title: page-title;
                    back: true;
                    has-switch: page-switch;
                    switch-on: page-switch-on;
                    switch-label: page-switch-label;
                    refresh: page-refresh;
                    blocks: blocks;
                    kbd: page-kbd;
                    g: g;
                    accent-glyph: accent-glyph;
                    go-back => { back(); }
                    toggled => { page-switched(); }
                    refreshed => { page-refreshed(); }
                    block(i, w, t) => { block(i, w, t); }
                    block-menu(i, x, y) => { block-menu(i, x, y); }
                    block-slide(i, v) => { block-slide(i, v); }
                }
            }
        }

        // ── Glass: the page, a second popover beside the panel ──
        Rectangle {
            visible: !Theme.material && sub-shown > 0.01;
            x: sub-x + (1 - sub-shown) * 12px;
            y: sub-top;
            width: sub-w;
            height: sub-h;
            opacity: min(1, sub-shown) * panel-opacity;
            transform-scale: 0.96 + 0.04 * sub-shown;
            transform-origin: { x: self.width, y: 24px };
            border-radius: 36px + pad;
            background: Theme.panel;
            border-width: 0.5px;
            border-color: Theme.separator;
            TouchArea { }
            sub-page := PageView {
                x: 16px;
                y: 16px;
                width: 320px;
                cap: min(page-cap, root.height - 34px - 30px - 10px - 32px - 12px);
                title: page-title;
                back: false;
                has-switch: page-switch;
                switch-on: page-switch-on;
                switch-label: page-switch-label;
                refresh: page-refresh;
                blocks: blocks;
                kbd: page-kbd;
                g: g;
                accent-glyph: accent-glyph;
                go-back => { back(); }
                toggled => { page-switched(); }
                refreshed => { page-refreshed(); }
                block(i, w, t) => { block(i, w, t); }
                block-menu(i, x, y) => { block-menu(i, x, y); }
                block-slide(i, v) => { block-slide(i, v); }
            }
        }

        // ── A control's choices, at the pointer (PointerMenu) ──
        if menu-open: TouchArea {
            clicked => { menu-close(); }
        }
        if menu-open: Rectangle {
            x: min(menu-x, root.width - self.width - 8px);
            y: min(menu-y, root.height - self.height - 8px);
            width: 240px;
            height: mcol.preferred-height;
            border-radius: Theme.menu-radius;
            background: Theme.material ? Theme.m3-surface-container : Theme.glass-solid;
            border-width: Theme.material ? 0 : 0.5px;
            border-color: Theme.separator;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 4px;
            mcol := VerticalLayout {
                padding: Theme.material ? 8px : 5px;
                for it[i] in menu: Rectangle {
                    height: it.sep ? (Theme.material ? 9px : 11px) : Theme.material ? 44px : 26px;
                    border-radius: Theme.item-radius;
                    background: !it.sep && mt.has-hover ? Theme.menu-hover : transparent;
                    accessible-role: list-item;
                    accessible-label: it.text;
                    accessible-checked: it.checked;
                    accessible-action-default => { menu-pick(i); }
                    if it.sep: Rectangle {
                        height: 1px;
                        x: 8px;
                        width: parent.width - 16px;
                        background: Theme.separator;
                    }
                    if !it.sep && it.checked: Ic {
                        x: 6px;
                        width: 14px;
                        icon: g.check;
                        bold: true;
                        size: 12px;
                        color: mt.has-hover ? Theme.menu-hover-fg : Theme.menu-fg;
                    }
                    if !it.sep: Text {
                        x: Theme.material ? 16px : 22px;
                        width: parent.width - self.x - 8px;
                        height: parent.height;
                        vertical-alignment: center;
                        overflow: elide;
                        text: it.text;
                        color: mt.has-hover ? Theme.menu-hover-fg : it.danger ? Theme.danger : Theme.menu-fg;
                        font-size: Theme.material ? 14px : Theme.body;
                    }
                    mt := TouchArea {
                        enabled: !it.sep;
                        clicked => { menu-pick(i); }
                    }
                }
            }
        }
    }

    public function focus-keys() {
        fs.focus();
    }
}

