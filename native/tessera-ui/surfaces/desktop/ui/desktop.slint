}

// The widget a kind draws
component Content inherits Rectangle {
    in property <DeskWidget> w;
    in property <string> cookie12;
    in property <string> cookie9;
    callback act(string, string);
    if w.kind == "clock": ClockW { w: w; }
    if w.kind == "worldClock": WorldW { w: w; cookie: cookie12; }
    if w.kind == "weather": WeatherW { w: w; }
    if w.kind == "today": TodayW { w: w; act(a, b) => { root.act(a, b); } }
    if w.kind == "calendar": CalendarW { w: w; cookie9: cookie9; act(a, b) => { root.act(a, b); } }
    if w.kind == "reminders": RemindersW { w: w; act(a, b) => { root.act(a, b); } }
    if w.kind == "batteries": BatteriesW { w: w; }
    if w.kind == "nowPlaying": NowPlayingW { w: w; act(a, b) => { root.act(a, b); } }
    if w.kind == "system": SystemW { w: w; }
    if w.kind == "photos": PhotosW { w: w; act(a, b) => { root.act(a, b); } }
    if w.kind == "notes": NotesW { w: w; act(a, b) => { root.act(a, b); } }
    if w.kind == "shortcuts": ShortcutsW { w: w; act(a, b) => { root.act(a, b); } }
    if w.kind == "screenTime": ScreenTimeW { w: w; }
    if w.kind == "batteryHistory": BatteryHistoryW { w: w; }
    if w.kind == "stocks": StocksW { w: w; }
    if w.kind == "": T { width: root.width; height: root.height; vertical-alignment: center; horizontal-alignment: center; text: w.t1; color: Theme.secondary; }
}

// One widget on the desktop (WidgetFrame.qml): its card (Glass: the
// plugin's glass under it, a tint without the plugin; Material: a flat
// tonal card), the widget, the remove badge while editing. Drag it
// anywhere; on release it snaps to the grid.
component Frame inherits Rectangle {
    in property <DeskWidget> w;
    in property <bool> editing;
    in property <bool> glass-plugin;
    in property <string> cookie12;
    in property <string> cookie9;
    callback act(int, string, string);
    callback drag(int, length, length, bool);
    callback menu(int, length, length);
    property <length> dx;
    property <length> dy;
    property <bool> dragging;
    property <float> shown: 0;
    property <float> grow: 0.9;
    init => {
        shown = 1;
        grow = 1;
    }
    animate shown { duration: 260ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    animate grow { duration: 420ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    x: w.x + dx;
    y: w.y + dy;
    animate x, y {
        duration: dragging ? 0ms : 450ms;
        easing: Theme.material ? spring(0.5) : spring(0.38);
    }
    width: w.w;
    height: w.h;
    z: dragging ? 10 : 0; // (above the others while dragged)
    opacity: shown;
    transform-scale: dragging ? 1.04 : grow;
    animate transform-scale { duration: 150ms; }
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    border-radius: w.pill ? self.height / 2 : Desk.tile;
    // (Glass without the plugin: a see-through tint with a rim; Hyprland
    // blurs it, being over 40% alpha)
    background: Theme.material ? (w.has-card ? w.card : transparent) : glass-plugin ? transparent : Theme.dark ? #1c1c216b : #f7f7fa80;
    border-width: Theme.material || glass-plugin ? 0 : 1px;
    border-color: Theme.dark ? #ffffff24 : #ffffff80;
    accessible-role: groupbox;
    accessible-label: w.t6 != "" && w.kind == "" ? w.t6 : w.kind;

    // Under the widget: drag, and right-click for the menu
    TouchArea {
        property <bool> moved-far;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.menu(w.index, root.x + self.mouse-x, root.y + self.mouse-y);
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.dragging {
                root.dragging = false;
                root.drag(w.index, root.x, root.y, false);
                root.dx = 0;
                root.dy = 0;
            }
        }
        moved => {
            if self.pressed && self.pressed-x >= 0 {
                if !root.dragging && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                    root.dragging = true;
                }
                if root.dragging {
                    root.dx += self.mouse-x - self.pressed-x;
                    root.dy += self.mouse-y - self.pressed-y;
                    root.drag(w.index, root.x, root.y, true);
                }
            }
        }
        scroll-event(e) => {
            if w.stack && w.stack-n > 1 {
                root.act(w.index, "scroll", e.delta-y / 1px > 0 ? "-1" : "1");
                return accept;
            }
            reject
        }
    }
    // A stack's next widget slides in from below (or above) and fades in:
    // set at once, then animated back (StackWidget.qml's 300 ms / 200 ms)
    property <int> page: w.stack-i;
    property <bool> snap;
    property <length> page-y;
    property <float> page-o: 1;
    animate page-y { duration: snap ? 0ms : 300ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    animate page-o { duration: snap ? 0ms : 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    changed page => {
        snap = true;
        page-y = 24px * w.stack-dir;
        page-o = 0;
        snap = false;
        page-y = 0;
        page-o = 1;
    }
    Rectangle {
        x: w.pad-x;
        y: w.pad;
        width: w.w - 2 * w.pad-x - (w.stack && w.stack-n > 1 ? 10px : 0);
        height: w.h - 2 * w.pad;
        clip: w.stack;
        Content {
            x: 0;
            y: root.page-y;
            width: parent.width;
            height: parent.height;
            opacity: root.page-o;
            w: w;
            cookie12: cookie12;
            cookie9: cookie9;
            act(a, b) => { root.act(w.index, a, b); }
        }
    }
    // A stack's page dots: click one to jump to it
    if w.stack && w.stack-n > 1: VerticalLayout {
        x: w.w - w.pad-x - 6px;
        y: (w.h - self.preferred-height) / 2;
        width: 16px;
        height: self.preferred-height;
        for i in w.stack-n: Rectangle {
            width: 16px;
            height: (i == w.stack-i ? 12px : 5px) + 4px;
            Rectangle {
                width: 5px;
                height: i == w.stack-i ? 12px : 5px;
                animate height { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                border-radius: 2.5px;
                background: Theme.material ? (i == w.stack-i ? Theme.m3-primary : dt.has-hover ? Theme.m3-on-surface-variant : Theme.m3-outline-variant) : i == w.stack-i || dt.has-hover ? Theme.label : Theme.tertiary;
            }
            dt := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.act(w.index, "stack", i); }
            }
        }
    }
    // Remove badge
    if editing: Rectangle {
        x: -8px;
        y: -8px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Theme.material ? Theme.m3-surface-container-highest : Theme.dark ? #3A3A40 : #E4E4E7;
        border-width: Theme.material ? 0 : 1px;
        border-color: Theme.separator;
        accessible-role: button;
        accessible-label: "Remove widget";
        accessible-action-default => { root.act(w.index, "remove", ""); }
        Rectangle { width: 10px; height: 2px; border-radius: 1px; background: Theme.label; }
        TouchArea {
            x: -6px;
            y: -6px;
            width: 36px;
            height: 36px;
            mouse-cursor: pointer;
            clicked => { root.act(w.index, "remove", ""); }
        }
    }
}

// A file or stack on the desktop
component IconCell inherits Rectangle {
    in property <DeskIcon> ic;
    in property <length> spot;
    callback icon(int, string, length, length);
    property <length> dx;
    property <length> dy;
    property <bool> dragging;
    x: ic.x + dx;
    y: ic.y + dy;
    animate x, y {
        duration: dragging ? 0ms : 450ms;
        easing: Theme.material ? spring(0.5) : spring(0.4);
    }
    width: spot - 6px;
    height: spot - 2px;
    z: dragging ? 5 : 0;
    accessible-role: list-item;
    accessible-label: ic.name;
    accessible-action-default => { root.icon(ic.index, "open", 0, 0); }
    if ic.selected: Rectangle {
        y: 0;
        width: 54px;
        height: 54px;
        border-radius: Theme.material ? 16px : 10px;
        background: Theme.material ? Theme.m3-secondary-container : #00000038;
    }
    Rectangle {
        y: 3px;
        width: 48px;
        height: 48px;
        for f[i] in ic.fan: Image {
            y: 1px - i * 3px;
            width: 46px;
            height: 46px;
            source: f;
            image-fit: contain;
            transform-rotation: (i - 1) * 6deg;
        }
        if !ic.stack: Image {
            width: 48px;
            height: 48px;
            source: ic.pic;
            image-fit: contain;
        }
    }
    Rectangle {
        y: 54px;
        width: min(parent.width, label.preferred-width + 8px);
        height: label.preferred-height + (Theme.material ? 4px : 2px);
        border-radius: Theme.material ? min(self.height / 2, 10px) : 4px;
        background: ic.selected ? (Theme.material ? Theme.m3-secondary-container : Theme.accent) : transparent;
        // (Glass: a raised shadow under the name on the wallpaper)
        if !ic.selected: T {
            x: (parent.width - self.width) / 2 + 1px;
            y: (parent.height - self.height) / 2 + 1px;
            width: min(self.preferred-width, root.width - 8px);
            text: ic.name;
            horizontal-alignment: center;
            overflow: elide;
            wrap: word-wrap;
            color: #0000008c;
            font-weight: 500;
        }
        label := T {
            width: min(self.preferred-width, root.width - 8px);
            text: ic.name;
            horizontal-alignment: center;
            overflow: elide;
            wrap: word-wrap;
            color: Theme.material && ic.selected ? Theme.m3-on-secondary-container : ic.selected ? Theme.on-accent : white;
            font-weight: 500;
        }
    }
    TouchArea {
        double-clicked => { root.icon(ic.index, "open", 0, 0); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.icon(ic.index, "menu", root.x + self.mouse-x, root.y + self.mouse-y);
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                if root.dragging {
                    root.dragging = false;
                    root.icon(ic.index, "drop", root.x, root.y);
                    root.dx = 0;
                    root.dy = 0;
                } else {
                    root.icon(ic.index, "click", 0, 0);
                }
            }
        }
        moved => {
            if self.pressed {
                if !root.dragging && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                    root.dragging = true;
                    root.icon(ic.index, "grab", 0, 0);
                }
                if root.dragging {
                    root.dx += self.mouse-x - self.pressed-x;
                    root.dy += self.mouse-y - self.pressed-y;
                }
            }
        }
    }
}

// ── The desktop (the first screen's) ────────────────────────────────────────
export component Desktop inherits Window {
    in property <[DeskWidget]> widgets;
    in property <[DeskIcon]> icons;
    in property <bool> editing;
    in property <bool> glass-plugin;
    in property <int> cols: 1;
    in property <int> rows: 1;
    in property <length> cell: 164px;
    in property <length> gap: 16px;
    in property <length> ox: 32px;
    in property <length> oy: 54px;
    in property <length> spot: 90px;
    in property <bool> ghost-on;
    in property <length> ghost-x;
    in property <length> ghost-y;
    in property <length> ghost-w;
    in property <length> ghost-h;
    in property <string> cookie12;
    in property <string> cookie9;
    // An open stack: its files beside it
    in property <bool> stack-open;
    in property <string> stack-name;
    in property <[DeskFile]> stack-files;
    in property <length> stack-x;
    in property <length> stack-y;
    callback act(int, string, string); // a widget's control
    callback drag(int, length, length, bool); // a widget dragged (its top left), released
    callback menu(int, length, length); // right-click: a widget's index, or -1 the desktop
    callback bare(); // a click on the bare desktop
    callback file(int, string, length, length); // a file or stack: click | open | menu | grab | drop
    callback stack-file(int, bool); // an open stack's file: open, or (true) its menu
    callback stack-file-menu(int, length, length);
    background: transparent;
    no-frame: true;
    title: "Desktop";
    default-font-family: Theme.font;

    // The bare desktop: a click ends editing and clears the selection;
    // right-click opens the desktop's menu
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.menu(-1, self.mouse-x, self.mouse-y);
            }
        }
        clicked => { root.bare(); }
    }

    // While editing or dragging: faint cells, and where the widget will land
    property <float> grid-shown: editing || ghost-on ? 1 : 0;
    animate grid-shown { duration: 220ms; }
    if grid-shown > 0.01: Rectangle {
        opacity: grid-shown;
        for i in cols * rows: Rectangle {
            x: ox + Math.mod(i, cols) * (cell + gap);
            y: oy + floor(i / cols) * (cell + gap);
            width: cell;
            height: cell;
            border-radius: Desk.tile;
            background: Theme.material ? Theme.m3-primary-container.with-alpha(0.16) : #ffffff08;
            border-width: 1px;
            border-color: Theme.material ? Theme.m3-primary-container.with-alpha(0.6) : #ffffff1f;
        }
        if ghost-on: Rectangle {
            x: ghost-x;
            y: ghost-y;
            animate x, y { duration: 400ms; easing: Theme.material ? spring(0.5) : spring(0.4); }
            width: ghost-w;
            height: ghost-h;
            border-radius: Desk.tile;
            background: Theme.material ? Theme.m3-primary-container.with-alpha(0.45) : #ffffff1a;
            border-width: Theme.material ? 3px : 2px;
            border-color: Theme.material ? Theme.m3-primary : #ffffff8c;
        }
    }

    // Files on the desktop (under the widgets)
    for ic in icons: IconCell {
        ic: ic;
        spot: root.spot;
        icon(i, what, x, y) => { root.file(i, what, x, y); }
    }

    for w in widgets: Frame {
        w: w;
        editing: root.editing;
        glass-plugin: root.glass-plugin;
        cookie12: root.cookie12;
        cookie9: root.cookie9;
        act(i, a, b) => { root.act(i, a, b); }
        drag(i, x, y, on) => { root.drag(i, x, y, on); }
        menu(i, x, y) => { root.menu(i, x, y); }
    }

    // Empty desktop while editing: a hint where widgets go
    if editing && widgets.length == 0: Rectangle {
        x: ox;
        y: oy;
        width: hint.preferred-width;
        height: hint.preferred-height;
        T { x: 1px; y: 1px; text: hint.text; color: #00000066; font-size: Theme.title; font-weight: 600; }
        hint := T { text: "Pick widgets from the gallery below"; color: #ffffffd9; font-size: Theme.title; font-weight: 600; }
    }

    // An open stack: its files in a panel beside it
    if stack-open: Rectangle {
        x: stack-x;
        y: stack-y;
        width: 4 * 96px + 24px;
        height: min(4, ceil(stack-files.length / 4)) * 96px + 48px;
        border-radius: Theme.material ? Theme.radius-popover : 18px;
        // (Material: its glass is a see-through surface container)
        background: Theme.material ? Theme.m3-surface-container.with-alpha(0.72) : glass-plugin ? transparent : Theme.panel;
        accessible-role: list;
        accessible-label: stack-name;
        TouchArea {} // (clicks stay inside)
        T { x: 14px; y: 10px; text: stack-name; font-size: Theme.body; font-weight: 600; }
        for f[i] in stack-files: Rectangle {
            x: 12px + Math.mod(i, 4) * 96px;
            y: 36px + floor(i / 4) * 96px;
            width: 96px;
            height: 96px;
            accessible-role: list-item;
            accessible-label: f.name;
            accessible-action-default => { root.stack-file(i, false); }
            Rectangle {
                x: 2px;
                y: 2px;
                width: 92px;
                height: 92px;
                border-radius: Theme.material ? 16px : 10px;
                background: fa.has-hover ? (Theme.material ? Theme.m3-on-surface.with-alpha(fa.pressed ? 0.1 : 0.08) : Theme.fill) : transparent;
            }
            Image { x: 24px; y: 10px; width: 48px; height: 48px; source: f.icon; image-fit: contain; }
            T { x: 4px; y: parent.height - 8px - self.height; width: parent.width - 8px; horizontal-alignment: center; overflow: elide; text: f.name; }
            fa := TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                        root.stack-file-menu(i, root.stack-x + parent.x + self.mouse-x, root.stack-y + parent.y + self.mouse-y);
                    }
                }
                clicked => { root.stack-file(i, false); }
            }
        }
    }
}

// ── The right-click menu (glass/ContextMenu.qml): a full-screen overlay, a
// click anywhere else closes it; it opens at the pointer, downward ──────────
export struct DeskMenuRow {
    text: string,
    enabled: bool,
    danger: bool,
    separator: bool,
}

export component DeskMenu inherits Window {
    in property <[DeskMenuRow]> rows;
    in property <length> point-x;
    in property <length> point-y;
    in property <length> menu-width: 200px;
    in property <bool> shown;
    in property <bool> glass-plugin;
    in-out property <int> current: -1;
    out property <float> progress: shown ? 1 : 0;
    animate progress {
        duration: shown ? 350ms : 120ms;
        easing: shown ? spring(0.36) : ease-in;
    }
    out property <length> panel-x: panel.x;
    out property <length> panel-y: panel.y;
    out property <length> panel-width: panel.width;
    out property <length> panel-height: panel.height;
    out property <float> panel-scale: panel.transform-scale;
    out property <length> radius: Theme.material ? 18px : 14px;
    callback chosen(int);
    callback dismissed();
    callback closed();
    changed progress => {
        if !shown && progress <= 0.001 { closed(); }
    }
    background: transparent;
    no-frame: true;
    title: "Desktop menu";
    default-font-family: Theme.font;

    public function open() {
        current = -1;
        keys.focus();
    }
    function ok(i: int) -> bool {
        return i >= 0 && i < rows.length && !rows[i].separator && rows[i].enabled;
    }
    function step(d: int) {
        if ok(current + d) { current = current + d; return; }
        if ok(current + 2 * d) { current = current + 2 * d; return; }
        if ok(current + 3 * d) { current = current + 3 * d; }
    }

    TouchArea {
        clicked => { root.dismissed(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button != PointerEventButton.left { root.dismissed(); }
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.dismissed(); return accept; }
            if e.text == Key.DownArrow { step(1); return accept; }
            if e.text == Key.UpArrow { step(-1); return accept; }
            if (e.text == Key.Return || e.text == " ") && ok(current) { root.chosen(current); return accept; }
            reject
        }
        panel := Rectangle {
            width: root.menu-width;
            height: rows-layout.preferred-height;
            x: max(8px, min(root.width - self.width - 8px, root.point-x));
            y: root.point-y + self.height + 8px > root.height ? max(8px, root.point-y - self.height) : root.point-y;
            opacity: min(1, root.progress);
            transform-origin: { x: 0, y: 0 };
            transform-scale: 0.94 + 0.06 * root.progress;
            border-radius: root.radius;
            background: Theme.material ? Theme.menu-bg : (root.glass-plugin ? transparent : Theme.panel);
            border-width: Theme.material ? 0 : 0.5px;
            border-color: Theme.separator;
            drop-shadow-blur: Theme.material ? 12px : 0;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.dark ? #00000066 : #00000029;
            accessible-role: list;
            accessible-label: "Desktop menu";
            TouchArea {}
            rows-layout := VerticalLayout {
                padding: 5px;
                for r[i] in rows: Rectangle {
                    height: r.separator ? 11px : 28px;
                    if r.separator: Rectangle {
                        x: 9px;
                        width: parent.width - 18px;
                        height: 1px;
                        background: Theme.separator;
                    }
                    if !r.separator: Rectangle {
                        property <bool> hot: root.current == i && r.enabled;
                        accessible-role: list-item;
                        accessible-label: r.text;
                        accessible-action-default => { if r.enabled { root.chosen(i); } }
                        border-radius: Theme.material ? 10px : 8px;
                        background: hot ? (r.danger && !Theme.material ? Theme.danger : Theme.highlight) : transparent;
                        Text {
                            x: 12px;
                            text: r.text;
                            vertical-alignment: center;
                            height: parent.height;
                            font-size: Theme.body;
                            color: hot && !(Theme.material && r.danger) ? (Theme.material ? Theme.on-highlight : #ffffff) : !r.enabled ? Theme.tertiary : r.danger ? Theme.danger : Theme.label;
                            accessible-role: none;
                        }
                        TouchArea {
                            enabled: r.enabled;
                            changed has-hover => { if self.has-hover { root.current = i; } }
                            clicked => { root.chosen(i); }
                        }
                    }
                }
            }
        }
    }
}

// ── Edit Widgets' gallery and Widget Options ────────────────────────────────
// (rust.surfaces: desktop; compare shell/modules/desktop/WidgetGallery.qml and
// WidgetOptions.qml). The gallery is a glass sheet along the bottom of the
// screen: pick a kind on the left, then click one of its sizes (the widget
// itself, scaled down) to add it to the desktop. Done or Escape ends editing.

export struct GalKind { id: string, label: string, icon: string, desc: string }
export struct GalSize { key: string, name: string, w: length, h: length, widget: DeskWidget }

export component Gallery inherits Window {
    in property <[GalKind]> kinds;
    in property <[GalSize]> sizes;
    in property <int> picked;
    in property <string> kind-label;
    in property <string> kind-desc;
    in property <length> row-h: 200px; // the tallest preview, scaled, and its name
    in property <bool> shown;
    in property <bool> on-glass;
    in property <string> cookie12;
    in property <string> cookie9;
    callback pick(int);
    callback add(int);
    callback done();
    callback closed(); // the fade out is over
    // the sheet, for the glass (window px)
    out property <float> body-x: m / 1px;
    out property <float> body-y: m / 1px;
    out property <float> body-w: (root.width - 2 * m) / 1px;
    out property <float> body-h: 316;
    out property <float> fade: min(1, progress);
    public function focus-keys() {
        keys.focus();
    }
    property <length> m: 24px;
    property <length> preview-scale: 0.56;
    property <float> progress: shown ? 1 : 0;
    animate progress { duration: shown ? 520ms : 192ms; easing: shown ? spring(0.4) : cubic-bezier(0.4, 0.0, 1.0, 1.0); }
    changed progress => {
        if !shown && progress <= 0.001 {
            closed();
        }
    }
    background: transparent;
    no-frame: true;
    title: "Widget gallery";
    default-font-family: Theme.font;

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.done();
                return accept;
            }
            if e.text == Key.UpArrow {
                root.pick(max(0, root.picked - 1));
                return accept;
            }
            if e.text == Key.DownArrow {
                root.pick(min(root.kinds.length - 1, root.picked + 1));
                return accept;
            }
            reject
        }
        body := Rectangle {
            x: m;
            y: m + (1 - min(1, progress)) * 40px;
            width: root.width - 2 * m;
            height: 316px;
            opacity: min(1, progress);
            border-radius: 28px;
            background: on-glass ? transparent : Theme.material ? Theme.m3-surface-container.with-alpha(Theme.blur ? Theme.panel-alpha : 1) : Theme.panel;
            border-width: Theme.material || on-glass ? 0px : 0.5px;
            border-color: Theme.separator;
            drop-shadow-blur: Theme.material ? 20px : 0px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.m3-shadow.with-alpha(Theme.dark ? 0.45 : 0.2);
            // clicks on the sheet stay on it
            TouchArea { }

            // Kinds
            Flickable {
                x: 12px;
                y: 12px;
                width: 200px;
                height: parent.height - 24px;
                viewport-height: root.kinds.length * (Theme.material ? 42px : 38px);
                for k[i] in root.kinds: Rectangle {
                    property <bool> chosen: i == root.picked;
                    y: i * (Theme.material ? 42px : 38px);
                    width: 200px;
                    height: Theme.material ? 40px : 36px;
                    border-radius: Theme.material ? self.height / 2 : 10px;
                    background: Theme.material ? (chosen ? Theme.m3-secondary-container : rowt.pressed ? Theme.m3-on-surface.with-alpha(0.1) : rowt.has-hover ? Theme.m3-on-surface.with-alpha(0.08) : transparent)
                        : chosen ? Theme.fill : rowt.has-hover ? Theme.fill-hover : transparent;
                    accessible-role: button;
                    accessible-label: k.label;
                    accessible-action-default => { root.pick(i); }
                    SymIcon {
                        x: Theme.material ? 14px : 10px;
                        y: (parent.height - 18px) / 2;
                        width: 18px;
                        height: 18px;
                        text: k.icon;
                        font-size: 18px;
                        fill: Theme.material && chosen;
                        color: Theme.material ? (chosen ? Theme.m3-on-secondary-container : Theme.m3-on-surface-variant) : chosen ? Theme.label : Theme.secondary;
                    }
                    Text {
                        x: Theme.material ? 44px : 38px;
                        y: (parent.height - self.height) / 2;
                        text: k.label;
                        color: Theme.material && chosen ? Theme.m3-on-secondary-container : Theme.label;
                        font-size: Theme.body;
                        font-weight: chosen ? 600 : 400;
                        accessible-role: none;
                    }
                    rowt := TouchArea {
                        clicked => { root.pick(i); }
                    }
                }
            }

            // Detail: name, what it shows, and its sizes
            detail := Rectangle {
                x: 12px + 200px + 24px;
                y: 16px;
                width: parent.width - self.x - 20px;
                height: parent.height - 32px;

                VerticalLayout {
                    width: parent.width - donebtn.width - 16px;
                    height: 80px;
                    alignment: start;
                    spacing: 4px;
                    Text {
                        text: root.kind-label;
                        color: Theme.label;
                        font-size: Theme.title;
                        font-weight: 600;
                    }
                    Text {
                        text: root.kind-desc + " Click a size to add it.";
                        color: Theme.secondary;
                        font-size: Theme.small;
                        wrap: word-wrap;
                    }
                }
                donebtn := Rectangle {
                    x: parent.width - self.width;
                    width: dl.preferred-width + (Theme.material ? 48px : 32px);
                    height: Theme.material ? 40px : 32px;
                    border-radius: Theme.material && dt.pressed ? 8px : self.height / 2;
                    animate border-radius { duration: 150ms; }
                    background: Theme.material ? Theme.m3-primary.mix(Theme.m3-on-primary, dt.pressed ? 0.9 : dt.has-hover ? 0.92 : 1)
                        : dt.pressed ? Theme.accent.darker(0.15) : Theme.accent;
                    accessible-role: button;
                    accessible-label: "Done";
                    accessible-action-default => { root.done(); }
                    dl := Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "Done";
                        color: Theme.material ? Theme.m3-on-primary : Theme.on-accent;
                        font-size: Theme.body;
                        font-weight: 600;
                        accessible-role: none;
                    }
                    dt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.done(); }
                    }
                }

                // Size previews: the real widget, scaled down
                HorizontalLayout {
                    x: 0px;
                    y: parent.height - root.row-h;
                    width: parent.width;
                    height: root.row-h;
                    alignment: start;
                    spacing: 20px;
                    for s[si] in root.sizes: VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        item := Rectangle {
                            width: s.w * preview-scale;
                            height: s.h * preview-scale;
                            transform-scale: at.pressed ? 0.95 : at.has-hover ? 1.04 : 1;
                            animate transform-scale { duration: 220ms; easing: spring(0.35); }
                            accessible-role: button;
                            accessible-label: "Add " + root.kind-label + ", " + s.name;
                            accessible-action-default => { root.add(si); }
                            Rectangle {
                                width: s.w;
                                height: s.h;
                                transform-scale: preview-scale;
                                transform-origin: { x: 0px, y: 0px };
                                border-radius: s.widget.pill ? self.height / 2 : Desk.tile;
                                background: Theme.material ? (s.widget.has-card ? s.widget.card : transparent) : Theme.platter;
                                border-width: at.has-hover ? (Theme.material ? 5px : 3px) : Theme.material ? 0px : 1px;
                                border-color: at.has-hover ? Theme.accent : Theme.dark ? #ffffff14 : #ffffff66;
                                clip: true;
                                Rectangle {
                                    x: s.widget.pad-x;
                                    y: s.widget.pad;
                                    width: parent.width - 2 * s.widget.pad-x;
                                    height: parent.height - 2 * s.widget.pad;
                                    Content {
                                        width: parent.width;
                                        height: parent.height;
                                        w: s.widget;
                                        cookie12: root.cookie12;
                                        cookie9: root.cookie9;
                                    }
                                }
                            }
                            // Add badge
                            Rectangle {
                                x: -8px;
                                y: -8px;
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.material ? Theme.m3-primary : Desk.green;
                                visible: at.has-hover;
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "\u{e3d4}";
                                    font-family: "Phosphor-Bold";
                                    font-size: 12px;
                                    color: Theme.material ? Theme.m3-on-primary : #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                            at := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.add(si); }
                            }
                        }
                        // (Material: a tonal chip, the secondary container on hover)
                        Rectangle {
                            width: item.width;
                            height: Theme.material ? 32px : 20px;
                            Rectangle {
                                width: nm.preferred-width + (Theme.material ? 24px : 0px);
                                height: parent.height;
                                x: (parent.width - self.width) / 2;
                                border-radius: Theme.material && at.has-hover ? self.height / 2 : 8px;
                                background: Theme.material ? (at.has-hover ? Theme.m3-secondary-container : Theme.m3-surface-container-highest) : transparent;
                                nm := Text {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    text: s.name;
                                    color: Theme.material ? (at.has-hover ? Theme.m3-on-secondary-container : Theme.m3-on-surface-variant) : Theme.secondary;
                                    font-size: Theme.small;
                                    font-weight: 500;
                                    accessible-role: none;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
