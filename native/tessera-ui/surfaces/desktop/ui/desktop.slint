// The desktop in Rust (rust.surfaces: desktop): the widgets on their grid,
// the files on the desktop, and the right-click menus. Compare
// shell/modules/desktop/: DesktopWidgets.qml (grid, snap preview, menus),
// WidgetFrame.qml (glass or a Material card, drag, remove badge),
// WidgetHeader.qml, each *Widget.qml, AnalogClock.qml, GaugeRing.qml,
// DesktopIcons.qml, and glass/ContextMenu.qml.
//
// Rust (src/surfaces/desktop/) builds every widget's words, lists and paths
// (one DeskWidget per widget, its fields named per kind below) and decides
// where things snap; this draws them and animates them.

import { Theme } from "@tessera/theme.slint";
import { SymIcon, Symbols } from "@tessera/symbols.slint";

// Colours Theme doesn't carry: Glass's accents (Theme.accents) and two more
// Material roles
export global Desk {
    in property <color> green: #30D158;
    in property <color> red: #FF453A;
    in property <color> yellow: #FFD60A;
    in property <color> accent-ink: #0A84FF; // Theme.accentInk
    in property <color> m3-on-tertiary: #ffffff;
    in property <color> m3-secondary: #ffffff;
    in property <length> tile: 36px; // Theme.radius.tile
}

export struct DLine { text: string, sub: string, tint: color, flag: bool, key: string }
export struct DGauge { value: float, glyph: string, picture: image, has-picture: bool, tint: color, text: string, name: string }
export struct DDay { label: string, col: int, row: int, today: bool, selected: bool, busy: bool }
export struct DHour { time: string, glyph: string, temp: string }
export struct DClock { angle-h: float, angle-m: float, night: bool, name: string, sub: string }
export struct DStat { label: string, text: string, tint: color, area: string, line: string, gw: float, gh: float }
export struct DStock { sym: string, name: string, price: string, change: string, has: bool, tone: color, tone-text: color, chip: color, spark: string }
export struct DButton { title: string, label: string, glyph: string, tint: color, bg: color, ink: color }
export struct DBar { label: string, frac: float, today: bool }
export struct DApp { name: string, time: string, frac: float, icon: image, has-icon: bool }
export struct DRun { area: string, line: string, tint: color }

// One widget. Common fields first; the rest are each kind's (see the
// components below for what t1… mean to each)
export struct DeskWidget {
    index: int,
    key: string,
    kind: string, // what's drawn (a stack: the widget on top)
    size: string,
    x: length, y: length, w: length, h: length, // the card at its cell
    has-card: bool, card: color, pill: bool, // Material's tonal card
    pad: length, pad-x: length,
    stack: bool, stack-n: int, stack-i: int, stack-dir: int, stack-turn: int,
    t1: string, t2: string, t3: string, t4: string, t5: string, t6: string,
    g1: string, g2: string,
    on: bool, flag: bool, alert: bool,
    tint: color,
    n1: float, n2: float,
    shape: string, // a Material shape's outline (0..100 box)
    img: image, img2: image, has-img: bool, front: bool,
    note: string,
    lines: [DLine], lines2: [DLine],
    gauges: [DGauge], days: [DDay], hours: [DHour], clocks: [DClock],
    stats: [DStat], stocks: [DStock], buttons: [DButton], bars: [DBar],
    apps: [DApp], runs: [DRun],
}

export struct DeskIcon {
    index: int,
    name: string,
    x: length, y: length,
    selected: bool,
    stack: bool,
    pic: image, has-pic: bool, // an image file's thumbnail, else its icon
    fan: [image], // a stack's three newest
}

export struct DeskFile { name: string, icon: image }

// ── Small pieces ────────────────────────────────────────────────────────────

component T inherits Text {
    color: Theme.label;
    font-size: Theme.small;
    vertical-alignment: top;
    accessible-role: none;
}

// A widget's title row: a coloured disc with an icon, and the name
component Header inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <color> tint: Theme.accent;
    in property <bool> alert;
    in property <color> title-color: Theme.label;
    height: 26px;
    Rectangle {
        x: 0;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: Theme.material ? (alert ? Theme.m3-error : Theme.m3-primary) : tint;
        SymIcon {
            text: glyph;
            fill: true;
            font-size: 15px;
            color: Theme.material ? (alert ? Theme.m3-on-error : Theme.m3-on-primary) : tint == Theme.accent ? Theme.on-accent : tint == Desk.yellow ? #1C1C1E : white;
        }
    }
    T {
        x: 34px;
        height: 26px;
        vertical-alignment: center;
        text: title;
        color: title-color;
        font-size: Theme.body;
        font-weight: 600;
    }
}

// An analog face: hour ticks, hour and minute hands (AnalogClock.qml).
// Material: a scalloped cookie, primary container by day, tertiary at night
component Analog inherits Rectangle {
    in property <DClock> c;
    in property <string> cookie; // Material's outline
    property <color> face: Theme.material ? (c.night ? Theme.m3-tertiary-container : Theme.m3-primary-container) : c.night ? #1C1C1E : #F5F5F7;
    property <color> ink: Theme.material ? (c.night ? Theme.m3-on-tertiary-container : Theme.m3-on-primary-container) : c.night ? #F5F5F7 : #1C1C1E;
    property <color> hour-ink: Theme.material ? (c.night ? Theme.m3-tertiary : Theme.m3-primary) : ink;
    property <float> ah: c.angle-h;
    property <float> am: c.angle-m;
    animate ah, am { duration: 400ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    width: 120px;
    height: self.width;
    if !Theme.material: Rectangle {
        border-radius: self.width / 2;
        background: face;
    }
    if Theme.material: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: cookie;
        fill: face;
    }
    for i in 12: Rectangle {
        visible: !Theme.material || Math.mod(i, 3) == 0;
        width: root.width;
        height: root.height;
        transform-rotation: i * 30deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        Rectangle {
            property <bool> quarter: Math.mod(i, 3) == 0;
            width: Theme.material ? max(3px, root.width * 0.04) : quarter ? 2.5px : 1.5px;
            height: Theme.material ? self.width : root.width * (quarter ? 0.09 : 0.06);
            x: (root.width - self.width) / 2;
            y: Theme.material ? root.width * 0.13 : root.width * 0.06;
            border-radius: Theme.material ? self.width / 2 : 1px;
            background: ink.with-alpha(Theme.material ? 0.6 : quarter ? 0.85 : 0.45);
        }
    }
    Rectangle {
        width: root.width;
        height: root.height;
        transform-rotation: ah * 1deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        Rectangle {
            width: Theme.material ? max(5px, root.width * 0.085) : max(3px, root.width * 0.045);
            height: Theme.material ? root.height * 0.23 + self.width : root.height * 0.27;
            x: (root.width - self.width) / 2;
            y: Theme.material ? root.height * 0.27 - self.width / 2 : root.height * 0.25;
            border-radius: self.width / 2;
            background: hour-ink;
        }
    }
    Rectangle {
        width: root.width;
        height: root.height;
        transform-rotation: am * 1deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        Rectangle {
            width: Theme.material ? max(3px, root.width * 0.05) : max(2px, root.width * 0.03);
            height: Theme.material ? root.height * 0.34 + self.width / 2 : root.height * 0.42;
            x: (root.width - self.width) / 2;
            y: Theme.material ? root.height * 0.16 : root.height * 0.1;
            border-radius: self.width / 2;
            background: ink;
        }
    }
    Rectangle {
        width: Theme.material ? max(6px, root.width * 0.06) : max(6px, root.width * 0.07);
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.material ? (c.night ? Theme.m3-primary : Theme.m3-tertiary) : Theme.accent;
        border-width: Theme.material ? 0 : 1.5px;
        border-color: face;
    }
}

// A ring for a level (GaugeRing.qml): a faint track and an arc
component Ring inherits Rectangle {
    in property <DGauge> g;
    property <length> thick: max(4px, self.width * 0.09);
    property <float> r: (self.width / 1px - thick / 1px) / 2;
    property <float> v: max(0.0001, min(0.9999, g.value));
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.material ? Theme.m3-secondary-container : Theme.fill;
        stroke-width: thick;
        MoveTo { x: root.width / 2px; y: root.height / 2px - r; }
        ArcTo { x: root.width / 2px; y: root.height / 2px + r; radius-x: r; radius-y: r; sweep: true; }
        ArcTo { x: root.width / 2px; y: root.height / 2px - r; radius-x: r; radius-y: r; sweep: true; }
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: g.tint;
        stroke-width: thick;
        stroke-line-cap: round;
        MoveTo { x: root.width / 2px; y: root.height / 2px - r; }
        ArcTo {
            x: root.width / 2px + r * sin(v * 360deg);
            y: root.height / 2px - r * cos(v * 360deg);
            radius-x: r;
            radius-y: r;
            large-arc: v > 0.5;
            sweep: true;
        }
    }
    if g.has-picture: Image {
        width: round((root.width - 2 * thick) * 0.78 / 1px) * 1px;
        height: self.width;
        source: g.picture;
        image-fit: contain;
    }
    if !g.has-picture && g.glyph != "": SymIcon {
        text: g.glyph;
        fill: true;
        font-size: round(root.width * 0.36 / 1px) * 1px;
        color: Theme.label;
    }
}

// A Material checkbox (square, small corners, a round state layer) or
// Glass's ring, ticking a to-do off
component Tick inherits Rectangle {
    in property <length> size: 16px;
    callback ticked();
    width: size;
    height: size;
    border-radius: Theme.material ? 2px : size / 2;
    border-width: Theme.material ? 2px : 1.5px;
    border-color: Theme.material ? Theme.m3-on-surface-variant : Theme.tertiary;
    if Theme.material && ta.has-hover: Rectangle {
        width: size * 2;
        height: size * 2;
        border-radius: size;
        background: Theme.m3-on-surface.with-alpha(ta.pressed ? 0.1 : 0.08);
    }
    ta := TouchArea {
        x: -6px;
        y: -6px;
        width: parent.width + 12px;
        height: parent.height + 12px;
        mouse-cursor: pointer;
        clicked => { root.ticked(); }
    }
    accessible-role: checkbox;
    accessible-checked: false;
    accessible-action-default => { ticked(); }
}

// ── The widgets ─────────────────────────────────────────────────────────────
// Each fills its content box (the card less its padding); `w` is its data

// Clock: small an analog face (clocks[0]); medium t1 the day, t2 the time, t3 the date
component ClockW inherits Rectangle {
    in property <DeskWidget> w;
    if w.size == "s" && w.clocks.length > 0: Analog {
        width: min(root.width, root.height);
        c: w.clocks[0];
        cookie: w.shape;
    }
    if w.size != "s": VerticalLayout {
        alignment: center;
        T { text: w.t1; color: Desk.accent-ink; font-weight: 700; letter-spacing: 1px; }
        T {
            text: w.t2;
            color: Theme.material ? Theme.m3-on-primary-container : Theme.label;
            font-size: 64px;
            font-weight: 600;
            letter-spacing: -2px;
        }
        T { text: w.t3; color: Theme.material ? Theme.m3-on-primary-container.with-alpha(0.8) : Theme.secondary; font-size: Theme.body; font-weight: 500; }
    }
}

// World clock: clocks (name, "Tomorrow, +9h")
component WorldW inherits Rectangle {
    in property <DeskWidget> w;
    in property <string> cookie;
    if w.size == "s" && w.clocks.length > 0: VerticalLayout {
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            Analog { width: 92px; c: w.clocks[0]; cookie: root.cookie; }
        }
        T { text: w.clocks[0].name; horizontal-alignment: center; font-weight: 600; }
    }
    if w.size != "s": HorizontalLayout {
        alignment: center;
        for c in w.clocks: VerticalLayout {
            width: root.width / 4;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                Analog { width: min(64px, root.width / 4 - 8px); c: c; cookie: root.cookie; }
            }
            T { text: c.name; horizontal-alignment: center; overflow: elide; font-weight: 600; }
            T { text: c.sub; horizontal-alignment: center; overflow: elide; color: Theme.secondary; font-size: Theme.caption; }
        }
    }
}

// Weather: on ready; t1 place, t2 temperature, t3 condition, t4 "H:… L:…",
// t5 the error or "Loading weather…", t6 Material small's "24°"; g1 the icon;
// hours. Material small: a circle in the tertiary container (shape)
component WeatherW inherits Rectangle {
    in property <DeskWidget> w;
    property <bool> m-small: Theme.material && w.size == "s";
    if m-small: Path {
        width: min(root.width, root.height);
        height: self.width;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: w.shape;
        fill: Theme.m3-tertiary-container;
    }
    if m-small && w.on: VerticalLayout {
        width: min(root.width, root.height) * 0.72;
        alignment: center;
        SymIcon { text: w.g1; fill: true; font-size: 22px; color: Theme.m3-tertiary; }
        T { text: w.t6; horizontal-alignment: center; color: Theme.m3-on-tertiary-container; font-size: 46px; font-weight: 500; }
        T { text: w.t1; horizontal-alignment: center; overflow: elide; color: Theme.m3-on-tertiary-container; font-weight: 500; }
        T { text: w.t4; horizontal-alignment: center; color: Theme.m3-on-tertiary-container.with-alpha(0.75); font-size: Theme.caption; }
    }
    if !w.on: T {
        width: m-small ? min(root.width, root.height) * 0.7 : root.width;
        height: root.height;
        vertical-alignment: center;
        horizontal-alignment: center;
        wrap: word-wrap;
        text: w.t5;
        color: m-small ? Theme.m3-on-tertiary-container : Theme.secondary;
    }
    if w.on && !m-small: Rectangle {
        VerticalLayout {
            x: 0;
            y: 0;
            width: w.size == "s" ? root.width : root.width / 2;
            height: self.preferred-height;
            T { text: w.t1; overflow: elide; font-size: Theme.body; font-weight: 600; }
            T {
                text: w.t2;
                color: Theme.material ? Theme.m3-on-secondary-container : Theme.label;
                font-size: Theme.material ? 44px : 42px;
                font-weight: Theme.material ? 500 : 400;
            }
        }
        if w.size == "s": VerticalLayout {
            x: 0;
            y: root.height - self.preferred-height;
            height: self.preferred-height;
            spacing: 2px;
            HorizontalLayout { alignment: start; SymIcon { text: w.g1; fill: true; font-size: 18px; color: Theme.label; } }
            T { text: w.t3; font-weight: 500; }
            T { text: w.t4; color: Theme.secondary; }
        }
        if w.size != "s": VerticalLayout {
            x: root.width - self.width;
            y: 0;
            width: root.width / 2;
            height: self.preferred-height;
            spacing: 2px;
            HorizontalLayout {
                alignment: end;
                SymIcon { text: w.g1; fill: true; font-size: 26px; color: Theme.label; }
            }
            T { text: w.t3; horizontal-alignment: right; font-weight: 500; }
            T { text: w.t4; horizontal-alignment: right; color: Theme.secondary; }
        }
        if w.size != "s": HorizontalLayout {
            y: root.height - self.preferred-height;
            height: self.preferred-height;
            for h in w.hours: VerticalLayout {
                spacing: 2px;
                T { text: h.time; horizontal-alignment: center; color: Theme.secondary; font-size: Theme.caption; font-weight: 500; }
                SymIcon { text: h.glyph; fill: true; font-size: 14px; color: Theme.label; }
                T { text: h.temp; horizontal-alignment: center; font-weight: 500; }
            }
        }
    }
}

// Calendar: t1 the day's heading, t2 today's date, on the date shows,
// lines its events (text, sub = when, tint), t3 the empty line; medium:
// days, t4 the month, n1 its weeks
component CalendarW inherits Rectangle {
    in property <DeskWidget> w;
    in property <string> cookie9;
    callback act(string, string);
    property <bool> wide: w.size != "s";
    if !wide: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.act("calendar", ""); }
    }
    VerticalLayout {
        x: 0;
        y: 0;
        width: wide ? root.width * 0.42 : root.width;
        height: self.preferred-height;
        T { text: w.t1; color: Desk.accent-ink; font-weight: 700; letter-spacing: 0.5px; }
        if w.on && !Theme.material: T { text: w.t2; font-size: 40px; }
        if w.on && Theme.material: Rectangle {
            width: 64px;
            height: 68px;
            Path {
                x: 0;
                y: 4px;
                width: 64px;
                height: 64px;
                viewbox-width: 100;
                viewbox-height: 100;
                commands: cookie9;
                fill: Theme.m3-primary;
            }
            T {
                y: 4px;
                height: 64px;
                width: 64px;
                vertical-alignment: center;
                horizontal-alignment: center;
                text: w.t2;
                color: Theme.m3-on-primary;
                font-size: 30px;
                font-weight: 500;
            }
        }
    }
    VerticalLayout {
        x: 0;
        y: root.height - self.preferred-height;
        width: wide ? root.width * 0.42 : root.width;
        height: self.preferred-height;
        spacing: 6px;
        if w.lines.length == 0: T { text: w.t3; wrap: word-wrap; color: Theme.secondary; }
        for e in w.lines: HorizontalLayout {
            spacing: 6px;
            height: 30px;
            Rectangle { width: 3px; height: 30px; border-radius: 1.5px; background: e.tint; }
            VerticalLayout {
                T { text: e.text; overflow: elide; font-weight: 600; }
                T { text: e.sub; overflow: elide; color: Theme.secondary; font-size: Theme.caption; }
            }
        }
    }
    if wide: Rectangle {
        x: root.width - self.width;
        width: root.width * 0.54;
        height: root.height;
        property <length> cw: self.width / 7;
        property <length> ch: self.height / (2 + w.n1);
        T { x: 0; y: 0; text: w.t4; color: Desk.accent-ink; font-size: Theme.caption; font-weight: 700; }
        for l[i] in ["M", "T", "W", "T", "F", "S", "S"]: T {
            x: i * cw;
            y: ch;
            width: cw;
            horizontal-alignment: center;
            text: l;
            color: Theme.tertiary;
            font-size: Theme.caption;
            font-weight: 600;
        }
        for d in w.days: Rectangle {
            x: d.col * cw;
            y: (d.row + 2) * ch;
            width: cw;
            height: ch;
            if d.today || d.selected || dt.has-hover: Rectangle {
                width: min(parent.width, parent.height) + 2px;
                height: self.width;
                border-radius: self.width / 2;
                background: d.today ? Theme.accent : Theme.material ? (d.selected ? Theme.m3-secondary-container : Theme.m3-on-surface.with-alpha(0.08)) : d.selected ? Theme.fill-pressed : Theme.fill;
            }
            T {
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: center;
                text: d.label;
                color: d.today ? Theme.on-accent : Theme.material && d.selected ? Theme.m3-on-secondary-container : Theme.label;
                font-size: Theme.caption;
                font-weight: d.today ? 700 : 500;
            }
            if d.busy && !d.today: Rectangle {
                y: parent.height - 2px;
                width: 3px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.accent;
            }
            dt := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.act("day", d.label); }
            }
        }
    }
}

// Reminders: t1 the count, lines the open ones (text, sub = due, flag =
// overdue, key), t3 the empty line, t4 "N more"; large: a field to add one
component RemindersW inherits Rectangle {
    in property <DeskWidget> w;
    callback act(string, string);
    Header { x: 0; y: 0; width: root.width; glyph: "\u{eadc}"; title: "Reminders"; }
    T { x: root.width - self.width; y: 0; text: w.t1; font-size: 24px; font-weight: 600; }
    VerticalLayout {
        x: 0;
        y: 38px;
        width: root.width;
        height: self.preferred-height;
        spacing: 8px;
        if w.lines.length == 0: T { text: w.t3; color: Theme.secondary; }
        for t in w.lines: HorizontalLayout {
            spacing: 8px;
            Tick { size: 16px; y: 0; ticked => { root.act("tick", t.key); } }
            T { text: t.text; overflow: elide; horizontal-stretch: 1; }
            if t.sub != "" && w.size != "s": T { text: t.sub; color: t.flag ? Theme.danger : Theme.tertiary; font-size: Theme.caption; horizontal-stretch: 0; }
        }
        if w.t4 != "": T { text: w.t4; color: Theme.secondary; font-size: Theme.caption; }
    }
    if w.size == "l": Rectangle {
        y: root.height - 32px;
        height: 32px;
        border-radius: Theme.material ? 16px : 10px;
        background: Theme.fill;
        SymIcon { x: 10px; width: 12px; text: "\u{e3d4}"; bold: true; font-size: 12px; color: Theme.secondary; }
        field := TextInput {
            x: 30px;
            width: parent.width - 40px;
            height: 100%;
            vertical-alignment: center;
            single-line: true;
            color: Theme.label;
            font-size: Theme.small;
            accessible-label: "New reminder";
            accepted => {
                if self.text != "" {
                    root.act("add", self.text);
                    self.text = "";
                }
            }
        }
        if field.text == "" && !field.has-focus: T {
            x: 30px;
            height: 100%;
            vertical-alignment: center;
            text: "New reminder";
            color: Theme.tertiary;
        }
    }
}

// Today: t1 the greeting, t2 the date, on the weather's ready (g1, t3), t4
// high/low/rain (large), lines events (text, sub = time, tint), t5 "Nothing
// else today", lines2 to-dos (large), t6 "No to-dos"
component TodayW inherits Rectangle {
    in property <DeskWidget> w;
    callback act(string, string);
    property <bool> large: w.size == "l";
    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width - (w.on ? wx.preferred-width + 8px : 0);
        height: self.preferred-height;
        spacing: 2px;
        T {
            text: w.t1;
            overflow: elide;
            color: Theme.material ? Theme.m3-on-primary-container : Theme.label;
            font-size: large ? 18px : 16px;
            font-weight: 600;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.act("today", ""); }
            }
        }
        T { text: w.t2; color: Theme.secondary; }
    }
    wx := HorizontalLayout {
        x: root.width - self.preferred-width;
        y: 0;
        width: self.preferred-width;
        visible: w.on;
        spacing: 6px;
        height: 24px;
        SymIcon { text: w.g1; fill: true; font-size: 18px; color: Theme.label; }
        T { text: w.t3; vertical-alignment: center; font-size: 18px; font-weight: 600; }
    }
    VerticalLayout {
        x: 0;
        y: large ? 60px : 56px;
        width: root.width;
        height: self.preferred-height;
        spacing: 6px;
        if large && w.on: T { text: w.t4; color: Theme.secondary; }
        if w.lines.length == 0: T { text: w.t5; color: Theme.tertiary; }
        for e in w.lines: HorizontalLayout {
            height: 18px;
            spacing: 8px;
            Rectangle { width: 3px; height: 14px; y: 2px; border-radius: 1.5px; background: e.tint; }
            T { text: e.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
            T { text: e.sub; color: Theme.secondary; vertical-alignment: center; horizontal-stretch: 0; }
        }
        if large: Rectangle { height: 4px; }
        if large && w.lines2.length == 0: T { text: w.t6; color: Theme.tertiary; }
        if large: VerticalLayout {
            spacing: 6px;
            for t in w.lines2: HorizontalLayout {
                height: 18px;
                spacing: 8px;
                Tick { size: Theme.material ? 16px : 14px; ticked => { root.act("tick", t.key); } }
                T { text: t.text; overflow: elide; vertical-alignment: center; }
            }
        }
    }
}

// Batteries: gauges (up to four); t1 "No batteries"
component BatteriesW inherits Rectangle {
    in property <DeskWidget> w;
    if w.gauges.length == 0: T { width: root.width; height: root.height; vertical-alignment: center; horizontal-alignment: center; text: w.t1; color: Theme.secondary; }
    if w.size == "s" && w.gauges.length == 1: VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Ring { width: 76px; height: 76px; g: w.gauges[0]; }
        }
        T { text: w.gauges[0].text; horizontal-alignment: center; font-size: Theme.body; font-weight: 600; }
    }
    if w.size == "s" && w.gauges.length > 1: Rectangle {
        width: 116px;
        height: w.gauges.length > 2 ? 116px : 52px;
        for g[i] in w.gauges: Ring {
            x: Math.mod(i, 2) * 64px;
            y: floor(i / 2) * 64px;
            width: 52px;
            height: 52px;
            g: g;
        }
    }
    if w.size != "s": HorizontalLayout {
        y: (root.height - self.preferred-height) / 2;
        height: self.preferred-height;
        for g in w.gauges: VerticalLayout {
            width: root.width / max(2, w.gauges.length);
            spacing: 6px;
            HorizontalLayout {
                alignment: center;
                Ring { width: 56px; height: 56px; g: g; }
            }
            T { text: g.text; horizontal-alignment: center; font-weight: 600; }
            T { text: g.name; horizontal-alignment: center; overflow: elide; color: Theme.secondary; font-size: Theme.caption; }
        }
    }
}

// Now Playing: t1 the title, t2 the artist, img the cover (has-img), on
// playing, flag a player is there
component NowPlayingW inherits Rectangle {
    in property <DeskWidget> w;
    callback act(string, string);
    property <length> art: w.size == "s" ? 64px : root.height;
    Rectangle {
        x: 0;
        y: 0;
        width: art;
        height: art;
        clip: true;
        // (Material: the cover cut round while it plays, square while
        // paused; Slint can't clip to the cookie shape)
        border-radius: Theme.material ? (w.on ? art / 2 : 12px) : 12px;
        animate border-radius { duration: 300ms; easing: ease-out; }
        background: Theme.material ? Theme.m3-surface-container-highest : Theme.fill;
        if w.has-img: Image { width: 100%; height: 100%; source: w.img; image-fit: cover; }
        if !w.has-img: SymIcon { text: "\u{e340}"; font-size: 26px; color: Theme.tertiary; }
    }
    VerticalLayout {
        x: w.size == "s" ? 0 : art + 14px;
        y: w.size == "s" ? root.height - self.preferred-height : 4px;
        width: root.width - self.x;
        height: self.preferred-height;
        spacing: 2px;
        T { text: w.t1; overflow: elide; color: Theme.material ? Theme.m3-on-secondary-container : Theme.label; font-size: Theme.body; font-weight: 600; }
        T { text: w.t2; overflow: elide; color: Theme.secondary; }
    }
    if w.size != "s": Rectangle {
        x: art + 6px;
        y: root.height - 40px;
        width: 120px;
        height: 40px;
        if Theme.material: Rectangle {
            x: 40px;
            width: 40px;
            height: 40px;
            border-radius: w.on ? 12px : 20px;
            animate border-radius { duration: 250ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            background: w.flag ? Theme.m3-primary : Theme.m3-on-surface.with-alpha(0.12);
        }
        for b[i] in [{ g: "\u{e5a4}", a: "previous" }, { g: w.on ? "\u{e39e}" : "\u{e3d0}", a: "toggle" }, { g: "\u{e5a6}", a: "next" }]: Rectangle {
            x: i * 40px;
            width: 40px;
            height: 40px;
            border-radius: Theme.material ? 20px : 10px;
            background: !w.flag ? transparent : Theme.material ? (i == 1 ? transparent : bt.pressed ? Theme.m3-on-surface.with-alpha(0.1) : bt.has-hover ? Theme.m3-on-surface.with-alpha(0.08) : transparent) : bt.pressed ? Theme.fill-pressed : bt.has-hover ? Theme.fill : transparent;
            accessible-role: button;
            accessible-label: b.a == "toggle" ? (w.on ? "Pause" : "Play") : b.a == "next" ? "Next track" : "Previous track";
            accessible-action-default => { root.act("media", b.a); }
            SymIcon {
                text: b.g;
                fill: true;
                font-size: 20px;
                color: !Theme.material ? Theme.label : !w.flag ? Theme.m3-on-surface.with-alpha(0.38) : i == 1 ? Theme.m3-on-primary : Theme.m3-on-secondary-container;
            }
            bt := TouchArea {
                enabled: w.flag;
                mouse-cursor: pointer;
                clicked => { root.act("media", b.a); }
            }
        }
    }
}

// System: stats (each with its graph's path in a gw × gh box); n1 columns
component SystemW inherits Rectangle {
    in property <DeskWidget> w;
    property <int> cols: w.n1;
    property <int> rows: ceil(w.stats.length / max(1, cols));
    property <length> sw: (root.width - (cols - 1) * 20px) / max(1, cols);
    property <length> sh: (root.height - (rows - 1) * 14px) / max(1, rows);
    for s[i] in w.stats: Rectangle {
        x: Math.mod(i, cols) * (sw + 20px);
        y: floor(i / cols) * (sh + 14px);
        width: sw;
        height: sh;
        T { x: 0; y: 0; height: 16px; vertical-alignment: center; text: s.label; font-weight: 600; }
        T { x: parent.width - self.width; y: 0; height: 16px; vertical-alignment: center; text: s.text; color: Theme.secondary; }
        if s.area != "": Path {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: parent.height - 22px;
            viewbox-width: s.gw;
            viewbox-height: s.gh;
            commands: s.area;
            fill: s.tint.with-alpha(0.18);
        }
        if s.line != "": Path {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: parent.height - 22px;
            viewbox-width: s.gw;
            viewbox-height: s.gh;
            commands: s.line;
            stroke: s.tint;
            stroke-width: 1.5px;
            stroke-line-cap: round;
        }
        // bars: their outline is filled (area holds them, no line)
    }
}

