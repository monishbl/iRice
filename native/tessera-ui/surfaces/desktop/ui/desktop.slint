}

// A note: its text (note), saved as you write
component NotesW inherits Rectangle {
    in property <DeskWidget> w;
    callback act(string, string);
    Rectangle {
        x: 0;
        y: 0;
        width: 26px;
        height: 26px;
        border-radius: Theme.material ? 13px : 7px;
        background: Theme.material ? Theme.m3-tertiary : Desk.yellow;
        SymIcon { text: "\u{e34c}"; fill: true; font-size: 15px; color: Theme.material ? Desk.m3-on-tertiary : #3A2E00; }
    }
    T {
        x: 34px;
        y: 0;
        height: 26px;
        vertical-alignment: center;
