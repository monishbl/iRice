        font-size: Theme.body;
        font-weight: 600;
    }
    Rectangle {
        y: 36px;
        height: root.height - 36px;
        clip: true;
        edit := TextInput {
            y: 0;
            width: parent.width;
            height: max(parent.height, self.preferred-height);
            single-line: false;
            wrap: word-wrap;
            text: w.note;
            color: Theme.material ? Theme.m3-on-tertiary-container : Theme.label;
            selection-background-color: Theme.material ? Theme.m3-tertiary.with-alpha(0.3) : Theme.accent.with-alpha(0.4);
            font-size: Theme.body;
            accessible-label: "Note";
            edited => { root.act("note", self.text); }
            key-pressed(e) => {
                if e.text == Key.Escape { self.clear-focus(); return accept; }
                reject
            }
        }
        if edit.text == "" && !edit.has-focus: T {
            x: 0;
            y: 0;
            text: "Click to write a note";
            color: Theme.material ? Theme.m3-on-tertiary-container.with-alpha(0.6) : Theme.tertiary;
            font-size: Theme.body;
        }
    }
}

// Shortcuts: buttons (label, glyph; Glass tint, Material bg and ink); t1 the empty line
component ShortcutsW inherits Rectangle {
    in property <DeskWidget> w;
    callback act(string, string);
    property <int> cols: w.size == "s" ? 2 : 4;
    property <length> bw: (root.width - 20px - (cols - 1) * 10px) / cols;
    property <length> bh: (root.height - 20px - 10px) / 2;
    for b[i] in w.buttons: Rectangle {
        x: 10px + Math.mod(i, cols) * (bw + 10px);
        y: 10px + floor(i / cols) * (bh + 10px);
        width: bw;
        height: bh;
        border-radius: Theme.material ? (ta.pressed ? 12px : 20px) : 12px;
        animate border-radius { duration: 200ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        background: Theme.material ? b.bg.mix(b.ink, ta.pressed ? 0.9 : ta.has-hover ? 0.92 : 1) : b.tint.with-alpha(ta.pressed ? 0.32 : ta.has-hover ? 0.26 : 0.18);
        animate background { duration: 150ms; }
        transform-scale: ta.pressed ? (Theme.material ? 1.04 : 0.95) : 1;
        animate transform-scale { duration: 100ms; }
        accessible-role: button;
        accessible-label: b.title;
        accessible-action-default => { root.act("shortcut", b.title); }
        VerticalLayout {
            x: 8px;
            width: parent.width - 14px;
            alignment: center;
            spacing: 4px;
            HorizontalLayout { alignment: start; SymIcon { text: b.glyph; fill: true; font-size: 20px; color: Theme.material ? b.ink : b.tint; } }
            T { text: b.label; wrap: word-wrap; overflow: elide; color: Theme.material ? b.ink : Theme.label; font-size: Theme.caption; font-weight: 500; }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.act("shortcut", b.title); }
        }
    }
    if w.buttons.length == 0: T { width: root.width; height: root.height; vertical-alignment: center; horizontal-alignment: center; wrap: word-wrap; text: w.t1; color: Theme.secondary; }
}

// Screen Time: t1 the total, bars the week (medium), apps, t3 the empty line
component ScreenTimeW inherits Rectangle {
    in property <DeskWidget> w;
    Header { x: 0; y: 0; width: root.width; glyph: "\u{e2b8}"; title: "Screen Time"; }
    VerticalLayout {
        x: 0;
        y: 36px;
        width: w.size == "s" ? root.width : root.width * 0.48;
        height: self.preferred-height;
        spacing: 8px;
        T { text: w.t1; font-size: 24px; font-weight: 600; }
        if w.size != "s": HorizontalLayout {
            alignment: start;
            spacing: 6px;
            for b[i] in w.bars: VerticalLayout {
                spacing: 3px;
                Rectangle {
                    width: 12px;
                    height: 44px;
                    Rectangle {
                        y: parent.height - self.height;
                        height: max(2px, parent.height * b.frac);
                        border-radius: Theme.material ? 6px : 3px;
                        background: b.today ? Theme.accent : Theme.material ? Theme.m3-secondary-container : Theme.fill;
                    }
                }
                T { text: b.label; horizontal-alignment: center; color: Theme.tertiary; font-size: Theme.caption; }
            }
        }
    }
    VerticalLayout {
        x: w.size == "s" ? 0 : root.width * 0.48 + 12px;
        y: root.height - self.preferred-height;
        width: root.width - self.x;
        height: self.preferred-height;
        spacing: 6px;
        if w.apps.length == 0: T { text: w.t3; color: Theme.secondary; }
        for a in w.apps: HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 18px;
                if a.has-icon: Image { width: 18px; height: 18px; source: a.icon; }
            }
            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    T { text: a.name; overflow: elide; font-size: Theme.caption; font-weight: 500; horizontal-stretch: 1; }
                    T { text: a.time; color: Theme.secondary; font-size: Theme.caption; horizontal-stretch: 0; }
                }
                Rectangle {
                    height: 3px;
                    Rectangle {
                        x: 0;
                        width: parent.width * a.frac;
                        border-radius: 1.5px;
                        background: Theme.accent.with-alpha(Theme.material ? 1 : 0.8);
                    }
                }
            }
        }
    }
}

// Battery History: t1 the level, g1 its icon, alert low, runs (each a path
// in an n1 × n2 box), t2 the left label, on there's history
component BatteryHistoryW inherits Rectangle {
    in property <DeskWidget> w;
    Header { x: 0; y: 0; width: root.width; glyph: w.g1; title: "Battery"; tint: w.alert ? Desk.red : Desk.green; alert: w.alert; }
    T { x: root.width - self.width; y: 0; text: w.t1; font-size: 24px; font-weight: 600; }
    Rectangle {
        y: 38px;
        height: root.height - 38px - 18px;
        for p in [0, 0.5, 1]: Rectangle {
            y: round((1 - p) * parent.height / 1px) * 1px;
            height: 1px;
            background: Theme.separator;
        }
        for r in w.runs: Rectangle {
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: w.n1;
                viewbox-height: w.n2;
                commands: r.area;
                fill: r.tint.with-alpha(0.28);
            }
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: w.n1;
                viewbox-height: w.n2;
                commands: r.line;
                stroke: r.tint;
                stroke-width: 1.5px;
            }
        }
    }
    T { x: 0; y: root.height - 14px; text: w.t2; color: Theme.tertiary; font-size: Theme.caption; }
    T { x: root.width - self.width; y: root.height - 14px; text: "Now"; color: Theme.tertiary; font-size: Theme.caption; }
    if !w.on: T { y: root.height - 14px; horizontal-alignment: center; width: root.width; text: "No history yet"; color: Theme.secondary; font-size: Theme.caption; }
}

