// The emoji picker in Rust (rust.surfaces: emoji), compare
// shell/modules/emoji/PickerWindow.qml and PickerButton.qml. A transparent
// full-screen layer (a click outside closes it) with the panel near the
// pointer: search, category tabs, a sectioned grid (or GIFs), a footer
// naming the selected item, and the skin-tone chooser. Rust
// (src/surfaces/emoji) owns the state: what's listed, the selection, the
// keys; this draws it.

import { Theme, Icon } from "@tessera/theme.slint";
import { SearchField, IconButton, KeyHint, Busy, StateShape, TextButton } from "@tessera/widgets.slint";

export struct ECell {
    text: string,
    name: string,
    emoji: bool,
    toned: bool,
}

// kind: 0 a section's title, 1 a hint (an empty section), 2 items
export struct ERow {
    kind: int,
    y: length,
    h: length,
    title: string,
    start: int,
    cols: int,
    cells: [ECell],
}

export struct ETab {
    icon: string,
    text: string,
    label: string,
}

export struct GifCell {
    image: image,
    ready: bool,
    title: string,
}

export component EmojiPicker inherits Window {
    // Where the panel sits (its top-left, set once per open)
    in property <length> panel-x;
    in property <length> panel-y;
    in property <bool> shown; // drives the open/close animation
    // (the first open: drawn once all but invisible first, so the fonts and
    // glyphs are ready before the animation starts)
    in property <bool> warm;
    in property <string> emoji-font: "Noto Color Emoji";
    in property <[ETab]> tabs;
    in property <int> tab;
    in property <bool> gif-mode;
    in property <[ERow]> rows;
    in property <length> rows-height;
    in-out property <length> list-y; // the list's content-y (0 or less)
    in property <int> sel;
    in property <int> pressed-index: -1;
    // The footer: the selected item, large, with its name
    in property <bool> footer-shown;
    in property <int> footer-kind; // 0 emoji, 1 kaomoji, 2 symbol, 3 GIF
    in property <string> footer-glyph;
    in property <string> footer-name;
    in property <string> footer-sub;
    in property <[string]> hint-insert: ["Enter"];
    in property <[string]> hint-copy: ["Shift", "Enter"];
    // Empty, loading and error states ("" none)
    in property <string> state-kind;
    in property <bool> state-spin;
    in property <string> state-icon;
    in property <string> state-title;
    in property <string> state-body;
    in property <string> state-action;
    in property <string> state-secondary;
    in property <string> state-outline; // Material's shape behind the icon
    in property <bool> state-problem; // (Material: the error container)
    // The skin-tone chooser
    in property <bool> tone-open;
    in property <length> tone-x;
    in property <length> tone-y;
    in property <[string]> tone-forms;
    in-out property <int> tone-choice;
    // GIFs
    in property <[GifCell]> gifs;
    in property <int> gif-sel;
    in property <bool> gif-more; // loading the next page
    in-out property <length> gif-y;
    in property <string> placeholder: "Search emoji, kaomoji and symbols";

    out property <float> openness: shown ? 1 : 0; // (Rust follows it for the glass shape)
    out property <length> panel-width: 420px;
    out property <length> panel-height: 428px;
    out property <length> body-y: panel.y;
    out property <float> body-scale: panel.transform-scale;
    out property <float> body-opacity: panel.opacity;
    property <length> pad: 12px;
    property <length> content-w: 396px;
    property <length> grid-h: 276px;

    callback key(string, bool, bool, bool) -> bool; // text, shift, alt, control: handled?
    callback edited(string);
    callback hovered(int);
    callback activate(int, bool); // item, copy only
    callback tone-for(int); // open the chooser for an item
    callback tone-pick(int, bool); // tone, copy only
    callback tone-close();
    callback set-tab(int);
    callback scrolled(length); // the list moved (its content-y)
    callback gif-hovered(int);
    callback gif-activate(int, bool);
    callback gif-scrolled(length, length); // content-y, its height
    callback state-act(bool); // the state's button (secondary?)
    callback dismissed(); // a click outside, Esc
    callback closed(); // the close animation ended

    background: transparent;
    no-frame: true;
    title: "Emoji";
    default-font-family: Theme.font;

    animate openness {
        duration: shown ? 380ms : 154ms;
        easing: shown ? spring(0.2) : cubic-bezier(0.4, 0, 1, 1);
    }
    changed openness => {
        if !shown && openness <= 0.001 { closed(); }
    }

    public function open() {
        field.set-text("");
        field.focus-field();
    }
    public function focus-field() {
        field.focus-field();
    }

    // A click outside closes it
    TouchArea {
        enabled: shown;
        clicked => { dismissed(); }
    }

    panel := Rectangle {
        x: panel-x;
        y: panel-y + (1 - openness) * -6px;
        width: panel-width;
        height: panel-height;
        opacity: warm && openness < 0.004 ? 0.004 : min(1, openness);
        transform-scale: 0.97 + 0.03 * min(1, openness);
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        // Glass: the tint over the plugin's glass; Material: its tonal surface
        border-radius: Theme.radius-popover + 4px;
        background: Theme.material ? Theme.m3-surface-container : Theme.panel;
        border-width: Theme.material ? 0 : 0.5px;
        border-color: Theme.separator;
        drop-shadow-blur: Theme.material ? 24px : 0;
        drop-shadow-offset-y: Theme.material ? 6px : 0;
        drop-shadow-color: Theme.material ? Theme.m3-shadow.with-alpha(Theme.dark ? 0.3 : 0.12) : transparent;
        accessible-role: groupbox;
        accessible-label: "Emoji, kaomoji, symbols and GIFs";

        // Clicks on the panel don't reach the outside catcher
        TouchArea {
            clicked => { tone-close(); }
        }

        content := Rectangle {
            x: pad;
            y: pad;
            width: content-w;
            height: panel-height - pad - 4px;

            field := SearchField {
                x: 0;
                y: 0;
                width: parent.width;
                placeholder: root.placeholder;
                edited(t) => { root.edited(t); }
                key(e) => { return root.key(e.text, e.modifiers.shift, e.modifiers.alt, e.modifiers.control); }
            }

            // ── Emoji, kaomoji, symbols, search results ──
            list := Flickable {
                visible: !gif-mode && state-kind == "";
                y: 36px + 8px + 32px + 4px;
                width: parent.width;
                height: grid-h;
                content-height: max(rows-height, self.height);
                content-y <=> root.list-y;
                changed content-y => { scrolled(self.content-y); }
                accessible-role: AccessibleRole.list;
                accessible-label: "Emoji";

                for r in rows: Rectangle {
                    y: r.y;
                    height: r.h;
                    width: content-w;
                    // (only the rows near the view are drawn)
                    property <bool> near: r.y + r.h > -list.content-y - 88px && r.y < -list.content-y + grid-h + 88px;
                    if near && r.kind == 0: Text {
                        x: 6px;
                        y: parent.height - 6px - self.preferred-height;
                        text: r.title;
                        color: Theme.secondary;
                        font-size: Theme.small;
                        font-weight: 600;
                        accessible-role: none;
                    }
                    if near && r.kind == 1: Text {
                        x: 6px;
                        height: parent.height;
                        text: r.title;
                        color: Theme.tertiary;
                        font-size: Theme.body;
                        vertical-alignment: center;
                    }
                    if near && r.kind == 2: Rectangle {
                        property <length> cw: content-w / max(1, r.cols);
                        property <int> on: root.sel - r.start;
                        // the selection (Material: secondary container, rounder pressed)
                        if on >= 0 && on < r.cells.length: Rectangle {
                            x: on * cw + 1px;
                            y: 1px;
                            width: cw - 2px;
                            height: parent.height - 2px;
                            border-radius: Theme.material && root.pressed-index == root.sel ? self.height / 2 : Theme.radius-control;
                            animate border-radius { duration: 250ms; easing: spring(0.3); }
                            background: Theme.material ? Theme.m3-secondary-container.mix(Theme.m3-on-secondary-container, root.pressed-index == root.sel ? 0.9 : 1)
                                : root.pressed-index == root.sel ? Theme.fill-pressed : Theme.accent.with-alpha(Theme.dark ? 0.32 : 0.16);
                        }
                        for c[ci] in r.cells: Rectangle {
                            x: ci * cw;
                            width: cw;
                            accessible-role: list-item;
                            accessible-label: c.name;
                            accessible-item-selectable: true;
                            accessible-item-selected: root.sel == r.start + ci;
                            accessible-action-default => { activate(r.start + ci, false); }
                            Text {
                                width: parent.width - 8px;
                                text: c.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: c.emoji ? clip : elide;
                                color: Theme.material && root.sel == r.start + ci ? Theme.m3-on-secondary-container : Theme.label;
                                font-family: c.emoji ? root.emoji-font : Theme.font;
                                font-size: c.emoji ? 28px : r.cols == 3 ? Theme.body : 20px;
                                accessible-role: none;
                            }
                            // has skin tones (right-click or hold)
                            if c.toned: Rectangle {
                                x: parent.width - 9px;
                                y: parent.height - 9px;
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.tertiary;
                            }
                        }
                        ta := TouchArea {
                            mouse-cursor: idx >= 0 ? pointer : default;
                            property <int> cix: floor(self.mouse-x / cw);
                            property <int> idx: self.has-hover && cix >= 0 && cix < r.cells.length ? r.start + cix : -1;
                            property <bool> held;
                            changed idx => { if idx >= 0 { hovered(idx); } }
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    held = false;
                                    if e.button == PointerEventButton.right && idx >= 0 { tone-for(idx); }
                                }
                                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && idx >= 0 && !held {
                                    activate(idx, e.modifiers.shift);
                                }
                            }
                            // hold: the tones
                            Timer {
                                interval: 450ms;
                                running: ta.pressed && ta.idx >= 0 && !ta.held;
                                triggered => {
                                    ta.held = true;
                                    tone-for(ta.idx);
                                }
                            }
                        }
                    }
                }
            }

            // ── GIFs ──
            gif-list := Flickable {
                visible: gif-mode && state-kind == "";
                y: 36px + 8px + 32px + 8px;
                width: parent.width;
                height: grid-h - 4px;
                content-height: max(self.height, ceil(gifs.length / 3) * 104px + (gif-more ? (Theme.material ? 56px : 40px) : 0));
                content-y <=> root.gif-y;
                changed content-y => { gif-scrolled(self.content-y, self.content-height); }
                accessible-role: AccessibleRole.list;
                accessible-label: "GIFs";
                for g[i] in gifs: Rectangle {
                    x: mod(i, 3) * (content-w / 3);
                    y: floor(i / 3) * 104px;
                    width: content-w / 3;
                    height: 104px;
                    accessible-role: list-item;
                    accessible-label: g.title != "" ? g.title : "GIF";
                    accessible-item-selectable: true;
                    accessible-item-selected: i == gif-sel;
                    accessible-action-default => { gif-activate(i, false); }
                    frame := Rectangle {
                        x: Theme.material ? 2px : 3px;
                        y: self.x;
                        width: parent.width - 2 * self.x;
                        height: parent.height - 2 * self.y;
                        border-radius: Theme.material ? 16px : Theme.radius-control;
                        background: Theme.fill;
                        clip: true;
                        if g.ready: Image {
                            width: parent.width;
                            height: parent.height;
                            source: g.image;
                            image-fit: cover;
                            accessible-role: none;
                        }
                    }
                    if i == gif-sel: Rectangle {
                        x: frame.x;
                        y: frame.y;
                        width: frame.width;
                        height: frame.height;
                        border-radius: frame.border-radius;
                        border-width: Theme.material ? 3px : 2px;
                        border-color: Theme.accent;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => { if self.has-hover { gif-hovered(i); } }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.has-hover {
                                gif-activate(i, e.modifiers.shift);
                            }
                        }
                    }
                }
                if gif-more: Busy {
                    x: (parent.width - self.width) / 2;
                    y: ceil(gifs.length / 3) * 104px + 8px;
                }
            }

            // ── States: loading, no results, the GIF key, errors ──
            if state-kind != "": VerticalLayout {
                y: 36px + 8px + 32px + 4px;
                width: parent.width;
                height: grid-h;
                alignment: center;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 8px;
                if state-spin: HorizontalLayout {
                    alignment: center;
                    Busy { }
                }
                if !Theme.material && state-icon != "": Icon {
                    text: state-icon;
                    font-size: 32px;
                    color: Theme.tertiary;
                }
                if Theme.material && state-icon != "": HorizontalLayout {
                    alignment: center;
                    padding-bottom: 8px;
                    StateShape {
                        outline: state-outline;
                        icon: state-icon;
                        shape-color: state-problem ? Theme.m3-error-container : Theme.m3-secondary-container;
                        icon-color: state-problem ? Theme.m3-on-error-container : Theme.m3-on-secondary-container;
                    }
                }
                Text {
                    text: state-title;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    color: state-spin ? Theme.secondary : Theme.label;
                    font-size: state-spin ? Theme.body : Theme.title;
                    font-weight: state-spin ? 400 : Theme.material ? 500 : 600;
                }
                if state-body != "": Text {
                    text: state-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    color: Theme.secondary;
                    font-size: Theme.body;
                }
                if state-action != "": HorizontalLayout {
                    alignment: center;
                    padding-top: 8px;
                    spacing: 8px;
                    TextButton {
                        text: state-action;
                        primary: true;
                        clicked => { state-act(false); }
                    }
                    if state-secondary != "": TextButton {
                        text: state-secondary;
                        clicked => { state-act(true); }
                    }
                }
            }

            // ── The footer: the selected item, large, with its name ──
            footer := Rectangle {
                y: 36px + 8px + 32px + 4px + grid-h;
                width: parent.width;
                height: 56px;
                Rectangle {
                    height: 1px;
                    y: 0;
                    background: Theme.separator;
                }
                if footer-shown && footer-kind < 3: Text {
                    x: 4px;
                    y: 2px;
                    height: parent.height;
                    width: footer-kind == 1 ? min(self.preferred-width, 150px) : 40px;
                    text: footer-glyph;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: footer-kind == 1 ? elide : clip;
                    color: Theme.label;
                    font-family: footer-kind == 0 ? root.emoji-font : Theme.font;
                    font-size: footer-kind == 0 ? 34px : footer-kind == 1 ? Theme.title : 28px;
                    accessible-role: none;
                }
                if footer-shown: VerticalLayout {
                    x: footer-kind == 3 ? 4px : footer-kind == 1 ? min(glyph-w.preferred-width, 150px) + 16px : 56px;
                    y: 2px;
                    width: hints.x - self.x - 12px;
                    height: parent.height;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: footer-name;
                        overflow: elide;
                        color: Theme.label;
                        font-size: Theme.body;
                        font-weight: 600;
                    }
                    Text {
                        text: footer-sub;
                        overflow: elide;
                        color: Theme.tertiary;
                        font-size: Theme.small;
                    }
                }
                // (the kaomoji's natural width, for the name's place)
                glyph-w := Text {
                    visible: false;
                    text: footer-kind == 1 ? footer-glyph : "";
                    font-size: Theme.title;
                }
                hints := HorizontalLayout {
                    x: parent.width - self.width - 2px;
                    y: (parent.height - self.height) / 2 + 2px;
                    width: self.preferred-width;
                    height: 22px;
                    spacing: 10px;
                    KeyHint {
                        keys: hint-insert;
                        text: "Insert";
                    }
                    KeyHint {
                        keys: hint-copy;
                        text: "Copy";
                    }
                }
            }

            // ── Category tabs (after the grid: their names show over it) ──
            for t[i] in tabs: Rectangle {
                x: i * (content-w / tabs.length);
                y: 36px + 8px;
                width: content-w / tabs.length;
                height: 32px;
                property <bool> active: i == root.tab;
                accessible-role: AccessibleRole.tab;
                accessible-label: t.label;
                accessible-item-selectable: true;
                accessible-item-selected: active;
                accessible-action-default => { set-tab(i); }
                // Glass: a fill behind the chosen one, a line under it
                if !Theme.material: Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.radius-control - 2px;
                    background: tt.pressed ? Theme.fill-pressed : active ? Theme.fill : tt.has-hover ? Theme.fill.with-alpha(Theme.fill.alpha * 0.6) : transparent;
                    animate background { duration: 150ms; }
                }
                // Material: the navigation indicator, a pill that grows out
                // from the middle of the chosen tab
                if Theme.material: Rectangle {
                    property <length> full: min(parent.width - 4px, 48px);
                    width: active || tt.has-hover ? full : full * 0.5;
                    height: 32px;
                    border-radius: 16px;
                    background: active ? Theme.m3-secondary-container.mix(Theme.m3-on-secondary-container, tt.pressed ? 0.9 : tt.has-hover ? 0.92 : 1)
                        : Theme.m3-on-surface-variant.with-alpha(tt.pressed ? 0.1 : tt.has-hover ? 0.08 : 0);
                    animate width { duration: 300ms; easing: spring(0.25); }
                    animate background { duration: 150ms; }
                }
                if t.icon != "": Icon {
                    text: t.icon;
                    fill: active;
                    font-size: 18px;
                    color: Theme.material ? (active ? Theme.m3-on-secondary-container : Theme.m3-on-surface-variant) : active ? Theme.label : Theme.tertiary;
                }
                if t.text != "": Text {
                    text: t.text;
                    color: Theme.material ? (active ? Theme.m3-on-secondary-container : Theme.m3-on-surface-variant) : active ? Theme.label : Theme.tertiary;
                    font-size: Theme.caption;
                    font-weight: 600;
                    accessible-role: none;
                }
                if !Theme.material: Rectangle {
                    y: parent.height - 2px;
                    width: active ? 14px : 0;
                    height: 2px;
                    border-radius: 1px;
                    background: Theme.accent;
                    animate width { duration: 150ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                }
                tt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        set-tab(i);
                        field.focus-field();
                    }
                    changed has-hover => { tip = false; }
                }
                property <bool> tip;
                Timer {
                    interval: 600ms;
                    running: tt.has-hover && !tip;
                    triggered => { tip = true; }
                }
                // its name on hover, after a moment
                if tip && tt.has-hover && !tt.pressed: Rectangle {
                    y: parent.height + 4px;
                    x: (parent.width - self.width) / 2;
                    width: tip-text.preferred-width + 16px;
                    height: 24px;
                    border-radius: Theme.material ? 4px : 6px;
                    background: Theme.material ? Theme.m3-inverse-surface : Theme.dark ? #3A3A3F : #1C1C1E;
                    tip-text := Text {
                        text: t.label;
                        color: Theme.material ? Theme.m3-inverse-on-surface : #F2F2F5;
                        font-size: Theme.small;
                        accessible-role: none;
                    }
                }
            }

            // While choosing a tone, a click elsewhere just closes the chooser
            if tone-open: TouchArea {
                clicked => { tone-close(); }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.right { tone-close(); }
                }
            }

            // ── Skin tones (right-click, hold, or Alt+Down); Material: a
            // floating toolbar, a pill ──
            if tone-open: Rectangle {
                x: tone-x;
                y: tone-y;
                width: 6 * 40px + 8px;
                height: 48px;
                border-radius: Theme.material ? self.height / 2 : Theme.menu-radius;
                background: Theme.material ? Theme.m3-surface-container-highest : Theme.glass-solid;
                border-width: Theme.material ? 0 : 1px;
                border-color: Theme.separator;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #00000040;
                accessible-role: AccessibleRole.list;
                accessible-label: "Skin tone";
                HorizontalLayout {
                    alignment: center;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    for f[ti] in tone-forms: Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: Theme.material ? self.height / 2 : Theme.radius-control;
                        background: Theme.material ? (ti == tone-choice ? Theme.m3-secondary-container.mix(Theme.m3-on-secondary-container, toneTa.pressed ? 0.9 : 1) : transparent)
                            : toneTa.pressed ? Theme.fill-pressed : ti == tone-choice ? Theme.accent.with-alpha(Theme.dark ? 0.32 : 0.16) : toneTa.has-hover ? Theme.fill : transparent;
                        accessible-role: list-item;
                        accessible-label: ["Default", "Light", "Medium-light", "Medium", "Medium-dark", "Dark"][ti] + " skin tone";
                        accessible-item-selectable: true;
                        accessible-item-selected: ti == tone-choice;
                        accessible-action-default => { tone-pick(ti, false); }
                        Text {
                            text: f;
                            font-family: root.emoji-font;
                            font-size: 26px;
                            accessible-role: none;
                        }
                        toneTa := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => { if self.has-hover { tone-choice = ti; } }
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.has-hover {
                                    tone-pick(ti, e.modifiers.shift);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
