// Every surface tessera-ui draws, for slint-build (build.rs) and Rust's `ui`
// module. A new surface: its .slint file here, one export line each.

export { Theme, Icons } from "theme.slint";
export { Bar, Menu, MenuRow, MenuTile, Entry, Chip, Live, Ctl, AlertRow, Ring, Symbols } from "menubar.slint";
export { EmojiPicker, ECell, ERow, ETab, GifCell } from "emoji.slint";
export { ClipboardPanel, CItem } from "clipboard.slint";
export { Dock, DockSlot, DockMenu, DockMenuRow } from "dock.slint";
export { OsdCapsule, OsdPanel, OsdBar, OsdRow } from "osd.slint";
export { Background } from "background.slint";
export { WallpaperPicker, Thumb } from "wallpaper.slint";
export { TodayScreen, Day, TEvent, TTodo, THour } from "today.slint";
export { ControlCenter, CcMod, CcGal, CcBlock, CcMenuItem, CcMedia, CcGlyphs, CcIc } from "controlcenter.slint";
