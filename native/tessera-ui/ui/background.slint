// The wallpaper, one window per screen on the background layer
// (src/surfaces/background; compare shell/modules/background/Background.qml).
// Two pictures, as the QML's two buffers: a new one fades in over the one
// before (700 ms, ease in and out), which keeps showing underneath until
// then and is let go afterwards. Black behind, as the QML's window.
//
// `fade` (following `target`) only ever goes up, by one per new picture;
// each picture starts fading in when `fade` passes its `-from` value (so
// one animated number drives both, and a new picture never needs an instant
// reset).

export component Background inherits Window {
    in property <image> a;
    in property <image> b;
    in property <float> a-from: -1;
    in property <float> b-from: -2;
    in property <float> target: 0; // where the fade is headed
    property <float> fade: target;
    // the newest is fully in (Rust lets the one below go)
    callback faded();

    background: black;
    no-frame: true;
    title: "Wallpaper";
    accessible-role: none;

    animate fade { duration: 700ms; easing: ease-in-out-quad; }
    changed fade => {
        if fade >= max(a-from, b-from) + 0.999 { faded(); }
    }

    Image {
        source: a;
        width: 100%;
        height: 100%;
        image-fit: fill;
        opacity: clamp(fade - a-from, 0, 1);
        visible: self.opacity > 0;
        z: a-from > b-from ? 1 : 0;
        accessible-role: none;
    }
    Image {
        source: b;
        width: 100%;
        height: 100%;
        image-fit: fill;
        opacity: clamp(fade - b-from, 0, 1);
        visible: self.opacity > 0;
        z: b-from > a-from ? 1 : 0;
        accessible-role: none;
    }
}
