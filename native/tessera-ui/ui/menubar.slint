// The menu bar in Rust (rust.surfaces: menubar), compare
// shell/modules/menubar/MenuBar.qml, MenuBarItem.qml, HoverTip.qml,
// PrivacyDots.qml, common/BatteryGlyph.qml and WifiGlyph.qml, and the menus:
// glass/MenuPopover.qml and MaterialMenu.qml.
// (Slint draws no cut-outs: the battery's bolt and its number inside are
// outlined instead of cut out of the fill.)

import { Theme, Icons, Icon } from "theme.slint";
import { Spaces, Chip, Island, Live, Ctl, AlertRow, Ring } from "island.slint";

export { Chip, Live, Ctl, AlertRow, Ring }

// One item on the right (items.rs: Entry)
export struct Entry {
    id: string,
    icon: string,
    fill: bool,
    bold: bool,
    text: string,
    tip: string,
    // 0 icon/text, 1 battery, 2 Wi-Fi, 3 privacy, 4 a tray picture
    glyph: int,
    image: image,
    level: float,
    charging: bool,
    plugged: bool,
    low-power: bool,
    show-percent: bool,
    wifi-on: bool,
    wifi-lit: string, // the lit arcs' glyph ("" none)
    camera: bool,
    mic: bool,
    location: bool,
    share: bool,
    danger: bool,
    active: bool,
    badge: int,
    indicator: string,
    unread: int,
}

// The drawn battery (BatteryGlyph): a capsule, its fill, the nub; a bolt or
// plug when on power; the number inside when asked
component BatteryGlyph inherits Rectangle {
    in property <float> level;
    in property <bool> charging;
    in property <bool> plugged;
    in property <bool> low-power;
    in property <bool> show-percent;
    in property <color> ink;
    in property <bool> ink-dark;
    property <length> size: 12px;
    property <length> cap-w: round(size * (show-percent ? 2.3 : Theme.material ? 1.9 : 2.05) / 1px) * 1px;
    property <length> nub-w: max(2px, round(size * (Theme.material ? 0.16 : 0.17) / 1px) * 1px);
    property <string> mark: charging ? "\u{e2de}" : plugged ? "\u{e946}" : ""; // lightning | plug
    property <length> mark-size: round(size * (Theme.material ? 1.15 : 1.3) / 1px) * 1px;
    property <bool> beside: mark != "" && (show-percent || Theme.material);
    property <length> beside-size: Theme.material ? mark-size : round(size * 0.95 / 1px) * 1px;
    property <color> green: Theme.dark ? #6DD58C : #1E8E3E;
    property <color> fill-color: low-power ? Theme.yellow : Theme.material && (charging || plugged) ? green : !charging && !plugged && level <= 0.2 ? Theme.danger : ink;
    property <color> faint: ink.with-alpha(Theme.material ? 0.3 : 0.35);
    width: cap-w + 1px + nub-w + (beside ? 2px + beside-size : 0);
    height: 16px;
    background: transparent;
    capsule := Rectangle {
        x: 0;
        width: cap-w;
        height: size;
        border-radius: round(size * (Theme.material ? 0.36 : 0.32) / 1px) * 1px;
        clip: true;
        background: faint;
        Rectangle {
            x: 0;
            width: round(parent.width * max(0, min(1, level)) / 1px) * 1px;
            background: fill-color;
        }
        if show-percent: Text {
            text: round(level * 100);
            color: ink-dark ? #ffffffd9 : #000000c0;
            font-size: round(size * (Theme.material ? 0.78 : 0.82) / 1px) * 1px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: cap-w + 1px;
        width: nub-w;
        height: round(size * (Theme.material ? 0.42 : 0.38) / 1px) * 1px;
        border-radius: nub-w / 2;
        background: faint;
    }
    // Glass: the bolt over the capsule, outlined so it reads over the fill
    if mark != "" && !beside: Icon {
        x: (cap-w - self.width) / 2;
        width: mark-size;
        text: mark;
        fill: true;
        font-size: mark-size + 3px;
        color: ink-dark ? #ffffffb3 : #000000a0;
    }
    if mark != "" && !beside: Icon {
        x: (cap-w - self.width) / 2;
        width: mark-size;
        text: mark;
        fill: true;
        font-size: mark-size;
        color: ink;
    }
    if beside: Icon {
        x: cap-w + 1px + nub-w + 2px;
        width: beside-size;
        text: mark;
        fill: true;
        font-size: beside-size;
        color: Theme.material && (charging || plugged) ? fill-color : ink;
    }
}

// One bar item (MenuBarItem): its icon or drawing, its text, a rounded
// highlight on hover and while its menu is open
component Item inherits Rectangle {
    in property <Entry> e;
    in property <color> ink;
    in property <bool> ink-dark;
    callback clicked(PointerEventButton, length);
    callback hovered(bool, length, string);
    property <color> tone: e.danger ? Theme.danger : ink;
    height: 24px;
    width: (e.glyph == 3 && Theme.material ? chip.width : row.preferred-width) + (e.glyph == 3 ? 16px : 18px);
    border-radius: Theme.material ? self.height / 2 : Theme.radius-item;
    background: Theme.material
        ? tone.with-alpha(e.active ? 0.16 : touch.pressed ? 0.1 : touch.has-hover ? 0.08 : 0)
        : tone.with-alpha(e.active ? 0.22 : touch.pressed ? 0.2 : touch.has-hover ? 0.12 : 0);
    animate background { duration: Theme.hover; }
    accessible-role: button;
    accessible-label: e.tip != "" ? e.tip : e.text;
    accessible-action-default => { root.clicked(PointerEventButton.left, self.absolute-position.x); }

    touch := TouchArea {
        changed has-hover => { root.hovered(self.has-hover, root.absolute-position.x + root.width / 2, e.tip); }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right && self.has-hover {
                root.clicked(PointerEventButton.right, root.absolute-position.x);
            }
        }
        clicked => { root.clicked(PointerEventButton.left, root.absolute-position.x); }
    }

    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        visible: e.glyph != 3;
        // Unread notifications, before the clock's text
        if e.unread > 0 && e.indicator != "off": HorizontalLayout {
            spacing: 3px;
            alignment: center;
            if e.indicator == "bellDot" || e.indicator == "bellCount": Rectangle {
                width: 15px;
                Icon {
                    text: "\u{e0ce}"; // bell
                    fill: true;
                    font-size: 14px;
                    color: root.tone;
                }
                if e.indicator == "bellDot": Rectangle {
                    x: 9px;
                    y: (parent.height - 16px) / 2;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.material ? Theme.m3-primary : Theme.blue;
                    border-width: Theme.material ? 0 : 1px;
                    border-color: #00000040;
                }
            }
            if e.indicator == "dot": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.material ? Theme.m3-primary : Theme.blue;
                }
            }
            if e.indicator == "count" || e.indicator == "bellCount": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: max(16px, count.preferred-width + 8px);
                    height: 16px;
                    border-radius: 8px;
                    background: e.indicator == "count" ? (Theme.material ? Theme.m3-primary : Theme.blue) : transparent;
                    count := Text {
                        text: e.unread > 99 ? "99+" : e.unread;
                        color: e.indicator == "count" ? (Theme.material ? Theme.m3-on-primary : #ffffff) : root.tone;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if e.glyph == 4: VerticalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: e.image;
                image-fit: contain;
                accessible-role: none;
            }
        }
        if e.glyph == 1: VerticalLayout {
            alignment: center;
            BatteryGlyph {
                level: e.level;
                charging: e.charging;
                plugged: e.plugged;
                low-power: e.low-power;
                show-percent: e.show-percent;
                ink: root.tone;
                ink-dark: root.ink-dark;
            }
        }
        // Wi-Fi: the arcs faint, the lit ones as strong as the signal
        if e.glyph == 2: Rectangle {
            width: 16px;
            Icon {
                text: e.wifi-on ? "\u{e4ea}" : "\u{e4f2}"; // wifi-high | wifi-slash
                fill: true;
                font-size: 16px;
                color: e.wifi-on ? root.tone.with-alpha(0.35) : root.tone;
            }
            if e.wifi-on && e.wifi-lit != "": Icon {
                text: e.wifi-lit;
                fill: true;
                font-size: 16px;
                color: root.tone;
            }
        }
        if e.icon != "": Icon {
            text: e.icon;
            fill: e.fill;
            bold: e.bold;
            font-size: 15px;
            color: root.tone;
        }
        if e.text != "": Text {
            text: e.text;
            color: root.tone;
            font-size: Theme.material ? 14px : Theme.body;
            font-weight: e.bold ? (Theme.material ? 600 : 700) : 500;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    // The privacy dots (Glass), Android's privacy chip (Material)
    if e.glyph == 3 && !Theme.material: HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-top: 8.5px;
        padding-bottom: 8.5px;
        if e.camera: Rectangle { width: 7px; border-radius: 3.5px; background: #30D158; }
        if e.mic: Rectangle { width: 7px; border-radius: 3.5px; background: #FF9F0A; }
        if e.location: Rectangle { width: 7px; border-radius: 3.5px; background: #0A84FF; }
        if e.share: Rectangle { width: 7px; border-radius: 3.5px; background: #BF5AF2; }
    }
    chip := Rectangle {
        visible: e.glyph == 3 && Theme.material;
        width: icons.preferred-width + 12px;
        height: 20px;
        border-radius: 10px;
        background: Theme.m3-tertiary-container;
        icons := HorizontalLayout {
            alignment: center;
            spacing: 2px;
            if e.camera: Icon { text: "\u{e4da}"; fill: true; font-size: 12px; color: Theme.m3-on-tertiary-container; }
            if e.mic: Icon { text: "\u{e326}"; fill: true; font-size: 12px; color: Theme.m3-on-tertiary-container; }
            if e.location: Icon { text: "\u{eade}"; fill: true; font-size: 12px; color: Theme.m3-on-tertiary-container; }
            if e.share: Icon { text: "\u{e404}"; fill: true; font-size: 12px; color: Theme.m3-on-tertiary-container; }
        }
    }
    // A count bubble (the shelf's items)
    if e.badge > 0: Rectangle {
        x: parent.width - self.width - 1px;
        y: 0;
        width: max(14px, badge.preferred-width + 6px);
        height: 14px;
        border-radius: 7px;
        background: Theme.danger;
        badge := Text {
            text: e.badge > 99 ? "99+" : e.badge;
            color: Theme.material ? Theme.m3-on-error : #ffffff;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A left-side item: the system menu's icon, the app's name, "Window"
component LeftItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> bold;
    in property <bool> active;
    in property <color> ink;
    in property <string> label;
    callback clicked(length);
    height: 24px;
    width: row.preferred-width + 18px;
    border-radius: Theme.material ? self.height / 2 : Theme.radius-item;
    background: ink.with-alpha(Theme.material ? (active ? 0.16 : t.pressed ? 0.1 : t.has-hover ? 0.08 : 0) : (active ? 0.22 : t.pressed ? 0.2 : t.has-hover ? 0.12 : 0));
    animate background { duration: Theme.hover; }
    accessible-role: button;
    accessible-label: label != "" ? label : text;
    accessible-expandable: true;
    accessible-expanded: active;
    accessible-action-default => { root.clicked(self.absolute-position.x); }
    t := TouchArea {
        clicked => { root.clicked(root.absolute-position.x); }
    }
    row := HorizontalLayout {
        alignment: center;
        if icon != "": Icon {
            text: icon;
            fill: true;
            font-size: 16px;
            color: ink;
        }
        if text != "": Text {
            text: root.text;
            color: ink;
            font-size: Theme.material ? 14px : Theme.body;
            font-weight: bold ? (Theme.material ? 600 : 700) : 500;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// One rounded screen corner (Corner.qml: black, concave)
component Corner inherits Path {
    in property <bool> at-right;
    in property <length> r: 12px;
    width: r;
    height: r;
    viewbox-width: 12;
    viewbox-height: 12;
    fill: #000000;
    commands: at-right ? "M 12 0 L 0 0 A 12 12 0 0 1 12 12 Z" : "M 0 0 L 12 0 A 12 12 0 0 0 0 12 Z";
}

// ── The bar (one per output) ────────────────────────────────────────────────
export component Bar inherits Window {
    // the look over the wallpaper
    in property <color> ink: Theme.fg; // the items' colour
    in property <bool> ink-dark; // (dark text: the battery's number reads light)
    in property <color> wall-ink: Theme.fg; // the spaces' and the island's, idle
    in property <bool> pills; // Material without a background: the groups in tonal pills
    in property <bool> opaque; // a background behind the bar
    in property <color> bg: Theme.bar-tint;
    in property <bool> corners;
    in property <length> corner-r: 12px;
    in property <bool> revealed: true; // auto-hide: shown now
    in property <bool> chrome: true; // false over a fullscreen app
    // left
    in property <string> logo: "\u{e604}";
    in property <bool> app-menu: true;
    in property <string> app-name: "Desktop";
    in property <bool> window-menu: true;
    in property <string> window-title;
    in property <string> open-menu; // system | app | window | "" (its highlight)
    // centre: the spaces alone, or the island (which shows them)
    in property <bool> spaces-shown;
    in property <bool> island-on;
    in property <[Chip]> chips;
    in property <length> strip-w;
    in property <bool> arrows;
    in property <length> left-x;
    in property <length> right-x;
    in property <bool> left-more;
    in property <bool> left-hot;
    in property <bool> right-more;
    in property <bool> right-hot;
    // the island's
    in property <int> island-mode;
    in property <bool> event-inside;
    in property <bool> has-card;
    in property <bool> hot;
    in property <bool> pinned;
    in property <string> layout: "replace";
    in property <Live> live;
    in property <int> live-count;
    in property <int> live-index;
    in property <[AlertRow]> alerts;
    in property <string> pill-text;
    in property <string> pill-icon;
    in property <color> pill-tint;
    in property <string> status;
    in property <bool> playing;
    // right
    in property <[Entry]> entries;
    // for Rust: where the island is (glass, input region) and the tip
    out property <length> isl-x: island.x + island.shape-x;
    out property <length> isl-y: island.y + island.shape-y;
    out property <length> isl-w: island.shape-w;
    out property <length> isl-h: island.shape-h;
    out property <length> isl-r: island.shape-r;
    out property <float> isl-fade: island.fade;
    out property <length> tip-x: tip.x;
    out property <length> tip-y: tip.y;
    out property <length> tip-w: tip.width;
    out property <length> tip-h: tip.height;
    out property <float> tip-o: tip.opacity;
    out property <bool> hovered: reveal.has-hover;
    callback menu(string, length); // system | app | window, at x
    callback clicked(string, PointerEventButton, length); // an entry: its id
    callback go(int);
    callback space-menu(int, length);
    callback arrow(int);
    callback space-wheel(int);
    callback scrolled(bool, length); // left half?, wheel delta (logical px, up > 0)
    callback island-hover(bool);
    callback island-pill();
    callback island-cycle(length, length);
    callback island-control(int);
    callback island-act(int, string);
    callback island-dismiss(int);
    callback island-level(float);
    callback island-pin();
    callback island-hold(bool);

    background: transparent;
    no-frame: true;
    title: "Menu bar";
    default-font-family: Theme.font;

    // the dancing bars' clock (12 frames a second, only while music plays)
    property <int> tick;
    Timer {
        interval: 83ms;
        running: (playing && island-on && island-mode == 1 && live.kind == "music" && live.show-bars) || (island-on && island-mode == 1 && live.kind == "recording");
        triggered => { tick += 1; }
    }

    // the hover tip (HoverTip): after half a second on an item, under it
    property <bool> tip-want;
    property <bool> tip-open;
    property <string> tip-text;
    property <length> tip-at;
    Timer {
        interval: 500ms;
        running: tip-want && !tip-open;
        triggered => { tip-open = true; }
    }
    Timer {
        interval: 120ms;
        running: !tip-want && tip-open;
        triggered => { tip-open = false; }
    }

    reveal := TouchArea {
        height: 30px;
        y: 0;
        scroll-event(e) => {
            if e.delta-y == 0 { return reject; }
            root.scrolled(self.mouse-x < self.width / 2, e.delta-y);
            accept
        }

        content := Rectangle {
            y: revealed ? 0 : -30px;
            opacity: revealed ? 1 : 0;
            animate y { duration: Theme.popover; easing: cubic-bezier(0.2, 0, 0, 1); }
            animate opacity { duration: Theme.popover; }

            if opaque && chrome: Rectangle {
                background: root.bg;
            }
            if corners && chrome: Corner {
                x: 0;
                y: 0;
                r: root.corner-r;
            }
            if corners && chrome: Corner {
                x: parent.width - self.width;
                y: 0;
                r: root.corner-r;
                at-right: true;
            }

            // The groups' pills (Material, no background)
            if pills && chrome && left.width > 0: Rectangle {
                x: left.x - 2px;
                width: left.width + 4px;
                y: 2px;
                height: 26px;
                border-radius: 13px;
                background: Theme.pill;
            }
            if pills && chrome && right.width > 0: Rectangle {
                x: right.x - 2px;
                width: right.width + 4px;
                y: 2px;
                height: 26px;
                border-radius: 13px;
                background: Theme.pill;
            }
            if pills && spaces-shown: Rectangle {
                x: spaces.x - 10px;
                width: spaces.width + 20px;
                y: 2px;
                height: 26px;
                border-radius: 13px;
                background: Theme.pill;
            }

            // ── Left
            left := HorizontalLayout {
                visible: chrome;
                x: pills ? 6px : 8px;
                width: self.preferred-width;
                y: 3px;
                height: 24px;
                spacing: 0;
                LeftItem {
                    icon: root.logo;
                    ink: root.ink;
                    label: "System menu";
                    active: open-menu == "system";
                    clicked(x) => { root.menu("system", x); }
                }
                if app-menu: LeftItem {
                    text: app-name;
                    bold: true;
                    ink: root.ink;
                    label: "Active app: " + app-name;
                    active: open-menu == "app";
                    clicked(x) => { root.menu("app", x); }
                }
                if window-menu: LeftItem {
                    text: "Window";
                    ink: root.ink;
                    active: open-menu == "window";
                    clicked(x) => { root.menu("window", x); }
                }
                if window-title != "": Text {
                    max-width: max(0px, root.width / 2 - 8px - 360px);
                    text: window-title;
                    color: root.ink.with-alpha(0.65);
                    font-size: Theme.body;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            // ── Centre: the spaces alone (the island shows them when it's on)
            spaces := Spaces {
                visible: spaces-shown;
                x: (parent.width - self.width) / 2;
                y: 4px;
                ink: pills ? Theme.m3-on-surface : root.wall-ink;
                chips: root.chips;
                strip-w: root.strip-w;
                arrows: root.arrows;
                left-x: root.left-x;
                right-x: root.right-x;
                left-more: root.left-more;
                left-hot: root.left-hot;
                right-more: root.right-more;
                right-hot: root.right-hot;
                go(id) => { root.go(id); }
                menu(id, x) => { root.space-menu(id, x); }
                arrow(d) => { root.arrow(d); }
                wheel(d) => { root.space-wheel(d); }
            }

            // ── Right
            right := HorizontalLayout {
                visible: chrome;
                width: self.preferred-width;
                x: parent.width - self.width - (pills ? 6px : 8px);
                y: 3px;
                height: 24px;
                spacing: 0;
                for e in entries: Item {
                    e: e;
                    ink: root.ink;
                    ink-dark: root.ink-dark;
                    clicked(b, x) => { tip-want = false; tip-open = false; root.clicked(e.id, b, x); }
                    hovered(on, x, text) => {
                        if on && !e.active && text != "" {
                            tip-text = text;
                            tip-at = x;
                            tip-want = true;
                        } else {
                            tip-want = false;
                        }
                    }
                }
            }
        }
    }

    // ── The island (taller than the bar: it opens below it)
    island := Island {
        visible: island-on;
        x: 0;
        y: content.y;
        width: root.width;
        height: root.height;
        opacity: content.opacity;
        mode: root.island-mode;
        event-inside: root.event-inside;
        has-card: root.has-card;
        pilled: root.pills;
        hot: root.hot;
        pinned: root.pinned;
        layout: root.layout;
        fg: pills ? Theme.m3-on-surface : root.wall-ink;
        chips: root.chips;
        strip-w: root.strip-w;
        arrows: root.arrows;
        left-x: root.left-x;
        right-x: root.right-x;
        left-more: root.left-more;
        left-hot: root.left-hot;
        right-more: root.right-more;
        right-hot: root.right-hot;
        live: root.live;
        live-count: root.live-count;
        live-index: root.live-index;
        alerts: root.alerts;
        pill-text: root.pill-text;
        pill-icon: root.pill-icon;
        pill-tint: root.pill-tint;
        status: root.status;
        tick: root.tick;
        go(id) => { root.go(id); }
        space-menu(id, x) => { root.space-menu(id, x); }
        arrow(d) => { root.arrow(d); }
        space-wheel(d) => { root.space-wheel(d); }
        hover(on) => { root.island-hover(on); }
        open-pill => { root.island-pill(); }
        cycle(dx, dy) => { root.island-cycle(dx, dy); }
        control(i) => { root.island-control(i); }
        act(u, w) => { root.island-act(u, w); }
        dismiss(u) => { root.island-dismiss(u); }
        set-level(v) => { root.island-level(v); }
        pin => { root.island-pin(); }
        holding(on) => { root.island-hold(on); }
    }

    // The tip: no input (outside the input region), on glass (Glass) or
    // Material's plain tooltip
    tip := Rectangle {
        property <length> pad-x: Theme.material ? 8px : 12px;
        property <length> pad-y: Theme.material ? 4px : 7px;
        width: tip-label.preferred-width + 2 * pad-x;
        height: tip-label.preferred-height + 2 * pad-y;
        x: max(0px, min(root.width - self.width, tip-at - self.width / 2));
        y: 35px + (tip-open ? 0 : -4px);
        opacity: tip-open && revealed ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity, y { duration: Theme.popover; easing: ease-out; }
        border-radius: Theme.material ? 4px : Theme.radius-control;
        background: Theme.material ? Theme.m3-inverse-surface : Theme.panel;
        tip-label := Text {
            text: tip-text;
            color: Theme.material ? Theme.m3-inverse-on-surface : Theme.label;
            font-size: Theme.small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ── A menu (its own layer surface): the system menu, the app's, Window, a
// tray item's, a space's ──────────────────────────────────────────────────────
export struct MenuTile {
    x: float,
    y: float,
    w: float,
    h: float,
    label: string,
}

export struct MenuRow {
    text: string,
    shortcut: string,
    separator: bool,
    header: bool,
    checkable: bool,
    checked: bool,
    enabled: bool,
    tiles: [MenuTile],
    // Material: the row starts or ends a group (between separators)
    first: bool,
    last: bool,
}

// A tiny screen with one region filled (TileGlyph)
component TileGlyph inherits Rectangle {
    in property <MenuTile> t;
    in property <bool> hot;
    width: 36px;
    height: 24px;
    border-radius: 5px;
    border-width: 1.5px;
    border-color: hot ? Theme.on-highlight : Theme.secondary;
    Rectangle {
        x: 3px + (parent.width - 6px) * t.x;
        y: 3px + (parent.height - 6px) * t.y;
        width: max(2px, (parent.width - 6px) * t.w - 1px);
        height: max(2px, (parent.height - 6px) * t.h - 1px);
        border-radius: 2px;
        background: hot ? Theme.on-highlight : Theme.label;
    }
}

export component Menu inherits Window {
    in property <[MenuRow]> rows;
    in property <length> menu-w: 220px;
    in property <bool> any-checks;
    in property <bool> shown; // drives the open/close animation
    in-out property <int> current: -1;
    out property <float> openness: shown ? 1 : 0; // (Rust follows it for the glass shape)
    out property <length> panel-x: panel.x;
    out property <length> panel-y: panel.y;
    out property <length> panel-width: panel.width;
    out property <length> panel-height: panel.height;
    out property <float> panel-scale: panel.transform-scale;
    property <length> pad: Theme.material ? 4px : 5px;
    callback activated(int);
    callback tile(int, int);
    callback step(int); // arrow keys: Rust picks the next row (menus.rs: step)
    callback dismissed();
    callback closed(); // the close animation ended

    background: transparent;
    no-frame: true;
    title: "Menu";
    default-font-family: Theme.font;
    preferred-width: menu-w + 2 * pad + 2 * 16px;
    preferred-height: 34px + content.preferred-height + 2 * pad + 16px;

    animate openness {
        duration: shown ? 420ms : 140ms;
        easing: shown ? spring(0.3) : ease-in;
    }
    changed openness => {
        if !shown && openness <= 0.001 { closed(); }
    }

    public function open() {
        current = -1;
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.UpArrow { step(-1); return accept; }
            if e.text == Key.DownArrow || e.text == Key.Tab { step(1); return accept; }
            if e.text == Key.Escape { dismissed(); return accept; }
            if e.text == Key.Return || e.text == " " { if current >= 0 { activated(current); } return accept; }
            reject
        }

        panel := Rectangle {
            x: 16px;
            y: 34px + (1 - openness) * -8px;
            width: menu-w + 2 * pad;
            height: content.preferred-height + 2 * pad;
            transform-origin: { x: 18px, y: 0px };
            transform-scale: 0.92 + 0.08 * openness;
            opacity: min(1, openness * 1.6);
            border-radius: Theme.material ? 16px : Theme.menu-radius + 2px;
            background: Theme.menu-bg;
            border-width: Theme.material ? 0 : 0.5px;
            border-color: Theme.separator;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
            accessible-role: list;
            accessible-label: "Menu";

            content := VerticalLayout {
                x: pad;
                y: pad;
                width: menu-w;
                spacing: 0;
                for r[i] in rows: Rectangle {
                    property <bool> hot: current == i && r.enabled && !r.separator && !r.header && r.tiles.length == 0;
                    height: r.separator ? (Theme.material ? 2px : 11px) : (r.header ? (Theme.material ? 32px : 22px) : r.tiles.length > 0 ? 36px : (Theme.material ? 40px : 26px)) + (Theme.material && r.first ? 4px : 0) + (Theme.material && r.last ? 4px : 0);
                    // Material: the group's surface (corners 12 outside, 4 where groups meet)
                    background: Theme.material && !r.separator ? Theme.m3-surface-container-low : transparent;
                    border-top-left-radius: Theme.material ? (r.first ? (i == 0 ? 12px : 4px) : 0) : 0;
                    border-top-right-radius: self.border-top-left-radius;
                    border-bottom-left-radius: Theme.material ? (r.last ? (i == rows.length - 1 ? 12px : 4px) : 0) : 0;
                    border-bottom-right-radius: self.border-bottom-left-radius;
                    accessible-role: list-item;
                    accessible-label: r.text;
                    accessible-item-selectable: r.enabled && !r.header;
                    accessible-item-selected: current == i;
                    accessible-checkable: r.checkable;
                    accessible-checked: r.checked;
                    accessible-action-default => { activated(i); }

                    if r.separator && !Theme.material: Rectangle {
                        width: parent.width - 18px;
                        height: 1px;
                        background: Theme.separator;
                    }
                    if r.header: Text {
                        x: Theme.material ? 12px : 10px;
                        y: parent.height - self.height - (Theme.material ? 6px : 3px);
                        text: r.text;
                        color: Theme.material ? Theme.m3-on-surface-variant : Theme.tertiary;
                        font-size: Theme.material ? 12px : Theme.caption;
                        font-weight: Theme.material ? 500 : 600;
                    }
                    if r.tiles.length > 0: HorizontalLayout {
                        x: Theme.material ? 4px : 6px;
                        y: (parent.height - 32px) / 2;
                        height: 32px;
                        width: self.preferred-width;
                        spacing: 4px;
                        for t[j] in r.tiles: Rectangle {
                            width: 44px;
                            border-radius: Theme.material ? 8px : Theme.radius-item + 2px;
                            background: tt.has-hover ? Theme.highlight : transparent;
                            accessible-role: button;
                            accessible-label: t.label;
                            accessible-action-default => { root.tile(i, j); }
                            TileGlyph {
                                t: t;
                                hot: tt.has-hover;
                            }
                            tt := TouchArea {
                                clicked => { root.tile(i, j); }
                            }
                        }
                    }
                    if !r.separator && !r.header && r.tiles.length == 0: Rectangle {
                        x: Theme.material ? 4px : 0;
                        y: Theme.material && r.first ? 4px : 0;
                        width: parent.width - 2 * self.x;
                        height: Theme.material ? 40px : 26px;
                        border-radius: Theme.material ? (r.checked ? self.height / 2 : 8px) : Theme.radius-item + 2px;
                        background: Theme.material
                            ? (r.checked ? (hot ? Theme.m3-tertiary-container.mix(Theme.m3-on-tertiary-container, 0.92) : Theme.m3-tertiary-container) : hot ? Theme.m3-on-surface.with-alpha(0.08) : transparent)
                            : (hot ? Theme.highlight : transparent);
                        animate background { duration: 100ms; }
                        if r.checked: Icon {
                            x: Theme.material ? 12px : 6px;
                            width: 16px;
                            text: "\u{e182}"; // check
                            bold: true;
                            font-size: Theme.material ? 16px : 12px;
                            color: Theme.material ? Theme.m3-on-tertiary-container : hot ? Theme.on-highlight : Theme.label;
                        }
                        Text {
                            x: Theme.material ? (any-checks ? 40px : 12px) : 22px;
                            width: parent.width - self.x - (r.shortcut != "" ? sc.preferred-width + 24px : 12px);
                            height: parent.height;
                            text: r.text;
                            color: Theme.material
                                ? (!r.enabled ? Theme.m3-on-surface.with-alpha(0.38) : r.checked ? Theme.m3-on-tertiary-container : Theme.m3-on-surface)
                                : (hot ? Theme.on-highlight : r.enabled ? Theme.label : Theme.tertiary);
                            font-size: Theme.material ? 14px : Theme.body;
                            font-weight: Theme.material ? 500 : 400;
                            overflow: elide;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        sc := Text {
                            x: parent.width - self.width - (Theme.material ? 12px : 10px);
                            width: self.preferred-width;
                            height: parent.height;
                            text: r.shortcut;
                            color: Theme.material ? (!r.enabled ? Theme.m3-on-surface.with-alpha(0.38) : Theme.m3-on-surface-variant) : hot ? Theme.on-highlight.with-alpha(0.8) : Theme.tertiary;
                            font-size: Theme.material ? 13px : Theme.body;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        TouchArea {
                            enabled: r.enabled;
                            moved => { if self.has-hover { current = i; } }
                            changed has-hover => {
                                if self.has-hover { current = i; } else if current == i { current = -1; }
                            }
                            clicked => { activated(i); }
                        }
                    }
                }
            }
        }
    }
}
