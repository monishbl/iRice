// Notification Center in Rust (rust.surfaces: notifications), compare
// shell/modules/notifications/NotificationCenter.qml (Glass),
// NotificationShade.qml (Material), and the widgets beside them:
// CalendarWidget.qml, TodoWidget.qml, FocusWidget.qml, plus
// shell/common/Segmented.qml and controlcenter/CircleToggle.qml.
// Rust (src/surfaces/notifications, center.rs) groups the list, lays out the
// calendar's days and keeps what's open; the shell sends the widgets' data
// (its Calendar, Todos and Timers) and does what they're asked.

import { Theme, Icon } from "theme.slint";
import { IconButton, StateShape } from "widgets.slint";
import { Banner, GlassCard, MaterialCard, Expander } from "notifications.slint";

export struct NcRow {
    kind: int, // 0 a notification, 1 an island alert, 2 an open group's header
    group: string, // its app ("Tessera": the alerts)
    count: int, // how many its card stands for (collapsed), else 1
    open: bool,
    edges: int, // Glass: a collapsed stack's edges below (0..2)
    first: bool, // Material: a block's ends
    last: bool,
    gap: length, // room above it
    b: Banner,
}

export struct NcItem {
    event: bool,
    title: string,
    sub: string,
    color: color,
    done: bool,
    key: string,
}

export struct NcDay {
    label: string,
    key: string,
    today: bool,
    selected: bool,
    in-month: bool,
    colors: [color], // up to three events' colours
    todos: bool,
    // the week view: its name ("Mon") and what's on (a few)
    name: string,
    lines: [NcItem],
    more: int,
}

export struct NcTodo {
    key: string,
    text: string,
    done: bool,
    due: string,
    overdue: bool,
}

export struct NcLap {
    name: string,
    time: string,
}

// Segmented.qml: Glass, a track with a sliding pill; Material, a connected
// button group (2 px apart, round ends, 8 px inside; the chosen one fills
// and turns round). Segments share the width evenly.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <string> label;
    callback selected(int);
    property <length> gap: Theme.material ? 2px : 0;
    property <length> seg: (self.width - 4px - gap * (options.length - 1)) / max(1, options.length);
    height: Theme.material ? 36px : 30px;
    border-radius: self.height / 2;
    background: Theme.material ? transparent : Theme.toggle-off;
    accessible-role: tab-list;
    accessible-label: label;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.LeftArrow && current > 0 { selected(current - 1); return accept; }
            if e.text == Key.RightArrow && current < options.length - 1 { selected(current + 1); return accept; }
            reject
        }
    }
    if !Theme.material: Rectangle {
        x: 2px + current * seg;
        y: 2px;
        width: seg;
        height: parent.height - 4px;
        border-radius: self.height / 2;
        background: Theme.dark ? #ffffff33 : #ffffff;
        animate x { duration: 280ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    for o[i] in options: Rectangle {
        property <bool> chosen: i == current;
        property <length> full: self.height / 2;
        property <length> inner: chosen ? full : touch.pressed ? 4px : 8px;
        x: 2px + i * (seg + gap);
        width: seg;
        height: parent.height;
        border-top-left-radius: !Theme.material ? 0 : i == 0 ? full : inner;
        border-bottom-left-radius: self.border-top-left-radius;
        border-top-right-radius: !Theme.material ? 0 : i == options.length - 1 ? full : inner;
        border-bottom-right-radius: self.border-top-right-radius;
        animate border-top-left-radius, border-top-right-radius { duration: 200ms; easing: spring(0.6); }
        background: !Theme.material ? transparent : chosen ? Theme.m3-primary.mix(Theme.m3-on-primary, touch.pressed ? 0.9 : touch.has-hover ? 0.92 : 1)
            : Theme.m3-surface-container-highest.mix(Theme.m3-on-surface-variant, touch.pressed ? 0.9 : touch.has-hover ? 0.92 : 1);
        animate background { duration: 150ms; }
        accessible-role: tab;
        accessible-label: o;
        accessible-checked: chosen;
        accessible-action-default => { selected(i); }
        Text {
            text: o;
            color: Theme.material ? (chosen ? Theme.m3-on-primary : Theme.m3-on-surface-variant) : chosen ? Theme.label : Theme.secondary;
            font-size: Theme.material ? Theme.body : Theme.small;
            font-weight: Theme.material ? 500 : 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(i); }
        }
    }
}

// CircleToggle.qml: the focus timer's round buttons
component CircleButton inherits Rectangle {
    in property <color> ink; // Glass, on: the glyph on its white circle (accentOnGlyph)
    in property <string> icon;
    in property <bool> checked;
    in property <string> label;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: Theme.material ? (checked ? Theme.m3-primary : Theme.m3-surface-container-highest).mix(Theme.m3-on-surface, touch.pressed ? 0.9 : touch.has-hover ? 0.92 : 1)
        : checked ? #ffffff : touch.has-hover ? Theme.fill-hover : Theme.toggle-off;
    animate background { duration: 150ms; }
    transform-scale: touch.pressed ? 0.94 : 1;
    animate transform-scale { duration: 100ms; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    Icon {
        text: icon;
        fill: true;
        font-size: 18px;
        color: Theme.material ? (checked ? Theme.m3-on-primary : Theme.m3-on-surface-variant) : checked ? ink : Theme.label;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A tick box: Glass a circle (accent when done), Material MaterialCheck.qml
// (a rounded square, primary when checked)
component Tick inherits Rectangle {
    in property <bool> checked;
    in property <color> tint: Theme.accent;
    in property <color> ring: Theme.tertiary; // Glass: the empty circle's edge
    in property <bool> round: true;
    in property <string> label;
    callback toggled();
    width: 18px;
    height: 18px;
    border-radius: Theme.material ? 4px : round ? 9px : 4px;
    background: checked ? (Theme.material ? Theme.m3-primary : tint) : transparent;
    border-width: checked ? 0 : Theme.material ? 2px : 1.5px;
    border-color: Theme.material ? Theme.m3-on-surface-variant : ring;
    accessible-role: checkbox;
    accessible-checked: checked;
    accessible-label: label;
    accessible-action-default => { toggled(); }
    if checked: Icon {
        text: "\u{e182}"; // check
        bold: true;
        font-size: Theme.material ? 14px : 10px;
        color: Theme.material ? Theme.m3-on-primary : Theme.on-accent;
    }
    TouchArea {
        x: -6px;
        y: -6px;
        width: parent.width + 12px;
        height: parent.height + 12px;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// A piece of the list or a widget's card behind its content (Platter.qml):
// Glass, the platter (bare: a glass chip of its own, a white veil and edge);
// Material, its tonal surface
component Platter inherits Rectangle {
    in property <bool> chip;
    border-radius: 18px;
    // (Material, see-through: Theme.qml's controlAlpha on its containers)
    background: Theme.material ? Theme.m3-surface-container-high.with-alpha(Theme.blur ? 1 - 0.4 * (1 - Theme.panel-alpha) / 0.55 : 1) : chip ? (Theme.dark ? #ffffff12 : #ffffff47) : Theme.platter;
    border-width: chip && !Theme.material ? 1px : 0;
    border-color: Theme.dark ? #ffffff0f : #ffffff4d;
}

// ── The calendar (CalendarWidget.qml) ───────────────────────────────────────
component CalendarTab {
    in property <string> outline; // Material: today, when chosen too, is a cookie
    in property <string> title;
    in property <bool> week;
    in property <[NcDay]> days;
    in property <string> day-title;
    in property <[NcItem]> items;
    in property <string> every-day;
    callback step(int);
    callback set-week(bool);
    callback pick(string);
    callback todo-toggle(string);
    property <length> cell: (self.width - 24px) / 7;
    property <length> btn: Theme.material ? 32px : 24px;
    height: col.preferred-height + 24px;
    col := VerticalLayout {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: self.preferred-height;
        spacing: 8px;
        // Month yyyy, Month | Week, ‹ ›
        HorizontalLayout {
            height: Theme.material ? 32px : 26px;
            spacing: 4px;
            Text {
                text: title;
                color: Theme.label;
                font-size: Theme.material ? 14px : Theme.body;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Segmented {
                y: (parent.height - self.height) / 2;
                width: Theme.material ? 124px : 104px;
                height: Theme.material ? 32px : 24px;
                options: ["Month", "Week"];
                current: week ? 1 : 0;
                label: "Calendar view";
                selected(i) => { set-week(i == 1); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                width: btn;
                height: btn;
                icon: "\u{e138}"; // caret-left
                icon-size: Theme.material ? 18px : 12px;
                label: week ? "Previous week" : "Previous month";
                clicked => { step(-1); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                width: btn;
                height: btn;
                icon: "\u{e13a}"; // caret-right
                icon-size: Theme.material ? 18px : 12px;
                label: week ? "Next week" : "Next month";
                clicked => { step(1); }
            }
        }
        // The month: weekdays, then six weeks of dates (the wheel turns months)
        if !week: Rectangle {
            height: 16px + 6 * 32px;
            TouchArea {
                scroll-event(e) => {
                    if e.delta-y < 0 { step(1); return accept; }
                    if e.delta-y > 0 { step(-1); return accept; }
                    reject
                }
            }
            for l[i] in ["M", "T", "W", "T", "F", "S", "S"]: Text {
                x: i * cell;
                y: 0;
                width: cell;
                height: 16px;
                text: l;
                color: Theme.tertiary;
                font-size: Theme.caption;
                font-weight: 600;
                horizontal-alignment: center;
                accessible-role: none;
            }
            for d[i] in days: Rectangle {
                x: mod(i, 7) * cell;
                y: 16px + floor(i / 7) * 32px;
                width: cell;
                height: 32px;
                accessible-role: button;
                accessible-label: d.key;
                accessible-action-default => { pick(d.key); }
                // Glass: today accent, the chosen day a fill; Material: today a
                // primary circle (a cookie when chosen too), the chosen day a
                // tonal square; hover a state layer
                Rectangle {
                    y: (parent.height - self.height) / 2 - 3px;
                    width: Theme.material ? 28px : 26px;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    border-radius: Theme.material && d.selected && !d.today ? 8px : self.width / 2;
                    visible: Theme.material ? !(d.today && d.selected) && (d.today || d.selected || touch.has-hover) : (d.today || d.selected || touch.has-hover);
                    background: Theme.material ? (d.today ? Theme.m3-primary : d.selected ? Theme.m3-secondary-container : Theme.m3-on-surface.with-alpha(0.08))
                        : d.today ? Theme.accent : d.selected ? Theme.fill-pressed : Theme.fill;
                }
                if Theme.material && d.today && d.selected: Path {
                    x: (parent.width - 28px) / 2;
                    y: (parent.height - 28px) / 2 - 3px;
                    width: 28px;
                    height: 28px;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    commands: outline;
                    fill: Theme.m3-primary;
                }
                Text {
                    y: (parent.height - self.height) / 2 - 3px;
                    x: (parent.width - self.width) / 2;
                    text: d.label;
                    color: d.today ? (Theme.material ? Theme.m3-on-primary : Theme.on-accent) : Theme.material && d.selected ? Theme.m3-on-secondary-container : d.in-month ? Theme.label : Theme.tertiary;
                    font-size: Theme.small;
                    font-weight: d.today ? 700 : Theme.material && d.selected ? 600 : 400;
                    accessible-role: none;
                }
                HorizontalLayout {
                    y: parent.height - 5px;
                    height: 4px;
                    alignment: center;
                    spacing: 2px;
                    opacity: d.in-month ? 1 : 0.5;
                    for c in d.colors: Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: c;
                    }
                    if d.todos: Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 1px;
                        background: Theme.material ? Theme.m3-tertiary : #ff9f0a;
                    }
                }
                touch := TouchArea {
                    clicked => { pick(d.key); }
                }
            }
        }
        // The week: a row a day, with what's on
        if week: VerticalLayout {
            spacing: 2px;
            for d in days: Rectangle {
                min-height: max(40px, wl.preferred-height + 10px);
                border-radius: Theme.material ? 12px : 8px;
                background: Theme.material ? (d.selected ? Theme.m3-secondary-container : wtouch.has-hover ? Theme.m3-on-surface.with-alpha(0.08) : transparent)
                    : d.selected ? Theme.fill : wtouch.has-hover ? Theme.fill.with-alpha(0.5) : transparent;
                wtouch := TouchArea {
                    clicked => { pick(d.key); }
                }
                VerticalLayout {
                    x: 8px;
                    width: 44px;
                    alignment: center;
                    Text {
                        text: d.name;
                        color: Theme.secondary;
                        font-size: Theme.caption;
                        font-weight: 600;
                    }
                    Text {
                        text: d.label;
                        color: d.today ? Theme.accent : Theme.label;
                        font-size: Theme.body;
                        font-weight: d.today ? 700 : 500;
                    }
                }
                wl := VerticalLayout {
                    x: 56px;
                    width: parent.width - 64px;
                    alignment: center;
                    spacing: 1px;
                    for e in d.lines: HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 3px;
                            border-radius: 1.5px;
                            background: e.event ? e.color : #ff9f0a;
                        }
                        Text {
                            text: e.title + (e.sub != "" ? " · " + e.sub : "");
                            color: Theme.label;
                            font-size: Theme.small;
                            overflow: elide;
                        }
                    }
                    if d.more > 0: Text {
                        text: "+" + d.more + " more";
                        color: Theme.tertiary;
                        font-size: Theme.caption;
                    }
                    if d.lines.length == 0: Text {
                        text: "Nothing on";
                        color: Theme.tertiary;
                        font-size: Theme.small;
                    }
                }
            }
        }
        if every-day != "": HorizontalLayout {
            spacing: 6px;
            Icon {
                text: "\u{e3f6}"; // repeat
                font-size: 12px;
                color: Theme.tertiary;
            }
            Text {
                text: "Every day: " + every-day;
                color: Theme.tertiary;
                font-size: Theme.caption;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        // The chosen day
        Text {
            height: Theme.material ? 32px : 22px;
            text: day-title;
            color: Theme.secondary;
            font-size: Theme.material ? Theme.body : Theme.caption;
            font-weight: Theme.material ? 500 : 600;
            vertical-alignment: center;
        }
        if items.length == 0: Text {
            text: "Nothing on this day.";
            color: Theme.tertiary;
            font-size: Theme.small;
            wrap: word-wrap;
        }
        if items.length > 0: VerticalLayout {
            spacing: Theme.material ? 4px : 8px;
            for it in items: Rectangle {
                height: Theme.material ? 44px : 36px;
                border-radius: Theme.material ? 12px : 8px;
                background: Theme.material ? (rt.has-hover ? Theme.fill-hover : Theme.fill) : rt.has-hover ? Theme.fill : transparent;
                rt := TouchArea { }
                if it.event: Rectangle {
                    x: Theme.material ? 10px : 6px;
                    y: Theme.material ? 10px : 5px;
                    width: Theme.material ? 4px : 3px;
                    height: parent.height - 2 * self.y;
                    border-radius: 2px;
                    background: it.color;
                }
                if !it.event: Tick {
                    x: Theme.material ? 10px : 4px;
                    y: (parent.height - self.height) / 2;
                    checked: it.done;
                    tint: #ff9f0a;
                    ring: #ff9f0a;
                    label: it.title;
                    toggled => { todo-toggle(it.key); }
                }
                VerticalLayout {
                    x: Theme.material ? (it.event ? 22px : 38px) : it.event ? 16px : 28px;
                    width: parent.width - self.x - 8px;
                    alignment: center;
                    Text {
                        text: it.title;
                        color: Theme.label;
                        font-size: Theme.small;
                        font-weight: 500;
                        overflow: elide;
                        stroke-width: 0;
                    }
                    Text {
                        text: it.sub;
                        color: Theme.secondary;
                        font-size: Theme.caption;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// ── To-do (TodoWidget.qml) ──────────────────────────────────────────────────
component TodoTab {
    in property <[NcTodo]> todos;
    in property <string> undo; // the text of the one just deleted, "" none
    callback add(string);
    callback toggle(string);
    callback remove(string);
    callback restore();
    callback rename(string, string);
    // the one being renamed (double-click; Enter or clicking away keeps it,
    // Esc cancels)
    property <string> renaming;
    height: col.preferred-height + 24px;
    col := VerticalLayout {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: self.preferred-height;
        spacing: 6px;
        Rectangle {
            height: Theme.material ? 40px : 32px;
            border-radius: Theme.material ? self.height / 2 : Theme.radius-control;
            background: Theme.fill;
            border-width: Theme.material && input.has-focus ? 2px : 0;
            border-color: Theme.material ? Theme.m3-primary : Theme.accent;
            Icon {
                x: Theme.material ? 14px : 10px;
                width: self.preferred-width;
                text: "\u{e3d4}"; // plus
                bold: !Theme.material;
                font-size: Theme.material ? 18px : 12px;
                color: Theme.secondary;
            }
            input := TextInput {
                x: Theme.material ? 42px : 30px;
                width: parent.width - self.x - (Theme.material ? 16px : 10px);
                color: Theme.label;
                font-size: Theme.body;
                vertical-alignment: center;
                single-line: true;
                accessible-label: "Add a to-do";
                accepted => {
                    if self.text != "" {
                        root.add(self.text);
                        self.text = "";
                    }
                }
            }
            Text {
                x: input.x;
                width: input.width;
                visible: input.text == "";
                text: "Add a to-do (e.g. call mum tomorrow 6pm)";
                color: Theme.tertiary;
                font-size: Theme.body;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }
        if todos.length == 0 && undo == "": Text {
            height: self.preferred-height + 16px;
            text: "Nothing to do. Nice.";
            color: Theme.secondary;
            font-size: Theme.small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        for t in todos: Rectangle {
            height: t.due != "" ? (Theme.material ? 48px : 40px) : Theme.material ? 40px : 30px;
            th := TouchArea {
                double-clicked => { renaming = t.key; }
            }
            Tick {
                x: 0;
                y: (parent.height - self.height) / 2;
                checked: t.done;
                round: true;
                tint: Theme.accent;
                label: t.text;
                toggled => { toggle(t.key); }
            }
            VerticalLayout {
                x: 18px + (Theme.material ? 14px : 10px);
                width: parent.width - self.x - 24px;
                alignment: center;
                if renaming != t.key: Text {
                    text: t.text;
                    color: t.done ? Theme.tertiary : Theme.label;
                    font-size: Theme.material ? 14px : Theme.body;
                    overflow: elide;
                }
                if renaming == t.key: TextInput {
                    text: t.text;
                    color: Theme.label;
                    font-size: Theme.material ? 14px : Theme.body;
                    single-line: true;
                    selection-background-color: Theme.accent.with-alpha(0.4);
                    accessible-label: "Rename " + t.text;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted => {
                        if self.text != "" && self.text != t.text { root.rename(t.key, self.text); }
                        renaming = "";
                    }
                    changed has-focus => {
                        if !self.has-focus && renaming == t.key {
                            if self.text != "" && self.text != t.text { root.rename(t.key, self.text); }
                            renaming = "";
                        }
                    }
                    key-pressed(e) => {
                        if e.text == Key.Escape { renaming = ""; return accept; }
                        reject
                    }
                }
                if t.due != "": Text {
                    text: t.due;
                    color: t.overdue ? Theme.danger : Theme.secondary;
                    font-size: Theme.small;
                }
            }
            // (done: struck through)
            if t.done && renaming != t.key: Rectangle {
                x: 18px + (Theme.material ? 14px : 10px);
                y: t.due != "" ? parent.height / 2 - 8px : parent.height / 2;
                width: min(parent.width - self.x - 24px, done-w.preferred-width);
                height: 1px;
                background: Theme.tertiary;
                done-w := Text {
                    visible: false;
                    text: t.text;
                    font-size: Theme.material ? 14px : Theme.body;
                }
            }
            if th.has-hover && renaming != t.key: IconButton {
                x: parent.width - self.width + 6px;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                icon: "\u{e4f6}"; // x
                icon-size: Theme.material ? 18px : 12px;
                icon-color: Theme.tertiary;
                label: "Delete " + t.text;
                clicked => { remove(t.key); }
            }
        }
        if undo != "": HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "Deleted “" + undo + "”";
                color: Theme.secondary;
                font-size: Theme.small;
                overflow: elide;
            }
            Text {
                text: "Undo";
                color: Theme.material ? Theme.m3-primary : Theme.accent;
                font-size: Theme.small;
                font-weight: 600;
                accessible-role: button;
                accessible-label: "Undo";
                accessible-action-default => { restore(); }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { restore(); }
                }
            }
        }
    }
}

// ── Focus: the pomodoro ring and the stopwatch (FocusWidget.qml) ────────────
component FocusTab {
    in property <color> ink;
    in property <int> mode; // 0 focus timer, 1 stopwatch
    in property <string> remaining;
    in property <bool> focus-phase;
    in property <bool> running;
    in property <string> sessions;
    in property <string> track; // the ring (path commands, 110 px box)
    in property <string> progress;
    in property <string> sw;
    in property <bool> sw-running;
    in property <[NcLap]> laps;
    callback set-mode(int);
    callback act(string);
    height: col.preferred-height + 24px;
    col := VerticalLayout {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: self.preferred-height;
        spacing: 12px;
        Segmented {
            options: ["Focus", "Stopwatch"];
            current: mode;
            label: "Timer";
            selected(i) => { set-mode(i); }
        }
        if mode == 0: HorizontalLayout {
            spacing: 16px;
            alignment: start;
            Rectangle {
                width: 110px;
                height: 110px;
                Path {
                    width: 110px;
                    height: 110px;
                    viewbox-width: 110;
                    viewbox-height: 110;
                    commands: track;
                    stroke: Theme.material ? Theme.m3-secondary-container : Theme.toggle-off;
                    stroke-width: 8px;
                    stroke-line-cap: round;
                }
                if progress != "": Path {
                    width: 110px;
                    height: 110px;
                    viewbox-width: 110;
                    viewbox-height: 110;
                    commands: progress;
                    stroke: focus-phase ? (Theme.material ? Theme.m3-primary : Theme.accent) : Theme.material ? Theme.m3-tertiary : Theme.success;
                    stroke-width: 8px;
                    stroke-line-cap: round;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: remaining;
                        color: Theme.label;
                        font-size: 24px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: focus-phase ? "Focus" : "Break";
                        color: Theme.secondary;
                        font-size: Theme.caption;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: sessions;
                    color: Theme.secondary;
                    font-size: Theme.small;
                }
                HorizontalLayout {
                    spacing: 8px;
                    CircleButton {
                        ink: ink;
                        icon: running ? "\u{e39e}" : "\u{e3d0}";
                        checked: true;
                        label: running ? "Pause" : "Start";
                        clicked => { act("timer.toggle"); }
                    }
                    CircleButton {
                        ink: ink;
                        icon: "\u{e5a6}";
                        label: "Skip";
                        clicked => { act("timer.skip"); }
                    }
                    CircleButton {
                        ink: ink;
                        icon: "\u{e038}";
                        label: "Reset";
                        clicked => { act("timer.reset"); }
                    }
                }
            }
        }
        if mode == 1: VerticalLayout {
            spacing: 8px;
            Text {
                text: sw;
                color: Theme.label;
                font-size: 34px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                CircleButton {
                    ink: ink;
                    icon: sw-running ? "\u{e39e}" : "\u{e3d0}";
                    checked: true;
                    label: sw-running ? "Pause" : "Start";
                    clicked => { act("sw.toggle"); }
                }
                CircleButton {
                    ink: ink;
                    icon: "\u{e244}";
                    label: "Lap";
                    clicked => { act("sw.lap"); }
                }
                CircleButton {
                    ink: ink;
                    icon: "\u{e038}";
                    label: "Reset";
                    clicked => { act("sw.reset"); }
                }
            }
            for l in laps: HorizontalLayout {
                height: 20px;
                Text {
                    text: l.name;
                    color: Theme.secondary;
                    font-size: Theme.small;
                    horizontal-stretch: 1;
                }
                Text {
                    text: l.time;
                    color: Theme.label;
                    font-size: Theme.small;
                }
            }
        }
    }
}

// ── The panel ───────────────────────────────────────────────────────────────
export component Center inherits Window {
    in property <bool> shown;
    in property <bool> bare; // Glass without the panel: each piece its own glass
    in property <bool> glass-plugin;
    in property <[NcRow]> rows;
    in property <bool> anything;
    in property <string> focus-text; // "Work is on", "" no Focus mode
    in property <string> clock; // Material's time and date
    in property <string> date;
    in property <string> outline; // Material's empty shape (cookie9)
    in property <int> tab; // 0 calendar, 1 to-do, 2 focus
    // the calendar
    in property <string> cal-title;
    in property <bool> cal-week;
    in property <[NcDay]> days;
    in property <string> day-title;
    in property <[NcItem]> day-items;
    in property <string> every-day;
    // to-do
    in property <[NcTodo]> todos;
    in property <string> todo-undo;
    // focus
    in property <int> focus-mode;
    in property <string> remaining;
    in property <bool> focus-phase;
    in property <bool> running;
    in property <string> sessions;
    in property <string> ring-track;
    in property <string> ring-progress;
    in property <string> sw;
    in property <bool> sw-running;
    in property <[NcLap]> laps;
    in property <color> accent-ink: Theme.accent;

    property <length> pad: Theme.material ? 12px : 16px;
    property <length> content-w: Theme.material ? 360px : 340px;
    property <length> m: 24px; // Popover.qml's shadow margin
    out property <length> body-x: body.x;
    out property <length> body-y: body.y;
    out property <length> body-width: body.width;
    out property <length> body-height: body.height;
    out property <float> body-opacity: body.opacity;
    out property <length> radius: Theme.material ? 24px + pad : 36px + pad;
    // (the list as scrolled, for the chips' glass)
    out property <length> list-top: body.y + pad + list-at.y;
    out property <length> list-scroll: -flick.content-y;
    out property <length> list-height: flick.height;
    out property <float> openness: shown ? 1 : 0;
    // the widgets' card, in the panel (Glass without the panel: its glass)
    out property <length> widgets-y: pad + widgets.y;
    out property <length> widgets-h: widgets.height;

    callback dismissed(); // a click outside, Esc
    callback closed(); // gone from view
    callback row-activated(int); // the card's click (its id)
    callback row-close(int); // dismiss it (its id; an alert's hid)
    callback alert-close(int);
    callback toggle-group(string);
    callback clear-group(string);
    callback action(int, string);
    callback reply-open(int);
    callback reply-cancel(int);
    callback reply-send(int, string);
    callback draft(int, string);
    callback link(string);
    callback clear-all();
    callback manage();
    callback set-tab(int);
    callback cal-step(int);
    callback cal-week-set(bool);
    callback cal-pick(string);
    callback todo-add(string);
    callback todo-toggle(string);
    callback todo-remove(string);
    callback todo-restore();
    callback todo-rename(string, string);
    callback focus-mode-set(int);
    callback act(string);
    callback card(int, length, length, length, length); // a row's card as laid out: index, y in the list, height (Glass's chips), width, edges' height

    background: transparent;
    no-frame: true;
    title: "Notification Center";
    default-font-family: Theme.font;

    animate openness {
        duration: shown ? 420ms : 196ms;
        easing: shown ? spring(0.3) : cubic-bezier(0.3, 0, 0.8, 0.15);
    }
    changed openness => {
        if !shown && openness <= 0.001 { closed(); }
    }

    // A click outside closes it (Popover.qml's catcher)
    TouchArea {
        enabled: shown;
        clicked => { dismissed(); }
    }
    // Esc closes (Popover.qml); it has the keys from the start
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { dismissed(); return accept; }
            reject
        }
    }
    public function take-keys() {
        keys.focus();
    }

    body := Rectangle {
        width: content-w + 2 * pad;
        height: col.preferred-height + 2 * pad;
        x: parent.width - self.width - m;
        y: 34px + (1 - openness) * -8px;
        opacity: min(1, openness);
        border-radius: radius;
        // Material: its tonal surface; Glass: the plugin's glass and a tint
        // (bare: nothing; the pieces are glass of their own)
        background: bare ? transparent : Theme.material ? Theme.m3-surface-container.with-alpha(Theme.blur ? Theme.panel-alpha : 1) : glass-plugin ? transparent : Theme.panel;
        border-width: !Theme.material && !bare ? 0.5px : 0;
        border-color: Theme.separator;
        drop-shadow-blur: Theme.material && !bare ? 32px : 0;
        drop-shadow-offset-y: 8px;
        // (no blur isn't no shadow: Slint still draws it hard)
        drop-shadow-color: Theme.material && !bare ? #000000.with-alpha(Theme.dark ? 0.4 : 0.16) : transparent;
        accessible-role: groupbox;
        accessible-label: "Notification Center";
        // (clicks inside stay inside)
        TouchArea { }

        col := VerticalLayout {
            x: pad;
            y: pad;
            width: content-w;
            height: self.preferred-height;
            spacing: Theme.material ? 16px : 10px;

            // Material: the time and date, large
            if Theme.material: VerticalLayout {
                Text {
                    x: 12px;
                    text: clock;
                    color: Theme.m3-on-surface;
                    font-size: 40px;
                    font-weight: 500;
                    letter-spacing: -0.4px;
                }
                Text {
                    x: 12px;
                    text: date;
                    color: Theme.m3-on-surface-variant;
                    font-size: 14px;
                    font-weight: 500;
                }
            }
            // Glass: the title and Clear all
            if !Theme.material: HorizontalLayout {
                height: 28px;
                padding-left: 4px;
                Text {
                    text: "Notifications";
                    color: bare ? #ffffff : Theme.label;
                    font-size: Theme.title;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    stroke: bare ? #00000033 : transparent;
                    stroke-width: bare ? 0.6px : 0;
                }
                if anything: Rectangle {
                    y: 1px;
                    width: clear-l.preferred-width + 20px;
                    height: 26px;
                    border-radius: 13px;
                    background: clear-t.has-hover ? Theme.fill-hover : Theme.fill;
                    accessible-role: button;
                    accessible-label: "Clear all notifications";
                    accessible-action-default => { clear-all(); }
                    clear-l := Text {
                        text: "Clear all";
                        color: Theme.label;
                        font-size: Theme.small;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    clear-t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { clear-all(); }
                    }
                }
            }

            // The notifications, grouped by app
            list-at := Rectangle {
                height: anything ? min(list.preferred-height, Theme.material ? 440px : 420px) + (Theme.material ? 0 : 8px) : Theme.material ? mempty.preferred-height : 84px;
                // Nothing here (in the list's place: no room of its own)
                if !anything && !Theme.material: Platter {
                    chip: bare;
                    height: 84px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Icon {
                            text: "\u{e0d0}"; // bell-simple
                            font-size: 22px;
                            color: Theme.tertiary;
                        }
                        Text {
                            text: focus-text != "" ? focus-text : "No notifications";
                            color: Theme.secondary;
                            font-size: Theme.small;
                            horizontal-alignment: center;
                        }
                    }
                }
                mempty := VerticalLayout {
                    visible: !anything && Theme.material;
                    height: self.preferred-height;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        StateShape {
                            width: 80px;
                            height: 80px;
                            outline: outline;
                            icon: "\u{e0d0}";
                            icon-size: 32px;
                            shape-color: Theme.m3-surface-container-high;
                            icon-color: Theme.m3-on-surface-variant;
                        }
                    }
                    Text {
                        text: "No notifications";
                        color: Theme.m3-on-surface;
                        font-size: Theme.title;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                    if focus-text != "": Text {
                        text: focus-text;
                        color: Theme.m3-on-surface-variant;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }
                flick := Flickable {
                    visible: anything;
                    // (Glass: 8 px more on the left and top, for the close badges)
                    x: Theme.material ? 0 : -8px;
                    width: parent.width + (Theme.material ? 0 : 8px);
                    height: parent.height;
                    content-height: list.preferred-height + (Theme.material ? 0 : 8px);
                    list := VerticalLayout {
                        x: Theme.material ? 0 : 8px;
                        y: Theme.material ? 0 : 8px;
                        width: content-w;
                        height: self.preferred-height;
                        for r[i] in rows: Rectangle {
                            height: r.gap + (r.kind == 2 ? (Theme.material ? 52px : 24px) : Theme.material ? seg.height : gcard.height + 8px * r.edges);
                            property <length> card-h: r.kind == 2 ? (Theme.material ? 52px : 24px) : Theme.material ? mcard.height : gcard.height;
                            changed card-h => { root.card(i, self.y + r.gap, card-h, self.width, 8px * r.edges); }
                            changed y => { root.card(i, self.y + r.gap, card-h, self.width, 8px * r.edges); }
                            init => { root.card(i, self.y + r.gap, card-h, self.width, 8px * r.edges); }

                            // ── Glass ──
                            if !Theme.material && r.kind == 2: HorizontalLayout {
                                y: r.gap;
                                height: 24px;
                                padding-left: 4px;
                                spacing: 6px;
                                Text {
                                    text: r.group;
                                    color: Theme.label;
                                    font-size: Theme.body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Rectangle {
                                    y: 1px;
                                    width: less-l.preferred-width + 18px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: less-t.has-hover ? Theme.fill-hover : Theme.fill;
                                    accessible-role: button;
                                    accessible-label: "Show less";
                                    accessible-action-default => { toggle-group(r.group); }
                                    less-l := Text {
                                        text: "Show less";
                                        color: Theme.label;
                                        font-size: Theme.caption;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    less-t := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { toggle-group(r.group); }
                                    }
                                }
                                IconButton {
                                    y: 1px;
                                    width: 22px;
                                    height: 22px;
                                    icon: "\u{e4f6}";
                                    icon-size: 11px;
                                    label: r.kind == 1 || r.b.alert ? "Clear Tessera alerts" : "Clear " + r.group;
                                    clicked => { clear-group(r.group); }
                                }
                            }
                            Rectangle {
                                visible: !Theme.material && r.kind != 2;
                                y: r.gap;
                                height: parent.height - r.gap;
                                // the stack's edges below the front card
                                for k in r.edges: Platter {
                                    chip: bare;
                                    x: (k + 1) * 8px;
                                    y: gcard.height - 4px + k * 8px;
                                    width: parent.width - 2 * (k + 1) * 8px;
                                    height: 12px;
                                    border-radius: 6px;
                                    opacity: 0.75 - 0.2 * k;
                                }
                                Platter {
                                    chip: bare;
                                    y: 0;
                                    height: gcard.height;
                                    border-radius: 18px;
                                }
                                gtouch := TouchArea {
                                    y: 0;
                                    height: gcard.height;
                                    gcard := GlassCard {
                                        width: content-w;
                                        b: r.b;
                                        hovered: gtouch.has-hover;
                                        activated => { root.row-activated(r.b.id); }
                                        close => { if r.b.alert { root.alert-close(r.b.id); } else { root.row-close(r.b.id); } }
                                        action(k) => { root.action(r.b.id, k); }
                                        reply-open => { root.reply-open(r.b.id); }
                                        reply-cancel => { root.reply-cancel(r.b.id); }
                                        reply-send(t) => { root.reply-send(r.b.id, t); }
                                        draft(t) => { root.draft(r.b.id, t); }
                                        link(u) => { root.link(u); }
                                    }
                                    // a collapsed stack expands instead
                                    if r.count > 1 && !r.open: TouchArea {
                                        clicked => { toggle-group(r.group); }
                                    }
                                }
                            }

                            // ── Material: one segmented list ──
                            seg := Rectangle {
                                visible: Theme.material;
                                property <length> live: swipe.current-position.x - swipe.pressed-position.x;
                                in-out property <length> off: 0;
                                property <length> dx: swipe.swiping ? live : off;
                                animate dx { duration: swipe.swiping ? 0ms : 200ms; easing: cubic-bezier(0.3, 0, 0.8, 0.15); }
                                property <bool> loose: swipe.swiping || dx != 0;
                                y: r.gap;
                                x: dx;
                                width: content-w;
                                height: r.kind == 2 ? 52px : mcard.height;
                                background: Theme.m3-surface-container-high.with-alpha(Theme.blur ? 1 - 0.4 * (1 - Theme.panel-alpha) / 0.55 : 1);
                                opacity: 1 - 0.6 * min(1, abs(dx) / max(1px, self.width));
                                border-top-left-radius: loose || r.first ? 24px : 6px;
                                border-top-right-radius: self.border-top-left-radius;
                                border-bottom-left-radius: loose || r.last ? 24px : 6px;
                                border-bottom-right-radius: self.border-bottom-left-radius;
                                animate border-top-left-radius, border-bottom-left-radius { duration: 150ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                                fly := Timer {
                                    interval: 200ms;
                                    running: false;
                                    triggered => {
                                        self.running = false;
                                        if r.count > 1 { clear-group(r.group); } else if r.b.alert { alert-close(r.b.id); } else { row-close(r.b.id); }
                                    }
                                }
                                // Swipe sideways to dismiss: past a third of the way it
                                // slides off, otherwise it springs back
                                swipe := SwipeGestureHandler {
                                    enabled: Theme.material && r.kind != 2;
                                    handle-swipe-left: true;
                                    handle-swipe-right: true;
                                    swiped => {
                                        if abs(live) > seg.width / 3 {
                                            seg.off = (live > 0 ? 1 : -1) * (seg.width + 24px);
                                            fly.running = true;
                                        } else {
                                            seg.off = 0;
                                        }
                                    }
                                    cancelled => { seg.off = 0; }
                                    mtouch := TouchArea {
                                        mcard := MaterialCard {
                                            visible: r.kind != 2;
                                            width: content-w;
                                            b: r.b;
                                            hovered: mtouch.has-hover;
                                            group-count: r.count;
                                            group-open: r.open;
                                            tap-expands: r.count > 1;
                                            group-toggled => { toggle-group(r.group); }
                                            activated => { root.row-activated(r.b.id); }
                                            close => { if r.b.alert { root.alert-close(r.b.id); } else { root.row-close(r.b.id); } }
                                            action(k) => { root.action(r.b.id, k); }
                                            reply-open => { root.reply-open(r.b.id); }
                                            reply-cancel => { root.reply-cancel(r.b.id); }
                                            reply-send(t) => { root.reply-send(r.b.id, t); }
                                            draft(t) => { root.draft(r.b.id, t); }
                                            link(u) => { root.link(u); }
                                        }
                                    }
                                }
                                // An open group's header: its name, Clear, and the chevron
                                if r.kind == 2: Rectangle {
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { toggle-group(r.group); }
                                    }
                                    Text {
                                        x: 16px;
                                        width: parent.width - 16px - 8px - 12px - 32px - 4px - 34px;
                                        text: r.group;
                                        color: Theme.m3-on-surface;
                                        font-size: Theme.title;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    IconButton {
                                        x: parent.width - 12px - 34px - 4px - 32px;
                                        y: (parent.height - self.height) / 2;
                                        width: 32px;
                                        height: 32px;
                                        icon: "\u{e4f6}";
                                        icon-size: 18px;
                                        icon-color: Theme.m3-on-surface-variant;
                                        label: r.b.alert ? "Clear Tessera alerts" : "Clear " + r.group;
                                        clicked => { clear-group(r.group); }
                                    }
                                    Expander {
                                        x: parent.width - 12px - self.width;
                                        y: (parent.height - self.height) / 2;
                                        count: r.count;
                                        open: true;
                                        clicked => { toggle-group(r.group); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Material: Manage and Clear all
            if Theme.material: Rectangle {
                height: 40px;
                manage-btn := Rectangle {
                    x: 0;
                    width: manage-l.preferred-width + 24px;
                    height: 40px;
                    border-radius: manage-t.pressed ? 12px : 20px;
                    animate border-radius { duration: 100ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    background: manage-t.pressed ? Theme.m3-primary.with-alpha(0.1) : manage-t.has-hover ? Theme.m3-primary.with-alpha(0.08) : transparent;
                    animate background { duration: 150ms; }
                    transform-scale: manage-t.pressed ? 0.97 : 1;
                    animate transform-scale { duration: 100ms; }
                    accessible-role: button;
                    accessible-label: "Manage notifications";
                    accessible-action-default => { manage(); }
                    manage-l := Text {
                        text: "Manage";
                        color: Theme.m3-primary;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    manage-t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { manage(); }
                    }
                }
                if anything: Rectangle {
                    x: parent.width - self.width;
                    width: mclear-l.preferred-width + 40px;
                    height: 40px;
                    border-radius: mclear-t.pressed ? 12px : 20px;
                    animate border-radius { duration: 100ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
                    background: Theme.m3-secondary-container.mix(Theme.m3-on-secondary-container, mclear-t.pressed ? 0.9 : mclear-t.has-hover ? 0.92 : 1);
                    animate background { duration: 150ms; }
                    transform-scale: mclear-t.pressed ? 0.97 : 1;
                    animate transform-scale { duration: 100ms; }
                    accessible-role: button;
                    accessible-label: "Clear all notifications";
                    accessible-action-default => { clear-all(); }
                    mclear-l := Text {
                        text: "Clear all";
                        color: Theme.m3-on-secondary-container;
                        font-size: 14px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    mclear-t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { clear-all(); }
                    }
                }
            }

            // Calendar, To-do and Focus: one card, the tabs its first row
            widgets := Platter {
                chip: bare;
                border-radius: Theme.material ? 24px : 36px;
                height: tabs.height + 12px + (Theme.material ? 4px : 0) + (tab == 0 ? cal.height : tab == 1 ? todo.height : focus.height);
                tabs := Segmented {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: Theme.material ? 36px : 28px;
                    options: ["Calendar", "To-do", "Focus"];
                    current: tab;
                    label: "Widgets";
                    selected(i) => { set-tab(i); }
                }
                cal := CalendarTab {
                    outline: outline;
                    y: tabs.y + tabs.height + (Theme.material ? 4px : 0);
                    width: parent.width;
                    visible: tab == 0;
                    title: cal-title;
                    week: cal-week;
                    days: days;
                    day-title: day-title;
                    items: day-items;
                    every-day: every-day;
                    step(n) => { cal-step(n); }
                    set-week(w) => { cal-week-set(w); }
                    pick(k) => { cal-pick(k); }
                    todo-toggle(k) => { root.todo-toggle(k); }
                }
                todo := TodoTab {
                    y: cal.y;
                    width: parent.width;
                    visible: tab == 1;
                    todos: todos;
                    undo: todo-undo;
                    add(t) => { todo-add(t); }
                    toggle(k) => { todo-toggle(k); }
                    remove(k) => { todo-remove(k); }
                    restore => { todo-restore(); }
                    rename(k, t) => { todo-rename(k, t); }
                }
                focus := FocusTab {
                    ink: accent-ink;
                    y: cal.y;
                    width: parent.width;
                    visible: tab == 2;
                    mode: focus-mode;
                    remaining: remaining;
                    focus-phase: focus-phase;
                    running: running;
                    sessions: sessions;
                    track: ring-track;
                    progress: ring-progress;
                    sw: sw;
                    sw-running: sw-running;
                    laps: laps;
                    set-mode(i) => { focus-mode-set(i); }
                    act(a) => { root.act(a); }
                }
            }
        }
    }
}
