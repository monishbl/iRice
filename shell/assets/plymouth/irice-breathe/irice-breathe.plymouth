[Plymouth Theme]
Name=irice-breathe
Description=iRice: The drop with a soft glow that breathes, and a thin line that fills as your computer starts.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/irice-breathe
ScriptFile=/usr/share/plymouth/themes/irice-breathe/irice-breathe.script
ConsoleLogBackgroundColor=0x0a0a0b
Font=Inter 11
