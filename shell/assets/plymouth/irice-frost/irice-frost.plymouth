[Plymouth Theme]
Name=irice-frost
Description=iRice: For Glass: the drop on a frosted glass tile, soft lights drifting behind it and a light sweeping across.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/irice-frost
ScriptFile=/usr/share/plymouth/themes/irice-frost/irice-frost.script
ConsoleLogBackgroundColor=0x0a0a0b
Font=Inter 11
