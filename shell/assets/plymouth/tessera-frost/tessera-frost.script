glass.image = scaled("glass"); glass.sprite = Sprite(glass.image);
mark.image = scaled("mark"); mark.sprite = Sprite(mark.image);
lighta.image = scaled("light"); lighta.sprite = Sprite(lighta.image);
lightb.image = scaled("white"); lightb.sprite = Sprite(lightb.image);
sweepnames[0] = "sweep00"; sweepnames[1] = "sweep01"; sweepnames[2] = "sweep02"; sweepnames[3] = "sweep03"; sweepnames[4] = "sweep04"; sweepnames[5] = "sweep05"; sweepnames[6] = "sweep06"; sweepnames[7] = "sweep07"; sweepnames[8] = "sweep08"; sweepnames[9] = "sweep09"; sweepnames[10] = "sweep10"; sweepnames[11] = "sweep11"; sweepnames[12] = "sweep12"; sweepnames[13] = "sweep13"; sweepnames[14] = "sweep14"; sweepnames[15] = "sweep15"; sweepnames[16] = "sweep16"; sweepnames[17] = "sweep17"; sweepnames[18] = "sweep18"; sweepnames[19] = "sweep19"; sweepnames[20] = "sweep20"; sweepnames[21] = "sweep21"; sweepnames[22] = "sweep22"; sweepnames[23] = "sweep23"; 
for (f = 0; sweepnames[f]; f++) sweeps[f] = scaled(sweepnames[f]);
sweep.sprite = Sprite();
fun place() {
  centre(glass.sprite, glass.image, 0, 0, 2);
  centre(mark.sprite, mark.image, 0, 0, 4);
  global.sweepx = global.cx - Math.Int(sweeps[0].GetWidth() / 2);
  global.sweepy = global.cy - Math.Int(sweeps[0].GetHeight() / 2);
  sweep.sprite.SetPosition(global.sweepx, global.sweepy, 3);
}
fun frame(i) {
  centre(lighta.sprite, lighta.image, Math.Int(t_ax[i] * global.L), Math.Int(t_ay[i] * global.L), 1);
  centre(lightb.sprite, lightb.image, Math.Int(t_bx[i] * global.L), Math.Int(t_by[i] * global.L), 1);
  if (t_sweep[i] < 0) sweep.sprite.SetOpacity(0);
  else {
    sweep.sprite.SetImage(sweeps[t_sweep[i]]);
    sweep.sprite.SetOpacity(1);
  }
}


place();
stack();
global.tick = 0; global.age = 0;
fun refresh() {
  frame(global.tick);
  global.tick = global.tick + 1;
  if (global.tick >= 240) global.tick = 0;
  global.age = global.age + 1;
  # (Caps Lock can change while the field shows)
  if (global.dialog.on && Plymouth.GetCapslockState() != global.caps) { global.caps = Plymouth.GetCapslockState(); stack(); }
}
Plymouth.SetRefreshFunction(refresh);
# Another display: everything sized and placed again
fun hotplug() { measure(); glass.image = scaled("glass"); glass.sprite = Sprite(glass.image); mark.image = scaled("mark"); mark.sprite = Sprite(mark.image); lighta.image = scaled("light"); lighta.sprite = Sprite(lighta.image); lightb.image = scaled("white"); lightb.sprite = Sprite(lightb.image); sweepnames[0] = "sweep00"; sweepnames[1] = "sweep01"; sweepnames[2] = "sweep02"; sweepnames[3] = "sweep03"; sweepnames[4] = "sweep04"; sweepnames[5] = "sweep05"; sweepnames[6] = "sweep06"; sweepnames[7] = "sweep07"; sweepnames[8] = "sweep08"; sweepnames[9] = "sweep09"; sweepnames[10] = "sweep10"; sweepnames[11] = "sweep11"; sweepnames[12] = "sweep12"; sweepnames[13] = "sweep13"; sweepnames[14] = "sweep14"; sweepnames[15] = "sweep15"; sweepnames[16] = "sweep16"; sweepnames[17] = "sweep17"; sweepnames[18] = "sweep18"; sweepnames[19] = "sweep19"; sweepnames[20] = "sweep20"; sweepnames[21] = "sweep21"; sweepnames[22] = "sweep22"; sweepnames[23] = "sweep23";  for (f = 0; sweepnames[f]; f++) sweeps[f] = scaled(sweepnames[f]); sweep.sprite = Sprite(); place(); stack(); }
Plymouth.SetDisplayHotplugFunction(hotplug);
