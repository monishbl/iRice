[Plymouth Theme]
Name=tessera-breathe
Description=Tessera: The badge with a soft glow that breathes, and a thin line that fills as your computer starts.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/tessera-breathe
