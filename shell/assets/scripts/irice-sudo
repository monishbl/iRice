#!/usr/bin/env -S python3 -I
"""sudo, for the AUR helper during an iRice update (yay/paru --sudo this):
hands the command to the update (sysupdate.py), whose root part, started
with the one password at the start, runs it if it's a pacman command
(irice-root.py check_pacman) and sends back its output and exit code. No
password is asked here. Outside an update (no IRICE_SUDO_SOCKET) it refuses.
"""
import json
import os
import signal
import socket
import sys


def main(argv):
    # sudo's own options: -v / -k (refresh, forget) are nothing to do here;
    # "--" ends them
    while argv and argv[0].startswith("-"):
        if argv[0] == "--":
            argv = argv[1:]
            break
        if argv[0] not in ("-v", "--validate", "-k", "-K", "--reset-timestamp", "--remove-timestamp"):
            print(f"irice-sudo: {argv[0]} isn't supported", file=sys.stderr)
            return 1
        argv = argv[1:]
    if not argv:
        return 0
    path = os.environ.get("IRICE_SUDO_SOCKET", "")
    if not path:
        print("irice-sudo: only works during an iRice update", file=sys.stderr)
        return 1
    # (the root part finishes what it started anyway: stopping here would
    # only lose its output)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(path)
        s.sendall((json.dumps({"token": os.environ.get("IRICE_SUDO_TOKEN", ""), "argv": argv,
                               "cwd": os.getcwd()}) + "\n").encode())
        for line in s.makefile("rb"):
            msg = json.loads(line)
            if "out" in msg:
                sys.stdout.write(msg["out"])
                sys.stdout.flush()
            if "exit" in msg:
                return int(msg["exit"])
    except (OSError, ValueError) as e:
        print(f"irice-sudo: the update isn't answering ({e})", file=sys.stderr)
        return 1
    print("irice-sudo: the update stopped answering", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
