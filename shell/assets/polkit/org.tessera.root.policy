<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Tessera's root helper (/usr/lib/tessera/tessera-root, from
  shell/assets/scripts/tessera-root.py), one action per subcommand: pkexec
  picks the action whose exec.path is the program and whose exec.argv1 is
  its first argument exactly. Every action asks for an administrator's
  password by default; 49-tessera.rules lets the small fixed ones through
  without it. A first argument not listed here falls back to pkexec's own
  action (org.freedesktop.policykit.exec, the password).
-->
<policyconfig>
  <vendor>Tessera</vendor>

  <action id="org.tessera.root.wallpaper">
    <description>Change the login screen's wallpaper</description>
    <message>Tessera wants to use your wallpaper on the login screen.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">wallpaper</annotate>
  </action>

  <action id="org.tessera.root.login-look">
    <description>Change the login screen's look</description>
    <message>Tessera wants to give the login screen your look.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">login-look</annotate>
  </action>

  <action id="org.tessera.root.fix">
    <description>Fix a system setting Tessera needs</description>
    <message>Tessera wants to fix a system service or setting.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">fix</annotate>
  </action>

  <action id="org.tessera.root.priority">
    <description>Change how the system schedules Tessera's shell</description>
    <message>Tessera wants to change its shell's priority (ananicy-cpp).</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">priority</annotate>
  </action>

  <action id="org.tessera.root.sharing-ports">
    <description>Let nearby sharing through the firewall</description>
    <message>Tessera wants to open or close the firewall's ports for Quick Share and LocalSend.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">sharing-ports</annotate>
  </action>

  <action id="org.tessera.root.fingerprint">
    <description>Use your fingerprint for passwords</description>
    <message>Tessera wants to change where your fingerprint is accepted instead of your password.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">fingerprint</annotate>
  </action>

  <action id="org.tessera.root.face">
    <description>Unlock the lock screen with your face</description>
    <message>Tessera wants to set up face unlock for your lock screen.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">face</annotate>
  </action>

  <action id="org.tessera.root.phonecam">
    <description>Use your phone as a webcam</description>
    <message>Tessera wants to add a virtual camera for your phone's camera.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">phonecam</annotate>
  </action>

  <action id="org.tessera.root.bootmenu">
    <description>Show snapshots in the boot menu</description>
    <message>Tessera wants to change whether snapshots are listed in the boot menu.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">bootmenu</annotate>
  </action>

  <!-- (always the password: it rebuilds the boot image) -->
  <action id="org.tessera.root.bootsplash">
    <description>Change the boot animation</description>
    <message>Tessera wants to change the animation shown while your computer starts. This rebuilds the boot image.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">bootsplash</annotate>
  </action>

  <action id="org.tessera.root.wifi-helper">
    <description>Set up a direct Wi-Fi link for Quick Share</description>
    <message>Tessera wants to set up a faster Wi-Fi link for Quick Share.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">wifi-helper</annotate>
  </action>

  <action id="org.tessera.root.quickshare-trust">
    <description>Let Quick Share set up fast links without asking</description>
    <message>Tessera wants to change whether Quick Share asks for your password for fast transfers.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">quickshare-trust</annotate>
  </action>

  <action id="org.tessera.root.update">
    <description>Install system updates</description>
    <message>Tessera wants to install updates.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tessera/tessera-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">update</annotate>
  </action>
</policyconfig>
